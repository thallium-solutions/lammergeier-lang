# Lammergeier standard library — cron-style scheduler.
#
# Thin wrapper around ``github.com/robfig/cron/v3`` — the de-facto
# Go cron library. It gives us a battle-tested parser (standard
# 5-field expressions, optional seconds, ``@hourly`` / ``@every 30s``
# descriptors, timezone support) and a thread-safe scheduler, so
# this module is intentionally small: create, schedule, start, stop.
#
#     from lamcron import Cron
#
#     # Fire every minute.
#     c: Cron = Cron.new()
#     id: int = c.schedule("* * * * *", lambda: print("tick")).unwrap()
#     c.start()                          # non-blocking — the scheduler
#                                        # runs in its own goroutine
#     # …do other work…
#     c.stop()                           # waits for in-flight jobs
#
#     # Second-resolution via the "with-seconds" factory.
#     fast: Cron = Cron.newWithSeconds()
#     fast.schedule("*/5 * * * * *", jobFn).unwrap()  # every 5 seconds
#     fast.start()
#
#     # Descriptor-style expressions work with either factory.
#     fast.schedule("@every 2s", ping).unwrap()
#
# Callback shape: any zero-arg function — ``lambda: ...``, a named
# function, or any Lam callable — is accepted. The scheduler
# recovers panics inside a job and logs them to stderr so one
# misbehaving callback can't take the whole scheduler down.

from lamconcurrency import Mutex
from lamerrors import Result, Error

go! {
    import (
        "fmt"

        cron "github.com/robfig/cron/v3"
    )

    // ``robfig/cron`` exposes a callback-shaped AddFunc API, but
    // callers routinely want the safety of panic-recovering job
    // wrappers. We install one shared wrapper so every scheduled
    // function benefits without the call-site having to remember
    // the idiom.
    //
    // The wrapper accepts every callable shape Lam is likely to
    // produce: bare ``func()``, ``func() interface{}`` (common for
    // lambdas), and the occasional ``func() error`` from authors
    // porting Go code verbatim.
    func lamCronWrap(fn interface{}) func() {
        return func() {
            defer func() {
                if r := recover(); r != nil {
                    // Stick to stderr; ``log`` would force a dep
                    // on every user program even when they don't
                    // care about cron diagnostics.
                    fmt.Printf("[lamcron] job panicked: %v\n", r)
                }
            }()
            switch f := fn.(type) {
            case func():
                f()
            case func() interface{}:
                f()
            case func() error:
                if err := f(); err != nil {
                    fmt.Printf("[lamcron] job returned error: %v\n", err)
                }
            default:
                fmt.Printf("[lamcron] job has unsupported signature %T\n", fn)
            }
        }
    }

    // Keep the SDK scheduler opaque at the Lam boundary. Lifecycle state
    // lives on ``Cron`` where its lamconcurrency mutex protects it.
    type lamCronHandle struct {
        c *cron.Cron
    }
}

class Cron {
    #- A cron scheduler. Construct with :py:meth:`new` (5-field,
       minute-resolution) or :py:meth:`newWithSeconds` (6-field,
       second-resolution). The two forms have identical runtime
       behaviour — only the parser differs. -#

    func init(self) {
        self._handle: any = None
        self._mu: Mutex = Mutex()
        self._started: bool = false
    }

    static func new() -> Cron {
        #- Create a fresh scheduler that accepts standard 5-field
           cron expressions (``min hour dom mon dow``) and ``@``
           descriptors (``@daily``, ``@every 1m``, …). -#
        c: Cron = Cron()
        go! {
            c._handle = &lamCronHandle{c: cron.New()}
        }
        return c
    }

    static func newWithSeconds() -> Cron {
        #- Create a scheduler that accepts 6-field expressions with
           an explicit seconds field, e.g. ``*/5 * * * * *``. Useful
           when you want sub-minute resolution without polling. -#
        c: Cron = Cron()
        go! {
            c._handle = &lamCronHandle{
                c: cron.New(cron.WithSeconds()),
            }
        }
        return c
    }

    func schedule(self, expr: str, fn: any) -> Result[int] {
        #- Register ``fn`` to run whenever ``expr`` next fires.
           Returns the entry ID, or a ``CronError`` for invalid input. -#
        self._mu.lock()
        defer self._mu.unlock()
        go! {
            switch fn.(type) {
            case func(), func() interface{}, func() error:
                // Supported callback shapes.
            default:
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CronError", fmt.Sprintf("schedule: unsupported callback signature %T", fn), nil,
                ))
            }
            h := s._handle.(*lamCronHandle)
            id, err := h.c.AddFunc(expr, lamCronWrap(fn))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CronError", fmt.Sprintf("bad schedule %q: %v", expr, err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(int(id))
        }
    }

    func remove(self, entryId: int) {
        #- Cancel a previously scheduled entry. Idempotent — passing
           an unknown or already-removed ID is a silent no-op. -#
        self._mu.lock()
        defer self._mu.unlock()
        go! {
            h := s._handle.(*lamCronHandle)
            h.c.Remove(cron.EntryID(entryId))
        }
    }

    func start(self) {
        #- Start ticking. Non-blocking — the scheduler runs in its
           own goroutine so callers can continue their program.
           Calling ``start`` twice is a no-op. -#
        self._mu.lock()
        defer self._mu.unlock()
        if self._started { return }
        go! {
            h := s._handle.(*lamCronHandle)
            h.c.Start()
        }
        self._started = true
    }

    func stop(self) {
        #- Stop accepting new job firings and block until every
           in-flight job finishes. Once stopped, a scheduler can
           be restarted by calling :py:meth:`start` again; entries
           persist across the restart. -#
        self._mu.lock()
        if not self._started {
            self._mu.unlock()
            return
        }
        self._started = false
        self._mu.unlock()
        go! {
            h := s._handle.(*lamCronHandle)
            // Do not hold the scheduler mutex while waiting: a running job
            // may legitimately call back into this Cron instance.
            ctx := h.c.Stop()
            <-ctx.Done()
        }
    }

    func entryIds(self) -> list[int] {
        #- Snapshot of the scheduler's current entry IDs, in the
           order ``robfig/cron`` maintains them internally. Useful
           for iterating over all jobs to ``remove`` them during
           shutdown. -#
        out: list[int] = []
        self._mu.lock()
        defer self._mu.unlock()
        go! {
            h := s._handle.(*lamCronHandle)
            for _, e := range h.c.Entries() {
                out = append(out, int(e.ID))
            }
        }
        return out
    }

    func count(self) -> int {
        #- Number of currently-scheduled entries. Handy for tests
           and readiness checks. -#
        return len(self.entryIds())
    }
}
