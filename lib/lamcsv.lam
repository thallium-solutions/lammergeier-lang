# Lammergeier standard library: CSV reading/writing
# Import with: from lamcsv import Csv, CsvReader
#
# Parsing and file operations return Result values. Csv.rows and Csv.batches
# are lazy generators: each yielded row or batch is itself a Result, allowing
# an open/read/parse failure to be reported without loading the whole file.
# Leaving a loop over them early (``break``, ``return``, ``?``, an exception)
# closes the file at once.
#
# Every reader and writer takes a ``delimiter`` (default ``","``; ``";"``
# for the spreadsheets of locales that write decimal commas, ``"\t"`` for
# TSV). It must be one character other than ``"``, ``\r``, ``\n`` and the
# Unicode replacement character; another value throws a
# ``CsvDelimiterError``.
#
# Writing follows RFC 4180: a field is quoted when it contains the
# delimiter, ``"``, ``\r`` or ``\n``, starts with white space (a space, a
# tab...) or is exactly ``\.``, and a ``"`` inside a quoted field is
# doubled; every record ends with ``\n``.
# Reading accepts the same (quoted fields may span lines, ``\r\n`` record
# ends are accepted) and requires every record to have as many fields as
# the first one.

from lamerrors import Result, Error

go! {
    import (
        "encoding/csv"
        "fmt"
        "io"
        "os"
        "strings"
        "unicode/utf8"
    )

    // lamCsvComma checks a delimiter: one rune that is not a quote, a line
    // break or the replacement character (an invalid one is a programming
    // error and throws).
    func lamCsvComma(delimiter string) rune {
        r, size := utf8.DecodeRuneInString(delimiter)
        if size == 0 || size != len(delimiter) || r == '"' || r == '\r' || r == '\n' || r == utf8.RuneError {
            panic(fmt.Sprintf("CsvDelimiterError: invalid CSV delimiter %q (one character other than a quote or a line break)", delimiter))
        }
        return r
    }
}

class CsvReader {
    #- Stateful streaming CSV file reader. Prefer Csv.rows/Csv.batches for
       normal iteration; use this class when explicit read/close control is
       required. readRow returns Ok([]) only when eof has become true. -#

    func init(self, reader: any, file: any) {
        self.reader: any = reader
        self.file: any = file
        self.eof: bool = false
        self.closed: bool = false
    }

    static func open(path: str, delimiter: str = ",") -> Result[CsvReader] {
        go! {
            comma := lamCsvComma(delimiter)
            f, err := os.Open(path)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvFileError", fmt.Sprintf("open %q: %v", path, err), nil,
                ))
            }
            r := csv.NewReader(f)
            r.Comma = comma
            return LAMMERGEIER.Result.Ok(NewCsvReader(r, f))
        }
    }

    func readRow(self) -> Result[list[str]] {
        go! {
            if self.closed {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvFileError", "readRow: reader is closed", nil,
                ))
            }
            r, ok := self.reader.(*csv.Reader)
            if !ok || r == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvFileError", "readRow: reader is invalid", nil,
                ))
            }
            row, err := r.Read()
            if err == io.EOF {
                self.eof = true
                return LAMMERGEIER.Result.Ok([]string{})
            }
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvParseError", fmt.Sprintf("read row failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(row)
        }
    }

    func close(self) -> Result[bool] {
        go! {
            if self.closed {
                return LAMMERGEIER.Result.Ok(true)
            }
            f, ok := self.file.(*os.File)
            if !ok || f == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvFileError", "close: file is invalid", nil,
                ))
            }
            if err := f.Close(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvFileError", fmt.Sprintf("close failed: %v", err), nil,
                ))
            }
            self.closed = true
            self.file = nil
            return LAMMERGEIER.Result.Ok(true)
        }
    }
}

class Csv {
    static func parseAll(content: str, delimiter: str = ",") -> Result[list[list[str]]] {
        #- Parse CSV already held in memory. -#
        go! {
            r := csv.NewReader(strings.NewReader(content))
            r.Comma = lamCsvComma(delimiter)
            records, err := r.ReadAll()
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CsvParseError", fmt.Sprintf("parse failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(records)
        }
    }

    static func parseFile(path: str, delimiter: str = ",") -> Result[list[list[str]]] {
        #- Parse a complete file through the streaming row generator. Use
           rows or batches when the complete result should not be retained. -#
        records: list[list[str]] = []
        for rowResult in Csv.rows(path, delimiter) {
            if not rowResult.ok() {
                return Result.Err(rowResult.error)
            }
            row: list[str] = rowResult.unwrap()
            records.append(row)
        }
        return Result.Ok(records)
    }

    static func rows(path: str, delimiter: str = ",") -> Result[list[str]] {
        #- Lazily yield Result[row] values from path. A file or parse error is
           yielded once, after which iteration ends. Empty files yield none. -#
        opened: Result[CsvReader] = CsvReader.open(path, delimiter)
        if not opened.ok() {
            yield Result.Err(opened.error)
            return
        }

        reader: CsvReader = opened.unwrap()
        try {
            while not reader.eof {
                rowResult: Result[list[str]] = reader.readRow()
                if not rowResult.ok() {
                    reader.close()
                    yield rowResult
                    return
                }
                if not reader.eof {
                    yield rowResult
                }
            }

            closed: Result[bool] = reader.close()
            if not closed.ok() {
                yield Result.Err(closed.error)
            }
        } finally {
            # A consumer leaving its loop early ends the generator at its
            # ``yield``: the file is closed then (``close`` is idempotent).
            reader.close()
        }
    }

    static func batches(path: str, batchSize: int = 100, delimiter: str = ",") -> Result[list[list[str]]] {
        #- Lazily yield Result[batch] values. batchSize must be positive; the
           final successful batch may contain fewer rows. -#
        if batchSize <= 0 {
            yield Result.Err(Error("CsvBatchSizeError", "batchSize must be greater than zero", None))
            return
        }

        batch: list[list[str]] = []
        for rowResult in Csv.rows(path, delimiter) {
            if not rowResult.ok() {
                yield Result.Err(rowResult.error)
                return
            }
            row: list[str] = rowResult.unwrap()
            batch.append(row)
            if len(batch) == batchSize {
                yield Result.Ok(batch)
                batch = []
            }
        }
        if len(batch) > 0 {
            yield Result.Ok(batch)
        }
    }

    static func streamRows(path: str, delimiter: str = ",") -> Result[list[str]] {
        #- Descriptive alias for rows. -#
        for rowResult in Csv.rows(path, delimiter) {
            yield rowResult
        }
    }

    static func streamBatches(path: str, batchSize: int = 100, delimiter: str = ",") -> Result[list[list[str]]] {
        #- Descriptive alias for batches. -#
        for batchResult in Csv.batches(path, batchSize, delimiter) {
            yield batchResult
        }
    }

    static func formatRow(fields: list[str], delimiter: str = ",") -> str {
        #- Format one RFC 4180-style record, excluding its trailing newline. -#
        go! {
            var buf strings.Builder
            w := csv.NewWriter(&buf)
            w.Comma = lamCsvComma(delimiter)
            _ = w.Write(fields)
            w.Flush()
            return strings.TrimSuffix(buf.String(), "\n")
        }
    }

    static func formatAll(rows: list[list[str]], delimiter: str = ",") -> str {
        #- Format records, each followed by ``\n`` (``""`` for no rows). -#
        go! {
            var buf strings.Builder
            w := csv.NewWriter(&buf)
            w.Comma = lamCsvComma(delimiter)
            for _, row := range rows {
                _ = w.Write(row)
            }
            w.Flush()
            return buf.String()
        }
    }
}

func main() {
    pass
}
