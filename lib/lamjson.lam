# Lammergeier standard library: native JSON values and utilities
# Import with: from lamjson import Json
#
# The native ``json`` type accepts null, booleans, strings, finite numbers,
# arrays, string-keyed objects, nested json values, and class instances that
# implement ``func __json__(self) -> json``. Fallible public operations return
# ``Result`` so callers can handle malformed input without panics or sentinels.
#
# Typed member reads are tolerant: ``Json.getStr(doc, "name")``,
# ``getInt``, ``getFloat``, ``getBool`` return the member when it has the
# requested kind and ``fallback`` otherwise (a missing member, null, another
# kind, or a ``doc`` that is not an object). ``getInt`` takes integers and
# floats with an integral value (``3.0``; not ``3.5``), ``getFloat`` any
# number; strings are never converted (``Conv.parse`` them). ``Json.has``
# tells a member set to null from a missing one, ``Json.at(doc, ["user",
# "tags", 0])`` follows a path, and ``Json.mapKeys(doc, Strings.camelCase)``
# renames object keys.
#
# Like Python objects, json values are shared, not copied: a json value put
# into a json literal (``{"user": user}``), returned by ``__json__`` and
# converted with ``json(x)``, or assigned to a member (``doc.user = user``)
# is the same value in both places, so nesting json values costs nothing
# per level; ``Json.copy(doc)`` makes an independent copy. Lam collections
# (``dict``, ``list``) are converted, which copies them.
#
# ``Json.encode``, ``str(doc)``, f-strings and the Go marshaler write the
# encoding/json bytes (sorted keys, ``<`` ``>`` ``&`` escaped as
# ``\u003c``...) directly into one pooled buffer; values encoding/json would
# treat specially go through it unchanged.

from lamerrors import Result, Error

go! {
    import (
        "database/sql/driver"
        "encoding/json"
        "fmt"
        "io"
        "math"
        "reflect"
        "slices"
        "sort"
        "strconv"
        "strings"
        "unicode/utf8"
        "unsafe"
    )

    type LamJSON struct {
        value interface{}
    }

    type lamJSONMarshaler interface {
        LamJSON() LamJSON
    }

    // lamDynamicValue: the most-derived object of a class instance viewed
    // as one of its bases (the compiler's ``_lamDyn``), so ``json(p)`` of a
    // ``p: Base`` holding a subclass runs the subclass's ``__json__``.
    func lamDynamicValue(value interface{}) interface{} {
        if d, ok := value.(interface{ _lamDyn() interface{} }); ok {
            if actual := d._lamDyn(); actual != nil {
                return actual
            }
        }
        return value
    }

    // lamJSONNormalize converts a Lam value to the tree a ``json`` value
    // holds: nil, bool, string, integers, finite floats,
    // ``map[string]interface{}`` and ``[]interface{}`` (never nil, never
    // a ``json.Number``). Lam containers are converted (copied); a
    // ``json`` value, also the result of a ``__json__`` method, already
    // holds such a tree and is shared, not copied again, so nesting json
    // values costs nothing per level.
    func lamJSONNormalize(value interface{}, depth int) (interface{}, error) {
        if depth > 256 {
            return nil, fmt.Errorf("json nesting exceeds 256 levels or contains a cycle")
        }
        // The shapes the compiler emits first, without reflection.
        switch v := value.(type) {
        case nil, bool, string, int, int64:
            return v, nil
        case LamJSON:
            return v.value, nil
        case *LamJSON:
            if v == nil { return nil, nil }
            return v.value, nil
        case map[string]interface{}:
            out := make(map[string]interface{}, len(v))
            for key, item := range v {
                normalized, err := lamJSONNormalize(item, depth+1)
                if err != nil { return nil, err }
                out[key] = normalized
            }
            return out, nil
        case []interface{}:
            out := make([]interface{}, len(v))
            for i, item := range v {
                normalized, err := lamJSONNormalize(item, depth+1)
                if err != nil { return nil, err }
                out[i] = normalized
            }
            return out, nil
        case []LamJSON:
            out := make([]interface{}, len(v))
            for i, item := range v { out[i] = item.value }
            return out, nil
        case []string:
            out := make([]interface{}, len(v))
            for i, item := range v { out[i] = item }
            return out, nil
        case []int:
            out := make([]interface{}, len(v))
            for i, item := range v { out[i] = item }
            return out, nil
        case map[string]LamJSON:
            out := make(map[string]interface{}, len(v))
            for key, item := range v { out[key] = item.value }
            return out, nil
        case map[string]string:
            out := make(map[string]interface{}, len(v))
            for key, item := range v { out[key] = item }
            return out, nil
        }
        value = lamDynamicValue(value)
        switch v := value.(type) {
        case lamJSONMarshaler:
            return v.LamJSON().value, nil
        case nil, bool, string,
             int, int8, int16, int32, int64,
             uint, uint8, uint16, uint32, uint64:
            return v, nil
        case float32:
            f := float64(v)
            if math.IsNaN(f) || math.IsInf(f, 0) { return nil, fmt.Errorf("json numbers must be finite") }
            return v, nil
        case float64:
            if math.IsNaN(v) || math.IsInf(v, 0) { return nil, fmt.Errorf("json numbers must be finite") }
            return v, nil
        case json.Number:
            if i, err := strconv.ParseInt(string(v), 10, 64); err == nil {
                if int64(int(i)) == i { return int(i), nil }
                return i, nil
            }
            f, err := strconv.ParseFloat(string(v), 64)
            if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
                return nil, fmt.Errorf("invalid json number %q", v)
            }
            return f, nil
        }

        rv := reflect.ValueOf(value)
        if !rv.IsValid() { return nil, nil }
        switch rv.Kind() {
        case reflect.Map:
            if rv.Type().Key().Kind() != reflect.String {
                return nil, fmt.Errorf("json object keys must be strings, got %s", rv.Type().Key())
            }
            out := make(map[string]interface{}, rv.Len())
            iter := rv.MapRange()
            for iter.Next() {
                normalized, err := lamJSONNormalize(iter.Value().Interface(), depth+1)
                if err != nil { return nil, err }
                out[iter.Key().String()] = normalized
            }
            return out, nil
        case reflect.Slice, reflect.Array:
            out := make([]interface{}, rv.Len())
            for i := 0; i < rv.Len(); i++ {
                normalized, err := lamJSONNormalize(rv.Index(i).Interface(), depth+1)
                if err != nil { return nil, err }
                out[i] = normalized
            }
            return out, nil
        }
        return nil, fmt.Errorf("value of type %T is not JSON-compatible; implement __json__", value)
    }

    func lamJSONFrom(value interface{}) (LamJSON, error) {
        normalized, err := lamJSONNormalize(value, 0)
        if err != nil { return LamJSON{}, err }
        return LamJSON{value: normalized}, nil
    }

    // lamValueText is ``str(v)`` / an f-string slot of an html, xml or json
    // value: the value's own text (rendered or encoded once), not copied
    // again through fmt. A string is itself; anything else (the compiler
    // expected one of those types but holds an ``interface{}``) is fmt's
    // ``%v``, as before.
    type lamTexter interface{ lamText() string }

    func (value LamJSON) lamText() string { return value.String() }

    func lamValueText(v interface{}) string {
        switch x := v.(type) {
        case string:
            return x
        case lamTexter:
            return x.lamText()
        }
        return fmt.Sprintf("%v", v)
    }

    func lamJSONMust(value interface{}) LamJSON {
        result, err := lamJSONFrom(value)
        if err != nil { panic(fmt.Sprintf("json value error: %v", err)) }
        return result
    }

    // lamJSONLiteral is ``lamJSONMust`` for a json literal (``{...}``,
    // ``[...]``, a comprehension): its outer object or array was just
    // built by the generated code and is referenced nowhere else, so its
    // members are normalized in place instead of into a copy.
    func lamJSONLiteral(value interface{}) LamJSON {
        switch v := value.(type) {
        case map[string]interface{}:
            for key, item := range v {
                normalized, err := lamJSONNormalize(item, 1)
                if err != nil { panic(fmt.Sprintf("json value error: %v", err)) }
                v[key] = normalized
            }
            return LamJSON{value: v}
        case []interface{}:
            for i, item := range v {
                normalized, err := lamJSONNormalize(item, 1)
                if err != nil { panic(fmt.Sprintf("json value error: %v", err)) }
                v[i] = normalized
            }
            return LamJSON{value: v}
        }
        return lamJSONMust(value)
    }

    // ── Encoding ──────────────────────────────────────────────────────
    //
    // lamJSONMarshal(value) is ``json.Marshal(value)``, byte for byte and
    // error for error, without its reflection and intermediate buffers:
    // the shapes json values and Lam collections have (objects with
    // sorted keys, arrays, strings with the same escaping, HTML-sensitive
    // ``<`` ``>`` ``&`` included, numbers formatted as encoding/json does)
    // are measured (lamJSONSize), then written into one allocation of that
    // size, which is the result; anything else (structs, []byte,
    // json.Number, values nested deeper than 128 levels, a non-finite
    // float) makes the whole value go through encoding/json instead, so
    // the result and the error never differ.

    // Bytes encoding/json writes as they are inside a string (HTML escaping on).
    var lamJSONSafe = func() (safe [utf8.RuneSelf]bool) {
        for c := 0x20; c < utf8.RuneSelf; c++ {
            safe[c] = c != '"' && c != '\\' && c != '<' && c != '>' && c != '&'
        }
        return
    }()

    const lamJSONHex = "0123456789abcdef"

    // lamJSONAppendString is encoding/json's appendString with escapeHTML.
    func lamJSONAppendString(dst []byte, src string) []byte {
        dst = append(dst, '"')
        start := 0
        for i := 0; i < len(src); {
            if b := src[i]; b < utf8.RuneSelf {
                if lamJSONSafe[b] {
                    i++
                    continue
                }
                dst = append(dst, src[start:i]...)
                switch b {
                case '\\', '"':
                    dst = append(dst, '\\', b)
                case '\b':
                    dst = append(dst, '\\', 'b')
                case '\f':
                    dst = append(dst, '\\', 'f')
                case '\n':
                    dst = append(dst, '\\', 'n')
                case '\r':
                    dst = append(dst, '\\', 'r')
                case '\t':
                    dst = append(dst, '\\', 't')
                default:
                    dst = append(dst, '\\', 'u', '0', '0', lamJSONHex[b>>4], lamJSONHex[b&0xF])
                }
                i++
                start = i
                continue
            }
            c, size := utf8.DecodeRuneInString(src[i:])
            if c == utf8.RuneError && size == 1 {
                dst = append(dst, src[start:i]...)
                dst = append(dst, `\ufffd`...)
                i += size
                start = i
                continue
            }
            if c == '\u2028' || c == '\u2029' {
                dst = append(dst, src[start:i]...)
                dst = append(dst, '\\', 'u', '2', '0', '2', lamJSONHex[c&0xF])
                i += size
                start = i
                continue
            }
            i += size
        }
        dst = append(dst, src[start:]...)
        return append(dst, '"')
    }

    // lamJSONAppendFloat is encoding/json's float encoder (finite values).
    func lamJSONAppendFloat(b []byte, f float64, bits int) []byte {
        abs := math.Abs(f)
        format := byte('f')
        if abs != 0 {
            if bits == 64 && (abs < 1e-6 || abs >= 1e21) || bits == 32 && (float32(abs) < 1e-6 || float32(abs) >= 1e21) {
                format = 'e'
            }
        }
        b = strconv.AppendFloat(b, f, format, -1, bits)
        if format == 'e' {
            n := len(b)
            if n >= 4 && b[n-4] == 'e' && b[n-3] == '-' && b[n-2] == '0' {
                b[n-2] = b[n-1]
                b = b[:n-1]
            }
        }
        return b
    }

    // lamJSONSortKeys sorts object keys as encoding/json does (bytewise).
    func lamJSONSortKeys(keys []string) {
        if len(keys) > 24 {
            slices.Sort(keys)
            return
        }
        for i := 1; i < len(keys); i++ {
            for j := i; j > 0 && keys[j] < keys[j-1]; j-- {
                keys[j], keys[j-1] = keys[j-1], keys[j]
            }
        }
    }

    // lamJSONAppendKey writes ``"key":``.
    func lamJSONAppendKey(b []byte, key string, first bool) []byte {
        if !first {
            b = append(b, ',')
        }
        b = lamJSONAppendString(b, key)
        return append(b, ':')
    }

    // lamJSONAppend writes ``value`` as json.Marshal would; false when it
    // cannot (the caller then uses encoding/json for the whole value).
    func lamJSONAppend(b []byte, value interface{}, depth int) ([]byte, bool) {
        if depth > 128 {
            return b, false
        }
        switch v := value.(type) {
        case nil:
            return append(b, "null"...), true
        case string:
            return lamJSONAppendString(b, v), true
        case bool:
            if v {
                return append(b, "true"...), true
            }
            return append(b, "false"...), true
        case int:
            return strconv.AppendInt(b, int64(v), 10), true
        case int64:
            return strconv.AppendInt(b, v, 10), true
        case int8:
            return strconv.AppendInt(b, int64(v), 10), true
        case int16:
            return strconv.AppendInt(b, int64(v), 10), true
        case int32:
            return strconv.AppendInt(b, int64(v), 10), true
        case uint:
            return strconv.AppendUint(b, uint64(v), 10), true
        case uint8:
            return strconv.AppendUint(b, uint64(v), 10), true
        case uint16:
            return strconv.AppendUint(b, uint64(v), 10), true
        case uint32:
            return strconv.AppendUint(b, uint64(v), 10), true
        case uint64:
            return strconv.AppendUint(b, v, 10), true
        case float64:
            if math.IsNaN(v) || math.IsInf(v, 0) {
                return b, false
            }
            return lamJSONAppendFloat(b, v, 64), true
        case float32:
            if f := float64(v); math.IsNaN(f) || math.IsInf(f, 0) {
                return b, false
            }
            return lamJSONAppendFloat(b, float64(v), 32), true
        case LamJSON:
            return lamJSONAppend(b, v.value, depth+1)
        case *LamJSON:
            if v == nil {
                return append(b, "null"...), true
            }
            return lamJSONAppend(b, v.value, depth+1)
        case map[string]interface{}:
            if v == nil {
                return append(b, "null"...), true
            }
            var stack [24]string
            keys := stack[:0]
            if len(v) > len(stack) {
                keys = make([]string, 0, len(v))
            }
            for key := range v {
                keys = append(keys, key)
            }
            lamJSONSortKeys(keys)
            b = append(b, '{')
            ok := true
            for i, key := range keys {
                b = lamJSONAppendKey(b, key, i == 0)
                if b, ok = lamJSONAppend(b, v[key], depth+1); !ok {
                    return b, false
                }
            }
            return append(b, '}'), true
        case []interface{}:
            if v == nil {
                return append(b, "null"...), true
            }
            b = append(b, '[')
            ok := true
            for i, item := range v {
                if i > 0 {
                    b = append(b, ',')
                }
                if b, ok = lamJSONAppend(b, item, depth+1); !ok {
                    return b, false
                }
            }
            return append(b, ']'), true
        case []LamJSON:
            if v == nil {
                return append(b, "null"...), true
            }
            b = append(b, '[')
            ok := true
            for i, item := range v {
                if i > 0 {
                    b = append(b, ',')
                }
                if b, ok = lamJSONAppend(b, item.value, depth+1); !ok {
                    return b, false
                }
            }
            return append(b, ']'), true
        case []string:
            if v == nil {
                return append(b, "null"...), true
            }
            b = append(b, '[')
            for i, item := range v {
                if i > 0 {
                    b = append(b, ',')
                }
                b = lamJSONAppendString(b, item)
            }
            return append(b, ']'), true
        case []int:
            if v == nil {
                return append(b, "null"...), true
            }
            b = append(b, '[')
            for i, item := range v {
                if i > 0 {
                    b = append(b, ',')
                }
                b = strconv.AppendInt(b, int64(item), 10)
            }
            return append(b, ']'), true
        case []map[string]interface{}:
            if v == nil {
                return append(b, "null"...), true
            }
            b = append(b, '[')
            ok := true
            for i, item := range v {
                if i > 0 {
                    b = append(b, ',')
                }
                if b, ok = lamJSONAppend(b, item, depth+1); !ok {
                    return b, false
                }
            }
            return append(b, ']'), true
        case map[string]string:
            if v == nil {
                return append(b, "null"...), true
            }
            var stack [24]string
            keys := stack[:0]
            if len(v) > len(stack) {
                keys = make([]string, 0, len(v))
            }
            for key := range v {
                keys = append(keys, key)
            }
            lamJSONSortKeys(keys)
            b = append(b, '{')
            for i, key := range keys {
                b = lamJSONAppendKey(b, key, i == 0)
                b = lamJSONAppendString(b, v[key])
            }
            return append(b, '}'), true
        case map[string]LamJSON:
            if v == nil {
                return append(b, "null"...), true
            }
            var stack [24]string
            keys := stack[:0]
            if len(v) > len(stack) {
                keys = make([]string, 0, len(v))
            }
            for key := range v {
                keys = append(keys, key)
            }
            lamJSONSortKeys(keys)
            b = append(b, '{')
            ok := true
            for i, key := range keys {
                b = lamJSONAppendKey(b, key, i == 0)
                if b, ok = lamJSONAppend(b, v[key].value, depth+1); !ok {
                    return b, false
                }
            }
            return append(b, '}'), true
        }
        return b, false
    }

    // lamJSONStringSize is the length lamJSONAppendString writes for src.
    func lamJSONStringSize(src string) int {
        n := 2
        for i := 0; i < len(src); {
            b := src[i]
            if b < utf8.RuneSelf {
                switch {
                case lamJSONSafe[b]:
                    n++
                case b == '\\' || b == '"' || b == '\b' || b == '\f' || b == '\n' || b == '\r' || b == '\t':
                    n += 2
                default:
                    n += 6
                }
                i++
                continue
            }
            c, size := utf8.DecodeRuneInString(src[i:])
            if (c == utf8.RuneError && size == 1) || c == '\u2028' || c == '\u2029' {
                n += 6
            } else {
                n += size
            }
            i += size
        }
        return n
    }

    func lamJSONIntSize(v int64) int {
        n := 1
        if v < 0 {
            n++
            if v == math.MinInt64 {
                return 20
            }
            v = -v
        }
        for v >= 10 {
            v /= 10
            n++
        }
        return n
    }

    func lamJSONUintSize(v uint64) int {
        n := 1
        for v >= 10 {
            v /= 10
            n++
        }
        return n
    }

    func lamJSONFloatSize(f float64, bits int) int {
        var tmp [40]byte
        return len(lamJSONAppendFloat(tmp[:0], f, bits))
    }

    // lamJSONObjectSize: braces, commas and the ``"key":`` of n members.
    func lamJSONMembersSize(n int) int {
        if n == 0 {
            return 2
        }
        return 2 + (n - 1) + n
    }

    func lamJSONItemsSize(n int) int {
        if n == 0 {
            return 2
        }
        return 2 + (n - 1)
    }

    // lamJSONSize is the length lamJSONAppend writes for value; false
    // exactly when lamJSONAppend would return false.
    func lamJSONSize(value interface{}, depth int) (int, bool) {
        if depth > 128 {
            return 0, false
        }
        switch v := value.(type) {
        case nil:
            return 4, true
        case string:
            return lamJSONStringSize(v), true
        case bool:
            if v {
                return 4, true
            }
            return 5, true
        case int:
            return lamJSONIntSize(int64(v)), true
        case int64:
            return lamJSONIntSize(v), true
        case int8:
            return lamJSONIntSize(int64(v)), true
        case int16:
            return lamJSONIntSize(int64(v)), true
        case int32:
            return lamJSONIntSize(int64(v)), true
        case uint:
            return lamJSONUintSize(uint64(v)), true
        case uint8:
            return lamJSONUintSize(uint64(v)), true
        case uint16:
            return lamJSONUintSize(uint64(v)), true
        case uint32:
            return lamJSONUintSize(uint64(v)), true
        case uint64:
            return lamJSONUintSize(v), true
        case float64:
            if math.IsNaN(v) || math.IsInf(v, 0) {
                return 0, false
            }
            return lamJSONFloatSize(v, 64), true
        case float32:
            if f := float64(v); math.IsNaN(f) || math.IsInf(f, 0) {
                return 0, false
            }
            return lamJSONFloatSize(float64(v), 32), true
        case LamJSON:
            return lamJSONSize(v.value, depth+1)
        case *LamJSON:
            if v == nil {
                return 4, true
            }
            return lamJSONSize(v.value, depth+1)
        case map[string]interface{}:
            if v == nil {
                return 4, true
            }
            n := lamJSONMembersSize(len(v))
            for key, item := range v {
                size, ok := lamJSONSize(item, depth+1)
                if !ok {
                    return 0, false
                }
                n += lamJSONStringSize(key) + size
            }
            return n, true
        case []interface{}:
            if v == nil {
                return 4, true
            }
            n := lamJSONItemsSize(len(v))
            for _, item := range v {
                size, ok := lamJSONSize(item, depth+1)
                if !ok {
                    return 0, false
                }
                n += size
            }
            return n, true
        case []LamJSON:
            if v == nil {
                return 4, true
            }
            n := lamJSONItemsSize(len(v))
            for _, item := range v {
                size, ok := lamJSONSize(item.value, depth+1)
                if !ok {
                    return 0, false
                }
                n += size
            }
            return n, true
        case []string:
            if v == nil {
                return 4, true
            }
            n := lamJSONItemsSize(len(v))
            for _, item := range v {
                n += lamJSONStringSize(item)
            }
            return n, true
        case []int:
            if v == nil {
                return 4, true
            }
            n := lamJSONItemsSize(len(v))
            for _, item := range v {
                n += lamJSONIntSize(int64(item))
            }
            return n, true
        case []map[string]interface{}:
            if v == nil {
                return 4, true
            }
            n := lamJSONItemsSize(len(v))
            for _, item := range v {
                size, ok := lamJSONSize(item, depth+1)
                if !ok {
                    return 0, false
                }
                n += size
            }
            return n, true
        case map[string]string:
            if v == nil {
                return 4, true
            }
            n := lamJSONMembersSize(len(v))
            for key, item := range v {
                n += lamJSONStringSize(key) + lamJSONStringSize(item)
            }
            return n, true
        case map[string]LamJSON:
            if v == nil {
                return 4, true
            }
            n := lamJSONMembersSize(len(v))
            for key, item := range v {
                size, ok := lamJSONSize(item.value, depth+1)
                if !ok {
                    return 0, false
                }
                n += lamJSONStringSize(key) + size
            }
            return n, true
        }
        return 0, false
    }

    // lamJSONEncodeExact is the encoding of value in a new slice of its
    // exact length (false: encoding/json has to be used).
    func lamJSONEncodeExact(value interface{}) ([]byte, bool) {
        size, ok := lamJSONSize(value, 0)
        if !ok {
            return nil, false
        }
        return lamJSONAppend(make([]byte, 0, size), value, 0)
    }

    // lamJSONMarshal is json.Marshal(value): see Encoding above.
    func lamJSONMarshal(value interface{}) ([]byte, error) {
        if b, ok := lamJSONEncodeExact(value); ok {
            return b, nil
        }
        return json.Marshal(value)
    }

    // lamJSONMarshalString is string(json.Marshal(value)) with one
    // allocation, the text's own bytes (never written again).
    func lamJSONMarshalString(value interface{}) (string, error) {
        if b, ok := lamJSONEncodeExact(value); ok {
            return unsafe.String(unsafe.SliceData(b), len(b)), nil
        }
        data, err := json.Marshal(value)
        if err != nil {
            return "", err
        }
        return unsafe.String(unsafe.SliceData(data), len(data)), nil
    }

    func lamJSONParse(text string) (LamJSON, error) {
        decoder := json.NewDecoder(strings.NewReader(text))
        decoder.UseNumber()
        var raw interface{}
        if err := decoder.Decode(&raw); err != nil { return LamJSON{}, err }
        var extra interface{}
        if err := decoder.Decode(&extra); err != io.EOF {
            if err == nil { return LamJSON{}, fmt.Errorf("multiple JSON values") }
            return LamJSON{}, err
        }
        return lamJSONFrom(raw)
    }

    func lamJSONParseMust(text string) LamJSON {
        result, err := lamJSONParse(text)
        if err != nil { panic(fmt.Sprintf("json decode error: %v", err)) }
        return result
    }

    func lamJSONRaw(value LamJSON) interface{} {
        return value.value
    }

    // lamJSONWrapRaw re-wraps a raw value taken out of a ``json`` value
    // (``match`` bindings of json sub-values); it is already normalised.
    func lamJSONWrapRaw(raw interface{}) LamJSON {
        return LamJSON{value: raw}
    }

    // LamMatchRaw lets ``match`` see through a ``json`` value stored in
    // ``any`` without the generated helpers naming the LamJSON type.
    func (value LamJSON) LamMatchRaw() interface{} {
        return value.value
    }

    func lamJSONIsNull(value LamJSON) bool {
        return value.value == nil
    }

    func lamJSONEqual(left LamJSON, right LamJSON) bool {
        return reflect.DeepEqual(left.value, right.value)
    }

    func lamJSONIndex(key interface{}) (int, bool) {
        switch v := key.(type) {
        case int: return v, true
        case int8: return int(v), true
        case int16: return int(v), true
        case int32: return int(v), true
        case int64: return int(v), true
        case uint: return int(v), true
        case uint8: return int(v), true
        case uint16: return int(v), true
        case uint32: return int(v), true
        case uint64: return int(v), true
        }
        return 0, false
    }

    func lamJSONGet(value LamJSON, key interface{}) LamJSON {
        switch current := value.value.(type) {
        case map[string]interface{}:
            text, ok := key.(string)
            if !ok { panic(fmt.Sprintf("json object index must be str, got %T", key)) }
            return LamJSON{value: current[text]}
        case []interface{}:
            index, ok := lamJSONIndex(key)
            if !ok { panic(fmt.Sprintf("json array index must be int, got %T", key)) }
            if index < 0 || index >= len(current) { panic("json array index out of range") }
            return LamJSON{value: current[index]}
        default:
            // null, string, number, bool: nothing to look up, like a
            // missing object key (``doc.user.address`` with ``user: null``).
            return LamJSON{value: nil}
        }
    }

    func lamJSONSet(value LamJSON, key interface{}, replacement LamJSON) {
        switch current := value.value.(type) {
        case map[string]interface{}:
            text, ok := key.(string)
            if !ok { panic(fmt.Sprintf("json object index must be str, got %T", key)) }
            current[text] = replacement.value
        case []interface{}:
            index, ok := lamJSONIndex(key)
            if !ok { panic(fmt.Sprintf("json array index must be int, got %T", key)) }
            if index < 0 || index >= len(current) { panic("json array index out of range") }
            current[index] = replacement.value
        default:
            panic(fmt.Sprintf("cannot assign through json %s", lamJSONKind(value)))
        }
    }

    func lamJSONDelete(value LamJSON, key interface{}) {
        switch current := value.value.(type) {
        case map[string]interface{}:
            text, ok := key.(string)
            if !ok { panic(fmt.Sprintf("json object index must be str, got %T", key)) }
            delete(current, text)
        case []interface{}:
            index, ok := lamJSONIndex(key)
            if !ok { panic(fmt.Sprintf("json array index must be int, got %T", key)) }
            if index < 0 || index >= len(current) { panic("json array index out of range") }
            current[index] = nil
        default:
            panic(fmt.Sprintf("cannot delete from json %s", lamJSONKind(value)))
        }
    }

    func lamJSONLen(value LamJSON) int {
        switch current := value.value.(type) {
        case map[string]interface{}: return len(current)
        case []interface{}: return len(current)
        case string: return len(current)
        case nil: return 0
        default: panic(fmt.Sprintf("json %s has no length", lamJSONKind(value)))
        }
    }

    // lamJSONToFloat backs ``float(j)`` (and ``int(j)`` / ``bool(j)``): JSON
    // numbers and booleans convert, JSON strings are parsed (ParseError on
    // malformed text), any other JSON value raises a TypeError.
    func lamJSONToFloat(value LamJSON, target string) float64 {
        switch v := value.value.(type) {
        case bool:
            if v { return 1 }
            return 0
        case int: return float64(v)
        case int8: return float64(v)
        case int16: return float64(v)
        case int32: return float64(v)
        case int64: return float64(v)
        case uint: return float64(v)
        case uint8: return float64(v)
        case uint16: return float64(v)
        case uint32: return float64(v)
        case uint64: return float64(v)
        case float32: return float64(v)
        case float64: return v
        case json.Number:
            parsed, err := v.Float64()
            if err != nil { panic(fmt.Sprintf("ParseError: cannot parse %q as %s: %v", string(v), target, err)) }
            return parsed
        case string:
            if target == "int" {
                parsed, err := strconv.Atoi(v)
                if err != nil { panic(fmt.Sprintf("ParseError: cannot parse %q as int: %v", v, err)) }
                return float64(parsed)
            }
            parsed, err := strconv.ParseFloat(v, 64)
            if err != nil { panic(fmt.Sprintf("ParseError: cannot parse %q as %s: %v", v, target, err)) }
            return parsed
        }
        panic(fmt.Sprintf("TypeError: cannot convert json %s to %s", lamJSONKind(value), target))
    }

    func lamJSONToInt(value LamJSON) int {
        switch v := value.value.(type) {
        case int: return v
        case int64: return int(v)
        }
        return int(lamJSONToFloat(value, "int"))
    }

    func lamJSONToBool(value LamJSON) bool {
        switch v := value.value.(type) {
        case bool: return v
        case string:
            parsed, err := strconv.ParseBool(v)
            if err != nil { panic(fmt.Sprintf("ParseError: cannot parse %q as bool: %v", v, err)) }
            return parsed
        }
        return lamJSONToFloat(value, "bool") != 0
    }

    func lamJSONKind(value LamJSON) string {
        switch value.value.(type) {
        case nil: return "null"
        case bool: return "boolean"
        case string: return "string"
        case int, int8, int16, int32, int64,
             uint, uint8, uint16, uint32, uint64,
             float32, float64: return "number"
        case []interface{}: return "array"
        case map[string]interface{}: return "object"
        default: return "invalid"
        }
    }

    func lamJSONTryToDict(value LamJSON) (map[string]interface{}, bool) {
        result, ok := value.value.(map[string]interface{})
        return result, ok
    }

    func lamJSONToDict(value LamJSON) map[string]interface{} {
        result, ok := lamJSONTryToDict(value)
        if !ok { panic(fmt.Sprintf("json %s cannot convert to dict", lamJSONKind(value))) }
        return result
    }

    func lamJSONTryToList(value LamJSON) ([]interface{}, bool) {
        result, ok := value.value.([]interface{})
        return result, ok
    }

    func lamJSONToList(value LamJSON) []interface{} {
        result, ok := lamJSONTryToList(value)
        if !ok { panic(fmt.Sprintf("json %s cannot convert to list", lamJSONKind(value))) }
        return result
    }

    func (value LamJSON) MarshalJSON() ([]byte, error) {
        return lamJSONMarshal(value.value)
    }

    func (value *LamJSON) UnmarshalJSON(data []byte) error {
        parsed, err := lamJSONParse(string(data))
        if err != nil { return err }
        *value = parsed
        return nil
    }

    func (value LamJSON) Value() (driver.Value, error) {
        text, err := lamJSONMarshalString(value)
        if err != nil { return nil, err }
        return text, nil
    }

    func (value *LamJSON) Scan(source interface{}) error {
        switch raw := source.(type) {
        case nil:
            *value = LamJSON{value: nil}
            return nil
        case []byte:
            parsed, err := lamJSONParse(string(raw))
            if err != nil { return err }
            *value = parsed
            return nil
        case string:
            parsed, err := lamJSONParse(raw)
            if err != nil { return err }
            *value = parsed
            return nil
        default:
            return fmt.Errorf("cannot scan %T into json", source)
        }
    }

    func (value LamJSON) String() string {
        text, err := lamJSONMarshalString(value)
        if err != nil { return "null" }
        return text
    }

    // ── Typed member reads (Json.has / getStr / getInt / ...) ─────────

    // lamJSONMember is the member ``key`` of an object; found is false for
    // a missing member and for anything that is not an object.
    func lamJSONMember(doc LamJSON, key string) (interface{}, bool) {
        members, ok := doc.value.(map[string]interface{})
        if !ok { return nil, false }
        value, found := members[key]
        return value, found
    }

    // lamJSONAsInt reads a JSON number as an int: integers that fit, and
    // floats with an integral value inside the int64 range (``3.0``).
    func lamJSONAsInt(value interface{}) (int, bool) {
        switch v := value.(type) {
        case int: return v, true
        case int8: return int(v), true
        case int16: return int(v), true
        case int32: return int(v), true
        case int64: return int(v), true
        case uint: if uint64(v) <= math.MaxInt64 { return int(v), true }
        case uint8: return int(v), true
        case uint16: return int(v), true
        case uint32: return int(v), true
        case uint64: if v <= math.MaxInt64 { return int(v), true }
        case float32: return lamJSONIntegralFloat(float64(v))
        case float64: return lamJSONIntegralFloat(v)
        }
        return 0, false
    }

    func lamJSONIntegralFloat(f float64) (int, bool) {
        if math.IsNaN(f) || math.IsInf(f, 0) || f != math.Trunc(f) { return 0, false }
        if f < -9.223372036854775808e18 || f >= 9.223372036854775807e18 { return 0, false }
        return int(f), true
    }

    func lamJSONAsFloat(value interface{}) (float64, bool) {
        switch v := value.(type) {
        case int: return float64(v), true
        case int8: return float64(v), true
        case int16: return float64(v), true
        case int32: return float64(v), true
        case int64: return float64(v), true
        case uint: return float64(v), true
        case uint8: return float64(v), true
        case uint16: return float64(v), true
        case uint32: return float64(v), true
        case uint64: return float64(v), true
        case float32: return float64(v), true
        case float64: return v, true
        }
        return 0, false
    }

    // lamJSONAt follows a path of object keys (str) and array indexes (int,
    // negative from the end); anything missing on the way is null.
    func lamJSONAt(doc LamJSON, path []interface{}) LamJSON {
        current := doc.value
        for _, step := range path {
            switch node := current.(type) {
            case map[string]interface{}:
                key, ok := step.(string)
                if !ok { return LamJSON{value: nil} }
                current = node[key]
            case []interface{}:
                index, ok := lamJSONIndex(step)
                if !ok { return LamJSON{value: nil} }
                if index < 0 { index += len(node) }
                if index < 0 || index >= len(node) { return LamJSON{value: nil} }
                current = node[index]
            default:
                return LamJSON{value: nil}
            }
        }
        return LamJSON{value: current}
    }

    // lamJSONCopy deep-copies objects and arrays (scalars are immutable).
    func lamJSONCopy(value interface{}) interface{} {
        switch v := value.(type) {
        case map[string]interface{}:
            out := make(map[string]interface{}, len(v))
            for key, item := range v { out[key] = lamJSONCopy(item) }
            return out
        case []interface{}:
            out := make([]interface{}, len(v))
            for i, item := range v { out[i] = lamJSONCopy(item) }
            return out
        }
        return value
    }

    // lamJSONMapKeys renames object keys with rename, in sorted key order so
    // a collision keeps the value of the greatest original key.
    func lamJSONMapKeys(value interface{}, rename func(string) string, deep bool, depth int) interface{} {
        if depth > 256 { panic("json nesting exceeds 256 levels") }
        switch v := value.(type) {
        case map[string]interface{}:
            keys := make([]string, 0, len(v))
            for key := range v { keys = append(keys, key) }
            sort.Strings(keys)
            out := make(map[string]interface{}, len(v))
            for _, key := range keys {
                if deep {
                    out[rename(key)] = lamJSONMapKeys(v[key], rename, true, depth+1)
                } else {
                    out[rename(key)] = lamJSONCopy(v[key])
                }
            }
            return out
        case []interface{}:
            out := make([]interface{}, len(v))
            for i, item := range v {
                if deep {
                    out[i] = lamJSONMapKeys(item, rename, true, depth+1)
                } else {
                    out[i] = lamJSONCopy(item)
                }
            }
            return out
        }
        return value
    }
}

class Json {
    static func encode(data: json) -> Result[str] {
        go! {
            text, err := lamJSONMarshalString(data)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonEncodeError", fmt.Sprintf("encode failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(text)
        }
    }

    static func encodePretty(data: json) -> Result[str] {
        go! {
            b, err := json.MarshalIndent(data, "", "  ")
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonEncodeError", fmt.Sprintf("encodePretty failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func decode(s: str) -> Result[json] {
        go! {
            parsed, err := lamJSONParse(s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonDecodeError", fmt.Sprintf("decode failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(parsed)
        }
    }

    static func decodeInto(s: str, target: any) -> Result[any] {
        go! {
            err := json.Unmarshal([]byte(s), target)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonDecodeError", fmt.Sprintf("decodeInto failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(nil)
        }
    }

    static func fromValue(data: any) -> Result[json] {
        go! {
            value, err := lamJSONFrom(data)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonConversionError", fmt.Sprintf("conversion failed: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    static func fromDict(data: any) -> Result[json] {
        return Json.fromValue(data)
    }

    static func fromList(data: any) -> Result[json] {
        return Json.fromValue(data)
    }

    static func toDict(data: json) -> Result[dict[str, any]] {
        converted: dict[str, any] = {}
        conversionOk: bool = false
        go! {
            converted, conversionOk = lamJSONTryToDict(data)
        }
        if not conversionOk {
            valueKind: str = Json.kind(data)
            return Result.Err(Error("JsonConversionError", f"json {valueKind} cannot convert to dict", None))
        }
        return Result.Ok(converted)
    }

    static func toList(data: json) -> Result[list[any]] {
        converted: list[any] = []
        conversionOk: bool = false
        go! {
            converted, conversionOk = lamJSONTryToList(data)
        }
        if not conversionOk {
            valueKind: str = Json.kind(data)
            return Result.Err(Error("JsonConversionError", f"json {valueKind} cannot convert to list", None))
        }
        return Result.Ok(converted)
    }

    static func kind(data: json) -> str {
        go! {
            return lamJSONKind(data)
        }
    }

    static func isValid(s: str) -> bool {
        go! {
            _, err := lamJSONParse(s)
            return err == nil
        }
    }

    static func has(doc: json, key: str) -> bool {
        #- True when ``doc`` is an object with the member ``key``, even when
           the member is null. -#
        found: bool = false
        go! {
            _, found = lamJSONMember(doc, key)
        }
        return found
    }

    static func getStr(doc: json, key: str, fallback: str = "") -> str {
        #- The string member ``key``; ``fallback`` when it is missing, null or
           not a string, or when ``doc`` is not an object. -#
        out: str = fallback
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if text, ok := member.(string); ok {
                    out = text
                }
            }
        }
        return out
    }

    static func getInt(doc: json, key: str, fallback: int = 0) -> int {
        #- The number member ``key`` as an ``int``: an integer, or a float
           with an integral value (``3.0``) inside the int range. A fraction
           (``3.5``), any other kind, null or a missing member is
           ``fallback``. -#
        out: int = fallback
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if n, ok := lamJSONAsInt(member); ok {
                    out = n
                }
            }
        }
        return out
    }

    static func getFloat(doc: json, key: str, fallback: float = 0.0) -> float {
        #- The number member ``key`` (integer or float) as a ``float``;
           ``fallback`` for any other kind, null or a missing member. -#
        out: float = fallback
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if f, ok := lamJSONAsFloat(member); ok {
                    out = f
                }
            }
        }
        return out
    }

    static func getBool(doc: json, key: str, fallback: bool = false) -> bool {
        #- The boolean member ``key``; ``fallback`` for any other kind (the
           string ``"true"`` included), null or a missing member. -#
        out: bool = fallback
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if flag, ok := member.(bool); ok {
                    out = flag
                }
            }
        }
        return out
    }

    static func getList(doc: json, key: str) -> list[json] {
        #- The elements of the array member ``key``; ``[]`` when it is
           missing, null or not an array. The elements are the document's
           own values (changing an object element changes ``doc``). -#
        out: list[json] = []
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if items, ok := member.([]interface{}); ok {
                    for _, item := range items {
                        out = append(out, LamJSON{value: item})
                    }
                }
            }
        }
        return out
    }

    static func getObject(doc: json, key: str) -> json {
        #- The object member ``key`` (the document's own object), or a new
           empty object when it is missing, null or not an object, so reads
           chain: ``Json.getStr(Json.getObject(doc, "user"), "name")``. -#
        out: json = {}
        go! {
            if member, found := lamJSONMember(doc, key); found {
                if _, ok := member.(map[string]interface{}); ok {
                    out = LamJSON{value: member}
                }
            }
        }
        return out
    }

    static func at(doc: json, path: list[any]) -> json {
        #- The value at ``path``: ``str`` steps read object members, ``int``
           steps array elements (negative from the end). A missing member,
           an index out of range, a step of the wrong type or a scalar on the
           way gives null: ``Json.at(doc, ["orders", -1, "id"])``. -#
        out: json = None
        go! {
            out = lamJSONAt(doc, path)
        }
        return out
    }

    static func copy(doc: json) -> json {
        #- A deep copy of ``doc``: changing the copy (or ``doc``) never
           changes the other. Putting a json value into a json literal or
           assigning it to a member shares it, like Python objects. -#
        out: json = None
        go! {
            out = LamJSON{value: lamJSONCopy(doc.value)}
        }
        return out
    }

    static func mapKeys(doc: json, rename: func(str) -> str, deep: bool = true) -> json {
        #- A copy of ``doc`` with every object key replaced by
           ``rename(key)``: ``Json.mapKeys(doc, Strings.camelCase)``. With
           ``deep`` (the default) the keys of nested objects, also inside
           arrays, are renamed too; ``deep=false`` renames only the keys of
           ``doc`` itself when it is an object. Keys are renamed in sorted
           order, so when two keys get the same name the value of the later
           one wins. Values are copied: changing the result never changes
           ``doc``. -#
        out: json = None
        go! {
            out = LamJSON{value: lamJSONMapKeys(doc.value, rename, deep, 0)}
        }
        return out
    }
}

func main() {
    pass
}
