# Lammergeier standard library: JSON utilities
# Import with: from lamjson import Json
#
# The ``encode``/``decode``/``decodeInto`` family panics on malformed
# input or values that don't round-trip through ``encoding/json``.
# The ``try*`` family returns a ``Result`` so callers can inspect
# the failure (or propagate with ``?``):
#
#     out: str = Json.tryEncode(data)?
#     v: any   = Json.tryDecode(payload).unwrapOr(default)

from lamerrors import Result, Error

go! {
    import (
        "encoding/json"
        "fmt"
    )
}

class Json {
    static func encode(data: any) -> str {
        go! {
            b, err := json.Marshal(data)
            if err != nil {
                panic(fmt.Sprintf("json encode error: %v", err))
            }
            return string(b)
        }
    }

    static func tryEncode(data: any) -> Result {
        #- Marshal ``data`` as JSON. Returns ``Result.Ok(str)`` or a
           ``Result.Err(Error("JsonEncodeError", ...))``. -#
        go! {
            b, err := json.Marshal(data)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonEncodeError",
                    fmt.Sprintf("encode failed: %v", err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func encodePretty(data: any) -> str {
        go! {
            b, err := json.MarshalIndent(data, "", "  ")
            if err != nil {
                panic(fmt.Sprintf("json encode error: %v", err))
            }
            return string(b)
        }
    }

    static func tryEncodePretty(data: any) -> Result {
        #- Like ``tryEncode`` but emits indented JSON. -#
        go! {
            b, err := json.MarshalIndent(data, "", "  ")
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonEncodeError",
                    fmt.Sprintf("encodePretty failed: %v", err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func decode(s: str) -> any {
        go! {
            var result interface{}
            json.Unmarshal([]byte(s), &result)
            return result
        }
    }

    static func tryDecode(s: str) -> Result {
        #- Decode a JSON string. Returns ``Result.Ok(any)`` (the
           parsed value, typically a map / slice / scalar) or a
           ``Result.Err(Error("JsonDecodeError", ...))``. -#
        go! {
            var result interface{}
            err := json.Unmarshal([]byte(s), &result)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonDecodeError",
                    fmt.Sprintf("decode failed: %v", err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(result)
        }
    }

    static func decodeInto(s: str, target: any) {
        #- Unmarshal JSON string into a struct pointer.
           Usage: Json.decodeInto(jsonStr, myObj)
        -#
        go! {
            err := json.Unmarshal([]byte(s), target)
            if err != nil {
                panic(fmt.Sprintf("json decode error: %v", err))
            }
        }
    }

    static func tryDecodeInto(s: str, target: any) -> Result {
        #- Like ``decodeInto`` but reports failures via ``Result``.
           ``Result.Ok(None)`` is returned on success since the
           decoded value lives in ``target``. -#
        go! {
            err := json.Unmarshal([]byte(s), target)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "JsonDecodeError",
                    fmt.Sprintf("decodeInto failed: %v", err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(nil)
        }
    }


    static func isValid(s: str) -> bool {
        #- True if `s` is syntactically valid JSON. -#
        go! {
            return json.Valid([]byte(s))
        }
    }
}

func main() {
    pass
}
