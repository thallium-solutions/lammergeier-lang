# Lammergeier standard library: Stack data structure
# Import with: from lamstack import Stack

class Stack {
    func __init__(self) {
        self.items: list[any] = []
    }

    func push(self, val: any) {
        self.items.append(val)
    }

    func pop(self) -> any {
        #- Remove and return the top of the stack. Panics when empty. -#
        if len(self.items) == 0 {
            raise "pop from empty stack"
        }
        last: any = self.items[len(self.items) - 1]
        self.items = self.items[:len(self.items) - 1]
        return last
    }

    func peek(self) -> any {
        #- Return the top of the stack without removing it. Panics when empty. -#
        if len(self.items) == 0 {
            raise "peek from empty stack"
        }
        return self.items[len(self.items) - 1]
    }

    func size(self) -> int {
        return len(self.items)
    }

    func isEmpty(self) -> bool {
        return len(self.items) == 0
    }

    func clear(self) {
        self.items = []
    }

    func toList(self) -> list[any] {
        #- Return a copy of the items from bottom to top. -#
        result: list[any] = []
        for item in self.items {
            result.append(item)
        }
        return result
    }
}

func main() {
    pass
}
