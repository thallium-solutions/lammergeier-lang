# Lammergeier standard library: compression helpers
# Import with: from lamcompress import Compress
#
# Compressed output is returned as a base64 string so callers don't have
# to worry about binary-safety. Decompression accepts the same format.

from lamerrors import Result, Error

go! {
    import (
        "bytes"
        "compress/gzip"
        "compress/zlib"
        "encoding/base64"
        "io"
    )
}

class Compress {
    static func gzip(data: str) -> str {
        #- GZip-compress a UTF-8 string; result is base64-encoded. -#
        go! {
            var buf bytes.Buffer
            w := gzip.NewWriter(&buf)
            if _, err := w.Write([]byte(data)); err != nil { panic(err) }
            if err := w.Close(); err != nil { panic(err) }
            return base64.StdEncoding.EncodeToString(buf.Bytes())
        }
    }

    static func gunzip(b64: str) -> Result[str] {
        #- Decode a base64 string and GZip-decompress it. Malformed or
           truncated input is returned as a structured error. -#
        go! {
            raw, err := base64.StdEncoding.DecodeString(b64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DecodeError", "gunzip base64 decode failed", err.Error(),
                ))
            }
            r, err := gzip.NewReader(bytes.NewReader(raw))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CompressionError", "invalid gzip stream", err.Error(),
                ))
            }
            defer r.Close()
            out, err := io.ReadAll(r)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CompressionError", "gzip decompression failed", err.Error(),
                ))
            }
            return LAMMERGEIER.Result.Ok(string(out))
        }
    }

    static func zlibDeflate(data: str) -> str {
        #- Zlib-compress a UTF-8 string; result is base64-encoded. -#
        go! {
            var buf bytes.Buffer
            w := zlib.NewWriter(&buf)
            if _, err := w.Write([]byte(data)); err != nil { panic(err) }
            if err := w.Close(); err != nil { panic(err) }
            return base64.StdEncoding.EncodeToString(buf.Bytes())
        }
    }

    static func zlibInflate(b64: str) -> Result[str] {
        #- Decode and inflate zlib data, reporting malformed input. -#
        go! {
            raw, err := base64.StdEncoding.DecodeString(b64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DecodeError", "zlib base64 decode failed", err.Error(),
                ))
            }
            r, err := zlib.NewReader(bytes.NewReader(raw))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CompressionError", "invalid zlib stream", err.Error(),
                ))
            }
            defer r.Close()
            out, err := io.ReadAll(r)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "CompressionError", "zlib decompression failed", err.Error(),
                ))
            }
            return LAMMERGEIER.Result.Ok(string(out))
        }
    }
}

func main() {
    pass
}
