# Lammergeier standard library: XML parsing, escaping and encoding.
#
# Documents are native ``xml`` values (see docs/SYNTAX.md "Markup:
# html and xml"): literals between ``<>`` and ``</>`` with an ``xml``
# target, or ``Xml.parse(text)``. They support ``select`` / ``first``
# with CSS selectors, attribute and text access and DOM-style edits.
#
#   * ``Xml.parse(text) -> Result[xml]`` — well-formed XML only.
#   * ``Xml.escape(text) -> str``.
#   * ``Xml.encode(value, root) -> xml`` / ``Xml.decode(text) -> Result[any]``
#     — JSON-flavoured shape-shifting (map → one child per key, list →
#     repeated ``<item>`` elements, scalar → text), for when both ends
#     are yours.
#
# Import with: ``from lamxml import Xml``.

from lamerrors import Result, Error
from lammarkup import Markup

go! {
    import (
        "encoding/xml"
        "fmt"
        "io"
        "strings"
    )

    // lamXmlEncodeValue serialises a Lam-shaped value into XML
    // wrapped in a single ``<root>`` element. The shape rules
    // mirror lamjson:
    //
    //   * map[string]interface{} → one child element per key
    //   * []interface{}          → one child element per entry
    //                              (caller decides the tag — we
    //                              use ``item`` when none is set)
    //   * scalar                 → text content of the parent
    //
    // Recursion is bounded indirectly by the input depth — for
    // unbounded inputs the caller should pre-cap.
    func lamXmlEncodeValue(tag string, v interface{}, sb *strings.Builder) {
        sb.WriteByte('<')
        sb.WriteString(tag)
        switch x := v.(type) {
        case nil:
            sb.WriteString("/>")
        case map[string]interface{}:
            sb.WriteByte('>')
            for k, val := range x {
                lamXmlEncodeValue(k, val, sb)
            }
            sb.WriteString("</")
            sb.WriteString(tag)
            sb.WriteByte('>')
        case []interface{}:
            sb.WriteByte('>')
            for _, val := range x {
                lamXmlEncodeValue("item", val, sb)
            }
            sb.WriteString("</")
            sb.WriteString(tag)
            sb.WriteByte('>')
        default:
            // Scalar — text content. Use Go's escaper so ``<&>``
            // round-trip safely.
            sb.WriteByte('>')
            xml.EscapeText(sb, []byte(fmt.Sprint(x)))
            sb.WriteString("</")
            sb.WriteString(tag)
            sb.WriteByte('>')
        }
    }
}


class Xml {
    #- Parsing, escaping and the dict/list encoding of ``xml`` values. -#

    static func parse(source: str) -> Result[xml] {
        #- Reads well-formed XML (prolog, comments, namespaces prefixes
           kept); malformed input is an ``XmlError``. -#
        go! {
            doc, err := lamXMLParseString(source)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("XmlError", err.Error(), nil))
            }
            return LAMMERGEIER.Result.Ok(doc)
        }
    }

    static func escape(text: str) -> str {
        #- ``text`` escaped for XML content and attribute values. -#
        return Markup.escape(text)
    }

    static func encode(value: any, root: str = "root") -> xml {
        #- A Lam-shaped value (dicts, lists, scalars) as XML wrapped in a
           single ``<root>`` element: one child per key, ``<item>`` per
           list entry, scalars as text. -#
        out: xml = <></>
        rootName: str = root
        go! {
            var sb strings.Builder
            lamXmlEncodeValue(rootName, value, &sb)
            parsed, err := lamXMLParseString(sb.String())
            if err == nil {
                out = parsed
            }
        }
        return out
    }

    static func decode(source: str) -> Result[any] {
        #- The JSON-flavoured shape of an XML document: element trees
           become ``dict[str, any]`` (attributes under ``@name``), repeated
           tags collapse into ``list[any]``, leaf text becomes a ``str``.
           Pass ``str(doc)`` for an ``xml`` value. -#
        go! {
            dec := xml.NewDecoder(strings.NewReader(source))
            v, err := lamXmlDecodeOne(dec)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("XmlError", err.Error(), nil))
            }
            return LAMMERGEIER.Result.Ok(v)
        }
    }
}


# ─── DOM + scalar decoders (Go-side helpers) ─────────────────────
go! {
    // lamXmlDecodeOne reads a single XML document and returns its
    // shape-shifted form (map / list / string). Behaviour:
    //
    //   * elements with only text → string
    //   * elements with only children of one tag → list of those
    //   * elements with mixed children → map[tag]value, repeated
    //     tags collapsing into a list
    //
    // Attributes are folded into the map under ``@name`` keys so
    // the structural shape stays a plain interface{} tree (no need
    // for a separate ``XmlAttrs`` container at the consumption
    // site).
    func lamXmlDecodeOne(dec *xml.Decoder) (interface{}, error) {
        for {
            tok, err := dec.Token()
            if err != nil { return nil, err }
            if start, ok := tok.(xml.StartElement); ok {
                return lamXmlDecodeElement(dec, start)
            }
        }
    }

    func lamXmlDecodeElement(dec *xml.Decoder, start xml.StartElement) (interface{}, error) {
        out := map[string]interface{}{}
        var textBuf strings.Builder
        for _, a := range start.Attr {
            out["@"+a.Name.Local] = a.Value
        }
        for {
            tok, err := dec.Token()
            if err != nil {
                if err == io.EOF { return nil, io.ErrUnexpectedEOF }
                return nil, err
            }
            switch t := tok.(type) {
            case xml.StartElement:
                child, err := lamXmlDecodeElement(dec, t)
                if err != nil { return nil, err }
                key := t.Name.Local
                if existing, ok := out[key]; ok {
                    if list, ok := existing.([]interface{}); ok {
                        out[key] = append(list, child)
                    } else {
                        out[key] = []interface{}{existing, child}
                    }
                } else {
                    out[key] = child
                }
            case xml.CharData:
                textBuf.Write([]byte(t))
            case xml.EndElement:
                txt := strings.TrimSpace(textBuf.String())
                // Pure-text element — collapse to a bare string.
                if len(out) == 0 {
                    return txt, nil
                }
                if txt != "" {
                    out["#text"] = txt
                }
                return out, nil
            }
        }
        return out, nil
    }
}


func main() {
    pass
}
