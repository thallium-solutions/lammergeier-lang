# Lammergeier standard library: typed HTTP clients, fluent requests, and a tiny server.
# Import with: from lamhttp import Http, HttpClient, HttpRequestOptions, HttpResponse
#
# ``Http.request`` and ``HttpClient.request`` accept typed per-request options
# and return ``Result[HttpResponse]``. ``Http.build`` / ``HttpClient.build``
# expose the same core through a fluent request builder. All one-shot and
# reusable-client verbs use the same transport-error convention.

from lamconv import Conv
from lamerrors import Result, Error
from lamjson import Json

go! {
    import (
        "fmt"
        "io"
        "net"
        "net/http"
        "strings"
        "time"
    )
}

class HttpRequestOptions {
    func init(self, timeoutMs: int = 0) {
        self.headers: dict[str, str] = {}
        self.queryParams: dict[str, str] = {}
        self.timeoutMs: int = timeoutMs
        self.contentType: str = ""
        self.body: str = ""
    }

    func header(self, name: str, value: str) -> HttpRequestOptions {
        self.headers[name] = value
        return self
    }

    func query(self, name: str, value: str) -> HttpRequestOptions {
        self.queryParams[name] = value
        return self
    }

    func timeout(self, ms: int) -> HttpRequestOptions {
        self.timeoutMs = ms
        return self
    }

    func text(self, body: str, contentType: str = "text/plain") -> HttpRequestOptions {
        self.body = body
        self.contentType = contentType
        return self
    }

    func json(self, value: json) -> HttpRequestOptions {
        self.body = str(value)
        self.contentType = "application/json"
        return self
    }
}

class Http {
    #- One-shot HTTP operations. Every operation that can fail at the
    transport layer returns ``Result``. An HTTP response is successful at
    the transport layer regardless of status, so 4xx/5xx responses are
    ``Ok(HttpResponse)`` values whose ``response.ok()`` is false. -#

    static func request(method: str, url: str) -> Result[HttpResponse] {
        return HttpClient().request(method, url)
    }

    static func request(method: str, url: str, options: HttpRequestOptions) -> Result[HttpResponse] {
        return HttpClient().request(method, url, options)
    }

    static func build(method: str, url: str) -> HttpRequest {
        return HttpClient().build(method, url)
    }

    static func get(url: str) -> Result[HttpResponse] {
        return Http.request("GET", url)
    }

    static func head(url: str) -> Result[HttpResponse] {
        return Http.request("HEAD", url)
    }

    static func delete(url: str) -> Result[HttpResponse] {
        return Http.request("DELETE", url)
    }

    static func post(url: str, contentType: str, body: str) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.text(body, contentType)
        return Http.request("POST", url, options)
    }

    static func post(url: str, jsonBody: str) -> Result[HttpResponse] {
        return Http.post(url, "application/json", jsonBody)
    }

    static func post(url: str, value: json) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.json(value)
        return Http.request("POST", url, options)
    }

    static func put(url: str, contentType: str, body: str) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.text(body, contentType)
        return Http.request("PUT", url, options)
    }

    static func put(url: str, value: json) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.json(value)
        return Http.request("PUT", url, options)
    }

    static func patch(url: str, contentType: str, body: str) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.text(body, contentType)
        return Http.request("PATCH", url, options)
    }

    static func patch(url: str, value: json) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.json(value)
        return Http.request("PATCH", url, options)
    }

    static func statusCode(url: str) -> Result[int] {
        response: HttpResponse = Http.get(url)?
        return Result.Ok(response.status)
    }

    static func getHeader(url: str, header: str) -> Result[str] {
        response: HttpResponse = Http.get(url)?
        return Result.Ok(response.header(header))
    }

    static func getWithHeaders(url: str, headers: dict[str, str]) -> Result[HttpResponse] {
        #- GET with custom request headers (e.g. Authorization). -#
        options: HttpRequestOptions = HttpRequestOptions()
        for name, headerValue in headers {
            options.headers[name] = headerValue
        }
        return Http.request("GET", url, options)
    }

    static func serve(port: int, handler: func(str, str, str) -> str) -> Result[HttpServer] {
        #- Start an HTTP server on `:port`. `handler` is a
        `func(method str, path str, body str) -> str` that returns the
        response body (a function, or a lambda whose parameters are typed
        from it: ``lambda method, path, body: f"{method} {path}"``). Bind
        failures are returned as ``HttpServerError``. -#
        go! {
            listener, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("HttpServerError", err.Error(), nil))
            }
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                body, _ := io.ReadAll(r.Body)
                r.Body.Close()
                var resp string
                if handler != nil {
                    resp = handler(r.Method, r.URL.Path, string(body))
                }
                fmt.Fprint(w, resp)
            })
            srv := &http.Server{Addr: fmt.Sprintf(":%d", port), Handler: mux}
            lamSrv := NewHttpServer()
            lamSrv.Raw = srv
            lamSrv.Listener = listener
            go func() {
                _ = srv.Serve(listener)
            }()
            return LAMMERGEIER.Result.Ok(lamSrv)
        }
    }
}

class HttpServer {
    #- Handle contained in a successful Http.serve Result. Call .close()
    to stop the server and receive any shutdown error. -#

    func init(self) {
        self.raw: any = None
        self.listener: any = None
    }

    func port(self) -> Result[int] {
        #- Return the bound TCP port. This is especially useful with
           ``Http.serve(0, handler)``, where the OS selects an ephemeral port. -#
        go! {
            listener, ok := s.Listener.(net.Listener)
            if !ok || listener == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("HttpServerError", "server is not running", nil))
            }
            address, ok := listener.Addr().(*net.TCPAddr)
            if !ok {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("HttpServerError", "server has no TCP address", nil))
            }
            return LAMMERGEIER.Result.Ok(address.Port)
        }
    }

    func close(self) -> Result[bool] {
        go! {
            server, ok := s.Raw.(*http.Server)
            if !ok || server == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("HttpServerError", "server is not running", nil))
            }
            if err := server.Close(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("HttpServerError", err.Error(), nil))
            }
            s.Raw = nil
            s.Listener = nil
            return LAMMERGEIER.Result.Ok(true)
        }
    }
}

class HttpCookie {
    #- Parsed representation of one ``Set-Cookie`` response header.
    ``expires`` preserves the HTTP-date text, ``raw`` preserves the
    complete header value, and ``unparsed`` retains unknown or malformed
    attributes instead of discarding them. -#

    func init(self, name: str = "", value: str = "") {
        self.name: str = name
        self.value: str = value
        self.path: str = ""
        self.domain: str = ""
        self.expires: str = ""
        self.maxAge: int = 0
        self.secure: bool = false
        self.httpOnly: bool = false
        self.sameSite: str = ""
        self.partitioned: bool = false
        self.raw: str = ""
        self.unparsed: list[str] = []
    }

    private static func _isInteger(text: str) -> bool {
        parsed: Result[int] = Conv.parse(text.trim())
        return parsed.ok()
    }

    private static func _integer(text: str) -> int {
        parsed: Result[int] = Conv.parse(text.trim())
        value: int = 0
        go! {
            if parsed.Ok() {
                value = parsed.Value.(int)
            }
        }
        return value
    }

    static func parse(raw: str) -> HttpCookie {
        #- Parse one Set-Cookie header without dropping extension attributes. -#
        cookie: HttpCookie = HttpCookie()
        cookie.raw = raw
        parts: list[str] = raw.split(";")
        if len(parts) == 0 {
            return cookie
        }

        pair: list[str] = parts[0].trim().splitN("=", 2)
        if len(pair) != 2 or pair[0].trim() == "" {
            cookie.unparsed.append(parts[0].trim())
            return cookie
        }
        cookie.name = pair[0].trim()
        cookie.value = pair[1].trim()
        if len(cookie.value) >= 2 {
            quoted: bool = cookie.value.startsWith("\"") and cookie.value.endsWith("\"")
            if quoted {
                cookie.value = cookie.value[1: len(cookie.value) - 1]
            }
        }

        for i in range(1, len(parts)) {
            attribute: str = parts[i].trim()
            if attribute == "" {
                continue
            }
            attributeParts: list[str] = attribute.splitN("=", 2)
            attributeName: str = attributeParts[0].trim().toLower()
            hasValue: bool = len(attributeParts) == 2
            attributeValue: str = ""
            if hasValue {
                attributeValue = attributeParts[1].trim()
            }

            if attributeName == "path" and hasValue {
                cookie.path = attributeValue
            } elif attributeName == "domain" and hasValue {
                cookie.domain = attributeValue
            } elif attributeName == "expires" and hasValue {
                cookie.expires = attributeValue
            } elif attributeName == "max-age" and hasValue and HttpCookie._isInteger(attributeValue) {
                cookie.maxAge = HttpCookie._integer(attributeValue)
            } elif attributeName == "secure" and not hasValue {
                cookie.secure = true
            } elif attributeName == "httponly" and not hasValue {
                cookie.httpOnly = true
            } elif attributeName == "samesite" and hasValue {
                cookie.sameSite = attributeValue
            } elif attributeName == "partitioned" and not hasValue {
                cookie.partitioned = true
            } else {
                cookie.unparsed.append(attribute)
            }
        }
        return cookie
    }
}

class HttpResponse {
    #- A completed HTTP exchange. Transport failures never produce an
    ``HttpResponse``; they are returned as ``Result.Err`` by the request API.
    Non-2xx responses are completed exchanges and remain ``Result.Ok``.
    ``headers`` retains every response header value and ``parsedCookies``
    retains parsed Set-Cookie values. -#

    func init(self, status: int = 0, body: str = "", headers: dict[str, list[str]] = {}) {
        self.status: int = status
        self.body: str = body
        self.headers: dict[str, list[str]] = headers
        self.parsedCookies: list[HttpCookie] = []
        for rawCookie in self.headerValues("Set-Cookie") {
            self.parsedCookies.append(HttpCookie.parse(rawCookie))
        }
    }

    func ok(self) -> bool {
        #- True when the HTTP status code is in the 2xx range. -#
        return self.status >= 200 and self.status < 300
    }

    func headerValues(self, name: str) -> list[str] {
        #- Return all values for ``name`` using case-insensitive matching. -#
        matches: list[str] = []
        for headerName, values in self.headers {
            if headerName.equalFold(name) {
                for value in values {
                    matches.append(value)
                }
            }
        }
        return matches
    }

    func header(self, name: str, fallback: str = "") -> str {
        #- Return the first matching response header value, or ``fallback``. -#
        values: list[str] = self.headerValues(name)
        if len(values) == 0 {
            return fallback
        }
        return values[0]
    }

    func json(self) -> Result[json] {
        #- Decode the response body as native JSON without panicking. -#
        return Json.decode(self.body)
    }

    func cookies(self) -> list[HttpCookie] {
        #- Return parsed response cookies in Set-Cookie header order. -#
        values: list[HttpCookie] = []
        for cookie in self.parsedCookies {
            values.append(cookie)
        }
        return values
    }

    func cookie(self, name: str) -> HttpCookie {
        #- Return the first cookie named ``name``, or ``None``. Cookie names
        are case-sensitive as required by the cookie specification. -#
        for cookie in self.parsedCookies {
            if cookie.name == name {
                return cookie
            }
        }
        return None
    }
}

class HttpRequest {
    func init(self, client: HttpClient, method: str, path: str) {
        self.client: HttpClient = client
        self.method: str = method
        self.path: str = path
        self.options: HttpRequestOptions = HttpRequestOptions()
    }

    func header(self, name: str, value: str) -> HttpRequest {
        self.options.header(name, value)
        return self
    }

    func query(self, name: str, value: str) -> HttpRequest {
        self.options.query(name, value)
        return self
    }

    func timeout(self, ms: int) -> HttpRequest {
        self.options.timeout(ms)
        return self
    }

    func text(self, body: str, contentType: str = "text/plain") -> HttpRequest {
        self.options.text(body, contentType)
        return self
    }

    func json(self, value: json) -> HttpRequest {
        self.options.json(value)
        return self
    }

    func send(self) -> Result[HttpResponse] {
        return self.client.request(self.method, self.path, self.options)
    }
}

class HttpClient {
    #- Reusable HTTP client with a base URL, default headers, and
    a configurable timeout. Use one client per logical "API I'm
    talking to" — the default headers are the right place to
    hang an Authorization token, an API key, a User-Agent, etc.

    Usage::

    api: HttpClient = HttpClient("https://api.example.com")
    api.setHeader("Authorization", "Bearer xyz")
    api.setTimeoutMs(5000)

    result: Result[HttpResponse] = api.get("/users/42")
    if result.ok() {
        res: HttpResponse = result.unwrap()
        body = res.body
    }

    Method paths can be absolute (``https://...``) or relative
    to the configured base URL. -#

    func init(self, baseUrl: str = "", timeoutMs: int = 30000) {
        self.baseUrl: str = baseUrl
        self.timeoutMs: int = timeoutMs
        self.headers: dict[str, str] = {}
    }

    func setHeader(self, name: str, value: str) {
        self.headers[name] = value
    }

    func removeHeader(self, name: str) {
        if name in self.headers {
            del self.headers[name]
        }
    }

    func setTimeoutMs(self, ms: int) {
        self.timeoutMs = ms
    }

    func _resolveUrl(self, path: str) -> str {
        if path.startsWith("http://") or path.startsWith("https://") {
            return path
        }
        if path == "" {
            return self.baseUrl
        }
        if self.baseUrl == "" {
            return path
        }
        if self.baseUrl.endsWith("/") and path.startsWith("/") {
            return self.baseUrl[: len(self.baseUrl) - 1] + path
        }
        if not self.baseUrl.endsWith("/") and not path.startsWith("/") {
            return self.baseUrl + "/" + path
        }
        return self.baseUrl + path
    }

    func _do(self, method: str, path: str, contentType: str, body: str) -> Result[HttpResponse] {
        options: HttpRequestOptions = HttpRequestOptions()
        options.contentType = contentType
        options.body = body
        return self._doOptions(method, path, options)
    }

    func _doOptions(self, method: str, path: str, options: HttpRequestOptions) -> Result[HttpResponse] {
        url: str = self._resolveUrl(path)
        merged: dict[str, str] = {}
        for k, v in self.headers {
            merged[k] = v
        }
        for k, v in options.headers {
            merged[k] = v
        }
        if options.contentType != "" and "Content-Type" not in merged {
            merged["Content-Type"] = options.contentType
        }
        timeoutMs: int = options.timeoutMs
        if timeoutMs <= 0 {
            timeoutMs = self.timeoutMs
        }
        body: str = options.body
        queryParams: dict[str, str] = options.queryParams

        status: int = 0
        respBody: str = ""
        errMsg: str = ""
        respHeaders: dict[str, list[str]] = {}
        go! {
            var rdr io.Reader
            if body != "" {
                rdr = strings.NewReader(body)
            }
            req, err := http.NewRequest(method, url, rdr)
            if err != nil {
                errMsg = err.Error()
            } else {
                query := req.URL.Query()
                for k, v := range queryParams {
                    query.Set(k, v)
                }
                req.URL.RawQuery = query.Encode()
                for k, v := range merged {
                    req.Header.Set(k, v)
                }
                client := &http.Client{
                    Timeout: time.Duration(timeoutMs) * time.Millisecond,
                }
                if resp, err := client.Do(req); err != nil {
                    errMsg = err.Error()
                } else {
                    defer resp.Body.Close()
                    status = resp.StatusCode
                    for name, values := range resp.Header {
                        respHeaders[name] = append([]string(nil), values...)
                    }
                    if b, err := io.ReadAll(resp.Body); err == nil {
                        respBody = string(b)
                    } else {
                        errMsg = err.Error()
                    }
                }
            }
        }
        if errMsg != "" {
            return Result.Err(Error("HttpError", f"{method} {url}: {errMsg}"))
        }
        return Result.Ok(HttpResponse(status, respBody, respHeaders))
    }

    func request(self, method: str, path: str) -> Result[HttpResponse] {
        return self.request(method, path, HttpRequestOptions())
    }

    func request(self, method: str, path: str, options: HttpRequestOptions) -> Result[HttpResponse] {
        return self._doOptions(method, path, options)
    }

    func build(self, method: str, path: str) -> HttpRequest {
        return HttpRequest(self, method, path)
    }

    func get(self, path: str) -> Result[HttpResponse] {
        return self._do("GET", path, "", "")
    }

    func head(self, path: str) -> Result[HttpResponse] {
        return self._do("HEAD", path, "", "")
    }

    func delete(self, path: str) -> Result[HttpResponse] {
        return self._do("DELETE", path, "", "")
    }

    func post(self, path: str, contentType: str, body: str) -> Result[HttpResponse] {
        return self._do("POST", path, contentType, body)
    }

    func post(self, path: str, value: json) -> Result[HttpResponse] {
        return self._do("POST", path, "application/json", str(value))
    }

    func put(self, path: str, contentType: str, body: str) -> Result[HttpResponse] {
        return self._do("PUT", path, contentType, body)
    }

    func put(self, path: str, value: json) -> Result[HttpResponse] {
        return self._do("PUT", path, "application/json", str(value))
    }

    func patch(self, path: str, contentType: str, body: str) -> Result[HttpResponse] {
        return self._do("PATCH", path, contentType, body)
    }

    func patch(self, path: str, value: json) -> Result[HttpResponse] {
        return self._do("PATCH", path, "application/json", str(value))
    }
}

func main() {
    pass
}
