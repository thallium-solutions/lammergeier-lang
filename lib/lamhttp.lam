# Lammergeier standard library: HTTP/networking utilities
# Import with: from lamhttp import Http
#
# The historical ``get``/``post`` family returns the response body as
# a string and silently maps network failures to ``""``. The ``try*``
# siblings (``tryGet``, ``tryPost``) return a ``Result[str]`` so callers
# can distinguish "empty body" from "server unreachable":
#
#     body: str = Http.tryGet(url)?
#     body: str = Http.tryGet(url).unwrapOr("")     # legacy behaviour

from lamconv import Conv
from lamerrors import Result, Error
from lamjson import Json

go! {
    import (
        "fmt"
        "io"
        "net/http"
        "strings"
        "time"
    )
}

class Http {
    static func get(url: str) -> str {
        go! {
            resp, err := http.Get(url)
            if err != nil {
                return ""
            }
            defer resp.Body.Close()
            body, _ := io.ReadAll(resp.Body)
            return string(body)
        }
    }

    static func tryGet(url: str) -> Result {
        #- GET ``url`` and return the response body. Returns
        ``Result.Ok(str)`` on a successful HTTP exchange, or
        ``Result.Err(Error("HttpError", ...))`` if the request
        couldn't even be made (DNS failure, connection refused,
        etc.). Non-2xx responses are still ``Ok`` — inspect the
        body or use ``tryStatusCode`` if the status matters. -#
        go! {
            resp, err := http.Get(url)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "HttpError",
                    fmt.Sprintf("GET %q: %v", url, err),
                    nil,
                ))
            }
            defer resp.Body.Close()
            body, err := io.ReadAll(resp.Body)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "HttpError",
                    fmt.Sprintf("GET %q: read body: %v", url, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(string(body))
        }
    }

    static func statusCode(url: str) -> int {
        go! {
            resp, err := http.Get(url)
            if err != nil {
                return 0
            }
            defer resp.Body.Close()
            return resp.StatusCode
        }
    }

    private static func _postText(url: str, contentType: str, body: str) -> str {
        go! {
            resp, err := http.Post(url, contentType, strings.NewReader(body))
            if err != nil {
                return ""
            }
            defer resp.Body.Close()
            respBody, _ := io.ReadAll(resp.Body)
            return string(respBody)
        }
    }

    private static func _tryPostText(url: str, contentType: str, body: str) -> Result[str] {
        go! {
            resp, err := http.Post(url, contentType, strings.NewReader(body))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "HttpError",
                    fmt.Sprintf("POST %q: %v", url, err),
                    nil,
                ))
            }
            defer resp.Body.Close()
            respBody, err := io.ReadAll(resp.Body)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "HttpError",
                    fmt.Sprintf("POST %q: read body: %v", url, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(string(respBody))
        }
    }

    static func post(url: str, contentType: str, body: str) -> str {
        #- POST a string body with an explicit content type. -#
        return Http._postText(url, contentType, body)
    }

    static func tryPost(url: str, contentType: str, body: str) -> Result[str] {
        #- POST a string body with an explicit content type and return a Result. -#
        return Http._tryPostText(url, contentType, body)
    }

    static func post(url: str, jsonBody: str) -> str {
        #- POST an already-encoded JSON string as ``application/json``. -#
        return Http._postText(url, "application/json", jsonBody)
    }

    static func tryPost(url: str, jsonBody: str) -> Result[str] {
        #- Result-returning overload for an already-encoded JSON string. -#
        return Http._tryPostText(url, "application/json", jsonBody)
    }

    static func post(url: str, value: json) -> str {
        #- Encode a native JSON value and POST it as ``application/json``. -#
        return Http._postText(url, "application/json", str(value))
    }

    static func tryPost(url: str, value: json) -> Result[str] {
        #- Result-returning native JSON POST overload. -#
        return Http._tryPostText(url, "application/json", str(value))
    }

    static func getHeader(url: str, header: str) -> str {
        go! {
            resp, err := http.Get(url)
            if err != nil {
                return ""
            }
            defer resp.Body.Close()
            return resp.Header.Get(header)
        }
    }

    static func getWithHeaders(url: str, headers: dict[str, str]) -> str {
        #- GET with custom request headers (e.g. Authorization). -#
        go! {
            req, err := http.NewRequest("GET", url, nil)
            if err != nil {
                return ""
            }
            for k, v := range headers {
                req.Header.Set(k, v)
            }
            client := &http.Client{Timeout: 30 * time.Second}
            resp, err := client.Do(req)
            if err != nil {
                return ""
            }
            defer resp.Body.Close()
            body, _ := io.ReadAll(resp.Body)
            return string(body)
        }
    }

    static func serve(port: int, handler: any) -> HttpServer {
        #- Start a blocking HTTP server on `:port`. `handler` must be a
        `func(method str, path str, body str) -> str` that returns the
        response body. For more control drop into go! with net/http. -#
        go! {
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                body, _ := io.ReadAll(r.Body)
                r.Body.Close()
                var resp string
                if fn, ok := handler.(func(string, string, string) string); ok {
                    resp = fn(r.Method, r.URL.Path, string(body))
                } else {
                    resp = ""
                }
                fmt.Fprint(w, resp)
            })
            srv := &http.Server{Addr: fmt.Sprintf(":%d", port), Handler: mux}
            lamSrv := NewHttpServer()
            lamSrv.Raw = srv
            go func() {
                srv.ListenAndServe()
            }()
            // give the server a moment to start listening
            time.Sleep(50 * time.Millisecond)
            return lamSrv
        }
    }
}

class HttpServer {
    #- Handle returned by Http.serve. Call .close() to stop the server. -#

    func __init__(self) {
        self.raw: any = None
    }

    func close(self) {
        go! {
            if s.Raw != nil {
                s.Raw.(*http.Server).Close()
                s.Raw = nil
            }
        }
    }
}

# ── Expanded verbs on the static Http class. These cover the rest
#    of the common-method surface (HEAD, PUT, DELETE, PATCH) for
#    one-shot calls that don't need a reusable client.
go! {
    // Run a request with an arbitrary verb, optional body, and
    // optional headers. The default client has a 30s timeout to
    // keep hung peers from leaking goroutines.
    func lamHttpDoVerb(method, url, contentType, body string, headers map[string]string) (string, int, error) {
        var rdr io.Reader
        if body != "" {
            rdr = strings.NewReader(body)
        }
        req, err := http.NewRequest(method, url, rdr)
        if err != nil {
            return "", 0, err
        }
        if contentType != "" {
            req.Header.Set("Content-Type", contentType)
        }
        for k, v := range headers {
            req.Header.Set(k, v)
        }
        client := &http.Client{Timeout: 30 * time.Second}
        resp, err := client.Do(req)
        if err != nil {
            return "", 0, err
        }
        defer resp.Body.Close()
        b, err := io.ReadAll(resp.Body)
        if err != nil {
            return "", resp.StatusCode, err
        }
        return string(b), resp.StatusCode, nil
    }
}

class HttpCookie {
    #- Parsed representation of one ``Set-Cookie`` response header.
    ``expires`` preserves the HTTP-date text, ``raw`` preserves the
    complete header value, and ``unparsed`` retains unknown or malformed
    attributes instead of discarding them. -#

    func __init__(self, name: str = "", value: str = "") {
        self.name: str = name
        self.value: str = value
        self.path: str = ""
        self.domain: str = ""
        self.expires: str = ""
        self.maxAge: int = 0
        self.secure: bool = false
        self.httpOnly: bool = false
        self.sameSite: str = ""
        self.partitioned: bool = false
        self.raw: str = ""
        self.unparsed: list[str] = []
    }

    private static func _isInteger(text: str) -> bool {
        return Conv.tryInt(text.trim()).ok()
    }

    private static func _integer(text: str) -> int {
        return Conv.toInt(text.trim())
    }

    static func parse(raw: str) -> HttpCookie {
        #- Parse one Set-Cookie header without dropping extension attributes. -#
        cookie: HttpCookie = HttpCookie()
        cookie.raw = raw
        parts: list[str] = raw.split(";")
        if len(parts) == 0 {
            return cookie
        }

        pair: list[str] = parts[0].trim().splitN("=", 2)
        if len(pair) != 2 or pair[0].trim() == "" {
            cookie.unparsed.append(parts[0].trim())
            return cookie
        }
        cookie.name = pair[0].trim()
        cookie.value = pair[1].trim()
        if len(cookie.value) >= 2 {
            quoted: bool = cookie.value.startsWith("\"") and cookie.value.endsWith("\"")
            if quoted {
                cookie.value = cookie.value[1: len(cookie.value) - 1]
            }
        }

        for i in range(1, len(parts)) {
            attribute: str = parts[i].trim()
            if attribute == "" {
                continue
            }
            attributeParts: list[str] = attribute.splitN("=", 2)
            attributeName: str = attributeParts[0].trim().toLower()
            hasValue: bool = len(attributeParts) == 2
            attributeValue: str = ""
            if hasValue {
                attributeValue = attributeParts[1].trim()
            }

            if attributeName == "path" and hasValue {
                cookie.path = attributeValue
            } elif attributeName == "domain" and hasValue {
                cookie.domain = attributeValue
            } elif attributeName == "expires" and hasValue {
                cookie.expires = attributeValue
            } elif attributeName == "max-age" and hasValue and HttpCookie._isInteger(attributeValue) {
                cookie.maxAge = HttpCookie._integer(attributeValue)
            } elif attributeName == "secure" and not hasValue {
                cookie.secure = true
            } elif attributeName == "httponly" and not hasValue {
                cookie.httpOnly = true
            } elif attributeName == "samesite" and hasValue {
                cookie.sameSite = attributeValue
            } elif attributeName == "partitioned" and not hasValue {
                cookie.partitioned = true
            } else {
                cookie.unparsed.append(attribute)
            }
        }
        return cookie
    }
}

class HttpResponse {
    #- Result of a request from ``HttpClient`` or ``Http.request``.
    ``status`` is the HTTP status code (0 if the request never
    reached the server). ``body`` is the response body as a
    string. ``error`` is set on transport-level failures only
    (DNS, refused, timeout) — non-2xx HTTP responses are NOT
    errors. ``headers`` retains every response header value and
    ``parsedCookies`` retains parsed Set-Cookie values. -#

    func __init__(self, status: int = 0, body: str = "", error: str = "", headers: dict[str, list[str]] = {}) {
        self.status: int = status
        self.body: str = body
        self.error: str = error
        self.headers: dict[str, list[str]] = headers
        self.parsedCookies: list[HttpCookie] = []
        for rawCookie in self.headerValues("Set-Cookie") {
            self.parsedCookies.append(HttpCookie.parse(rawCookie))
        }
    }

    func ok(self) -> bool {
        #- True if the request completed (no transport error) and
        the status code is in the 2xx range. -#
        return self.error == "" and self.status >= 200 and self.status < 300
    }

    func headerValues(self, name: str) -> list[str] {
        #- Return all values for ``name`` using case-insensitive matching. -#
        matches: list[str] = []
        for headerName, values in self.headers {
            if headerName.equalFold(name) {
                for value in values {
                    matches.append(value)
                }
            }
        }
        return matches
    }

    func header(self, name: str, fallback: str = "") -> str {
        #- Return the first matching response header value, or ``fallback``. -#
        values: list[str] = self.headerValues(name)
        if len(values) == 0 {
            return fallback
        }
        return values[0]
    }

    func json(self) -> json {
        #- Decode the response body as native JSON. -#
        return Json.decode(self.body)
    }

    func tryJson(self) -> Result[json] {
        #- Decode the response body without panicking on malformed JSON. -#
        return Json.tryDecode(self.body)
    }

    func cookies(self) -> list[HttpCookie] {
        #- Return parsed response cookies in Set-Cookie header order. -#
        values: list[HttpCookie] = []
        for cookie in self.parsedCookies {
            values.append(cookie)
        }
        return values
    }

    func cookie(self, name: str) -> HttpCookie {
        #- Return the first cookie named ``name``, or ``None``. Cookie names
        are case-sensitive as required by the cookie specification. -#
        for cookie in self.parsedCookies {
            if cookie.name == name {
                return cookie
            }
        }
        return None
    }
}

class HttpClient {
    #- Reusable HTTP client with a base URL, default headers, and
    a configurable timeout. Use one client per logical "API I'm
    talking to" — the default headers are the right place to
    hang an Authorization token, an API key, a User-Agent, etc.

    Usage::

    api: HttpClient = HttpClient("https://api.example.com")
    api.setHeader("Authorization", "Bearer xyz")
    api.setTimeoutMs(5000)

    res: HttpResponse = api.get("/users/42")
    if res.ok() {
        body = res.body
    }

    Method paths can be absolute (``https://...``) or relative
    to the configured base URL. -#

    func __init__(self, baseUrl: str = "", timeoutMs: int = 30000) {
        self.baseUrl: str = baseUrl
        self.timeoutMs: int = timeoutMs
        self.headers: dict[str, str] = {}
    }

    func setHeader(self, name: str, value: str) {
        self.headers[name] = value
    }

    func removeHeader(self, name: str) {
        if name in self.headers {
            del self.headers[name]
        }
    }

    func setTimeoutMs(self, ms: int) {
        self.timeoutMs = ms
    }

    func _resolveUrl(self, path: str) -> str {
        if path.startsWith("http://") or path.startsWith("https://") {
            return path
        }
        if path == "" {
            return self.baseUrl
        }
        if self.baseUrl == "" {
            return path
        }
        if self.baseUrl.endsWith("/") and path.startsWith("/") {
            return self.baseUrl[: len(self.baseUrl) - 1] + path
        }
        if not self.baseUrl.endsWith("/") and not path.startsWith("/") {
            return self.baseUrl + "/" + path
        }
        return self.baseUrl + path
    }

    func _do(self, method: str, path: str, contentType: str, body: str) -> HttpResponse {
        url: str = self._resolveUrl(path)
        merged: dict[str, str] = {}
        for k, v in self.headers {
            merged[k] = v
        }
        if contentType != "" and "Content-Type" not in merged {
            merged["Content-Type"] = contentType
        }
        timeoutMs: int = self.timeoutMs

        status: int = 0
        respBody: str = ""
        errMsg: str = ""
        respHeaders: dict[str, list[str]] = {}
        go! {
            var rdr io.Reader
            if body != "" {
                rdr = strings.NewReader(body)
            }
            req, err := http.NewRequest(method, url, rdr)
            if err != nil {
                errMsg = err.Error()
            } else {
                for k, v := range merged {
                    req.Header.Set(k, v)
                }
                client := &http.Client{
                    Timeout: time.Duration(timeoutMs) * time.Millisecond,
                }
                if resp, err := client.Do(req); err != nil {
                    errMsg = err.Error()
                } else {
                    defer resp.Body.Close()
                    status = resp.StatusCode
                    for name, values := range resp.Header {
                        respHeaders[name] = append([]string(nil), values...)
                    }
                    if b, err := io.ReadAll(resp.Body); err == nil {
                        respBody = string(b)
                    } else {
                        errMsg = err.Error()
                    }
                }
            }
        }
        return HttpResponse(status, respBody, errMsg, respHeaders)
    }

    func get(self, path: str) -> HttpResponse {
        return self._do("GET", path, "", "")
    }

    func head(self, path: str) -> HttpResponse {
        return self._do("HEAD", path, "", "")
    }

    func delete(self, path: str) -> HttpResponse {
        return self._do("DELETE", path, "", "")
    }

    func post(self, path: str, contentType: str, body: str) -> HttpResponse {
        return self._do("POST", path, contentType, body)
    }

    func post(self, path: str, value: json) -> HttpResponse {
        return self._do("POST", path, "application/json", str(value))
    }

    func put(self, path: str, contentType: str, body: str) -> HttpResponse {
        return self._do("PUT", path, contentType, body)
    }

    func put(self, path: str, value: json) -> HttpResponse {
        return self._do("PUT", path, "application/json", str(value))
    }

    func patch(self, path: str, contentType: str, body: str) -> HttpResponse {
        return self._do("PATCH", path, contentType, body)
    }

    func patch(self, path: str, value: json) -> HttpResponse {
        return self._do("PATCH", path, "application/json", str(value))
    }
}

func main() {
    pass
}
