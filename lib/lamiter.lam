# Lammergeier standard library: lazy iterator combinators.
# Import with: from lamiter import Iter
#
# ``Iter[T]`` lets you chain ``map`` / ``filter`` / ``take`` / … without
# materialising intermediate slices. Each combinator wraps the
# previous one in a thunk; the values only flow through when you call
# a terminal operation (``toList``, ``forEach``, ``reduce``, ``count_``,
# ``first``, ``anyMatch``, ``allMatch``).
#
#   from lamiter import Iter
#
#   evens: list[int] = Iter.range_(0, 100).filter(lambda x: x % 2 == 0).map(lambda x: x * x).toList()
#   names: list[str] = Iter.fromList(users).map(lambda u: u.name).filter(lambda n: n.startsWith("a")).toList()
#   total: int = Iter.fromList([1, 2, 3]).reduce(0, lambda acc, x: acc + x)
#   lens: list[int] = Iter.fromList(words).map(len).toList()
#
# The iterator is generic over its element type: ``fromList`` /
# ``repeat`` take it from their argument, ``range_`` / ``count`` are
# ``Iter[int]``, and ``map`` gives an ``Iter[U]`` of its callback's result
# type. Callbacks are typed from the elements (``filter`` takes a
# ``func(T) -> bool``), so a lambda's parameters need no annotation or
# conversion and a callback of the wrong type is a compile error. An
# ``Iter[any]`` (from a ``list[any]``) still takes ``func(any) -> ...``
# callbacks. ``enumerate`` yields ``tuple[int, T]`` pairs; ``first``
# returns a ``Result[T]`` (an ``EmptyIteratorError`` when there is no
# value).

from lamerrors import Result, Error

class Iter[T] {
    #- A pull-based iterator. ``self.next_`` holds a Go
       ``func() (T, bool)`` that returns the next value, or ``(_, false)``
       at end of stream. Combinators build new ``Iter`` instances that wrap
       ``next_``. -#

    func init(self) {
        self.next_: any = None
    }

    static func fromList(values: list[T]) -> Iter[T] {
        #- Wrap a slice as an iterator. The slice is captured by
           reference; mutating it mid-iteration is undefined. -#
        it: Iter[T] = Iter[T]()
        go! {
            i := 0
            it.Next_ = func() (T, bool) {
                var zero T
                if i >= len(values) { return zero, false }
                v := values[i]
                i++
                return v, true
            }
        }
        return it
    }

    static func count(start: int, step: int) -> Iter[int] {
        #- Infinite arithmetic progression. Useful with ``take``. -#
        it: Iter[int] = Iter[int]()
        go! {
            n := start
            it.Next_ = func() (int, bool) {
                v := n
                n += step
                return v, true
            }
        }
        return it
    }

    static func range_(start: int, stop: int) -> Iter[int] {
        #- Half-open ``[start, stop)`` integer range. -#
        it: Iter[int] = Iter[int]()
        go! {
            n := start
            it.Next_ = func() (int, bool) {
                if n >= stop { return 0, false }
                v := n
                n++
                return v, true
            }
        }
        return it
    }

    static func repeat(value: T, times: int) -> Iter[T] {
        #- Yield ``value`` ``times`` times. -#
        it: Iter[T] = Iter[T]()
        go! {
            n := 0
            it.Next_ = func() (T, bool) {
                if n >= times {
                    var zero T
                    return zero, false
                }
                n++
                return value, true
            }
        }
        return it
    }

    # ─── Lazy combinators ───────────────────────────────────
    func map[U](self, fn: func(T) -> U) -> Iter[U] {
        #- Apply ``fn`` to each element: an ``Iter[U]`` of its results. -#
        out: Iter[U] = Iter[U]()
        go! {
            src := s.Next_.(func() (T, bool))
            out.Next_ = func() (U, bool) {
                v, hasNext := src()
                if !hasNext {
                    var zero U
                    return zero, false
                }
                return fn(v), true
            }
        }
        return out
    }

    func filter(self, predicate: func(T) -> bool) -> Iter[T] {
        #- Keep the elements ``predicate`` accepts. -#
        out: Iter[T] = Iter[T]()
        go! {
            src := s.Next_.(func() (T, bool))
            out.Next_ = func() (T, bool) {
                for {
                    v, hasNext := src()
                    if !hasNext { return v, false }
                    if predicate(v) { return v, true }
                }
            }
        }
        return out
    }

    func take(self, n: int) -> Iter[T] {
        #- At most the first ``n`` elements (pulls no further). -#
        out: Iter[T] = Iter[T]()
        go! {
            src := s.Next_.(func() (T, bool))
            taken := 0
            limit := int(n)
            out.Next_ = func() (T, bool) {
                if taken >= limit {
                    var zero T
                    return zero, false
                }
                v, hasNext := src()
                if !hasNext { return v, false }
                taken++
                return v, true
            }
        }
        return out
    }

    func drop(self, n: int) -> Iter[T] {
        #- Skip the first ``n`` elements. -#
        out: Iter[T] = Iter[T]()
        go! {
            src := s.Next_.(func() (T, bool))
            dropped := 0
            limit := int(n)
            out.Next_ = func() (T, bool) {
                for dropped < limit {
                    v, hasNext := src()
                    if !hasNext { return v, false }
                    dropped++
                }
                return src()
            }
        }
        return out
    }

    func takeWhile(self, predicate: func(T) -> bool) -> Iter[T] {
        #- Elements up to (not including) the first one ``predicate`` rejects. -#
        out: Iter[T] = Iter[T]()
        go! {
            src := s.Next_.(func() (T, bool))
            done := false
            out.Next_ = func() (T, bool) {
                var zero T
                if done { return zero, false }
                v, hasNext := src()
                if !hasNext { done = true; return zero, false }
                if !predicate(v) { done = true; return zero, false }
                return v, true
            }
        }
        return out
    }

    func dropWhile(self, predicate: func(T) -> bool) -> Iter[T] {
        #- Skip elements while ``predicate`` accepts them, then yield the rest. -#
        out: Iter[T] = Iter[T]()
        go! {
            src := s.Next_.(func() (T, bool))
            stopped := false
            out.Next_ = func() (T, bool) {
                if !stopped {
                    for {
                        v, hasNext := src()
                        if !hasNext { return v, false }
                        if !predicate(v) {
                            stopped = true
                            return v, true
                        }
                    }
                }
                return src()
            }
        }
        return out
    }

    func enumerate(self) -> Iter[tuple[int, T]] {
        #- Yield ``(index, value)`` pairs (a ``tuple[int, T]``, printed
           ``[0 a]``; destructure it with ``i, v = pair`` or ``for i, v in``
           over ``toList()``). -#
        out: Iter[tuple[int, T]] = Iter[tuple[int, T]]()
        go! {
            src := s.Next_.(func() (T, bool))
            i := 0
            out.Next_ = func() ([]interface{}, bool) {
                v, hasNext := src()
                if !hasNext { return nil, false }
                pair := []interface{}{i, v}
                i++
                return pair, true
            }
        }
        return out
    }

    func chain(self, other: Iter[T]) -> Iter[T] {
        #- Concatenate two iterators end-to-end. -#
        out: Iter[T] = Iter[T]()
        go! {
            a := s.Next_.(func() (T, bool))
            b := other.Next_.(func() (T, bool))
            useA := true
            out.Next_ = func() (T, bool) {
                if useA {
                    if v, hasNext := a(); hasNext { return v, true }
                    useA = false
                }
                return b()
            }
        }
        return out
    }

    # ─── Terminal operations ────────────────────────────────
    func toList(self) -> list[T] {
        #- Drain the iterator into a ``list[T]``. -#
        out: list[T] = []
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                v, hasNext := src()
                if !hasNext { break }
                out = append(out, v)
            }
        }
        return out
    }

    func forEach(self, fn: func(T)) {
        #- Call ``fn`` on every element. -#
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                v, hasNext := src()
                if !hasNext { break }
                fn(v)
            }
        }
    }

    func reduce[A](self, initial: A, fn: func(A, T) -> A) -> A {
        #- Fold the elements into an accumulator of type ``A`` (the type of
           ``initial``): ``reduce(0, lambda acc, x: acc + x)``. -#
        acc: A = initial
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                v, hasNext := src()
                if !hasNext { break }
                acc = fn(acc, v)
            }
        }
        return acc
    }

    func count_(self) -> int {
        #- Drain the iterator and count how many values it yielded.
           Named with a trailing underscore because ``count`` is a
           static constructor on this same class. -#
        n: int = 0
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                _, hasNext := src()
                if !hasNext { break }
                n++
            }
        }
        return n
    }

    func first(self) -> Result[T] {
        #- The first value, or an ``EmptyIteratorError`` when the iterator
           yields nothing. -#
        found: bool = false
        value: any = None
        go! {
            src := s.Next_.(func() (T, bool))
            if v, hasNext := src(); hasNext {
                found = true
                value = v
            }
        }
        if not found {
            return Result.Err(Error("EmptyIteratorError", "Iter.first: empty iterator"))
        }
        return Result.Ok(value)
    }

    func anyMatch(self, predicate: func(T) -> bool) -> bool {
        #- Whether some element satisfies ``predicate`` (stops at the first). -#
        matched: bool = false
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                v, hasNext := src()
                if !hasNext { break }
                if predicate(v) {
                    matched = true
                    break
                }
            }
        }
        return matched
    }

    func allMatch(self, predicate: func(T) -> bool) -> bool {
        #- Whether every element satisfies ``predicate`` (stops at the first
           that does not). -#
        matched: bool = true
        go! {
            src := s.Next_.(func() (T, bool))
            for {
                v, hasNext := src()
                if !hasNext { break }
                if !predicate(v) {
                    matched = false
                    break
                }
            }
        }
        return matched
    }
}

func main() {
    pass
}
