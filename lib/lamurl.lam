# Lammergeier standard library: URL parsing, escaping and query strings
# Import with: from lamurl import Url
#
# Escaping comes in the shapes the parts of a URL need:
#
#   * ``Url.encode`` / ``Url.decode`` — query values in form encoding (Go's
#     ``QueryEscape``: a space is ``+``).
#   * ``Url.encodeComponent`` / ``Url.decodeComponent`` — JavaScript's
#     ``encodeURIComponent``: everything but ``A-Z a-z 0-9 - _ . ! ~ * ' ( )``
#     is percent-encoded (a space is ``%20``), UTF-8 byte by byte.
#   * ``Url.encodePath`` — a whole path: ``/`` and the characters a path may
#     hold (``$ & + , : ; = @``) stay (Go's ``URL.EscapedPath``);
#     ``Url.encodePathSegment`` escapes ``/`` too (Go's ``PathEscape``).
#   * ``Url.encodeUserInfo`` — a user name or password (Go's ``url.User``).
#
# ``Url.query(params)`` builds a form-encoded query string (no leading
# ``?``) from a ``dict[str, list[str]]`` (keys sorted, each key's values in
# order) or from ``[key, value]`` pairs (kept in order, keys may repeat);
# ``Url.parseQuery`` reads one back into a ``dict[str, list[str]]``.

from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "net/url"
        "sort"
        "strings"
    )

    func lamUrlError(raw string, err error) *Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            "UrlParseError", "invalid URL " + raw, err.Error(),
        ))
    }

    func lamUrlEncodeComponent(s string) string {
        const hexDigits = "0123456789ABCDEF"
        var sb strings.Builder
        for i := 0; i < len(s); i++ {
            c := s[i]
            if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || strings.IndexByte("-_.!~*'()", c) >= 0 {
                sb.WriteByte(c)
            } else {
                sb.WriteByte('%')
                sb.WriteByte(hexDigits[c>>4])
                sb.WriteByte(hexDigits[c&15])
            }
        }
        return sb.String()
    }

    func lamUrlQueryPair(sb *strings.Builder, key string, value string) {
        if sb.Len() > 0 {
            sb.WriteByte('&')
        }
        sb.WriteString(url.QueryEscape(key))
        sb.WriteByte('=')
        sb.WriteString(url.QueryEscape(value))
    }
}

class Url {
    static func parse(rawUrl: str) -> Result[str] {
        go! {
            u, err := url.Parse(rawUrl)
            if err != nil { return lamUrlError(rawUrl, err) }
            return LAMMERGEIER.Result.Ok(u.String())
        }
    }

    static func host(rawUrl: str) -> Result[str] {
        go! {
            u, err := url.Parse(rawUrl)
            if err != nil { return lamUrlError(rawUrl, err) }
            return LAMMERGEIER.Result.Ok(u.Host)
        }
    }

    static func path(rawUrl: str) -> Result[str] {
        go! {
            u, err := url.Parse(rawUrl)
            if err != nil { return lamUrlError(rawUrl, err) }
            return LAMMERGEIER.Result.Ok(u.Path)
        }
    }

    static func scheme(rawUrl: str) -> Result[str] {
        go! {
            u, err := url.Parse(rawUrl)
            if err != nil { return lamUrlError(rawUrl, err) }
            return LAMMERGEIER.Result.Ok(u.Scheme)
        }
    }

    static func queryParam(rawUrl: str, key: str) -> Result[str] {
        #- A missing key is a successful empty string; only malformed URLs
           produce an error. -#
        go! {
            u, err := url.Parse(rawUrl)
            if err != nil { return lamUrlError(rawUrl, err) }
            return LAMMERGEIER.Result.Ok(u.Query().Get(key))
        }
    }

    static func encode(s: str) -> str {
        #- A query key or value in form encoding: a space is ``+``. -#
        go! {
            return url.QueryEscape(s)
        }
    }

    static func decode(s: str) -> Result[str] {
        #- The inverse of ``encode`` (``+`` is a space); a malformed ``%``
           escape is a ``DecodeError``. -#
        go! {
            decoded, err := url.QueryUnescape(s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DecodeError", "invalid URL escape sequence", err.Error(),
                ))
            }
            return LAMMERGEIER.Result.Ok(decoded)
        }
    }

    static func encodeComponent(s: str) -> str {
        #- JavaScript's ``encodeURIComponent``: ``"a b&c/é"`` ->
           ``"a%20b%26c%2F%C3%A9"``; ``A-Z a-z 0-9 - _ . ! ~ * ' ( )`` stay. -#
        go! {
            return lamUrlEncodeComponent(s)
        }
    }

    static func decodeComponent(s: str) -> Result[str] {
        #- The inverse of ``encodeComponent``: ``%XX`` escapes are decoded and
           ``+`` stays a plus. A malformed escape is a ``DecodeError``. -#
        go! {
            decoded, err := url.PathUnescape(s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DecodeError", "invalid URL escape sequence", err.Error(),
                ))
            }
            return LAMMERGEIER.Result.Ok(decoded)
        }
    }

    static func encodePath(s: str) -> str {
        #- A URL path: ``"/files/a b/ü.txt"`` -> ``"/files/a%20b/%C3%BC.txt"``;
           ``/`` and ``$ & + , : ; = @`` stay, ``?`` and ``#`` are escaped. -#
        go! {
            return (&url.URL{Path: s}).EscapedPath()
        }
    }

    static func encodePathSegment(s: str) -> str {
        #- One path segment: like ``encodePath`` but ``/`` is escaped too
           (``"a/b"`` -> ``"a%2Fb"``). -#
        go! {
            return url.PathEscape(s)
        }
    }

    static func encodeUserInfo(s: str) -> str {
        #- A user name or password for ``scheme://user:password@host``:
           ``@ / ? :`` and the characters outside a URL are escaped,
           ``$ & + , ; =`` stay. -#
        go! {
            return url.User(s).String()
        }
    }

    static func query(params: dict[str, list[str]]) -> str {
        #- ``{"q": ["a b"], "tag": ["x", "y"]}`` -> ``"q=a+b&tag=x&tag=y"``:
           keys in sorted order, each key's values in order, form encoded
           (``encode``). A key with no values is left out. -#
        go! {
            keys := make([]string, 0, len(params))
            for key := range params {
                keys = append(keys, key)
            }
            sort.Strings(keys)
            var sb strings.Builder
            for _, key := range keys {
                for _, value := range params[key] {
                    lamUrlQueryPair(&sb, key, value)
                }
            }
            return sb.String()
        }
    }

    static func query(params: dict[str, str]) -> str {
        #- ``{"page": "2", "q": "a b"}`` -> ``"page=2&q=a+b"`` (keys sorted). -#
        go! {
            keys := make([]string, 0, len(params))
            for key := range params {
                keys = append(keys, key)
            }
            sort.Strings(keys)
            var sb strings.Builder
            for _, key := range keys {
                lamUrlQueryPair(&sb, key, params[key])
            }
            return sb.String()
        }
    }

    static func query(pairs: list[list[str]]) -> str {
        #- ``[["tag", "x"], ["q", "a b"], ["tag", "y"]]`` ->
           ``"tag=x&q=a+b&tag=y"``: the pairs in their order. Every pair must
           have two items (a ``UrlQueryError`` is thrown otherwise). -#
        go! {
            var sb strings.Builder
            for i, pair := range pairs {
                if len(pair) != 2 {
                    panic(fmt.Sprintf("UrlQueryError: query pair %d has %d items, expected [key, value]", i, len(pair)))
                }
                lamUrlQueryPair(&sb, pair[0], pair[1])
            }
            return sb.String()
        }
    }

    static func parseQuery(s: str) -> Result[dict[str, list[str]]] {
        #- ``"q=a+b&tag=x&tag=y"`` -> ``{"q": ["a b"], "tag": ["x", "y"]}``
           (a leading ``?`` is ignored, ``&`` separates pairs, a key without
           ``=`` has the value ``""``). A malformed escape or a ``;`` is a
           ``UrlQueryError``. -#
        go! {
            text := strings.TrimPrefix(s, "?")
            values, err := url.ParseQuery(text)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "UrlQueryError", fmt.Sprintf("invalid query %q", s), err.Error(),
                ))
            }
            out := map[string][]string{}
            for key, items := range values {
                out[key] = items
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }
}

func main() {
    pass
}
