# Lammergeier standard library: regex utilities
# Import with: from lamre import Re
#
# Pattern operations return ``Result`` so malformed patterns remain
# distinguishable from valid false, empty-string, and empty-list results.

from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "regexp"
    )
}

class Re {
    static func match(pattern: str, s: str) -> Result[bool] {
        #- Match ``pattern`` against ``s``. Returns ``Result.Ok(bool)``
           on a valid pattern (the bool says whether ``s`` contains a
           match) or ``Result.Err(Error("RegexError", ...))`` if the
           pattern can't be compiled. -#
        go! {
            matched, err := regexp.MatchString(pattern, s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(matched)
        }
    }

    static func find(pattern: str, s: str) -> Result[str] {
        #- Find the first match of ``pattern`` in ``s``. ``Ok("")``
           still means a valid pattern with no match; ``Err(...)``
           means the pattern itself was malformed. -#
        go! {
            re, err := regexp.Compile(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(re.FindString(s))
        }
    }

    static func findAll(pattern: str, s: str) -> Result[list[str]] {
        #- Find every match. ``Ok([])`` means a valid pattern with no
           matches; ``Err(...)`` means the pattern was malformed. -#
        go! {
            re, err := regexp.Compile(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(re.FindAllString(s, -1))
        }
    }

    static func replaceAll(pattern: str, s: str, repl: str) -> Result[str] {
        #- Replace every match of ``pattern`` in ``s`` with ``repl``.
           ``Err(...)`` only fires for invalid patterns. -#
        go! {
            re, err := regexp.Compile(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(re.ReplaceAllString(s, repl))
        }
    }

    static func split(pattern: str, s: str) -> Result[list[str]] {
        #- Split ``s`` by every match of ``pattern``. -#
        go! {
            re, err := regexp.Compile(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(re.Split(s, -1))
        }
    }

    static func matchGroups(pattern: str, s: str) -> Result[list[str]] {
        go! {
            re, err := regexp.Compile(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RegexError",
                    fmt.Sprintf("compile %q: %v", pattern, err),
                    nil,
                ))
            }
            m := re.FindStringSubmatch(s)
            if m == nil {
                m = []string{}
            }
            return LAMMERGEIER.Result.Ok(m)
        }
    }
}

func main() {
    pass
}
