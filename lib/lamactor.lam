# Lammergeier standard library: actor-model concurrency.
#
# Inspired by the lightweight ``go-actor`` design:
# https://github.com/vladopajic/go-actor — but reshaped around the
# Erlang/Akka mailbox-message-handler vocabulary that's more
# familiar to most users.
#
# Three building blocks:
#
#   * ``Mailbox``       — a Channel-backed queue with ``send`` / ``receive`` /
#                         ``offer`` / ``poll`` / async methods / ``close``.
#                         Use this directly when you want a worker goroutine
#                         you control yourself.
#   * ``Actor``         — convention: a class that exposes
#                         ``onMessage(self, msg)``, plus optional
#                         ``onStart(self)``, ``onStop(self)``, and
#                         ``onError(self, err)``.
#   * ``ActorSystem``   — spawns + supervises actors. Returns an
#                         ``ActorRef`` for ``tell`` / ``ask`` /
#                         ``stop`` calls. ``shutdown(timeoutMs)``
#                         drains every actor before returning.
#
# Usage::
#
#     from lamactor import ActorSystem, ActorRef
#
#     class Counter {
#         func init(self) {
#             self.n: int = 0
#         }
#
#         func onMessage(self, msg: any) -> any {
#             if msg == "inc"  { self.n = self.n + 1; return self.n }
#             if msg == "get"  { return self.n }
#             return None
#         }
#     }
#
#     func main() {
#         sys: ActorSystem = ActorSystem()
#         ref: ActorRef = sys.spawn(Counter())
#         ref.tell("inc")
#         ref.tell("inc")
#         total: any = ref.ask("get", 1000)
#         print(total)               # 2
#         sys.shutdown(1000)
#     }
#
# The dispatch loop survives panics in user code via ``recover()``;
# if the actor exposes ``onError`` it gets the recovered value and
# can return ``True`` to keep going, ``False`` to stop. The default
# is to stop on any unhandled panic.

from lamerrors import Result, Error
from lamconcurrency import Channel, Mutex, Atomic, WaitGroup

go! {
    import "reflect"

    // Actor metadata is deliberately composed from lamconcurrency. The only
    // native machinery left here is reflective invocation of Lam handlers.
    type lamActorEnvelope struct {
        body  interface{}
        reply *Channel
    }

    type lamActorEntry struct {
        id         uint64
        name       string
        actor      interface{}
        mailbox    *Channel
        stopped    *Atomic
        completion *WaitGroup
    }

    type lamActorRegistry struct {
        mu     *Mutex
        nextId uint64
        actors map[uint64]*lamActorEntry
        named  map[string]*lamActorEntry
    }

    func newLamActorRegistry() *lamActorRegistry {
        return &lamActorRegistry{
            mu:     NewMutex(),
            actors: map[uint64]*lamActorEntry{},
            named:  map[string]*lamActorEntry{},
        }
    }

    // Reflectively call a Lam-defined method on the actor. Returns
    // (result, ok). ``ok=false`` signals "method not implemented" —
    // useful for the optional onStart / onStop / onError hooks where
    // the dispatcher is happy to skip a missing override.
    func lamActorInvoke(actor interface{}, method string,
                        args ...interface{}) (interface{}, bool) {
        if actor == nil {
            return nil, false
        }
        rv := reflect.ValueOf(actor)
        if !rv.IsValid() {
            return nil, false
        }
        m := rv.MethodByName(method)
        if !m.IsValid() {
            return nil, false
        }
        in := make([]reflect.Value, len(args))
        mtyp := m.Type()
        for i, a := range args {
            if i >= mtyp.NumIn() {
                break
            }
            wantType := mtyp.In(i)
            if a == nil {
                in[i] = reflect.Zero(wantType)
                continue
            }
            v := reflect.ValueOf(a)
            if v.Type().AssignableTo(wantType) {
                in[i] = v
            } else if v.Type().ConvertibleTo(wantType) {
                in[i] = v.Convert(wantType)
            } else {
                in[i] = reflect.Zero(wantType)
            }
        }
        // Pad missing args with zero values so a handler whose
        // signature is wider than what we have on hand still runs.
        for len(in) < mtyp.NumIn() {
            in = append(in, reflect.Zero(mtyp.In(len(in))))
        }
        out := m.Call(in)
        if len(out) == 0 {
            return nil, true
        }
        return out[0].Interface(), true
    }

    func lamActorWait(group *WaitGroup, timeoutMs int) bool {
        if timeoutMs <= 0 {
            group.Wait()
            return true
        }
        finished := NewChannel(1)
        go func() {
            group.Wait()
            _ = finished.Send(true)
        }()
        return finished.ReceiveTimeout(timeoutMs).Ok()
    }

    func lamActorSignalStop(entry *lamActorEntry) {
        if entry.stopped.CompareAndSwap(0, 1) {
            _ = entry.mailbox.Close()
        }
    }

    func lamActorStop(entry *lamActorEntry, timeoutMs int) bool {
        lamActorSignalStop(entry)
        return lamActorWait(entry.completion, timeoutMs)
    }

    // The actor's main loop receives exclusively through Channel. Closing the
    // mailbox performs an orderly drain; a handler panic uses state 2 to exit
    // immediately after publishing the pending ask reply.
    func lamActorLoop(entry *lamActorEntry) {
        defer entry.completion.Done()
        _, _ = lamActorInvoke(entry.actor, "OnStart")
        for {
            received := entry.mailbox.Receive()
            if !received.Ok() {
                _, _ = lamActorInvoke(entry.actor, "OnStop")
                return
            }
            env, ok := received.Value.(*lamActorEnvelope)
            if !ok || env == nil {
                continue
            }
            result := lamActorDispatchOne(entry, env)
            if env.reply != nil {
                _ = env.reply.Offer(result)
            }
            if entry.stopped.Get() == 2 {
                _, _ = lamActorInvoke(entry.actor, "OnStop")
                return
            }
        }
    }

    // Single-message dispatch with panic recovery + optional onError hook.
    func lamActorDispatchOne(entry *lamActorEntry,
                             env *lamActorEnvelope) (out interface{}) {
        defer func() {
            if r := recover(); r != nil {
                if cont, ok := lamActorInvoke(entry.actor, "OnError", r); ok {
                    if keep, ok2 := cont.(bool); ok2 && keep {
                        out = nil
                        return
                    }
                }
                entry.stopped.Set(2)
                _ = entry.mailbox.Close()
                out = nil
            }
        }()
        result, _ := lamActorInvoke(entry.actor, "OnMessage", env.body)
        return result
    }
}


class Mailbox {
    #- Concurrent-safe message queue composed from `lamconcurrency.Channel`.
       `capacity=0` selects an unbounded FIFO; positive capacities preserve
       bounded send backpressure and immediate `offer` full-buffer results. -#

    func init(self, capacity: int = 0) {
        self.capacity: int = capacity
        self.channel: Channel = Channel(capacity)
        if capacity <= 0 {
            self.channel = Channel.unbounded()
        }
    }

    func send(self, msg: any) -> Result[bool] {
        return self.channel.send(msg)
    }

    func receive(self) -> Result[any] {
        return self.channel.receive()
    }

    func offer(self, msg: any) -> Result[bool] {
        return self.channel.offer(msg)
    }

    func poll(self) -> Result[any] {
        return self.channel.poll()
    }

    async func asyncSend(self, msg: any) -> Result[bool] {
        return self.channel.send(msg)
    }

    async func asyncReceive(self) -> Result[any] {
        return self.channel.receive()
    }

    func close(self) -> Result[bool] {
        return self.channel.close()
    }

    func isClosed(self) -> bool {
        return self.channel.isClosed()
    }

    func size(self) -> int {
        return self.channel.size()
    }
}


class ActorRef {
    #- Handle returned from ``ActorSystem.spawn``. Treat instances
       as opaque — the constructor here only exists so the type
       checker is happy; ``__init__`` does not register an actor.
       Use ``sys.spawn(...)`` to obtain a real ref. -#

    func init(self) {
        self.id: int = 0
        self.actorName: str = ""
        self.registry: any = None
    }

    func tell(self, msg: any) -> Result[bool] {
        #- Fire-and-forget send. Stopped actors and full mailboxes are
           reported instead of silently dropping the message. -#
        go! {
            reg, ok := s.Registry.(*lamActorRegistry)
            if !ok || reg == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor reference is not active", nil,
                ))
            }
            reg.mu.Lock()
            entry, present := reg.actors[uint64(s.Id)]
            reg.mu.Unlock()
            if !present || entry.stopped.Get() != 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor is stopped", nil,
                ))
            }
            offered := entry.mailbox.Offer(&lamActorEnvelope{body: msg})
            if !offered.Ok() {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor mailbox is closed", offered.Error,
                ))
            }
            if accepted, ok := offered.Value.(bool); ok && accepted {
                return LAMMERGEIER.Result.Ok(true)
            }
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "MailboxFullError", "actor mailbox is full", nil,
            ))
        }
    }

    func ask(self, msg: any, timeoutMs: int = 5000) -> Result[any] {
        #- Send ``msg`` and wait for a reply. A handler may successfully
           return ``None``; timeout and stopped-actor failures stay distinct. -#
        go! {
            reg, ok := s.Registry.(*lamActorRegistry)
            if !ok || reg == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor reference is not active", nil,
                ))
            }
            reg.mu.Lock()
            entry, present := reg.actors[uint64(s.Id)]
            reg.mu.Unlock()
            if !present || entry.stopped.Get() != 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor is stopped", nil,
                ))
            }
            reply := NewChannel(1)
            offered := entry.mailbox.Offer(&lamActorEnvelope{body: msg, reply: reply})
            if !offered.Ok() {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorStoppedError", "actor mailbox is closed", offered.Error,
                ))
            }
            if accepted, ok := offered.Value.(bool); !ok || !accepted {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ActorTimeoutError", "timed out enqueueing actor request", nil,
                ))
            }
            received := reply.ReceiveTimeout(timeoutMs)
            if received.Ok() {
                return LAMMERGEIER.Result.Ok(received.Value)
            }
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "ActorTimeoutError", "timed out waiting for actor reply", received.Error,
            ))
        }
    }

    func stop(self) {
        #- Stop this actor. Returns once its ``onStop`` (if any)
           has finished, or after a 5s grace period — whichever
           comes first. -#
        go! {
            reg, ok := s.Registry.(*lamActorRegistry)
            if !ok || reg == nil {
                return
            }
            reg.mu.Lock()
            entry, present := reg.actors[uint64(s.Id)]
            reg.mu.Unlock()
            if !present {
                return
            }
            lamActorStop(entry, 5000)
            reg.mu.Lock()
            delete(reg.actors, uint64(s.Id))
            if entry.name != "" && reg.named[entry.name] == entry {
                delete(reg.named, entry.name)
            }
            reg.mu.Unlock()
        }
    }

    func isAlive(self) -> bool {
        go! {
            reg, ok := s.Registry.(*lamActorRegistry)
            if !ok || reg == nil {
                return false
            }
            reg.mu.Lock()
            entry, present := reg.actors[uint64(s.Id)]
            reg.mu.Unlock()
            if !present {
                return false
            }
            return entry.stopped.Get() == 0
        }
    }
}


class ActorSystem {
    #- Registry that owns and supervises a group of actors. Spawn
       actors with ``spawn(actor)`` (or ``spawnNamed(name, actor)``);
       each call returns an ``ActorRef``. ``shutdown(timeoutMs)``
       stops every live actor in parallel and waits up to
       ``timeoutMs`` total. -#

    func init(self) {
        self.registry: any = None
        go! {
            s.Registry = newLamActorRegistry()
        }
    }

    func spawn(self, actor: any) -> ActorRef {
        #- Spawn ``actor`` in a fresh goroutine. The actor is any
           object with an ``onMessage(self, msg)`` method; optional
           ``onStart`` / ``onStop`` / ``onError`` hooks are honoured
           if present. Returns an ``ActorRef`` for sending messages. -#
        return self.spawnNamed("", actor)
    }

    func spawnNamed(self, actorName: str, actor: any) -> ActorRef {
        #- Like ``spawn`` but registers the actor under ``actorName``
           so ``find(actorName)`` can retrieve it later. Re-using a
           name replaces the previous binding (the old actor keeps
           running until you ``stop`` it explicitly). -#
        ref: ActorRef = ActorRef()
        ref.actorName = actorName
        go! {
            reg := s.Registry.(*lamActorRegistry)
            reg.mu.Lock()
            reg.nextId++
            id := reg.nextId
            entry := &lamActorEntry{
                id:         id,
                name:       actorName,
                actor:      actor,
                mailbox:    NewChannel(64),
                stopped:    NewAtomic(0),
                completion: NewWaitGroup(),
            }
            entry.completion.Add(1)
            reg.actors[id] = entry
            if actorName != "" {
                reg.named[actorName] = entry
            }
            reg.mu.Unlock()
            go lamActorLoop(entry)
            ref.Id = int(id)
            ref.Registry = reg
        }
        return ref
    }

    func find(self, actorName: str) -> ActorRef {
        #- Look up an actor by name. Returns an ``ActorRef`` whose
           ``isAlive()`` is ``True`` on hit, or an inert ref
           (``isAlive()`` is ``False``, ``tell``/``ask`` are no-ops)
           when no actor with that name is registered. The inert
           shape lets callers stay statically typed without an
           explicit cast. -#
        ref: ActorRef = ActorRef()
        ref.actorName = actorName
        go! {
            reg := s.Registry.(*lamActorRegistry)
            reg.mu.Lock()
            entry, ok := reg.named[actorName]
            reg.mu.Unlock()
            if ok && entry.stopped.Get() == 0 {
                ref.Id = int(entry.id)
                ref.Registry = reg
            }
        }
        return ref
    }

    func numActors(self) -> int {
        go! {
            reg := s.Registry.(*lamActorRegistry)
            reg.mu.Lock()
            defer reg.mu.Unlock()
            count := 0
            for _, e := range reg.actors {
                if e.stopped.Get() == 0 {
                    count++
                }
            }
            return count
        }
    }

    func shutdown(self, timeoutMs: int = 5000) {
        #- Stop every live actor and wait up to ``timeoutMs``
           total for them to drain. Idempotent. -#
        go! {
            reg := s.Registry.(*lamActorRegistry)
            reg.mu.Lock()
            entries := make([]*lamActorEntry, 0, len(reg.actors))
            for _, entry := range reg.actors {
                entries = append(entries, entry)
            }
            reg.mu.Unlock()

            waiters := NewWaitGroup()
            for _, entry := range entries {
                lamActorSignalStop(entry)
                waiters.Add(1)
                go func(current *lamActorEntry) {
                    current.completion.Wait()
                    waiters.Done()
                }(entry)
            }
            _ = lamActorWait(waiters, timeoutMs)

            reg.mu.Lock()
            for id, entry := range reg.actors {
                if entry.stopped.Get() != 0 {
                    delete(reg.actors, id)
                    if entry.name != "" && reg.named[entry.name] == entry {
                        delete(reg.named, entry.name)
                    }
                }
            }
            reg.mu.Unlock()
        }
    }
}
