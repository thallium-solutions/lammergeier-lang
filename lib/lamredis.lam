    func zrangeWithScores(self, key: str, start: int, stop: int) -> list[dict[str, any]] {
        out: list[dict[str, any]] = []
        go! {
            c := s._client.(*rdb.Client)
            res, err := c.ZRangeWithScores(lamRedisCtx, key, int64(start), int64(stop)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZRANGE %s: %v", key, err))
            }
            for _, z := range res {
                m := map[string]interface{}{}
                m["member"] = lamRedisToString(z.Member)
                m["score"] = z.Score
                out = append(out, m)
            }
        }
        return out
    }

