    # ── Pub/Sub ───────────────────────────────────────────────
    func publish(self, channel: str, message: any) -> int {
        #- Returns the number of subscribers that received the
           message. -#
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            n, err := c.Publish(lamRedisCtx, channel, lamRedisToString(message)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: PUBLISH %s: %v", channel, err))
            }
            out = int(n)
        }
        return out
    }

    func subscribe(self, channels: list[any]) -> PubSub {
        #- Subscribe to one or more channels. The returned
           ``PubSub`` blocks on ``next()`` until a message arrives;
           always pair the call with ``ps.close()`` once you're
           done so the connection returns to the pool. -#
        ps: PubSub = PubSub()
        go! {
            c := s._client.(*rdb.Client)
            sub := c.Subscribe(lamRedisCtx, lamRedisStrings(channels)...)
            // Wait for confirmation that the subscription has
            // taken effect — without this an immediate ``publish``
            // from the same client could race the SUBSCRIBE.
            if _, err := sub.Receive(lamRedisCtx); err != nil {
                sub.Close()
                panic(fmt.Sprintf("redis: SUBSCRIBE: %v", err))
            }
            ps._ps = sub
        }
        return ps
    }

    func psubscribe(self, patterns: list[any]) -> PubSub {
        #- Pattern subscribe. Same blocking semantics as
           ``subscribe`` — ``next()`` returns just the payload, use
           ``nextWith()`` for the matching channel + pattern. -#
        ps: PubSub = PubSub()
        go! {
            c := s._client.(*rdb.Client)
            sub := c.PSubscribe(lamRedisCtx, lamRedisStrings(patterns)...)
            if _, err := sub.Receive(lamRedisCtx); err != nil {
                sub.Close()
                panic(fmt.Sprintf("redis: PSUBSCRIBE: %v", err))
            }
            ps._ps = sub
        }
        return ps
    }

    # ── Pipelines / utilities ────────────────────────────────
    func pipeline(self, commands: list[dict[str, any]]) -> list[any] {
        #- Execute several commands in a single network round-trip.
           Each entry is ``{"cmd": "...", "args": [...]}``; results
           come back in the same order. Errors per-command are
           returned as ``Error`` instances so the caller can spot
           individual failures without aborting the batch. -#
        out: list[any] = []
        go! {
            c := s._client.(*rdb.Client)
            pipe := c.Pipeline()
            cmders := make([]rdb.Cmder, 0, len(commands))
            for _, cmd := range commands {
                name, _ := cmd["cmd"].(string)
                var args []interface{}
                if rawArgs, ok := cmd["args"].([]interface{}); ok {
                    args = lamRedisArgs(rawArgs)
                } else if rawArgsList, ok := cmd["args"].([]string); ok {
                    args = make([]interface{}, len(rawArgsList))
                    for i, v := range rawArgsList {
                        args[i] = v
                    }
                }
                full := append([]interface{}{name}, args...)
                cmders = append(cmders, pipe.Do(lamRedisCtx, full...))
            }
            _, err := pipe.Exec(lamRedisCtx)
            // Per-command results are still readable even when
            // ``Exec`` returns a non-nil error (e.g. one command
            // erroring out doesn't void the others).
            for _, cmder := range cmders {
                if dc, ok := cmder.(*rdb.Cmd); ok {
                    if v, e := dc.Result(); e == nil || lamRedisIsNil(e) {
                        out = append(out, v)
                    } else {
                        out = append(out, fmt.Sprintf("error: %v", e))
                    }
                }
            }
            _ = err
        }
        return out
    }

    func flushDb(self) {
        #- Drop every key in the currently-selected DB. Test-only —
           never call this against shared infrastructure. -#
        go! {
            c := s._client.(*rdb.Client)
            if err := c.FlushDB(lamRedisCtx).Err(); err != nil {
                panic(fmt.Sprintf("redis: FLUSHDB: %v", err))
            }
        }
    }

    func dbSize(self) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            n, err := c.DBSize(lamRedisCtx).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: DBSIZE: %v", err))
            }
            out = int(n)
        }
        return out
    }
