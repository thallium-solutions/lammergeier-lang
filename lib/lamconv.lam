# Lammergeier standard library: conversion utilities
# Import with: from lamconv import Conv
#
# Parsing operations return ``Result`` so valid zero values remain
# distinguishable from malformed input:
#
#     parsed: Result[int] = Conv.parse(s)
#     n: int = parsed?
#     fallback: int = parsed.unwrapOr(0)

from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "strconv"
    )
}

class Conv {
    static func parse(s: str) -> Result[int] {
        #- Parse ``s`` as a decimal integer. Returns ``Result.Ok(int)``
           on success, or ``Result.Err(Error("ParseError", ...))`` if
           the string is not a valid integer literal. -#
        go! {
            v, err := strconv.Atoi(s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as int: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(v)
        }
    }

    static func parse(s: str) -> Result[float] {
        #- Parse ``s`` as a 64-bit float. Returns ``Result.Ok(float)``
           on success or ``Result.Err`` with a ``ParseError`` on
           failure. -#
        go! {
            v, err := strconv.ParseFloat(s, 64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as float: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(v)
        }
    }

    static func parse(s: str) -> Result[bool] {
        #- Parse ``s`` as a boolean (``"true"`` / ``"false"`` / ``"1"`` /
           ``"0"`` / ``"t"`` / ``"f"``). Returns ``Result.Ok(bool)`` or
           a ``ParseError`` on malformed input. -#
        go! {
            v, err := strconv.ParseBool(s)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as bool: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(v)
        }
    }

    static func fromHex(s: str) -> Result[int] {
        #- Parse ``s`` as a hexadecimal integer without silently losing
           parse failures. -#
        go! {
            v, err := strconv.ParseInt(s, 16, 64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as hexadecimal int: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(int(v))
        }
    }

    static func fromOctal(s: str) -> Result[int] {
        #- Parse ``s`` as an octal integer without silently losing parse
           failures. -#
        go! {
            v, err := strconv.ParseInt(s, 8, 64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as octal int: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(int(v))
        }
    }

    static func fromBin(s: str) -> Result[int] {
        #- Parse ``s`` as a binary integer without silently losing parse
           failures. -#
        go! {
            v, err := strconv.ParseInt(s, 2, 64)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ParseError",
                    fmt.Sprintf("cannot parse %q as binary int: %v", s, err),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(int(v))
        }
    }
}

func main() {
    pass
}
