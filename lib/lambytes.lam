# Lammergeier standard library: bytes/buffer utilities
# Import with: from lambytes import Bytes

from lamstrings import Strings
from lamerrors import Result, Error

go! {
    import "encoding/hex"
}

class Bytes {
    static func toBytes(s: str) -> list[int] {
        go! {
            result := make([]int, len(s))
            for i, b := range []byte(s) {
                result[i] = int(b)
            }
            return result
        }
    }

    static func fromBytes(b: list[int]) -> str {
        go! {
            bs := make([]byte, len(b))
            for i, v := range b {
                bs[i] = byte(v)
            }
            return string(bs)
        }
    }

    static func hexEncode(data: str) -> str {
        go! {
            return hex.EncodeToString([]byte(data))
        }
    }

    static func hexDecode(data: str) -> Result[str] {
        #- Decode hexadecimal text. Invalid input is reported as an error;
           decoding valid empty text succeeds with an empty string. -#
        go! {
            b, err := hex.DecodeString(data)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DecodeError", "invalid hexadecimal input", err.Error(),
                ))
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func contains(data: str, sub: str) -> bool {
        return Strings.contains(data, sub)
    }

    static func count(data: str, sub: str) -> int {
        return Strings.count(data, sub)
    }
}

func main() {
    pass
}
