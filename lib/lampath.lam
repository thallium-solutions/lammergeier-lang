# Lammergeier standard library: path/filepath utilities
# Import with: from lampath import Path

from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "os"
        "path/filepath"
        "strings"
    )
}

class Path {
    static func join(*parts: any) -> str {
        #- Join either a single ``list[str]`` or variadic string components. -#
        go! {
            if len(parts) == 1 {
                if listed, ok := parts[0].([]string); ok {
                    return filepath.Join(listed...)
                }
                if listed, ok := parts[0].([]interface{}); ok {
                    stringsOnly := make([]string, len(listed))
                    for i, part := range listed {
                        value, ok := part.(string)
                        if !ok { panic(fmt.Sprintf("Path.join: component %d is not a string", i)) }
                        stringsOnly[i] = value
                    }
                    return filepath.Join(stringsOnly...)
                }
            }
            stringsOnly := make([]string, len(parts))
            for i, part := range parts {
                value, ok := part.(string)
                if !ok { panic(fmt.Sprintf("Path.join: component %d is not a string", i)) }
                stringsOnly[i] = value
            }
            return filepath.Join(stringsOnly...)
        }
    }

    static func base(p: str) -> str {
        go! {
            return filepath.Base(p)
        }
    }

    static func dir(p: str) -> str {
        go! {
            return filepath.Dir(p)
        }
    }

    static func ext(p: str) -> str {
        go! {
            return filepath.Ext(p)
        }
    }

    static func abs(p: str) -> Result[str] {
        go! {
            a, err := filepath.Abs(p)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "IOError", fmt.Sprintf("abs %q: %v", p, err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(a)
        }
    }

    static func clean(p: str) -> str {
        go! {
            return filepath.Clean(p)
        }
    }

    static func isAbs(p: str) -> bool {
        go! {
            return filepath.IsAbs(p)
        }
    }

    static func rel(basePath: str, targPath: str) -> Result[str] {
        go! {
            r, err := filepath.Rel(basePath, targPath)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "IOError", fmt.Sprintf("rel %q to %q: %v", basePath, targPath, err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(r)
        }
    }

    static func glob(pattern: str) -> Result[list[str]] {
        go! {
            matches, err := filepath.Glob(pattern)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "IOError", fmt.Sprintf("glob %q: %v", pattern, err), nil,
                ))
            }
            if matches == nil {
                matches = []string{}
            }
            return LAMMERGEIER.Result.Ok(matches)
        }
    }

    static func exists(p: str) -> Result[bool] {
        #- ``Ok(false)`` means absent; other stat failures are errors. -#
        go! {
            _, err := os.Stat(p)
            if err == nil {
                return LAMMERGEIER.Result.Ok(true)
            }
            if os.IsNotExist(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "IOError", fmt.Sprintf("exists %q: %v", p, err), nil,
            ))
        }
    }

    static func splitExt(p: str) -> list[str] {
        #- Split a path into [stem, ext]. `ext` includes the leading dot. -#
        go! {
            ext := filepath.Ext(p)
            stem := strings.TrimSuffix(p, ext)
            return []string{stem, ext}
        }
    }

    static func withExt(p: str, ext: str) -> str {
        #- Return `p` with its extension replaced by `ext` (leading dot optional). -#
        go! {
            if ext != "" && !strings.HasPrefix(ext, ".") { ext = "." + ext }
            stem := strings.TrimSuffix(p, filepath.Ext(p))
            return stem + ext
        }
    }

    static func split(p: str) -> list[str] {
        #- Split a path into [dir, file]. `dir` keeps its trailing slash. -#
        go! {
            d, f := filepath.Split(p)
            return []string{d, f}
        }
    }
}

func main() {
    pass
}
