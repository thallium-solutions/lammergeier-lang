# Lammergeier standard library: environment variables, dotenv parsing,
# and unified config-file loading.
#
# Import with: ``from lamenv import Env, Dotenv, Config``.
#
# - ``Env`` wraps the ``os`` package for plain process-environment
#   reads and writes.
# - ``Dotenv`` parses ``.env`` files into a ``dict[str, str]`` and
#   can apply them to ``os.Environ`` (with or without overriding
#   existing values). It supports the modern feature set most
#   ``.env`` parsers expose: ``export`` prefix, quoted values with
#   escapes, ``${VAR}`` / ``$VAR`` interpolation, inline ``#``
#   comments outside of quotes, and multi-line triple-quoted
#   values.
# - ``Config`` chooses the right decoder for a path based on its
#   extension (``.env``, ``.json``, ``.yaml`` / ``.yml``,
#   ``.toml``) and merges the result into a single ``dict``,
#   later sources overriding earlier ones.

from lamconv import Conv
from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "os"
        "path/filepath"
        "strings"
    )
}

class Env {
    static func get(key: str) -> Result[str] {
        #- Return the value of ``key``. An explicitly empty value is
           ``Ok("")``; an unset key is an ``EnvError``. -#
        go! {
            value, ok := os.LookupEnv(key)
            if !ok {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "EnvError", fmt.Sprintf("environment variable %q is not set", key), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    static func getOr(key: str, fallback: str) -> str {
        #- Return ``key``'s value, or ``fallback`` if it is unset. -#
        value: str = Env.get(key).unwrapOr(fallback)
        return value
    }

    static func get(key: str, fallback: int) -> Result[int] {
        raw: Result[str] = Env.get(key)
        if not raw.ok() {
            return Result.Ok(fallback)
        }
        value: str = raw.unwrap()
        return Conv.parse(value)
    }

    static func get(key: str, fallback: float) -> Result[float] {
        raw: Result[str] = Env.get(key)
        if not raw.ok() {
            return Result.Ok(fallback)
        }
        value: str = raw.unwrap()
        return Conv.parse(value)
    }

    static func get(key: str, fallback: bool) -> Result[bool] {
        raw: Result[str] = Env.get(key)
        if not raw.ok() {
            return Result.Ok(fallback)
        }
        value: str = raw.unwrap()
        return Conv.parse(value)
    }

    static func set(key: str, val: str) -> Result[any] {
        go! {
            if err := os.Setenv(key, val); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("EnvError", err.Error(), nil))
            }
            return LAMMERGEIER.Result.Ok(nil)
        }
    }

    static func unset(key: str) -> Result[any] {
        go! {
            if err := os.Unsetenv(key); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("EnvError", err.Error(), nil))
            }
            return LAMMERGEIER.Result.Ok(nil)
        }
    }

    static func has(key: str) -> bool {
        return Env.get(key).ok()
    }

    static func all() -> dict[str, any] {
        #- Snapshot of the current environment as a plain dict. -#
        out: dict[str, any] = {}
        go! {
            for _, line := range os.Environ() {
                eq := strings.IndexByte(line, '=')
                if eq < 0 {
                    continue
                }
                out[line[:eq]] = line[eq+1:]
            }
        }
        return out
    }
}

class Dotenv {
    #- ``.env`` parser & applier.

       Use :meth:`parse` for a *pure* parse (returns the key/value
       map without touching the process environment) and
       :meth:`load` / :meth:`loadOverride` to also publish the
       results into ``os.Environ``. Variable interpolation
       (``${OTHER}`` / ``$OTHER``) honours both already-loaded
       entries from the same file and the live process
       environment, with file-local entries winning. -#

    static func parse(text: str) -> dict[str, any] {
        out: dict[str, any] = {}
        go! {
            lamEnvParseDotenv(text, out)
        }
        return out
    }

    static func parseFile(path: str) -> Result[dict[str, any]] {
        go! {
            data, err := os.ReadFile(path)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "DotenvError", fmt.Sprintf("cannot read %q: %v", path, err), nil,
                ))
            }
            out := map[string]interface{}{}
            lamEnvParseDotenv(string(data), out)
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    static func load(path: str) -> Result[int] {
        #- Parse ``path`` and copy each entry into ``os.Environ``.
           Existing variables are *kept* — a key already present in
           the environment is not overwritten. Returns the count of
           entries actually published. -#
        entries: dict[str, any] = Dotenv.parseFile(path)?
        return Dotenv.applyToEnv(entries, false)
    }

    static func loadOverride(path: str) -> Result[int] {
        #- Same as :meth:`load`, but file entries always win. -#
        entries: dict[str, any] = Dotenv.parseFile(path)?
        return Dotenv.applyToEnv(entries, true)
    }

    static func applyToEnv(entries: dict[str, any], override_: bool) -> Result[int] {
        go! {
            n := 0
            for k, v := range entries {
                vs, _ := v.(string)
                if !override_ {
                    if _, exists := os.LookupEnv(k); exists {
                        continue
                    }
                }
                if err := os.Setenv(k, vs); err != nil {
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DotenvError", err.Error(), nil))
                }
                n++
            }
            return LAMMERGEIER.Result.Ok(n)
        }
    }
}

class Config {
    #- Decode a config file based on its extension and return a
       ``dict[str, any]``.

       Supported extensions: ``.env``, ``.json``, ``.yaml`` /
       ``.yml``, ``.toml``. The function returns a ``Result`` so
       you can branch on failure cleanly:

           cfg = Config.load("app.toml")
           if cfg.ok() { use(cfg.value) } else { print(cfg.error) }

       Use :meth:`merge` to combine multiple sources (defaults +
       env-specific override + ``.env`` secrets):

           cfg = Config.merge([
               Config.load("config/defaults.yaml"),
               Config.load("config/" + env + ".yaml"),
               Dotenv.parseFile(".env"),
           ])
    -#

    static func load(path: str) -> Result[dict[str, any]] {
        go! {
            ext := strings.ToLower(filepath.Ext(path))
            data, err := os.ReadFile(path)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ConfigError",
                    fmt.Sprintf("config: cannot read %q: %v", path, err),
                    nil,
                ))
            }
            m := map[string]interface{}{}
            switch ext {
            case ".env":
                lamEnvParseDotenv(string(data), m)
            case ".json":
                if err := lamEnvJSONUnmarshal(data, &m); err != nil {
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                        "ConfigError",
                        fmt.Sprintf("config: %q: %v", path, err),
                        nil,
                    ))
                }
            case ".yaml", ".yml":
                if err := lamEnvYAMLUnmarshal(data, &m); err != nil {
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                        "ConfigError",
                        fmt.Sprintf("config: %q: %v", path, err),
                        nil,
                    ))
                }
            case ".toml":
                if err := lamEnvTOMLDecode(string(data), &m); err != nil {
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                        "ConfigError",
                        fmt.Sprintf("config: %q: %v", path, err),
                        nil,
                    ))
                }
            default:
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "ConfigError",
                    fmt.Sprintf("config: unsupported extension %q for %q", ext, path),
                    nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(m)
        }
    }

    static func merge(sources: list[any]) -> dict[str, any] {
        #- Merge a list of dict-shaped sources into a single dict.
           Later entries override earlier ones; nested dicts are
           merged shallowly (key-by-key) rather than replaced. -#
        out: dict[str, any] = {}
        go! {
            for _, src := range sources {
                lamEnvMergeInto(out, src)
            }
        }
        return out
    }
}

go! {
    // ── .env tokenizer ─────────────────────────────────────────
    //
    // Supports:
    //   - blank lines and ``# ...`` line comments
    //   - optional ``export `` prefix
    //   - quoted values (single, double, triple-double)
    //   - escape sequences inside double quotes (\n, \t, \r, \\, \", \$)
    //   - ``${VAR}`` / ``$VAR`` interpolation against already-loaded
    //     entries plus the live process environment
    //   - inline ``#`` comments outside of quotes
    func lamEnvParseDotenv(src string, out map[string]interface{}) {
        i := 0
        n := len(src)
        for i < n {
            // Skip whitespace and blank lines
            for i < n && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') {
                i++
            }
            if i >= n {
                break
            }
            if src[i] == '#' {
                for i < n && src[i] != '\n' {
                    i++
                }
                continue
            }
            // Optional ``export `` prefix
            if i+7 <= n && src[i:i+7] == "export " {
                i += 7
                for i < n && (src[i] == ' ' || src[i] == '\t') {
                    i++
                }
            }
            // Key
            keyStart := i
            for i < n && (src[i] == '_' ||
                (src[i] >= 'A' && src[i] <= 'Z') ||
                (src[i] >= 'a' && src[i] <= 'z') ||
                (src[i] >= '0' && src[i] <= '9' && i > keyStart) ||
                src[i] == '.') {
                i++
            }
            if i == keyStart {
                // Not a valid key — skip this line.
                for i < n && src[i] != '\n' {
                    i++
                }
                continue
            }
            key := src[keyStart:i]
            for i < n && (src[i] == ' ' || src[i] == '\t') {
                i++
            }
            if i >= n || src[i] != '=' {
                // Bare line (e.g. ``KEY`` with no value) — store empty.
                out[key] = ""
                for i < n && src[i] != '\n' {
                    i++
                }
                continue
            }
            i++ // consume '='
            for i < n && (src[i] == ' ' || src[i] == '\t') {
                i++
            }
            // Value
            var value string
            if i+3 <= n && src[i:i+3] == "\"\"\"" {
                i += 3
                start := i
                for i+3 <= n && src[i:i+3] != "\"\"\"" {
                    i++
                }
                value = lamEnvUnescapeDouble(src[start:i])
                if i+3 <= n {
                    i += 3
                }
            } else if i < n && (src[i] == '"' || src[i] == '\'') {
                quote := src[i]
                i++
                start := i
                for i < n && src[i] != quote {
                    if src[i] == '\\' && i+1 < n {
                        i += 2
                        continue
                    }
                    i++
                }
                raw := src[start:i]
                if quote == '"' {
                    value = lamEnvUnescapeDouble(raw)
                } else {
                    value = raw
                }
                if i < n && src[i] == quote {
                    i++
                }
            } else {
                start := i
                for i < n && src[i] != '\n' {
                    if src[i] == '#' {
                        // Trim trailing whitespace, then bail.
                        break
                    }
                    i++
                }
                value = strings.TrimRight(src[start:i], " \t")
                // Skip the comment, if any
                for i < n && src[i] != '\n' {
                    i++
                }
            }
            value = lamEnvInterpolate(value, out)
            out[key] = value
        }
    }

    func lamEnvUnescapeDouble(s string) string {
        var sb strings.Builder
        i := 0
        for i < len(s) {
            if s[i] == '\\' && i+1 < len(s) {
                switch s[i+1] {
                case 'n':
                    sb.WriteByte('\n')
                case 'r':
                    sb.WriteByte('\r')
                case 't':
                    sb.WriteByte('\t')
                case '\\':
                    sb.WriteByte('\\')
                case '"':
                    sb.WriteByte('"')
                case '$':
                    sb.WriteByte('$')
                default:
                    sb.WriteByte(s[i])
                    sb.WriteByte(s[i+1])
                }
                i += 2
                continue
            }
            sb.WriteByte(s[i])
            i++
        }
        return sb.String()
    }

    func lamEnvInterpolate(s string, scope map[string]interface{}) string {
        var sb strings.Builder
        i := 0
        for i < len(s) {
            if s[i] == '$' && i+1 < len(s) {
                if s[i+1] == '{' {
                    end := i + 2
                    for end < len(s) && s[end] != '}' {
                        end++
                    }
                    name := s[i+2 : end]
                    sb.WriteString(lamEnvLookup(name, scope))
                    if end < len(s) {
                        i = end + 1
                    } else {
                        i = end
                    }
                    continue
                }
                if (s[i+1] >= 'A' && s[i+1] <= 'Z') ||
                    (s[i+1] >= 'a' && s[i+1] <= 'z') || s[i+1] == '_' {
                    end := i + 1
                    for end < len(s) && ((s[end] >= 'A' && s[end] <= 'Z') ||
                        (s[end] >= 'a' && s[end] <= 'z') ||
                        (s[end] >= '0' && s[end] <= '9') || s[end] == '_') {
                        end++
                    }
                    name := s[i+1 : end]
                    sb.WriteString(lamEnvLookup(name, scope))
                    i = end
                    continue
                }
            }
            sb.WriteByte(s[i])
            i++
        }
        return sb.String()
    }

    func lamEnvLookup(name string, scope map[string]interface{}) string {
        if v, ok := scope[name]; ok {
            if s, ok := v.(string); ok {
                return s
            }
        }
        return os.Getenv(name)
    }

    func lamEnvMergeInto(dst map[string]interface{}, src interface{}) {
        switch m := src.(type) {
        case map[string]interface{}:
            for k, v := range m {
                dst[k] = v
            }
        case map[interface{}]interface{}:
            for k, v := range m {
                if ks, ok := k.(string); ok {
                    dst[ks] = v
                }
            }
        case map[string]string:
            for k, v := range m {
                dst[k] = v
            }
        }
    }
}

# JSON / YAML / TOML wrappers — kept as tiny helper functions so the
# Config decoder can call them without dragging the per-format
# decoders into ``lamenv``'s top-level imports. Each wrapper just
# delegates to the upstream decoder.

go! {
    import (
        "encoding/json"

        toml "github.com/BurntSushi/toml"
        yaml "gopkg.in/yaml.v3"
    )

    func lamEnvJSONUnmarshal(b []byte, v interface{}) error {
        return json.Unmarshal(b, v)
    }

    func lamEnvYAMLUnmarshal(b []byte, v interface{}) error {
        return yaml.Unmarshal(b, v)
    }

    func lamEnvTOMLDecode(s string, v interface{}) error {
        _, err := toml.Decode(s, v)
        return err
    }
}

func main() {
    pass
}
