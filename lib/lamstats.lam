# Lammergeier standard library: basic statistics
# Import with: from lamstats import Stats
#
# Accepts lists of `float` (use Conv.toFloat if you have ints). Every
# function returns float; callers can round/truncate as needed.

from lammath import Math

class Stats {
    static func sum(values: list[float]) -> float {
        total: float = 0.0
        for value in values {
            total += value
        }
        return total
    }

    static func product(values: list[float]) -> float {
        if len(values) == 0 {
            return 0.0
        }
        total: float = 1.0
        for value in values {
            total *= value
        }
        return total
    }

    static func mean(values: list[float]) -> float {
        if len(values) == 0 {
            throw ValueError("Stats.mean: empty list")
        }
        return Stats.sum(values) / float(len(values))
    }

    static func median(values: list[float]) -> float {
        n: int = len(values)
        if n == 0 {
            throw ValueError("Stats.median: empty list")
        }
        ordered: list[float] = values.sort()
        if n % 2 == 1 {
            return ordered[n / 2]
        }
        return (ordered[n / 2 - 1] + ordered[n / 2]) / 2.0
    }

    static func mode(values: list[float]) -> float {
        #- Return the most frequent value. Ties return the smallest mode. -#
        if len(values) == 0 {
            throw ValueError("Stats.mode: empty list")
        }
        ordered: list[float] = values.sort()
        best: float = ordered[0]
        bestCount: int = 1
        current: float = ordered[0]
        currentCount: int = 1
        for i in range(1, len(ordered)) {
            if ordered[i] == current {
                currentCount += 1
            } else {
                if currentCount > bestCount {
                    best = current
                    bestCount = currentCount
                }
                current = ordered[i]
                currentCount = 1
            }
        }
        if currentCount > bestCount {
            best = current
        }
        return best
    }

    static func variance(values: list[float]) -> float {
        #- Population variance. Use `sampleVariance` for a sample estimate. -#
        n: int = len(values)
        if n == 0 {
            throw ValueError("Stats.variance: empty list")
        }
        average: float = Stats.sum(values) / float(n)
        sumSq: float = 0.0
        for value in values {
            delta: float = value - average
            sumSq += delta * delta
        }
        return sumSq / float(n)
    }

    static func sampleVariance(values: list[float]) -> float {
        n: int = len(values)
        if n < 2 {
            throw ValueError("Stats.sampleVariance: need at least 2 values")
        }
        average: float = Stats.sum(values) / float(n)
        sumSq: float = 0.0
        for value in values {
            delta: float = value - average
            sumSq += delta * delta
        }
        return sumSq / float(n - 1)
    }

    static func stddev(values: list[float]) -> float {
        #- Population standard deviation. -#
        if len(values) == 0 {
            throw ValueError("Stats.stddev: empty list")
        }
        return Math.sqrt(Stats.variance(values))
    }

    static func minVal(values: list[float]) -> float {
        if len(values) == 0 {
            throw ValueError("Stats.minVal: empty list")
        }
        best: float = values[0]
        for value in values {
            if value < best {
                best = value
            }
        }
        return best
    }

    static func maxVal(values: list[float]) -> float {
        if len(values) == 0 {
            throw ValueError("Stats.maxVal: empty list")
        }
        best: float = values[0]
        for value in values {
            if value > best {
                best = value
            }
        }
        return best
    }

    static func range_(values: list[float]) -> float {
        #- max - min. Named `range_` because `range` is a Lam keyword. -#
        if len(values) == 0 {
            throw ValueError("Stats.range_: empty list")
        }
        low: float = values[0]
        high: float = values[0]
        for value in values {
            if value < low {
                low = value
            }
            if value > high {
                high = value
            }
        }
        return high - low
    }

    static func percentile(values: list[float], p: float) -> float {
        #- Linear-interpolated percentile, 0 <= p <= 100. -#
        if len(values) == 0 {
            throw ValueError("Stats.percentile: empty list")
        }
        if p < 0.0 or p > 100.0 {
            throw ValueError("Stats.percentile: p must be in [0,100]")
        }
        ordered: list[float] = values.sort()
        rank: float = p / 100.0 * float(len(ordered) - 1)
        low: int = int(rank)
        high: int = low + 1
        if high >= len(ordered) {
            return ordered[low]
        }
        fraction: float = rank - float(low)
        return ordered[low] + (ordered[high] - ordered[low]) * fraction
    }
}

func main() {
    pass
}
