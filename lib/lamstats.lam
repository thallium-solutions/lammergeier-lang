# Lammergeier standard library: basic statistics
# Import with: from lamstats import Stats
#
# Numeric APIs accept homogeneous lists of `int` or `float`. Reductions that
# preserve the input domain return T; averages, dispersion, and interpolation
# return float. Ordered extrema and mode preserve their ordered input type.

from lammath import Math

class Stats {
    static func sum[T: number](values: list[T]) -> T {
        total: T = 0
        for value: T in values {
            total += value
        }
        return total
    }

    static func product[T: number](values: list[T]) -> T {
        if len(values) == 0 {
            return 0
        }
        total: T = 1
        for value: T in values {
            total *= value
        }
        return total
    }

    static func mean[T: number](values: list[T]) -> float {
        if len(values) == 0 {
            throw ValueError("Stats.mean: empty list")
        }
        return float(Stats.sum(values)) / float(len(values))
    }

    static func median[T: number](values: list[T]) -> float {
        n: int = len(values)
        if n == 0 {
            throw ValueError("Stats.median: empty list")
        }
        ordered: list[T] = values.sort()
        if n % 2 == 1 {
            return float(ordered[n // 2])
        }
        return (float(ordered[n // 2 - 1]) + float(ordered[n // 2])) / 2.0
    }

    static func mode[T: ordered](values: list[T]) -> T {
        #- Return the most frequent value. Ties return the smallest mode. -#
        if len(values) == 0 {
            throw ValueError("Stats.mode: empty list")
        }
        ordered: list[T] = values.sort()
        best: T = ordered[0]
        bestCount: int = 1
        current: T = ordered[0]
        currentCount: int = 1
        for i in range(1, len(ordered)) {
            if ordered[i] == current {
                currentCount += 1
            } else {
                if currentCount > bestCount {
                    best = current
                    bestCount = currentCount
                }
                current = ordered[i]
                currentCount = 1
            }
        }
        if currentCount > bestCount {
            best = current
        }
        return best
    }

    static func variance[T: number](values: list[T]) -> float {
        #- Population variance. Use `sampleVariance` for a sample estimate. -#
        n: int = len(values)
        if n == 0 {
            throw ValueError("Stats.variance: empty list")
        }
        average: float = Stats.mean(values)
        sumSq: float = 0.0
        for value: T in values {
            delta: float = float(value) - average
            sumSq += delta * delta
        }
        return sumSq / float(n)
    }

    static func sampleVariance[T: number](values: list[T]) -> float {
        n: int = len(values)
        if n < 2 {
            throw ValueError("Stats.sampleVariance: need at least 2 values")
        }
        average: float = Stats.mean(values)
        sumSq: float = 0.0
        for value: T in values {
            delta: float = float(value) - average
            sumSq += delta * delta
        }
        return sumSq / float(n - 1)
    }

    static func stddev[T: number](values: list[T]) -> float {
        #- Population standard deviation. -#
        if len(values) == 0 {
            throw ValueError("Stats.stddev: empty list")
        }
        return Math.sqrt(Stats.variance(values))
    }

    static func minVal[T: ordered](values: list[T]) -> T {
        if len(values) == 0 {
            throw ValueError("Stats.minVal: empty list")
        }
        best: T = values[0]
        for value: T in values {
            if value < best {
                best = value
            }
        }
        return best
    }

    static func maxVal[T: ordered](values: list[T]) -> T {
        if len(values) == 0 {
            throw ValueError("Stats.maxVal: empty list")
        }
        best: T = values[0]
        for value: T in values {
            if value > best {
                best = value
            }
        }
        return best
    }

    static func range_[T: number](values: list[T]) -> T {
        #- max - min. Named `range_` because `range` is a Lam keyword. -#
        if len(values) == 0 {
            throw ValueError("Stats.range_: empty list")
        }
        low: T = values[0]
        high: T = values[0]
        for value: T in values {
            if value < low {
                low = value
            }
            if value > high {
                high = value
            }
        }
        return high - low
    }

    static func percentile[T: number](values: list[T], p: float) -> float {
        #- Linear-interpolated percentile, 0 <= p <= 100. -#
        if len(values) == 0 {
            throw ValueError("Stats.percentile: empty list")
        }
        if p < 0.0 or p > 100.0 {
            throw ValueError("Stats.percentile: p must be in [0,100]")
        }
        ordered: list[T] = values.sort()
        rank: float = p / 100.0 * float(len(ordered) - 1)
        low: int = int(rank)
        high: int = low + 1
        if high >= len(ordered) {
            return float(ordered[low])
        }
        fraction: float = rank - float(low)
        lowValue: float = float(ordered[low])
        highValue: float = float(ordered[high])
        return lowValue + (highValue - lowValue) * fraction
    }
}

func main() {
    pass
}
