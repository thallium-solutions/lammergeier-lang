# Lammergeier standard library: schema validation for JSON, YAML, and XML.
#
# ``Schema.validate`` is overloaded for text and native ``json`` schemas and
# documents. Successful validation returns the original document in ``Result``;
# failures return a structured ``Error``. JSON is the default text backend.
#
# Import with: ``from lamschema import Schema``.

from lamerrors import Result, Error

go! {
    import (
        "encoding/json"
        "encoding/xml"
        "fmt"
        "io"
        "strings"
        "sync"

        xmlparser "github.com/moolekkari/validatexml-go"
        gojsonschema "github.com/xeipuuv/gojsonschema"
        yaml "gopkg.in/yaml.v3"
    )

    type lamSchemaEntry struct {
        schema *gojsonschema.Schema
    }

    type lamSchemaFailure struct {
        kind    string
        message string
        cause   interface{}
    }

    const lamSchemaCacheLimit = 1024

    var (
        lamSchemaMu        sync.RWMutex
        lamSchemaByText    = map[string]*lamSchemaEntry{}
        lamSchemaXSDByText = map[string]*xmlparser.Schema{}
    )

    func lamSchemaCompileText(source string) (*gojsonschema.Schema, *lamSchemaFailure) {
        var parsed interface{}
        if err := json.Unmarshal([]byte(source), &parsed); err != nil {
            return nil, &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "schema is not valid JSON: " + err.Error(),
                cause: map[string]interface{}{"backend": "json", "target": "schema"},
            }
        }

        lamSchemaMu.RLock()
        entry := lamSchemaByText[source]
        lamSchemaMu.RUnlock()
        if entry != nil {
            return entry.schema, nil
        }

        compiled, err := gojsonschema.NewSchema(gojsonschema.NewStringLoader(source))
        if err != nil {
            return nil, &lamSchemaFailure{
                kind: "SchemaCompileError",
                message: "schema compilation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "gojsonschema", "target": "schema"},
            }
        }

        lamSchemaMu.Lock()
        if len(lamSchemaByText) >= lamSchemaCacheLimit {
            lamSchemaByText = map[string]*lamSchemaEntry{}
        }
        lamSchemaByText[source] = &lamSchemaEntry{schema: compiled}
        lamSchemaMu.Unlock()
        return compiled, nil
    }

    func lamSchemaText(value LamJSON) (string, *lamSchemaFailure) {
        encoded, err := json.Marshal(lamJSONRaw(value))
        if err != nil {
            return "", &lamSchemaFailure{
                kind: "SchemaCompileError",
                message: "schema encoding failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "json", "target": "schema"},
            }
        }
        return string(encoded), nil
    }

    func lamSchemaIssues(result *gojsonschema.Result) []interface{} {
        issues := make([]interface{}, 0, len(result.Errors()))
        for _, issue := range result.Errors() {
            issues = append(issues, map[string]interface{}{
                "field": issue.Field(),
                "keyword": issue.Type(),
                "description": issue.Description(),
                "value": issue.Value(),
                "details": issue.Details(),
                "backend": "gojsonschema",
            })
        }
        return issues
    }

    func lamSchemaValidationFailure(result *gojsonschema.Result) *lamSchemaFailure {
        if result.Valid() {
            return nil
        }
        issues := lamSchemaIssues(result)
        return &lamSchemaFailure{
            kind: "SchemaValidationError",
            message: fmt.Sprintf("document does not satisfy schema (%d issue(s))", len(issues)),
            cause: issues,
        }
    }

    func lamSchemaValidateText(schemaText string, document string) *lamSchemaFailure {
        compiled, failure := lamSchemaCompileText(schemaText)
        if failure != nil {
            return failure
        }
        var parsed interface{}
        if err := json.Unmarshal([]byte(document), &parsed); err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "document is not valid JSON: " + err.Error(),
                cause: map[string]interface{}{"backend": "json", "target": "document"},
            }
        }
        result, err := compiled.Validate(gojsonschema.NewStringLoader(document))
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "document validation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "gojsonschema", "target": "document"},
            }
        }
        return lamSchemaValidationFailure(result)
    }

    func lamSchemaValidateValue(schemaText string, document LamJSON) *lamSchemaFailure {
        compiled, failure := lamSchemaCompileText(schemaText)
        if failure != nil {
            return failure
        }
        result, err := compiled.Validate(gojsonschema.NewGoLoader(lamJSONRaw(document)))
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaValidationError",
                message: "document validation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "gojsonschema", "target": "document"},
            }
        }
        return lamSchemaValidationFailure(result)
    }

    func lamSchemaNormalizeYAML(value interface{}) (interface{}, error) {
        switch current := value.(type) {
        case map[string]interface{}:
            out := make(map[string]interface{}, len(current))
            for key, child := range current {
                normalized, err := lamSchemaNormalizeYAML(child)
                if err != nil { return nil, err }
                out[key] = normalized
            }
            return out, nil
        case map[interface{}]interface{}:
            out := make(map[string]interface{}, len(current))
            for key, child := range current {
                text, ok := key.(string)
                if !ok { return nil, fmt.Errorf("YAML mapping keys must be strings") }
                normalized, err := lamSchemaNormalizeYAML(child)
                if err != nil { return nil, err }
                out[text] = normalized
            }
            return out, nil
        case []interface{}:
            out := make([]interface{}, len(current))
            for index, child := range current {
                normalized, err := lamSchemaNormalizeYAML(child)
                if err != nil { return nil, err }
                out[index] = normalized
            }
            return out, nil
        default:
            return value, nil
        }
    }

    func lamSchemaYAMLToJSON(source string) (string, error) {
        var raw interface{}
        if err := yaml.Unmarshal([]byte(source), &raw); err != nil { return "", err }
        normalized, err := lamSchemaNormalizeYAML(raw)
        if err != nil { return "", err }
        encoded, err := json.Marshal(normalized)
        if err != nil { return "", err }
        return string(encoded), nil
    }

    func lamSchemaValidateYAML(schemaText string, document string) *lamSchemaFailure {
        var rawSchema interface{}
        if err := yaml.Unmarshal([]byte(schemaText), &rawSchema); err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "schema is not valid YAML: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "schema"},
            }
        }
        normalizedSchema, err := lamSchemaNormalizeYAML(rawSchema)
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "schema is not JSON-compatible YAML: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "schema"},
            }
        }
        encodedSchema, err := json.Marshal(normalizedSchema)
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaCompileError",
                message: "YAML schema encoding failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "schema"},
            }
        }
        compiled, failure := lamSchemaCompileText(string(encodedSchema))
        if failure != nil { return failure }

        var rawDocument interface{}
        if err = yaml.Unmarshal([]byte(document), &rawDocument); err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "document is not valid YAML: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "document"},
            }
        }
        normalizedDocument, err := lamSchemaNormalizeYAML(rawDocument)
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "document is not JSON-compatible YAML: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "document"},
            }
        }
        result, err := compiled.Validate(gojsonschema.NewGoLoader(normalizedDocument))
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaValidationError",
                message: "YAML document validation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "yaml", "target": "document"},
            }
        }
        return lamSchemaValidationFailure(result)
    }

    func lamSchemaRejectExternalXSD(source string) error {
        decoder := xml.NewDecoder(strings.NewReader(source))
        for {
            token, err := decoder.Token()
            if err == io.EOF { return nil }
            if err != nil { return err }
            start, ok := token.(xml.StartElement)
            if !ok || start.Name.Space != "http://www.w3.org/2001/XMLSchema" {
                continue
            }
            if start.Name.Local == "include" || start.Name.Local == "import" || start.Name.Local == "redefine" {
                return fmt.Errorf("external XSD includes, imports, and redefines are disabled")
            }
        }
    }

    func lamSchemaCompileXSD(source string) (*xmlparser.Schema, *lamSchemaFailure) {
        if err := lamSchemaRejectExternalXSD(source); err != nil {
            return nil, &lamSchemaFailure{
                kind: "SchemaCompileError",
                message: "XSD compilation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "xsd", "target": "schema"},
            }
        }
        lamSchemaMu.RLock()
        compiled := lamSchemaXSDByText[source]
        lamSchemaMu.RUnlock()
        if compiled != nil { return compiled, nil }

        parsed, err := xmlparser.ParseXSD([]byte(source))
        if err != nil {
            return nil, &lamSchemaFailure{
                kind: "SchemaCompileError",
                message: "XSD compilation failed: " + err.Error(),
                cause: map[string]interface{}{"backend": "xsd", "target": "schema"},
            }
        }
        lamSchemaMu.Lock()
        if len(lamSchemaXSDByText) >= lamSchemaCacheLimit {
            lamSchemaXSDByText = map[string]*xmlparser.Schema{}
        }
        lamSchemaXSDByText[source] = parsed
        lamSchemaMu.Unlock()
        return parsed, nil
    }

    func lamSchemaValidateXML(schemaText string, document string) *lamSchemaFailure {
        compiled, failure := lamSchemaCompileXSD(schemaText)
        if failure != nil { return failure }
        parsed, err := xmlparser.Parse([]byte(document))
        if err != nil {
            return &lamSchemaFailure{
                kind: "SchemaParseError",
                message: "document is not valid XML: " + err.Error(),
                cause: map[string]interface{}{"backend": "xml", "target": "document"},
            }
        }
        if err = compiled.Validate(parsed); err != nil {
            issues := []interface{}{map[string]interface{}{
                "description": err.Error(),
                "backend": "xsd",
            }}
            if validation, ok := err.(*xmlparser.ValidationError); ok {
                issues = make([]interface{}, 0, len(validation.Errors))
                for _, message := range validation.Errors {
                    issues = append(issues, map[string]interface{}{
                        "description": message,
                        "backend": "xsd",
                    })
                }
            }
            return &lamSchemaFailure{
                kind: "SchemaValidationError",
                message: fmt.Sprintf("XML document does not satisfy XSD (%d issue(s))", len(issues)),
                cause: issues,
            }
        }
        return nil
    }

    func lamSchemaFailureMessages(failure *lamSchemaFailure) []string {
        if failure == nil { return nil }
        messages := []string{}
        if issues, ok := failure.cause.([]interface{}); ok {
            for _, raw := range issues {
                if issue, ok := raw.(map[string]interface{}); ok {
                    if description, ok := issue["description"].(string); ok {
                        messages = append(messages, description)
                    }
                }
            }
        }
        if len(messages) == 0 { messages = append(messages, failure.message) }
        return messages
    }

    func lamSchemaFailureResult(failure *lamSchemaFailure) *Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            failure.kind, failure.message, failure.cause,
        ))
    }

    func lamSchemaFormatFailure(format string) *Result {
        return lamSchemaFailureResult(&lamSchemaFailure{
            kind: "SchemaFormatError",
            message: fmt.Sprintf("unsupported schema format %q; expected json, yaml, or xml", format),
            cause: map[string]interface{}{"format": format},
        })
    }
}

class Schema {
    static func validate(schema: str, document: str, format: str = "json") -> Result[str] {
        go! {
            var failure *lamSchemaFailure
            switch format {
            case "json":
                failure = lamSchemaValidateText(schema, document)
            case "yaml":
                failure = lamSchemaValidateYAML(schema, document)
            case "xml":
                failure = lamSchemaValidateXML(schema, document)
            default:
                return lamSchemaFormatFailure(format)
            }
            if failure != nil {
                return lamSchemaFailureResult(failure)
            }
            return LAMMERGEIER.Result.Ok(document)
        }
    }

    static func validate(schema: str, document: json) -> Result[json] {
        go! {
            if failure := lamSchemaValidateValue(schema, document); failure != nil {
                return lamSchemaFailureResult(failure)
            }
            return LAMMERGEIER.Result.Ok(document)
        }
    }

    static func validate(schema: json, document: str) -> Result[str] {
        go! {
            schemaText, failure := lamSchemaText(schema)
            if failure != nil {
                return lamSchemaFailureResult(failure)
            }
            if failure = lamSchemaValidateText(schemaText, document); failure != nil {
                return lamSchemaFailureResult(failure)
            }
            return LAMMERGEIER.Result.Ok(document)
        }
    }

    static func validate(schema: json, document: json) -> Result[json] {
        go! {
            schemaText, failure := lamSchemaText(schema)
            if failure != nil {
                return lamSchemaFailureResult(failure)
            }
            if failure = lamSchemaValidateValue(schemaText, document); failure != nil {
                return lamSchemaFailureResult(failure)
            }
            return LAMMERGEIER.Result.Ok(document)
        }
    }
}

func main() {
    pass
}
