# Lammergeier standard library — relational database access.
#
# Supports SQLite (pure-Go ``modernc.org/sqlite``), MySQL
# (``go-sql-driver/mysql``), and PostgreSQL (``lib/pq``) out of the
# box. Connection pooling is built into Go's ``database/sql`` and is
# exposed here through ``Db.setPool(maxOpen, maxIdle, idleSec,
# lifetimeSec)``. Automatic reconnection is layered on top: any query
# that fails with a transient driver error (closed connection, bad
# connection, server gone away …) is retried up to ``maxRetries``
# times with exponential backoff.
#
# A Knex.js-style chainable query builder is provided via
# ``Db.table(name)`` (returns a ``QueryBuilder``) for SELECT / INSERT
# / UPDATE / DELETE construction.
#
# Quick start::
#
#     from lamdb import Db, QueryBuilder, Row, Where
#
#     db: Db = Db.connect("sqlite", ":memory:")?
#     _ = db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")?
#
#     # Raw SQL with positional parameters (driver-agnostic ``?``).
#     _ = db.exec("INSERT INTO users (name, age) VALUES (?, ?)", ["alice", 30])?
#
#     # Knex-style builder.
#     rows: list[dict[str, any]] = db.table("users")
#         .select(["id", "name"])
#         .where("age", ">", 18)
#         .orderBy("name", "asc")
#         .limit(10)
#         .get()?
#
#     # Insert / update / delete return affected-row counts in Results.
#     n: int = db.table("users").insert({"name": "bob", "age": 42})?
#     n2: int = db.table("users").whereEq("id", 1).update({"age": 31})?
#     n3: int = db.table("users").whereEq("id", 1).delete()?
#
# Services take a ``DbConn``: the query surface (``exec``, ``query``,
# ``first``, ``scalar``, the JSON reads, ``table``, ``transaction``,
# ``pool``) that a ``Db``, a ``withContext`` view and a ``Tx`` all have, so
# one function runs inside or outside a transaction. ``Db.atomic(conn,
# fn)`` runs ``fn(tx) -> Result[T]`` as one unit and returns its typed
# Result: a transaction on a ``Db`` (commit on ``Ok``, rollback on ``Err``
# or a throw), a savepoint on a ``Tx`` (release / rollback to it), so units
# compose. ``conn.pool()`` is the owning pool, for libraries needing a
# ``Db``.
#
#     func move(conn: DbConn, id: int) -> Result[int] {
#         return Db.atomic(conn, lambda (tx: Tx) -> Result[int]: tx.exec("UPDATE ...", [id]))
#     }
#
# Driver compatibility notes:
#   * SQLite uses ``?`` placeholders and ``[INTEGER PRIMARY KEY
#     AUTOINCREMENT]``.
#   * MySQL uses ``?`` placeholders and ``[INT AUTO_INCREMENT]``.
#   * Postgres uses ``$1``, ``$2`` placeholders and ``SERIAL``. The
#     query builder rewrites ``?`` → ``$1``/``$2``/… automatically
#     when the driver is ``postgres``.
#
# Expected database failures are returned through unsuffixed ``Result[T]``
# APIs. Callers can inspect errors, use ``?`` to propagate them, or opt into
# a panic explicitly with ``unwrap()``.
#
# Rows are ``dict[str, any]`` holding the drivers' values: ``int64``,
# ``float64``, ``bool``, ``str`` (text, NUMERIC, UUID, arrays and blobs all
# arrive as text), date/time columns as Go ``time.Time`` and NULL as
# ``None``. The static ``Row`` helpers read them typed — ``Row.int(row,
# "id")``, ``Row.str``, ``Row.float``, ``Row.bool``, ``Row.unix`` /
# ``Row.time`` (a ``DateTime``), ``Row.optionalStr`` & co. for nullable
# columns, ``Row.strList`` for PostgreSQL ``text[]``, ``Row.timeText`` for a
# timestamp in a Go layout (whole seconds by default) — and
# ``Db.textArray(values)`` writes a ``text[]`` parameter (``?::text[]``).
#
# ``first`` / ``scalar`` / ``firstJson`` / ``scalarJson`` stop reading at the
# first row (the rest of the result set is not read, no ``LIMIT`` needed);
# ``scalar`` is the first column in select order.
#
# Failures keep the driver's error as their ``Error.cause``:
# ``Db.sqlState(result)`` reads its SQLSTATE (SQLite and MySQL constraint
# codes mapped to the standard ones) and ``Db.isUniqueViolation`` /
# ``Db.isForeignKeyViolation`` test for ``23505`` / ``23503`` without
# matching messages. ``Where`` builds the WHERE clause of hand-written SQL
# with its parameters in order (``add``, ``addIf``, ``addIn``, escaped
# ``ilikeAny`` / ``likeAny`` searches).

from lamerrors import Result, Error
from lamdatetime import DateTime
from lamcontext import Context

go! {
    import (
        "context"
        "database/sql"
        "errors"
        "fmt"
        "math"
        "math/big"
        "strings"
        "strconv"
        "sync"
        "time"

        lamMysql "github.com/go-sql-driver/mysql"
        lamPq "github.com/lib/pq"
        lamSqlite "modernc.org/sqlite"
    )

    // ``"`` and ``\`` inside a quoted array element (``Db.textArray``).
    var lamDbTextArrayEscaper = strings.NewReplacer("\\", "\\\\", "\"", "\\\"")

    func lamDbContext(ctx *Context) context.Context {
        if ctx == nil {
            return context.Background()
        }
        native, ok := ctx.Native().(context.Context)
        if !ok || native == nil {
            return context.Background()
        }
        return native
    }

    // ─── Driver normalisation ─────────────────────────────────
    // Lam users pick a friendly driver name; we map it to the
    // ``database/sql`` driver name and DSN format.
    func lamDbResolveDriver(driver string) string {
        switch strings.ToLower(driver) {
        case "sqlite", "sqlite3":
            return "sqlite"
        case "mysql", "mariadb":
            return "mysql"
        case "postgres", "postgresql", "pg":
            return "postgres"
        default:
            return driver
        }
    }

    // ─── Placeholder rewriting ────────────────────────────────
    // SQLite and MySQL use ``?`` placeholders. Postgres expects
    // ``$1``, ``$2``, … so when the dialect is postgres we rewrite
    // every unquoted ``?`` to ``$N`` (where N is its 1-based index).
    func lamDbRewritePlaceholders(query, dialect string) string {
        if dialect != "postgres" || strings.IndexByte(query, '?') < 0 {
            return query
        }
        var b strings.Builder
        b.Grow(len(query) + 16)
        n := 0
        inSingle := false
        inDouble := false
        for i := 0; i < len(query); i++ {
            ch := query[i]
            switch {
            case ch == '\'' && !inDouble:
                inSingle = !inSingle
                b.WriteByte(ch)
            case ch == '"' && !inSingle:
                inDouble = !inDouble
                b.WriteByte(ch)
            case ch == '?' && !inSingle && !inDouble:
                n++
                b.WriteString("$")
                b.WriteString(strconv.Itoa(n))
            default:
                b.WriteByte(ch)
            }
        }
        return b.String()
    }

    // Render the QueryBuilder's flat condition triples. Predicate
    // groups use this same renderer before wrapping the result in
    // parentheses, so nesting preserves both boolean order and parameter
    // order without introducing a second condition representation.
    func lamDbRenderConditions(conds []interface{}) (string, []interface{}) {
        var b strings.Builder
        params := []interface{}{}
        rendered := 0
        for _, raw := range conds {
            triple, ok := raw.([]interface{})
            if !ok || len(triple) < 3 {
                continue
            }
            logic, _ := triple[0].(string)
            fragment, _ := triple[1].(string)
            values, _ := triple[2].([]interface{})
            if fragment == "" {
                continue
            }
            if rendered > 0 {
                b.WriteString(" ")
                b.WriteString(logic)
                b.WriteString(" ")
            }
            b.WriteString(fragment)
            params = append(params, values...)
            rendered++
        }
        return b.String(), params
    }

    // ─── Reading rows ─────────────────────────────────────────
    // ``lamDbQuery`` runs a SELECT (retrying transient failures ``attempts``
    // times) and reads up to ``limit`` rows (every row when ``limit`` is
    // 0) as maps keyed by column name, text and bytes as ``str``; it also
    // returns the column names in select order. With a limit the rows are
    // closed as soon as it is reached, so ``first`` / ``scalar`` never read
    // (or keep) the rest of the result set.
    type lamDbQueryer interface {
        QueryContext(ctx context.Context, query string, args ...interface{}) (*sql.Rows, error)
    }

    func lamDbQuery(ctx context.Context, conn lamDbQueryer, q string, args []interface{}, attempts int, retryBaseMs int, limit int) ([]map[string]interface{}, []string, error) {
        var lastErr error
        for k := 0; k < attempts; k++ {
            rows, err := conn.QueryContext(ctx, q, args...)
            if err != nil {
                lastErr = err
                if lamDbIsTransient(err) && k < attempts-1 {
                    if waitErr := lamDbRetryWait(ctx, time.Duration(retryBaseMs<<k) * time.Millisecond); waitErr != nil {
                        lastErr = waitErr
                        break
                    }
                    continue
                }
                break
            }
            out, cols, err := lamDbReadRows(rows, limit)
            if err != nil {
                lastErr = err
                break
            }
            return out, cols, nil
        }
        if lastErr == nil {
            lastErr = fmt.Errorf("query failed without a driver error")
        }
        return nil, nil, lastErr
    }

    func lamDbReadRows(rows *sql.Rows, limit int) ([]map[string]interface{}, []string, error) {
        cols, err := rows.Columns()
        if err != nil {
            rows.Close()
            return nil, nil, err
        }
        out := []map[string]interface{}{}
        // One scan buffer for every row: each row map gets its own values.
        vals := make([]interface{}, len(cols))
        ptrs := make([]interface{}, len(cols))
        for i := range vals {
            ptrs[i] = &vals[i]
        }
        for rows.Next() {
            if err = rows.Scan(ptrs...); err != nil {
                break
            }
            row := make(map[string]interface{}, len(cols))
            for i, c := range cols {
                if b, ok := vals[i].([]byte); ok {
                    row[c] = string(b)
                } else {
                    row[c] = vals[i]
                }
            }
            out = append(out, row)
            if limit > 0 && len(out) >= limit {
                break
            }
        }
        if err == nil {
            err = rows.Err()
        }
        closeErr := rows.Close()
        if err == nil && limit > 0 {
            // Stopping early: closing reads what the driver still has to
            // read of the result, and reports a failure found there.
            err = closeErr
        }
        if err != nil {
            return nil, nil, err
        }
        return out, cols, nil
    }

    // lamDbFirstColumn is the first column (in select order) of the first
    // row, nil without rows.
    func lamDbFirstColumn(rows []map[string]interface{}, cols []string) interface{} {
        if len(rows) == 0 || len(cols) == 0 {
            return nil
        }
        return rows[0][cols[0]]
    }

    // ─── Transient error detection ────────────────────────────
    // A transient error is one that the driver/DB might recover
    // from on retry: closed connection, broken pipe, server
    // restart. We check both ``sql.ErrConnDone`` /
    // ``driver.ErrBadConn`` (via ``database/sql/driver``) plus a
    // string-pattern fallback for vendor-specific messages.
    func lamDbIsTransient(err error) bool {
        if err == nil || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
            return false
        }
        if errors.Is(err, sql.ErrConnDone) {
            return true
        }
        msg := strings.ToLower(err.Error())
        for _, pat := range []string{
            "bad connection",
            "broken pipe",
            "connection refused",
            "connection reset",
            "server has gone away",
            "server closed the connection",
            "timeout",
            "no such host",
            "i/o timeout",
            "tls handshake",
        } {
            if strings.Contains(msg, pat) {
                return true
            }
        }
        return false
    }

    func lamDbRetryWait(ctx context.Context, delay time.Duration) error {
        timer := time.NewTimer(delay)
        defer timer.Stop()
        select {
        case <-ctx.Done():
            return ctx.Err()
        case <-timer.C:
            return ctx.Err()
        }
    }

    // ─── Driver error codes (``Db.sqlState``) ─────────────────
    // Driver failures keep the driver's error as the ``Error.cause``; these
    // helpers find it behind a failed ``Result`` / ``Error`` chain and read
    // its code, never its message.
    func lamDbDriverCause(value interface{}, depth int) error {
        if depth > 32 {
            return nil
        }
        switch typed := value.(type) {
        case nil:
            return nil
        case *Result:
            if typed == nil {
                return nil
            }
            return lamDbDriverCause(typed.Error, depth+1)
        case *Error:
            if typed == nil {
                return nil
            }
            return lamDbDriverCause(typed.Cause, depth+1)
        case error:
            return typed
        }
        return nil
    }

    // lamDbSQLState is the SQLSTATE of a driver error: PostgreSQL's own
    // code, MySQL's error number mapped to the standard class 23 codes where
    // MySQL reports only ``23000``, and SQLite's extended result code mapped
    // the same way (``23505`` unique, ``23503`` foreign key, ``23502`` not
    // null, ``23514`` check, ``23000`` other constraints).
    func lamDbSQLState(value interface{}) string {
        err := lamDbDriverCause(value, 0)
        if err == nil {
            return ""
        }
        var pqErr *lamPq.Error
        if errors.As(err, &pqErr) {
            return string(pqErr.Code)
        }
        var sqliteErr *lamSqlite.Error
        if errors.As(err, &sqliteErr) {
            code := sqliteErr.Code()
            switch code {
            case 2067, 1555, 2579: // SQLITE_CONSTRAINT_UNIQUE, _PRIMARYKEY, _ROWID
                return "23505"
            case 787: // SQLITE_CONSTRAINT_FOREIGNKEY
                return "23503"
            case 1299: // SQLITE_CONSTRAINT_NOTNULL
                return "23502"
            case 275: // SQLITE_CONSTRAINT_CHECK
                return "23514"
            }
            if code&0xff == 19 { // SQLITE_CONSTRAINT and its other extended codes
                return "23000"
            }
            return ""
        }
        var mysqlErr *lamMysql.MySQLError
        if errors.As(err, &mysqlErr) {
            switch mysqlErr.Number {
            case 1062, 1169, 1586: // ER_DUP_ENTRY, ER_DUP_UNIQUE, ER_DUP_ENTRY_WITH_KEY_NAME
                return "23505"
            case 1216, 1217, 1451, 1452, 1701: // foreign key failures
                return "23503"
            case 1048, 1364: // ER_BAD_NULL_ERROR, ER_NO_DEFAULT_FOR_FIELD
                return "23502"
            case 3819: // ER_CHECK_CONSTRAINT_VIOLATED
                return "23514"
            }
            state := string(mysqlErr.SQLState[:])
            if strings.Trim(state, "\x00") == "" {
                return ""
            }
            return state
        }
        return ""
    }

    // lamDbDecodeJSONColumns replaces the ``jsonColumns`` of every row by
    // native json values (a missing column or NULL becomes JSON null), in
    // the order the columns are listed. It returns the failure message and
    // its cause, or an empty message when every value decoded.
    func lamDbDecodeJSONColumns(rows []map[string]interface{}, jsonColumns []string) (string, error) {
        seen := map[string]bool{}
        columns := []string{}
        for _, column := range jsonColumns {
            if !seen[column] {
                seen[column] = true
                columns = append(columns, column)
            }
        }
        for _, row := range rows {
            for _, column := range columns {
                raw, ok := row[column]
                if !ok || raw == nil {
                    parsed, err := lamJSONFrom(nil)
                    if err != nil {
                        return err.Error(), err
                    }
                    row[column] = parsed
                    continue
                }
                var text string
                switch value := raw.(type) {
                case []byte:
                    text = string(value)
                case string:
                    text = value
                case LamJSON:
                    continue
                default:
                    parsed, err := lamJSONFrom(value)
                    if err != nil {
                        return err.Error(), err
                    }
                    row[column] = parsed
                    continue
                }
                parsed, err := lamJSONParse(text)
                if err != nil {
                    return fmt.Sprintf("column %s contains invalid JSON: %v", column, err), nil
                }
                row[column] = parsed
            }
        }
        return "", nil
    }

    // lamDbScalarJSON reads a scalar column value as native json: text and
    // bytes are parsed, other driver values converted.
    func lamDbScalarJSON(raw interface{}) (LamJSON, error) {
        switch typed := raw.(type) {
        case []byte:
            return lamJSONParse(string(typed))
        case string:
            return lamJSONParse(typed)
        case LamJSON:
            return typed, nil
        }
        return lamJSONFrom(raw)
    }
}

interface DbObserver {
    #- ``failure`` is the stable Error.kind (or empty on success), never
       a driver message or bound parameters. -#
    func start(ctx: Context, statement: str) -> any
    func finish(ctx: Context, token: any, failure: str)
}

class DbObservation {
    func init(self, observer: DbObserver, token: any) {
        self.observer: DbObserver = observer
        self.token: any = token
    }
}

#- The query surface shared by a ``Db`` (the pool or a ``withContext``
   view) and a ``Tx``: the type services take, so the same code runs inside
   or outside a transaction. ``Db.atomic(conn, fn)`` runs ``fn`` in a
   transaction on a ``Db`` and in a savepoint on a ``Tx``; ``pool()`` is
   the owning pool, for libraries that need a ``Db``. -#
interface DbConn {
    func exec(query: str, params: list[any] = []) -> Result[int]
    func query(query: str, params: list[any] = []) -> Result[list[dict[str, any]]]
    func first(query: str, params: list[any] = []) -> Result[dict[str, any]]
    func scalar(query: str, params: list[any] = []) -> Result[any]
    func queryJson(query: str, jsonColumns: list[str], params: list[any] = []) -> Result[list[dict[str, any]]]
    func firstJson(query: str, jsonColumns: list[str], params: list[any] = []) -> Result[dict[str, any]]
    func scalarJson(query: str, params: list[any] = []) -> Result[json]
    func table(name: str) -> QueryBuilder
    func transaction(fn: any) -> Result[bool]
    func pool() -> Db
}

class Db {
    #- Pooled connection handle around a ``*sql.DB``. Goroutine-safe
       (the underlying ``database/sql`` pool is). Expected driver failures
       are returned as structured ``Result`` errors. -#

    func init(self) {
        self.driver: str = ""
        self.dsn: str = ""
        self.handle: any = None      # *sql.DB
        self.maxRetries: int = 3
        self.retryBaseMs: int = 50
        self.context: Context = Context.simple()
        self.observer: DbObserver = None
        self.owner: Db = None         # set only on scoped handles; the pool owns close/observer.
    }

    func setObserver(self, observer: DbObserver) {
        #- Configure observation once on the owning pool, before sharing
           request handles. A nil observer disables observation. -#
        if self.owner != None {
            self.owner.setObserver(observer)
            return
        }
        self.observer = observer
    }

    func withContext(self, ctx: Context) -> Db {
        #- A request-scoped view of the same pool; closing it does not close
           the owning connection. The returned handle may be used concurrently
           with other views. -#
        scoped: Db = Db()
        scoped.driver = self.driver
        scoped.dsn = self.dsn
        scoped.handle = self.handle
        scoped.maxRetries = self.maxRetries
        scoped.retryBaseMs = self.retryBaseMs
        scoped.context = ctx
        if self.owner != None {
            scoped.owner = self.owner
        } else {
            scoped.owner = self
        }
        return scoped
    }

    func pool(self) -> Db {
        #- The owning pool: this ``Db`` itself, or the pool a ``withContext``
           view was derived from (also through nested views). -#
        if self.owner != None {
            return self.owner
        }
        return self
    }

    func _start(self, statement: str) -> DbObservation {
        source: Db = self
        if self.owner != None {
            source = self.owner
        }
        observer: DbObserver = source.observer
        if observer == None {
            return None
        }
        token: any = observer.start(self.context, statement)
        return DbObservation(observer, token)
    }

    func _finish(self, observation: DbObservation, result: Result) {
        if observation == None {
            return
        }
        observer: DbObserver = observation.observer
        if observer != None {
            failure: str = ""
            if not result.ok() {
                error: Error = result.error
                failure = error.kind
            }
            observer.finish(self.context, observation.token, failure)
        }
    }

    static func textArray(values: list[str]) -> str {
        #- A PostgreSQL array literal for a parameter: ``["a", "b c"]`` ->
           ``{"a","b c"}`` (every element quoted, ``"`` and ``\`` escaped).
           Pass it as ``?::text[]``. -#
        out: str = ""
        go! {
            var sb strings.Builder
            size := 2
            for _, value := range values {
                size += len(value) + 3
            }
            sb.Grow(size)
            sb.WriteByte('{')
            for i, value := range values {
                if i > 0 {
                    sb.WriteByte(',')
                }
                sb.WriteByte('"')
                lamDbTextArrayEscaper.WriteString(&sb, value)
                sb.WriteByte('"')
            }
            sb.WriteByte('}')
            out = sb.String()
        }
        return out
    }

    static func parseTextArray(text: str) -> Result[list[str]] {
        #- The elements of a PostgreSQL array literal (``{a,"b c"}``);
           unquoted ``NULL`` elements are dropped. Text that is not an array
           literal is a ``DbArrayError``. -#
        out: list[str] = []
        failure: str = ""
        go! {
            values, nulls, err := lamDbParseTextArray(text)
            if err != nil {
                failure = err.Error()
            } else {
                for i, item := range values {
                    if !nulls[i] {
                        out = append(out, item)
                    }
                }
            }
        }
        if failure != "" {
            return Result.Err(Error("DbArrayError", failure))
        }
        return Result.Ok(out)
    }

    static func sqlState(err: any) -> str {
        #- The SQLSTATE code of a database failure — a failed ``Result``, its
           ``Error`` or a driver error — read from the driver's error code
           (never its message): PostgreSQL's code as it is (``"23505"``,
           ``"40001"``...); MySQL and SQLite constraint failures mapped to
           ``"23505"`` (unique / primary key), ``"23503"`` (foreign key),
           ``"23502"`` (not null), ``"23514"`` (check) or ``"23000"``, other
           MySQL errors their own SQLSTATE. ``""`` when there is no driver
           error (a success, a connection that was never made, a value that
           is not an error). -#
        out: str = ""
        go! {
            out = lamDbSQLState(err)
        }
        return out
    }

    static func isUniqueViolation(err: any) -> bool {
        #- True when ``err`` (a failed ``Result``, its ``Error`` or a driver
           error) is a unique or primary-key constraint violation (SQLSTATE
           ``23505``): ``if Db.isUniqueViolation(inserted) { ... }``. -#
        return Db.sqlState(err) == "23505"
    }

    static func isForeignKeyViolation(err: any) -> bool {
        #- True when ``err`` is a foreign-key constraint violation (SQLSTATE
           ``23503``; SQLite reports them only with ``PRAGMA foreign_keys =
           ON``). -#
        return Db.sqlState(err) == "23503"
    }

    static func connect(driver: str, dsn: str) -> Result[Db] {
        #- Open and verify a pooled database connection. Driver resolution,
           open, and ping failures are returned as ``DbConnectError``. -#
        go! {
            d := lamDbResolveDriver(driver)
            handle, err := sql.Open(d, dsn)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbConnectError", err.Error(), err))
            }
            handle.SetMaxOpenConns(25)
            handle.SetMaxIdleConns(5)
            handle.SetConnMaxIdleTime(5 * time.Minute)
            handle.SetConnMaxLifetime(30 * time.Minute)
            if err := handle.Ping(); err != nil {
                handle.Close()
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbConnectError", err.Error(), err))
            }
            db := &Db{Driver: d, Dsn: dsn, Handle: handle, MaxRetries: 3, RetryBaseMs: 50, Context: lamContextCreate(context.Background(), &lamContextValueLayer{})}
            return LAMMERGEIER.Result.Ok(db)
        }
    }

    func setPool(self, maxOpen: int, maxIdle: int, idleSec: int, lifetimeSec: int) -> Result[bool] {
        #- Tune the underlying connection pool. ``maxOpen`` caps the
           number of concurrent connections, ``maxIdle`` how many to
           keep warm, ``idleSec``/``lifetimeSec`` recycle stale
           connections. Passing ``0`` for any value uses the Go
           default. -#
        go! {
            handle, ok := self.Handle.(*sql.DB)
            if !ok || handle == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbConfigError", "database is not connected", nil))
            }
            handle.SetMaxOpenConns(maxOpen)
            handle.SetMaxIdleConns(maxIdle)
            if idleSec > 0 {
                handle.SetConnMaxIdleTime(time.Duration(idleSec) * time.Second)
            }
            if lifetimeSec > 0 {
                handle.SetConnMaxLifetime(time.Duration(lifetimeSec) * time.Second)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func setRetries(self, maxRetries: int, baseMs: int) {
        #- Configure transient-error retry behaviour. ``maxRetries`` is
           the number of *retries* (not total attempts); ``baseMs`` is
           the starting backoff window which doubles on every
           subsequent retry. Negative values are clamped to zero. -#
        if maxRetries < 0 {
            maxRetries = 0
        }
        if baseMs < 0 {
            baseMs = 0
        }
        self.maxRetries = maxRetries
        self.retryBaseMs = baseMs
    }

    func close(self) -> Result[bool] {
        if self.owner != None {
            return Result.Err(Error("DbCloseError", "scoped handle cannot close the pool"))
        }
        go! {
            h, ok := self.Handle.(*sql.DB)
            if !ok || h == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbCloseError", "database is not connected", nil))
            }
            if err := h.Close(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbCloseError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func ping(self) -> Result[bool] {
        go! {
            h, ok := self.Handle.(*sql.DB)
            if !ok || h == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbPingError", "database is not connected", nil))
            }
            if err := h.Ping(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbPingError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func driverName(self) -> str {
        return self.driver
    }

    func raw(self) -> any {
        #- Escape hatch — returns the underlying ``*sql.DB`` for
           scenarios the wrapper doesn't cover (savepoints, listen/
           notify, copy-from, etc.). -#
        return self.handle
    }

    # ── Raw SQL ────────────────────────────────────────────────
    func exec(self, query: str, params: list[any] = []) -> Result[int] {
        observation: DbObservation = self._start(query)
        result: Result[int] = self._exec(query, params)
        self._finish(observation, result)
        return result
    }

    func _exec(self, query: str, params: list[any]) -> Result[int] {
        #- Execute an INSERT / UPDATE / DELETE / DDL statement and return
           the affected-row count. Transient failures are retried; the final
           driver failure is returned as ``DbExecError``. -#
        go! {
            handle, ok := self.Handle.(*sql.DB)
            if !ok || handle == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbExecError", "database is not connected", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            // database/sql copies the arguments; ``params`` is passed as is.
            args := params
            attempts := self.MaxRetries + 1
            ctx := lamDbContext(self.Context)
            var lastErr error
            var affected int64
            for k := 0; k < attempts; k++ {
                res, err := handle.ExecContext(ctx, q, args...)
                if err == nil {
                    affected, err = res.RowsAffected()
                    if err == nil {
                        lastErr = nil
                        break
                    }
                }
                lastErr = err
                if !lamDbIsTransient(err) || k == attempts-1 { break }
                if waitErr := lamDbRetryWait(ctx, time.Duration(self.RetryBaseMs<<k) * time.Millisecond); waitErr != nil {
                    lastErr = waitErr
                    break
                }
            }
            if lastErr != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbExecError", lastErr.Error(), lastErr))
            }
            return LAMMERGEIER.Result.Ok(int(affected))
        }
    }

    func query(self, query: str, params: list[any] = []) -> Result[list[dict[str, any]]] {
        observation: DbObservation = self._start(query)
        result: Result[list[dict[str, any]]] = self._query(query, params)
        self._finish(observation, result)
        return result
    }

    func _query(self, query: str, params: list[any], limit: int = 0) -> Result[list[dict[str, any]]] {
        #- Run a SELECT and return its rows (at most ``limit`` when it is
           not 0) as dictionaries keyed by column name. Query, metadata,
           scan, iteration, and connection failures are returned as
           ``DbQueryError``. -#
        go! {
            handle, ok := self.Handle.(*sql.DB)
            if !ok || handle == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", "database is not connected", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            out, _, err := lamDbQuery(lamDbContext(self.Context), handle, q, params, self.MaxRetries+1, self.RetryBaseMs, limit)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    func _scalar(self, query: str, params: list[any]) -> Result[any] {
        go! {
            handle, ok := self.Handle.(*sql.DB)
            if !ok || handle == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", "database is not connected", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            out, cols, err := lamDbQuery(lamDbContext(self.Context), handle, q, params, self.MaxRetries+1, self.RetryBaseMs, 1)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(lamDbFirstColumn(out, cols))
        }
    }

    func queryJson(self, query: str, jsonColumns: list[str], params: list[any] = []) -> Result[list[dict[str, any]]] {
        #- ``query`` with the ``jsonColumns`` of every row read as native
           ``json`` (NULL is JSON null); invalid JSON is a ``DbJsonError``. -#
        rows: list[dict[str, any]] = self.query(query, params)?
        return Db._jsonRows(rows, jsonColumns)
    }

    func firstJson(self, query: str, jsonColumns: list[str], params: list[any] = []) -> Result[dict[str, any]] {
        #- The first row of ``queryJson`` (``{}`` if no rows were returned);
           like ``first``, only that row is read and decoded. -#
        rows: list[dict[str, any]] = self._firstRows(query, params)?
        rows = Db._jsonRows(rows, jsonColumns)?
        return Result.Ok(Db._firstRow(rows))
    }

    func scalarJson(self, query: str, params: list[any] = []) -> Result[json] {
        #- ``scalar`` read as native ``json``; invalid JSON is a
           ``DbJsonError``. -#
        raw: any = self.scalar(query, params)?
        return Db._jsonValue(raw)
    }

    func first(self, query: str, params: list[any] = []) -> Result[dict[str, any]] {
        #- Run a SELECT and return only the first row (``{}`` if no rows
           were returned); the rest of the result set is not read. Query
           failures remain visible as errors. -#
        rows: list[dict[str, any]] = self._firstRows(query, params)?
        return Result.Ok(Db._firstRow(rows))
    }

    func _firstRows(self, query: str, params: list[any]) -> Result[list[dict[str, any]]] {
        observation: DbObservation = self._start(query)
        result: Result[list[dict[str, any]]] = self._query(query, params, 1)
        self._finish(observation, result)
        return result
    }

    func scalar(self, query: str, params: list[any] = []) -> Result[any] {
        #- Run a SELECT and return the first column (in select order) of
           the first row; the rest of the result set is not read. An empty
           result set is ``Ok(None)``; query failures are errors. -#
        observation: DbObservation = self._start(query)
        result: Result[any] = self._scalar(query, params)
        self._finish(observation, result)
        return result
    }

    # Shared by ``Db`` and ``Tx`` so both read rows the same way.
    static func _firstRow(rows: list[dict[str, any]]) -> dict[str, any] {
        if len(rows) == 0 {
            empty: dict[str, any] = {}
            return empty
        }
        return rows[0]
    }

    static func _jsonRows(rows: list[dict[str, any]], jsonColumns: list[str]) -> Result[list[dict[str, any]]] {
        go! {
            if message, cause := lamDbDecodeJSONColumns(rows, jsonColumns); message != "" {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbJsonError", message, cause))
            }
        }
        return Result.Ok(rows)
    }

    static func _jsonValue(raw: any) -> Result[json] {
        go! {
            value, err := lamDbScalarJSON(raw)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbJsonError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    # ── Transactions ───────────────────────────────────────────
    static func atomic[T](conn: DbConn, fn: func(Tx) -> Result[T]) -> Result[T] {
        #- Run ``fn`` as one unit of work on ``conn`` and return its
           ``Result``: on a ``Db`` in a new transaction (BEGIN ... COMMIT), on
           a ``Tx`` in a savepoint of it (``tx.transaction``). An ``Ok``
           commits (releases the savepoint); an ``Err`` rolls back (to the
           savepoint) and is returned unchanged; a throw rolls back and is
           re-thrown. A begin, commit or release failure is returned as a
           ``DbTransactionError`` (``fn`` does not run when begin fails). -#
        ran: bool = false
        outcome: Result[T] = Result.Err(Error("DbTransactionError", "the transaction callback did not run"))
        func step(tx: Tx) -> Result[bool] {
            ran = true
            outcome = fn(tx)
            if not outcome.ok() {
                return Result.Err(outcome.error)
            }
            return Result.Ok(true)
        }
        finished: Result[bool] = conn.transaction(step)
        if ran and not outcome.ok() {
            return outcome
        }
        if not finished.ok() {
            return Result.Err(finished.error)
        }
        return outcome
    }

    func transaction(self, fn: any) -> Result[bool] {
        #- Run ``fn(tx: Tx)`` in a transaction. ``Ok(true)`` means the
           transaction committed and ``Ok(false)`` means user code explicitly
           rolled it back. Begin and commit failures are returned as errors.
           Unexpected callback panics are rolled back and re-raised. For the
           callback's own typed ``Result`` use ``Db.atomic(db, fn)``. -#
        go! {
            started := self.Begin()
            if !started.Ok() {
                return LAMMERGEIER.Result.Err(started.Error)
            }
            txObj := started.Value.(*Tx)
            defer func() {
                if r := recover(); r != nil {
                    if !txObj.RolledBack && !txObj.Committed { _ = txObj.Rollback() }
                    panic(r)
                }
            }()
            switch cb := fn.(type) {
            case func(*Tx) *Result:
                callbackResult := cb(txObj)
                if callbackResult == nil {
                    if !txObj.RolledBack && !txObj.Committed { _ = txObj.Rollback() }
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "callback returned no Result", nil))
                }
                if !callbackResult.Ok() {
                    if !txObj.RolledBack && !txObj.Committed { _ = txObj.Rollback() }
                    return LAMMERGEIER.Result.Err(callbackResult.Error)
                }
            case func(*Tx):
                cb(txObj)
            default:
                _ = txObj.Rollback()
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "callback must accept a Tx", nil))
            }
            if txObj.RolledBack {
                return LAMMERGEIER.Result.Ok(false)
            }
            if txObj.Committed {
                return LAMMERGEIER.Result.Ok(true)
            }
            return txObj.Commit()
        }
    }

    func begin(self) -> Result[Tx] {
        observation: DbObservation = self._start("BEGIN")
        result: Result[Tx] = self._begin()
        self._finish(observation, result)
        return result
    }

    func _begin(self) -> Result[Tx] {
        #- Open an explicit transaction. The caller owns the lifecycle and
           must call ``commit`` or ``rollback`` exactly once. -#
        go! {
            handle, ok := self.Handle.(*sql.DB)
            if !ok || handle == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "database is not connected", nil))
            }
            tx, err := handle.BeginTx(lamDbContext(self.Context), nil)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", err.Error(), err))
            }
            source := s
            if s.Owner != nil { source = s.Owner }
            txObj := &Tx{Conn: tx, Driver: self.Driver, RolledBack: false, Committed: false, Context: self.Context, Observer: source.Observer, Db: s}
            return LAMMERGEIER.Result.Ok(txObj)
        }
    }

    # ── Knex-style query builder ───────────────────────────────
    func table(self, name: str) -> QueryBuilder {
        #- Open a fluent query builder targeting ``name``. Chain
           ``select``/``where``/``orderBy``/``limit``/``offset`` and
           terminate with ``get``/``first``/``count``/``insert``/
           ``update``/``delete``. -#
        qb: QueryBuilder = QueryBuilder()
        qb.db = self
        qb.driver = self.driver
        qb.tableName = name
        return qb
    }
}

class Row {
    #- Typed reads of a ``dict[str, any]`` row. A missing column, NULL or a
       value that does not convert gives ``fallback`` (``Row.int``,
       ``Row.float``, ``Row.str``, ``Row.bool``, ``Row.unix``) or ``None``
       (``Row.optional*``, ``Row.time``). Numbers convert from any integer
       or float kind, numeric text (NUMERIC arrives as text: ``"123.45"``)
       and big numbers; booleans from ``bool``, numbers and ``t`` / ``true``
       / ``yes`` / ``on`` / ``1`` (and their negatives); times from
       ``time.Time``, Unix seconds and timestamp texts. -#

    static func int(row: dict[str, any], key: str, fallback: int = 0) -> int {
        #- The column as an ``int`` (floats and numeric text are truncated,
           a time is its Unix seconds). -#
        value: any = row[key] if key in row else None
        out: int = fallback
        go! {
            if n, ok := lamDbRowInt(value); ok {
                out = n
            }
        }
        return out
    }

    static func float(row: dict[str, any], key: str, fallback: float = 0.0) -> float {
        #- The column as a ``float`` (NUMERIC text such as ``"123.45"``). -#
        value: any = row[key] if key in row else None
        out: float = fallback
        go! {
            if f, ok := lamDbRowFloat(value); ok {
                out = f
            }
        }
        return out
    }

    static func str(row: dict[str, any], key: str, fallback: str = "") -> str {
        #- The column as text: text as it is, numbers in decimal (floats
           shortest, no exponent), booleans ``true`` / ``false``, times in
           RFC 3339 UTC with fractional seconds. -#
        value: any = row[key] if key in row else None
        out: str = fallback
        go! {
            if text, ok := lamDbRowStr(value); ok {
                out = text
            }
        }
        return out
    }

    static func bool(row: dict[str, any], key: str, fallback: bool = false) -> bool {
        #- The column as a ``bool`` (``t`` / ``f`` texts, ``0`` / ``1``). -#
        value: any = row[key] if key in row else None
        out: bool = fallback
        go! {
            if flag, ok := lamDbRowBool(value); ok {
                out = flag
            }
        }
        return out
    }

    static func unix(row: dict[str, any], key: str, fallback: int = 0) -> int {
        #- A date/time column as Unix seconds (timestamp texts are parsed;
           texts without an offset are UTC). -#
        value: any = row[key] if key in row else None
        out: int = fallback
        go! {
            if when, ok := lamDbRowTime(value); ok {
                out = int(when.Unix())
            }
        }
        return out
    }

    static func time(row: dict[str, any], key: str) -> optional[DateTime] {
        #- A date/time column as a ``DateTime`` in UTC (``inLocation`` for
           another zone), or ``None`` for NULL, a missing column or a value
           that is not a time. -#
        value: any = row[key] if key in row else None
        found: bool = false
        nanos: int = 0
        go! {
            if when, ok := lamDbRowTime(value); ok && when.Year() > 1677 && when.Year() < 2262 {
                found = true
                nanos = int(when.UnixNano())
            }
        }
        if not found {
            return None
        }
        return DateTime(nanos, "UTC")
    }

    static func timeText(row: dict[str, any], key: str, layout: str = "2006-01-02T15:04:05Z07:00", location: str = "UTC", fallback: str = "") -> str {
        #- A date/time column written with a Go ``layout`` in ``location``:
           by default RFC 3339 in whole seconds, UTC (``2026-11-03T19:05:00Z``,
           where ``Row.str`` keeps the fractional seconds). Timestamp texts
           are parsed as for ``Row.unix``; NULL, a missing column or a value
           that is not a time is ``fallback``. An unknown ``location`` throws
           a ``LocationError``. -#
        value: any = row[key] if key in row else None
        out: str = fallback
        go! {
            loc, err := lamDateTimeLocation(location)
            if err != nil {
                panic(fmt.Sprintf("LocationError: Row.timeText %s: %v", location, err))
            }
            if when, ok := lamDbRowTime(value); ok {
                out = when.In(loc).Format(layout)
            }
        }
        return out
    }

    static func optionalStr(row: dict[str, any], key: str) -> optional[str] {
        #- ``Row.str``, or ``None`` for NULL or a missing column. -#
        if Row.isNull(row, key) {
            return None
        }
        return Row.str(row, key)
    }

    static func optionalInt(row: dict[str, any], key: str) -> optional[int] {
        #- ``Row.int``, or ``None`` for NULL, a missing column or a value
           that is not a number. -#
        value: any = row[key] if key in row else None
        found: bool = false
        out: int = 0
        go! {
            out, found = lamDbRowInt(value)
        }
        if not found {
            return None
        }
        return out
    }

    static func optionalFloat(row: dict[str, any], key: str) -> optional[float] {
        #- ``Row.float``, or ``None`` for NULL, a missing column or a value
           that is not a number. -#
        value: any = row[key] if key in row else None
        found: bool = false
        out: float = 0.0
        go! {
            out, found = lamDbRowFloat(value)
        }
        if not found {
            return None
        }
        return out
    }

    static func optionalBool(row: dict[str, any], key: str) -> optional[bool] {
        #- ``Row.bool``, or ``None`` for NULL, a missing column or a value
           that is not a boolean. -#
        value: any = row[key] if key in row else None
        found: bool = false
        out: bool = false
        go! {
            out, found = lamDbRowBool(value)
        }
        if not found {
            return None
        }
        return out
    }

    static func isNull(row: dict[str, any], key: str) -> bool {
        #- True for NULL and for a column the row does not have. -#
        if key not in row {
            return true
        }
        return row[key] == None
    }

    static func strList(row: dict[str, any], key: str) -> list[str] {
        #- A PostgreSQL array column (``text[]``, ``varchar[]``, ``uuid[]``
           arrive as ``{a,"b c",NULL}``) as a list; NULL elements are
           dropped, a NULL or malformed value is ``[]``. -#
        value: any = row[key] if key in row else None
        out: list[str] = []
        go! {
            out = lamDbRowStrList(value)
        }
        return out
    }

    static func intList(row: dict[str, any], key: str) -> list[int] {
        #- A PostgreSQL ``int[]`` / ``bigint[]`` column as a list; NULL and
           non-numeric elements are dropped. -#
        value: any = row[key] if key in row else None
        out: list[int] = []
        go! {
            for _, item := range lamDbRowStrList(value) {
                if n, ok := lamDbRowInt(item); ok {
                    out = append(out, n)
                }
            }
        }
        return out
    }
}

class Where {
    #- A WHERE clause for hand-written SQL, built condition by condition with
       its ``?`` parameters in order:

           w: Where = Where().add("shop_id = ?", [shopId]).addIf(onlyActive, "disabled = ?", [false])
           _ = w.ilikeAny(["title", "brand"], search)
           rows = db.query(f"SELECT * FROM products {w.sql()} LIMIT ?", w.paramsWith([20]))?

       Conditions are joined with ``AND``, each in parentheses, so a
       condition holding ``OR`` keeps its meaning, also when more SQL follows
       (``w.sql() + " AND visible"``). A ``Where`` with no conditions renders
       as ``""``. Column names and SQL
       fragments are inserted as written: never build them from user input;
       values always go through parameters. -#

    func init(self) {
        self.clauses: list[str] = []
        self.values: list[any] = []
    }

    func add(self, clause: str, params: list[any] = []) -> Where {
        #- Adds ``clause`` (with its ``?`` placeholders) and its ``params``. -#
        self.clauses.append(clause)
        for value in params {
            self.values.append(value)
        }
        return self
    }

    func addIf(self, condition: bool, clause: str, params: list[any] = []) -> Where {
        #- ``add`` when ``condition`` is true (optional filters). -#
        if condition {
            self.add(clause, params)
        }
        return self
    }

    func addIn(self, column: str, values: list[any]) -> Where {
        #- ``column IN (?, ?, ...)`` over ``values``; an empty list matches
           no row (``1 = 0``). -#
        if len(values) == 0 {
            return self.add("1 = 0")
        }
        marks: list[str] = ["?" for _ in values]
        return self.add(f"{column} IN ({', '.join(marks)})", values)
    }

    func ilikeAny(self, columns: list[str], text: str, match: str = "contains") -> Where {
        #- PostgreSQL: ``CAST(a AS TEXT) ILIKE ? ESCAPE '!' OR ...`` over
           ``columns`` for ``text`` (trimmed; nothing is added when it is
           empty): the rows where any column contains it, case-insensitively.
           ``%`` and ``_`` typed by the user match themselves
           (``Where.likePattern``); ``match`` is ``"contains"``,
           ``"prefix"``, ``"suffix"`` or ``"exact"``. -#
        return self._likeAny(columns, text, match, "CAST({column} AS TEXT) ILIKE ? ESCAPE '!'")
    }

    func likeAny(self, columns: list[str], text: str, match: str = "contains") -> Where {
        #- ``a LIKE ? ESCAPE '!' OR ...``: ``ilikeAny`` for every driver (case
           sensitivity is the database's: SQLite and MySQL's default
           collations ignore ASCII case, PostgreSQL does not). -#
        return self._likeAny(columns, text, match, "{column} LIKE ? ESCAPE '!'")
    }

    func _likeAny(self, columns: list[str], text: str, match: str, shape: str) -> Where {
        needle: str = text.trim()
        if needle == "" or len(columns) == 0 {
            return self
        }
        pattern: str = Where.likePattern(needle, match, "!")
        parts: list[str] = [shape.replace("{column}", column) for column in columns]
        values: list[any] = [pattern for _ in columns]
        return self.add(" OR ".join(parts), values)
    }

    func sql(self, prefix: str = "WHERE") -> str {
        #- ``"WHERE (a = ?) AND (b = ?)"`` (``prefix`` first, ``""`` leaves it
           out: ``"AND " + w.sql("")``); ``""`` when there is no condition. -#
        if len(self.clauses) == 0 {
            return ""
        }
        body: str = " AND ".join([f"({clause})" for clause in self.clauses])
        if prefix == "" {
            return body
        }
        return f"{prefix} {body}"
    }

    func params(self) -> list[any] {
        #- The parameters of the conditions, in order (a copy). -#
        return [value for value in self.values]
    }

    func paramsWith(self, extra: list[any]) -> list[any] {
        #- The parameters followed by ``extra`` (``LIMIT ? OFFSET ?``). -#
        out: list[any] = self.params()
        for value in extra {
            out.append(value)
        }
        return out
    }

    func isEmpty(self) -> bool {
        return len(self.clauses) == 0
    }

    static func likePattern(text: str, match: str = "contains", escape: str = "\\") -> str {
        #- A LIKE / ILIKE pattern matching ``text`` literally: ``escape``,
           ``%`` and ``_`` in ``text`` are escaped with ``escape`` (the
           default backslash is PostgreSQL's and MySQL's default escape
           character; SQLite needs an explicit ``ESCAPE '\'``). ``match``:
           ``"contains"`` (``%text%``, the default), ``"prefix"``
           (``text%``), ``"suffix"`` (``%text``) or ``"exact"``. Another
           ``match``, or an ``escape`` that is not one ASCII character other
           than ``%`` and ``_``, throws a ``ValueError``. -#
        if len(escape) != 1 or escape == "%" or escape == "_" {
            throw ValueError(f"Where.likePattern: escape must be one character other than % and _, got {escape}")
        }
        escaped: str = text.replace(escape, escape + escape).replace("%", escape + "%").replace("_", escape + "_")
        if match == "contains" {
            return f"%{escaped}%"
        }
        if match == "prefix" {
            return f"{escaped}%"
        }
        if match == "suffix" {
            return f"%{escaped}"
        }
        if match == "exact" {
            return escaped
        }
        throw ValueError(f"Where.likePattern: match must be contains, prefix, suffix or exact, got {match}")
    }
}

class Tx {
    #- Active transaction handle yielded by ``Db.begin`` and
       ``Db.transaction``. ``tx.transaction(fn)`` / ``Db.atomic(tx, fn)``
       open a nested level (a savepoint) on the same handle; while one is
       open, ``commit`` / ``rollback`` end that level only. Not safe for
       concurrent use. -#

    func init(self) {
        self.conn: any = None       # *sql.Tx
        self.driver: str = ""
        self.rolledBack: bool = false
        self.committed: bool = false
        self.context: Context = Context.simple()
        self.observer: DbObserver = None
        self.db: Db = None                # the handle that began it (``pool()``).
        self.nested: list[str] = []       # savepoint names of the open nested levels.
        self.nestedEnd: list[str] = []    # per level: "", "commit" or "rollback".
    }

    func pool(self) -> Db {
        #- The owning pool of the ``Db`` that began this transaction
           (``None`` for a ``Tx`` not created by ``begin``). -#
        if self.db == None {
            return None
        }
        return self.db.pool()
    }

    func depth(self) -> int {
        #- The number of open nested levels: ``0`` in the transaction itself,
           ``1`` inside a ``tx.transaction`` / ``Db.atomic(tx, ...)`` callback,
           and so on. -#
        return len(self.nested)
    }

    func transaction(self, fn: any) -> Result[bool] {
        #- ``Db.transaction`` nested in this transaction: run ``fn(tx)`` with
           this same ``Tx`` inside ``SAVEPOINT lam_sp_<depth>``. ``Ok`` releases
           the savepoint (``Ok(true)``); ``Err`` rolls back to it, releases it
           and is returned; a throw does the same and is re-thrown. Inside
           ``fn``, ``commit()`` releases and ``rollback()`` rolls back the
           savepoint only (then ``Ok(false)`` is returned), never the outer
           transaction. The savepoint statements are observed with the
           transaction's context; a failing SAVEPOINT is returned without
           running ``fn``. -#
        name: str = f"lam_sp_{len(self.nested) + 1}"
        _ = self.savepoint(name)?
        self.nested.append(name)
        self.nestedEnd.append("")
        go! {
            level := len(s.Nested) - 1
            pop := func() {
                s.Nested = s.Nested[:level]
                s.NestedEnd = s.NestedEnd[:level]
            }
            undo := func() {
                if s.NestedEnd[level] == "" {
                    if rewound := s.RollbackTo(name); rewound.Ok() {
                        _ = s.ReleaseSavepoint(name)
                    }
                }
                pop()
            }
            defer func() {
                if r := recover(); r != nil {
                    if len(s.Nested) > level {
                        undo()
                    }
                    panic(r)
                }
            }()
            switch cb := fn.(type) {
            case func(*Tx) *Result:
                callbackResult := cb(s)
                if callbackResult == nil {
                    undo()
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "callback returned no Result", nil))
                }
                if !callbackResult.Ok() {
                    undo()
                    return LAMMERGEIER.Result.Err(callbackResult.Error)
                }
            case func(*Tx):
                cb(s)
            default:
                undo()
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "callback must accept a Tx", nil))
            }
            ended := s.NestedEnd[level]
            pop()
            if ended == "rollback" {
                return LAMMERGEIER.Result.Ok(false)
            }
            if ended == "commit" {
                return LAMMERGEIER.Result.Ok(true)
            }
            return s.ReleaseSavepoint(name)
        }
    }

    func _endLevel(self, keep: bool) -> Result[bool] {
        # ``commit`` / ``rollback`` while a nested level is open.
        level: int = len(self.nested) - 1
        if self.nestedEnd[level] != "" {
            return Result.Err(Error("DbTransactionError", "the nested transaction has already ended"))
        }
        name: str = self.nested[level]
        if keep {
            _ = self.releaseSavepoint(name)?
            self.nestedEnd[level] = "commit"
            return Result.Ok(true)
        }
        _ = self.rollbackTo(name)?
        _ = self.releaseSavepoint(name)?
        self.nestedEnd[level] = "rollback"
        return Result.Ok(true)
    }

    func _start(self, statement: str) -> DbObservation {
        observer: DbObserver = self.observer
        if observer == None {
            return None
        }
        token: any = observer.start(self.context, statement)
        return DbObservation(observer, token)
    }

    func _finish(self, observation: DbObservation, result: Result) {
        if observation == None {
            return
        }
        observer: DbObserver = observation.observer
        if observer != None {
            failure: str = ""
            if not result.ok() {
                error: Error = result.error
                failure = error.kind
            }
            observer.finish(self.context, observation.token, failure)
        }
    }

    func exec(self, query: str, params: list[any] = []) -> Result[int] {
        observation: DbObservation = self._start(query)
        result: Result[int] = self._exec(query, params)
        self._finish(observation, result)
        return result
    }

    func _exec(self, query: str, params: list[any]) -> Result[int] {
        go! {
            tx, ok := self.Conn.(*sql.Tx)
            if !ok || tx == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbExecError", "transaction is not active", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            // database/sql copies the arguments; ``params`` is passed as is.
            args := params
            res, err := tx.ExecContext(lamDbContext(self.Context), q, args...)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbExecError", err.Error(), err))
            }
            n, err := res.RowsAffected()
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbExecError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(int(n))
        }
    }

    func query(self, query: str, params: list[any] = []) -> Result[list[dict[str, any]]] {
        observation: DbObservation = self._start(query)
        result: Result[list[dict[str, any]]] = self._query(query, params)
        self._finish(observation, result)
        return result
    }

    func _query(self, query: str, params: list[any], limit: int = 0) -> Result[list[dict[str, any]]] {
        go! {
            tx, ok := self.Conn.(*sql.Tx)
            if !ok || tx == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", "transaction is not active", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            out, _, err := lamDbQuery(lamDbContext(self.Context), tx, q, params, 1, 0, limit)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    func _scalar(self, query: str, params: list[any]) -> Result[any] {
        go! {
            tx, ok := self.Conn.(*sql.Tx)
            if !ok || tx == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", "transaction is not active", nil))
            }
            q := lamDbRewritePlaceholders(query, self.Driver)
            out, cols, err := lamDbQuery(lamDbContext(self.Context), tx, q, params, 1, 0, 1)
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbQueryError", err.Error(), err))
            }
            return LAMMERGEIER.Result.Ok(lamDbFirstColumn(out, cols))
        }
    }

    func _firstRows(self, query: str, params: list[any]) -> Result[list[dict[str, any]]] {
        observation: DbObservation = self._start(query)
        result: Result[list[dict[str, any]]] = self._query(query, params, 1)
        self._finish(observation, result)
        return result
    }

    func first(self, query: str, params: list[any] = []) -> Result[dict[str, any]] {
        #- ``Db.first`` inside the transaction: the first row of
           ``tx.query`` (``{}`` if no rows were returned), observed and run
           with the transaction's context like ``tx.query``. -#
        rows: list[dict[str, any]] = self._firstRows(query, params)?
        return Result.Ok(Db._firstRow(rows))
    }

    func scalar(self, query: str, params: list[any] = []) -> Result[any] {
        #- ``Db.scalar`` inside the transaction: the first column of the
           first row, ``Ok(None)`` for an empty result. -#
        observation: DbObservation = self._start(query)
        result: Result[any] = self._scalar(query, params)
        self._finish(observation, result)
        return result
    }

    func queryJson(self, query: str, jsonColumns: list[str], params: list[any] = []) -> Result[list[dict[str, any]]] {
        #- ``Db.queryJson`` inside the transaction. -#
        rows: list[dict[str, any]] = self.query(query, params)?
        return Db._jsonRows(rows, jsonColumns)
    }

    func firstJson(self, query: str, jsonColumns: list[str], params: list[any] = []) -> Result[dict[str, any]] {
        #- ``Db.firstJson`` inside the transaction. -#
        rows: list[dict[str, any]] = self._firstRows(query, params)?
        rows = Db._jsonRows(rows, jsonColumns)?
        return Result.Ok(Db._firstRow(rows))
    }

    func scalarJson(self, query: str, params: list[any] = []) -> Result[json] {
        #- ``Db.scalarJson`` inside the transaction. -#
        raw: any = self.scalar(query, params)?
        return Db._jsonValue(raw)
    }

    func rollback(self) -> Result[bool] {
        #- Roll the transaction back; inside a nested level (``depth() > 0``)
           roll back to its savepoint and release it instead. -#
        if len(self.nested) > 0 {
            return self._endLevel(false)
        }
        observation: DbObservation = self._start("ROLLBACK")
        result: Result[bool] = self._rollback()
        self._finish(observation, result)
        return result
    }

    func _rollback(self) -> Result[bool] {
        go! {
            tx, ok := self.Conn.(*sql.Tx)
            if !ok || tx == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "transaction is not active", nil))
            }
            if err := tx.Rollback(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", err.Error(), err))
            }
            self.RolledBack = true
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func commit(self) -> Result[bool] {
        #- Commit the transaction; inside a nested level (``depth() > 0``)
           release its savepoint instead. -#
        if len(self.nested) > 0 {
            return self._endLevel(true)
        }
        observation: DbObservation = self._start("COMMIT")
        result: Result[bool] = self._commit()
        self._finish(observation, result)
        return result
    }

    func _commit(self) -> Result[bool] {
        go! {
            tx, ok := self.Conn.(*sql.Tx)
            if !ok || tx == nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", "transaction is not active", nil))
            }
            if err := tx.Commit(); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error("DbTransactionError", err.Error(), err))
            }
            self.Committed = true
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    # ── Savepoints (SQLite, MySQL ≥5.6, Postgres) ──────────────
    func _savepointExec(self, statement: str) -> Result[bool] {
        observation: DbObservation = self._start(statement)
        executed: Result[int] = self._exec(statement, [])
        result: Result[bool] = Result.Ok(true)
        if not executed.ok() {
            error: Error = executed.error
            result = Result.Err(Error("DbTransactionError", error.message, error.cause))
        }
        self._finish(observation, result)
        return result
    }

    func savepoint(self, savepointName: str) -> Result[bool] {
        #- Mark a point inside the transaction that can be rolled
           back to without aborting the whole transaction. ``name``
           must be a SQL identifier; we forward it verbatim. -#
        return self._savepointExec("SAVEPOINT " + savepointName)
    }

    func rollbackTo(self, savepointName: str) -> Result[bool] {
        #- Rewind state to the named savepoint. The transaction
           stays open afterwards — the caller can keep going,
           savepoint again, or commit/rollback normally. -#
        return self._savepointExec("ROLLBACK TO SAVEPOINT " + savepointName)
    }

    func releaseSavepoint(self, savepointName: str) -> Result[bool] {
        #- Drop the named savepoint, locking in everything done
           since it was created. -#
        return self._savepointExec("RELEASE SAVEPOINT " + savepointName)
    }

    func table(self, name: str) -> QueryBuilder {
        #- Fluent builder bound to *this* transaction. Every
           terminal call (``get``, ``insert``, ``update``, …) runs
           through the transaction's connection, so its writes
           are atomic with the rest of the transaction. -#
        qb: QueryBuilder = QueryBuilder()
        qb.tx = self
        qb.tableName = name
        qb.driver = self.driver
        return qb
    }
}

class QueryBuilder {
    #- Fluent SQL builder modelled on knex.js. Each method returns
       ``self`` so chains compose (also across newlines)::

           rows: list[dict[str, any]] = db.table("users")
               .select("id", "name")
               .where("age", ">", 18)
               .orderBy("name")
               .limit(10)
               .get()

       Method semantics:
         * ``select(*cols)``   — defaults to ``*`` if never called.
         * ``where(col, op, val)`` — three-arg form. Two-arg shorthand
           ``where(col, val)`` becomes ``col = val``. Successive calls
           AND together.
         * ``orWhere(col, op, val)`` — OR-joined predicate.
         * ``whereGroup(fn)`` / ``orWhereGroup(fn)`` — nested predicates;
           ``fn`` receives a child QueryBuilder used only for conditions.
         * ``whereIn(col, values)`` / ``whereNotIn`` — list membership.
         * ``whereNull(col)`` / ``whereNotNull(col)``.
         * ``clone()`` — independently mutable copy with the same binding.
         * ``orderBy(col, dir="asc")`` / ``limit(n)`` / ``offset(n)``.
         * ``join(other, on)`` / ``leftJoin`` / ``rightJoin``.
         * ``groupBy(*cols)`` / ``having(col, op, val)``.

       Terminal methods:
         * ``get()``                — list of dicts.
         * ``first()``              — first dict or ``{}``.
         * ``count()``              — integer (uses ``COUNT(*)``).
         * ``insert(record)``       — affected count for one record.
         * ``insertMany(records)``  — affected count for a batch.
         * ``update(record)``       — affected count.
         * ``delete()``             — affected count.
         * ``toSql()``              — preview the assembled SQL +
           parameter list without executing. -#

    func init(self) {
        self.db: Db = None
        self.tx: Tx = None              # set when bound to a transaction.
        self.driver: str = ""           # mirrored from db/tx for placeholder rewriting.
        self.tableName: str = ""
        self.cols: list[str] = []
        self.conds: list[any] = []        # list of [logic, sqlFragment, paramList]
        self.orderClauses: list[str] = []
        self.groupCols: list[str] = []
        self.havingFragment: str = ""
        self.havingParams: list[any] = []
        self.limitN: int = -1
        self.offsetN: int = -1
        self.joins: list[str] = []
        self.distinctOn: bool = false
        self.lockMode: str = ""           # ``""``, ``FOR UPDATE``, ``FOR SHARE``.
        self.returningCols: list[str] = []
    }

    func clone(self) -> QueryBuilder {
        #- Return an independently mutable copy of this builder. Database /
           transaction bindings are retained, while every mutable clause and
           condition-parameter list is copied. -#
        cloned: QueryBuilder = QueryBuilder()
        go! {
            cloned.Db = s.Db
            cloned.Tx = s.Tx
            cloned.Driver = s.Driver
            cloned.TableName = s.TableName
            cloned.Cols = append([]string{}, s.Cols...)
            cloned.Conds = make([]interface{}, 0, len(s.Conds))
            for _, raw := range s.Conds {
                triple, ok := raw.([]interface{})
                if !ok || len(triple) < 3 {
                    cloned.Conds = append(cloned.Conds, raw)
                    continue
                }
                logic, _ := triple[0].(string)
                fragment, _ := triple[1].(string)
                values, _ := triple[2].([]interface{})
                copiedValues := append([]interface{}{}, values...)
                cloned.Conds = append(cloned.Conds, []interface{}{logic, fragment, copiedValues})
            }
            cloned.OrderClauses = append([]string{}, s.OrderClauses...)
            cloned.GroupCols = append([]string{}, s.GroupCols...)
            cloned.HavingFragment = s.HavingFragment
            cloned.HavingParams = append([]interface{}{}, s.HavingParams...)
            cloned.LimitN = s.LimitN
            cloned.OffsetN = s.OffsetN
            cloned.Joins = append([]string{}, s.Joins...)
            cloned.DistinctOn = s.DistinctOn
            cloned.LockMode = s.LockMode
            cloned.ReturningCols = append([]string{}, s.ReturningCols...)
        }
        return cloned
    }

    func select(self, cols: list[any]) -> QueryBuilder {
        #- Add columns to the SELECT list. The list is ``list[any]``
           rather than ``list[str]`` only because Lam list literals
           are erased to ``[]interface{}`` at the call site; values
           are coerced to strings internally. -#
        go! {
            for _, c := range cols {
                if cs, ok := c.(string); ok {
                    s.Cols = append(s.Cols, cs)
                }
            }
        }
        return self
    }

    func where(self, col: str, op: str, val: any) -> QueryBuilder {
        #- ``WHERE col op ?`` with operator and value. Use
           ``whereEq`` when ``op`` is ``=`` to skip the operator
           argument. Successive ``where`` calls are AND-joined. -#
        frag: str = ""
        go! {
            frag = fmt.Sprintf("%s %s ?", col, op)
        }
        params: list[any] = [val]
        self.conds.append(["AND", frag, params])
        return self
    }

    func whereEq(self, col: str, val: any) -> QueryBuilder {
        #- Two-arg shorthand for the common ``WHERE col = ?`` case. -#
        return self.where(col, "=", val)
    }

    func orWhere(self, col: str, op: str, val: any) -> QueryBuilder {
        frag: str = ""
        go! {
            frag = fmt.Sprintf("%s %s ?", col, op)
        }
        params: list[any] = [val]
        self.conds.append(["OR", frag, params])
        return self
    }

    func orWhereEq(self, col: str, val: any) -> QueryBuilder {
        return self.orWhere(col, "=", val)
    }

    func _addWhereGroup(self, logic: str, callback: any) -> QueryBuilder {
        #- Build predicates on an isolated child builder, then append their
           rendered SQL as one parenthesized predicate. Empty groups are a
           no-op. Callbacks may return the child builder (as Lam lambdas do)
           or return nothing. -#
        group: QueryBuilder = QueryBuilder()
        group.driver = self.driver
        go! {
            switch cb := callback.(type) {
            case func(*QueryBuilder) *QueryBuilder:
                _ = cb(group)
            case func(*QueryBuilder):
                cb(group)
            case func(*QueryBuilder) interface{}:
                _ = cb(group)
            default:
                panic(fmt.Sprintf("QueryBuilder predicate group callback must accept a QueryBuilder, got %T", callback))
            }
        }
        if len(group.conds) == 0 {
            return self
        }
        fragment: str = ""
        params: list[any] = []
        go! {
            rendered, values := lamDbRenderConditions(group.Conds)
            if rendered != "" {
                fragment = "(" + rendered + ")"
                params = values
            }
        }
        if fragment != "" {
            self.conds.append([logic, fragment, params])
        }
        return self
    }

    func whereGroup(self, callback: func(QueryBuilder) -> QueryBuilder) -> QueryBuilder {
        #- AND-join a parenthesized predicate group. Groups may contain any
           ``where*`` / ``orWhere*`` predicates, including nested groups. -#
        return self._addWhereGroup("AND", callback)
    }

    func orWhereGroup(self, callback: func(QueryBuilder) -> QueryBuilder) -> QueryBuilder {
        #- OR-join a parenthesized predicate group. If this is the first
           predicate, the leading OR is omitted just like ``orWhere``. -#
        return self._addWhereGroup("OR", callback)
    }

    func whereIn(self, col: str, values: list[any]) -> QueryBuilder {
        n: int = len(values)
        if n == 0 {
            self.conds.append(["AND", "1=0", []])
            return self
        }
        frag: str = ""
        go! {
            placeholders := strings.Repeat("?,", n)
            placeholders = placeholders[:len(placeholders)-1]
            frag = fmt.Sprintf("%s IN (%s)", col, placeholders)
        }
        self.conds.append(["AND", frag, values])
        return self
    }

    func whereNotIn(self, col: str, values: list[any]) -> QueryBuilder {
        n: int = len(values)
        if n == 0 {
            self.conds.append(["AND", "1=1", []])
            return self
        }
        frag: str = ""
        go! {
            placeholders := strings.Repeat("?,", n)
            placeholders = placeholders[:len(placeholders)-1]
            frag = fmt.Sprintf("%s NOT IN (%s)", col, placeholders)
        }
        self.conds.append(["AND", frag, values])
        return self
    }

    func whereNull(self, col: str) -> QueryBuilder {
        frag: str = ""
        go! { frag = fmt.Sprintf("%s IS NULL", col) }
        self.conds.append(["AND", frag, []])
        return self
    }

    func whereNotNull(self, col: str) -> QueryBuilder {
        frag: str = ""
        go! { frag = fmt.Sprintf("%s IS NOT NULL", col) }
        self.conds.append(["AND", frag, []])
        return self
    }

    func whereBetween(self, col: str, low: any, high: any) -> QueryBuilder {
        #- ``WHERE col BETWEEN ? AND ?``. Successive ``where*`` calls
           AND-join. Pair with ``orWhereBetween`` for OR logic. -#
        frag: str = ""
        go! { frag = fmt.Sprintf("%s BETWEEN ? AND ?", col) }
        params: list[any] = [low, high]
        self.conds.append(["AND", frag, params])
        return self
    }

    func whereNotBetween(self, col: str, low: any, high: any) -> QueryBuilder {
        frag: str = ""
        go! { frag = fmt.Sprintf("%s NOT BETWEEN ? AND ?", col) }
        params: list[any] = [low, high]
        self.conds.append(["AND", frag, params])
        return self
    }

    func whereLike(self, col: str, pattern: str) -> QueryBuilder {
        #- ``WHERE col LIKE ?`` — pattern uses SQL wildcards (``%``,
           ``_``). Driver-specific escape rules apply. -#
        frag: str = ""
        go! { frag = fmt.Sprintf("%s LIKE ?", col) }
        params: list[any] = [pattern]
        self.conds.append(["AND", frag, params])
        return self
    }

    func whereNotLike(self, col: str, pattern: str) -> QueryBuilder {
        frag: str = ""
        go! { frag = fmt.Sprintf("%s NOT LIKE ?", col) }
        params: list[any] = [pattern]
        self.conds.append(["AND", frag, params])
        return self
    }

    func whereRaw(self, fragment: str, params: list[any] = []) -> QueryBuilder {
        #- Append a raw SQL fragment to the WHERE clause. Bound
           parameters in ``params`` are substituted in order for
           any ``?`` placeholders in ``fragment``. -#
        self.conds.append(["AND", fragment, params])
        return self
    }

    func orWhereRaw(self, fragment: str, params: list[any] = []) -> QueryBuilder {
        self.conds.append(["OR", fragment, params])
        return self
    }

    func distinct(self) -> QueryBuilder {
        #- Toggle ``SELECT DISTINCT``. Affects the very next
           terminal call. -#
        self.distinctOn = true
        return self
    }

    func selectRaw(self, fragment: str) -> QueryBuilder {
        #- Append a raw expression to the SELECT list (e.g.
           ``selectRaw("COUNT(*) AS cnt")``). The fragment is
           emitted verbatim — make sure it's safe SQL. -#
        self.cols.append(fragment)
        return self
    }

    func returning(self, cols: list[any]) -> QueryBuilder {
        #- Postgres-only. Add a ``RETURNING`` clause to the next
           ``insert``/``update``/``delete``. Other drivers ignore
           the request silently — call ``query()`` after a raw
           ``INSERT ... RETURNING`` if you need cross-driver
           portability. -#
        go! {
            for _, c := range cols {
                if cs, ok := c.(string); ok {
                    s.ReturningCols = append(s.ReturningCols, cs)
                }
            }
        }
        return self
    }

    func forUpdate(self) -> QueryBuilder {
        #- Append ``FOR UPDATE`` to the next ``get``/``first`` so
           the rows are write-locked until the surrounding
           transaction completes. SQLite ignores the hint. -#
        self.lockMode = "FOR UPDATE"
        return self
    }

    func forShare(self) -> QueryBuilder {
        #- Append ``FOR SHARE`` (Postgres) / ``LOCK IN SHARE MODE``
           (MySQL) for a read-lock. SQLite ignores. -#
        self.lockMode = "FOR SHARE"
        return self
    }

    func orderBy(self, col: str, dir_: str = "asc") -> QueryBuilder {
        clause: str = ""
        go! {
            d := strings.ToUpper(dir_)
            if d != "ASC" && d != "DESC" { d = "ASC" }
            clause = fmt.Sprintf("%s %s", col, d)
        }
        self.orderClauses.append(clause)
        return self
    }

    func groupBy(self, cols: list[any]) -> QueryBuilder {
        go! {
            for _, c := range cols {
                if cs, ok := c.(string); ok {
                    s.GroupCols = append(s.GroupCols, cs)
                }
            }
        }
        return self
    }

    func having(self, col: str, op: str, val: any) -> QueryBuilder {
        go! {
            self.HavingFragment = fmt.Sprintf("%s %s ?", col, op)
        }
        self.havingParams.append(val)
        return self
    }

    func limit(self, n: int) -> QueryBuilder {
        self.limitN = n
        return self
    }

    func offset(self, n: int) -> QueryBuilder {
        self.offsetN = n
        return self
    }

    func join(self, other: str, leftCol: str, rightCol: str) -> QueryBuilder {
        clause: str = ""
        go! {
            clause = fmt.Sprintf("INNER JOIN %s ON %s = %s", other, leftCol, rightCol)
        }
        self.joins.append(clause)
        return self
    }

    func leftJoin(self, other: str, leftCol: str, rightCol: str) -> QueryBuilder {
        clause: str = ""
        go! {
            clause = fmt.Sprintf("LEFT JOIN %s ON %s = %s", other, leftCol, rightCol)
        }
        self.joins.append(clause)
        return self
    }

    func rightJoin(self, other: str, leftCol: str, rightCol: str) -> QueryBuilder {
        clause: str = ""
        go! {
            clause = fmt.Sprintf("RIGHT JOIN %s ON %s = %s", other, leftCol, rightCol)
        }
        self.joins.append(clause)
        return self
    }

    func toSql(self) -> dict[str, any] {
        #- Render the SELECT with its parameter list. Useful for
           debugging / logging / EXPLAIN. -#
        sql_: str = ""
        params: list[any] = []
        go! {
            cols := "*"
            if len(s.Cols) > 0 {
                cols = strings.Join(s.Cols, ", ")
            }
            var b strings.Builder
            b.WriteString("SELECT ")
            if s.DistinctOn {
                b.WriteString("DISTINCT ")
            }
            b.WriteString(cols)
            b.WriteString(" FROM ")
            b.WriteString(s.TableName)
            for _, j := range s.Joins {
                b.WriteString(" ")
                b.WriteString(j)
            }
            collected := []interface{}{}
            if len(s.Conds) > 0 {
                b.WriteString(" WHERE ")
                for i, raw := range s.Conds {
                    triple, _ := raw.([]interface{})
                    logic, _ := triple[0].(string)
                    frag, _ := triple[1].(string)
                    listv, _ := triple[2].([]interface{})
                    if i > 0 {
                        b.WriteString(" ")
                        b.WriteString(logic)
                        b.WriteString(" ")
                    }
                    b.WriteString(frag)
                    collected = append(collected, listv...)
                }
            }
            if len(s.GroupCols) > 0 {
                b.WriteString(" GROUP BY ")
                b.WriteString(strings.Join(s.GroupCols, ", "))
            }
            if s.HavingFragment != "" {
                b.WriteString(" HAVING ")
                b.WriteString(s.HavingFragment)
                collected = append(collected, s.HavingParams...)
            }
            if len(s.OrderClauses) > 0 {
                b.WriteString(" ORDER BY ")
                b.WriteString(strings.Join(s.OrderClauses, ", "))
            }
            if s.LimitN >= 0 {
                b.WriteString(fmt.Sprintf(" LIMIT %d", s.LimitN))
            }
            if s.OffsetN >= 0 {
                b.WriteString(fmt.Sprintf(" OFFSET %d", s.OffsetN))
            }
            if s.LockMode != "" {
                // SQLite has neither FOR UPDATE nor FOR SHARE.
                if s.Driver != "sqlite" {
                    if s.Driver == "mysql" && s.LockMode == "FOR SHARE" {
                        b.WriteString(" LOCK IN SHARE MODE")
                    } else {
                        b.WriteString(" ")
                        b.WriteString(s.LockMode)
                    }
                }
            }
            sql_ = b.String()
            params = collected
        }
        out: dict[str, any] = {}
        out["sql"] = sql_
        out["params"] = params
        return out
    }

    func _runQuery(self, sqlText: str, params: list[any]) -> Result[list[dict[str, any]]] {
        #- Internal: run a SELECT through the bound transaction
           (when ``self.tx`` is set) or through the underlying
           ``Db`` connection. -#
        if self.tx != None {
            return self.tx.query(sqlText, params)
        }
        return self.db.query(sqlText, params)
    }

    func _runExec(self, sqlText: str, params: list[any]) -> Result[int] {
        if self.tx != None {
            return self.tx.exec(sqlText, params)
        }
        return self.db.exec(sqlText, params)
    }

    func get(self) -> Result[list[dict[str, any]]] {
        plan: dict[str, any] = self.toSql()
        sqlText: str = ""
        params: list[any] = []
        go! {
            if v, ok := plan["sql"].(string); ok { sqlText = v }
            if p, ok := plan["params"].([]interface{}); ok { params = p }
        }
        return self._runQuery(sqlText, params)
    }

    func first(self) -> Result[dict[str, any]] {
        self.limitN = 1
        rows: list[dict[str, any]] = self.get()?
        if len(rows) == 0 {
            empty: dict[str, any] = {}
            return Result.Ok(empty)
        }
        return Result.Ok(rows[0])
    }

    func count(self) -> Result[int] {
        savedCols: list[str] = self.cols
        self.cols = ["COUNT(*) AS cnt"]
        plan: dict[str, any] = self.toSql()
        self.cols = savedCols
        sqlText: str = ""
        params: list[any] = []
        go! {
            if v, ok := plan["sql"].(string); ok { sqlText = v }
            if p, ok := plan["params"].([]interface{}); ok { params = p }
        }
        rows: list[dict[str, any]] = self._runQuery(sqlText, params)?
        if len(rows) == 0 {
            return Result.Ok(0)
        }
        first_: dict[str, any] = rows[0]
        n: int = 0
        go! {
            if v, ok := first_["cnt"]; ok {
                switch x := v.(type) {
                case int:    n = x
                case int64:  n = int(x)
                case float64: n = int(x)
                case string:
                    if i, err := strconv.Atoi(x); err == nil { n = i }
                }
            }
        }
        return Result.Ok(n)
    }

    func insert(self, record: dict[str, any]) -> Result[int] {
        sqlText: str = ""
        params: list[any] = []
        go! {
            keys := []string{}
            placeholders := []string{}
            vals := []interface{}{}
            for k, v := range record {
                keys = append(keys, k)
                placeholders = append(placeholders, "?")
                vals = append(vals, v)
            }
            sqlText = fmt.Sprintf(
                "INSERT INTO %s (%s) VALUES (%s)",
                s.TableName,
                strings.Join(keys, ", "),
                strings.Join(placeholders, ", "),
            )
            if len(s.ReturningCols) > 0 && s.Driver == "postgres" {
                sqlText += " RETURNING " + strings.Join(s.ReturningCols, ", ")
            }
            params = vals
        }
        if len(self.returningCols) > 0 and self.driver == "postgres" {
            rows: list[dict[str, any]] = self._runQuery(sqlText, params)?
            return Result.Ok(len(rows))
        }
        return self._runExec(sqlText, params)
    }

    func insertReturning(self, record: dict[str, any]) -> Result[list[dict[str, any]]] {
        #- Postgres-only: INSERT and return the rows the database
           generated. Combine with ``returning(cols)`` to pick which
           columns come back. Other drivers return ``[]``. -#
        if self.driver != "postgres" {
            empty: list[dict[str, any]] = []
            return Result.Ok(empty)
        }
        sqlText: str = ""
        params: list[any] = []
        go! {
            keys := []string{}
            placeholders := []string{}
            vals := []interface{}{}
            for k, v := range record {
                keys = append(keys, k)
                placeholders = append(placeholders, "?")
                vals = append(vals, v)
            }
            sqlText = fmt.Sprintf(
                "INSERT INTO %s (%s) VALUES (%s)",
                s.TableName,
                strings.Join(keys, ", "),
                strings.Join(placeholders, ", "),
            )
            ret := "*"
            if len(s.ReturningCols) > 0 {
                ret = strings.Join(s.ReturningCols, ", ")
            }
            sqlText += " RETURNING " + ret
            params = vals
        }
        return self._runQuery(sqlText, params)
    }

    func insertMany(self, records: list[dict[str, any]]) -> Result[int] {
        n: int = len(records)
        if n == 0 {
            return Result.Ok(0)
        }
        sqlText: str = ""
        params: list[any] = []
        go! {
            // ``records`` is already []map[string]interface{} so no
            // type assertion is needed on element access.
            firstRow := records[0]
            keys := []string{}
            for k := range firstRow {
                keys = append(keys, k)
            }
            rowPlaceholders := "(" + strings.Repeat("?,", len(keys))
            rowPlaceholders = rowPlaceholders[:len(rowPlaceholders)-1] + ")"
            allPlaceholders := []string{}
            vals := []interface{}{}
            for _, rec := range records {
                allPlaceholders = append(allPlaceholders, rowPlaceholders)
                for _, k := range keys {
                    vals = append(vals, rec[k])
                }
            }
            sqlText = fmt.Sprintf(
                "INSERT INTO %s (%s) VALUES %s",
                s.TableName,
                strings.Join(keys, ", "),
                strings.Join(allPlaceholders, ", "),
            )
            params = vals
        }
        return self._runExec(sqlText, params)
    }

    func update(self, record: dict[str, any]) -> Result[int] {
        sqlText: str = ""
        params: list[any] = []
        go! {
            sets := []string{}
            vals := []interface{}{}
            for k, v := range record {
                sets = append(sets, fmt.Sprintf("%s = ?", k))
                vals = append(vals, v)
            }
            var b strings.Builder
            b.WriteString(fmt.Sprintf("UPDATE %s SET %s", s.TableName, strings.Join(sets, ", ")))
            if len(s.Conds) > 0 {
                b.WriteString(" WHERE ")
                for i, raw := range s.Conds {
                    triple, _ := raw.([]interface{})
                    logic, _ := triple[0].(string)
                    frag, _ := triple[1].(string)
                    listv, _ := triple[2].([]interface{})
                    if i > 0 {
                        b.WriteString(" ")
                        b.WriteString(logic)
                        b.WriteString(" ")
                    }
                    b.WriteString(frag)
                    vals = append(vals, listv...)
                }
            }
            sqlText = b.String()
            params = vals
        }
        return self._runExec(sqlText, params)
    }

    func delete(self) -> Result[int] {
        sqlText: str = ""
        params: list[any] = []
        go! {
            var b strings.Builder
            b.WriteString(fmt.Sprintf("DELETE FROM %s", s.TableName))
            vals := []interface{}{}
            if len(s.Conds) > 0 {
                b.WriteString(" WHERE ")
                for i, raw := range s.Conds {
                    triple, _ := raw.([]interface{})
                    logic, _ := triple[0].(string)
                    frag, _ := triple[1].(string)
                    listv, _ := triple[2].([]interface{})
                    if i > 0 {
                        b.WriteString(" ")
                        b.WriteString(logic)
                        b.WriteString(" ")
                    }
                    b.WriteString(frag)
                    vals = append(vals, listv...)
                }
            }
            sqlText = b.String()
            params = vals
        }
        return self._runExec(sqlText, params)
    }

    # ── Aggregations ──────────────────────────────────────────
    func _aggregate(self, expr: str) -> Result[any] {
        #- Run a single-column aggregate (``SUM``, ``AVG``, …) and
           return the scalar value, coerced to the closest Lam
           type (``int`` / ``float`` / ``str`` / ``None``). -#
        savedCols: list[str] = self.cols
        self.cols = [expr + " AS agg"]
        plan: dict[str, any] = self.toSql()
        self.cols = savedCols
        sqlText: str = ""
        params: list[any] = []
        go! {
            if v, ok := plan["sql"].(string); ok { sqlText = v }
            if p, ok := plan["params"].([]interface{}); ok { params = p }
        }
        rows: list[dict[str, any]] = self._runQuery(sqlText, params)?
        if len(rows) == 0 {
            return Result.Ok(None)
        }
        first_: dict[str, any] = rows[0]
        out: any = None
        go! {
            if v, ok := first_["agg"]; ok {
                out = v
            }
        }
        return Result.Ok(out)
    }

    func sum(self, col: str) -> Result[any] {
        #- ``SELECT SUM(col)``. Returns ``Ok(None)`` if no rows. -#
        return self._aggregate("SUM(" + col + ")")
    }

    func avg(self, col: str) -> Result[any] {
        return self._aggregate("AVG(" + col + ")")
    }

    func min(self, col: str) -> Result[any] {
        return self._aggregate("MIN(" + col + ")")
    }

    func max(self, col: str) -> Result[any] {
        return self._aggregate("MAX(" + col + ")")
    }

    func exists(self) -> Result[bool] {
        #- ``true`` iff at least one row matches. Cheaper than
           ``count() > 0`` because we ``LIMIT 1``. -#
        savedLimit: int = self.limitN
        self.limitN = 1
        rowsResult: Result[list[dict[str, any]]] = self.get()
        self.limitN = savedLimit
        if not rowsResult.ok() {
            return Result.Err(rowsResult.error)
        }
        rows: list[dict[str, any]] = []
        go! { rows = rowsResult.Value.([]map[string]interface{}) }
        return Result.Ok(len(rows) > 0)
    }

    func pluck(self, col: str) -> Result[list[any]] {
        #- Project a single column out of every row. Equivalent to
           ``[r[col] for r in this.select(col).get()]``. -#
        savedCols: list[str] = self.cols
        self.cols = [col]
        rowsResult: Result[list[dict[str, any]]] = self.get()
        self.cols = savedCols
        if not rowsResult.ok() {
            return Result.Err(rowsResult.error)
        }
        rows: list[dict[str, any]] = []
        go! { rows = rowsResult.Value.([]map[string]interface{}) }
        out: list[any] = []
        go! {
            for _, r := range rows {
                if v, ok := r[col]; ok {
                    out = append(out, v)
                }
            }
        }
        return Result.Ok(out)
    }

    func paginate(self, page: int, perPage: int) -> Result[dict[str, any]] {
        #- Convenience wrapper around ``limit`` + ``offset`` that
           also runs a sibling ``COUNT(*)`` so the caller can render
           page navigation. ``page`` is 1-indexed. The returned
           dict has keys ``data``, ``total``, ``page``, ``perPage``,
           and ``lastPage``. -#
        if page < 1 {
            page = 1
        }
        if perPage < 1 {
            perPage = 15
        }
        total: int = self.count()?
        self.limitN = perPage
        self.offsetN = (page - 1) * perPage
        rows: list[dict[str, any]] = self.get()?
        lastPage: int = 1
        if total > 0 {
            lastPage = (total + perPage - 1) // perPage
        }
        out: dict[str, any] = {}
        out["data"] = rows
        out["total"] = total
        out["page"] = page
        out["perPage"] = perPage
        out["lastPage"] = lastPage
        return Result.Ok(out)
    }

    # ── Mutating shortcuts ────────────────────────────────────
    func increment(self, col: str, n: int = 1) -> Result[int] {
        #- ``UPDATE ... SET col = col + ?`` against the current
           WHERE clause. -#
        return self._adjust(col, n, "+")
    }

    func decrement(self, col: str, n: int = 1) -> Result[int] {
        return self._adjust(col, n, "-")
    }

    func _adjust(self, col: str, n: int, op: str) -> Result[int] {
        sqlText: str = ""
        params: list[any] = []
        go! {
            var b strings.Builder
            b.WriteString(fmt.Sprintf("UPDATE %s SET %s = %s %s ?", s.TableName, col, col, op))
            vals := []interface{}{n}
            if len(s.Conds) > 0 {
                b.WriteString(" WHERE ")
                for i, raw := range s.Conds {
                    triple, _ := raw.([]interface{})
                    logic, _ := triple[0].(string)
                    frag, _ := triple[1].(string)
                    listv, _ := triple[2].([]interface{})
                    if i > 0 {
                        b.WriteString(" ")
                        b.WriteString(logic)
                        b.WriteString(" ")
                    }
                    b.WriteString(frag)
                    vals = append(vals, listv...)
                }
            }
            sqlText = b.String()
            params = vals
        }
        return self._runExec(sqlText, params)
    }

    func upsert(self, record: dict[str, any], conflictCols: list[any], updateCols: list[any] = []) -> Result[int] {
        #- INSERT a row, falling back to UPDATE on conflict against
           ``conflictCols``. Driver dialects:

             * SQLite + Postgres: ``ON CONFLICT (cols) DO UPDATE SET ...``.
             * MySQL: ``ON DUPLICATE KEY UPDATE ...`` (``conflictCols``
               is informational; MySQL detects the conflicting key
               itself).

           When ``updateCols`` is empty every column from ``record``
           except those in ``conflictCols`` is updated. -#
        sqlText: str = ""
        params: list[any] = []
        go! {
            keys := []string{}
            placeholders := []string{}
            vals := []interface{}{}
            for k, v := range record {
                keys = append(keys, k)
                placeholders = append(placeholders, "?")
                vals = append(vals, v)
            }
            // Resolve which columns to UPDATE on conflict.
            conflictSet := map[string]struct{}{}
            for _, c := range conflictCols {
                if cs, ok := c.(string); ok {
                    conflictSet[cs] = struct{}{}
                }
            }
            updates := []string{}
            for _, c := range updateCols {
                if cs, ok := c.(string); ok {
                    updates = append(updates, cs)
                }
            }
            if len(updates) == 0 {
                for _, k := range keys {
                    if _, isConflict := conflictSet[k]; !isConflict {
                        updates = append(updates, k)
                    }
                }
            }
            base := fmt.Sprintf(
                "INSERT INTO %s (%s) VALUES (%s)",
                s.TableName,
                strings.Join(keys, ", "),
                strings.Join(placeholders, ", "),
            )
            switch s.Driver {
            case "mysql":
                if len(updates) > 0 {
                    parts := []string{}
                    for _, c := range updates {
                        parts = append(parts, fmt.Sprintf("%s = VALUES(%s)", c, c))
                    }
                    base += " ON DUPLICATE KEY UPDATE " + strings.Join(parts, ", ")
                }
            default: // sqlite + postgres
                conflictCSV := []string{}
                for _, c := range conflictCols {
                    if cs, ok := c.(string); ok {
                        conflictCSV = append(conflictCSV, cs)
                    }
                }
                base += " ON CONFLICT (" + strings.Join(conflictCSV, ", ") + ") "
                if len(updates) == 0 {
                    base += "DO NOTHING"
                } else {
                    parts := []string{}
                    for _, c := range updates {
                        parts = append(parts, fmt.Sprintf("%s = excluded.%s", c, c))
                    }
                    base += "DO UPDATE SET " + strings.Join(parts, ", ")
                }
            }
            sqlText = base
            params = vals
        }
        return self._runExec(sqlText, params)
    }

    func firstOrCreate(self, lookup: dict[str, any], extra: dict[str, any] = {}) -> Result[dict[str, any]] {
        #- Return the first row matching ``lookup`` if one exists;
           otherwise INSERT a row composed of ``lookup`` ⊕ ``extra``
           and return that. The lookup keys become equality
           predicates. Pair with a transaction for a race-free
           upsert. -#
        for k, v in lookup {
            _ = self.whereEq(k, v)
        }
        existing: dict[str, any] = self.first()?
        if len(existing) > 0 {
            return Result.Ok(existing)
        }
        record: dict[str, any] = {}
        for k, v in lookup {
            record[k] = v
        }
        for k, v in extra {
            record[k] = v
        }
        # Reset conditions so insert() doesn't try to honour them.
        cleared: list[any] = []
        self.conds = cleared
        _ = self.insert(record)?
        return Result.Ok(record)
    }

    func updateOrCreate(self, lookup: dict[str, any], values: dict[str, any]) -> Result[dict[str, any]] {
        #- Upsert by composition: if a row matches ``lookup``, apply
           ``values`` via UPDATE; otherwise INSERT ``lookup`` ⊕
           ``values``. Returns the resulting row. -#
        for k, v in lookup {
            _ = self.whereEq(k, v)
        }
        existing: dict[str, any] = self.first()?
        if len(existing) > 0 {
            _ = self.update(values)?
            for k, v in values {
                existing[k] = v
            }
            return Result.Ok(existing)
        }
        record: dict[str, any] = {}
        for k, v in lookup {
            record[k] = v
        }
        for k, v in values {
            record[k] = v
        }
        cleared: list[any] = []
        self.conds = cleared
        _ = self.insert(record)?
        return Result.Ok(record)
    }

    func truncate(self) -> Result[int] {
        #- ``DELETE FROM table`` (portable). On Postgres / MySQL we
           emit ``TRUNCATE TABLE`` which resets identity counters
           atomically; SQLite uses the DELETE form because it lacks
           TRUNCATE. -#
        sqlText: str = ""
        go! {
            switch s.Driver {
            case "postgres", "mysql":
                sqlText = "TRUNCATE TABLE " + s.TableName
            default:
                sqlText = "DELETE FROM " + s.TableName
            }
        }
        empty: list[any] = []
        return self._runExec(sqlText, empty)
    }
}

go! {
    // Compile-time silence for the unused sync import (kept so future
    // additions like prepared-statement caching can pull it in
    // without re-shuffling imports).
    var _ sync.Mutex

    // ─── Typed row values (``Row``) ───────────────────────────
    // Every helper returns ``ok == false`` for NULL and for values that do
    // not convert, so the Lam side picks the fallback / None.

    func lamDbRowText(value interface{}) (string, bool) {
        switch typed := value.(type) {
        case string:
            return typed, true
        case []byte:
            return string(typed), true
        }
        return "", false
    }

    func lamDbRowInt(value interface{}) (int, bool) {
        switch typed := value.(type) {
        case nil:
            return 0, false
        case bool:
            if typed {
                return 1, true
            }
            return 0, true
        case int:
            return typed, true
        case int8:
            return int(typed), true
        case int16:
            return int(typed), true
        case int32:
            return int(typed), true
        case int64:
            return int(typed), true
        case uint:
            return int(typed), true
        case uint8:
            return int(typed), true
        case uint16:
            return int(typed), true
        case uint32:
            return int(typed), true
        case uint64:
            return int(typed), true
        case float32:
            return lamDbRowFloatToInt(float64(typed))
        case float64:
            return lamDbRowFloatToInt(typed)
        case time.Time:
            return int(typed.Unix()), true
        case *big.Int:
            if typed.IsInt64() {
                return int(typed.Int64()), true
            }
            return 0, false
        case *big.Float:
            if typed.IsInf() {
                return 0, false
            }
            n, accuracy := typed.Int64()
            if (accuracy == big.Below && n == math.MaxInt64) || (accuracy == big.Above && n == math.MinInt64) {
                return 0, false
            }
            return int(n), true
        case *big.Rat:
            f, _ := typed.Float64()
            return lamDbRowFloatToInt(f)
        }
        if text, ok := lamDbRowText(value); ok {
            text = strings.TrimSpace(text)
            if n, err := strconv.ParseInt(text, 10, 64); err == nil {
                return int(n), true
            }
            if f, err := strconv.ParseFloat(text, 64); err == nil {
                return lamDbRowFloatToInt(f)
            }
        }
        return 0, false
    }

    func lamDbRowFloatToInt(f float64) (int, bool) {
        if math.IsNaN(f) || math.IsInf(f, 0) || f >= 9.223372036854775807e18 || f < -9.223372036854775808e18 {
            return 0, false
        }
        return int(f), true
    }

    func lamDbRowFloat(value interface{}) (float64, bool) {
        switch typed := value.(type) {
        case nil:
            return 0, false
        case float64:
            return typed, true
        case float32:
            return float64(typed), true
        case *big.Int:
            f, _ := new(big.Float).SetInt(typed).Float64()
            return f, true
        case *big.Float:
            f, _ := typed.Float64()
            return f, true
        case *big.Rat:
            f, _ := typed.Float64()
            return f, true
        case time.Time:
            return float64(typed.UnixNano()) / 1e9, true
        }
        if text, ok := lamDbRowText(value); ok {
            f, err := strconv.ParseFloat(strings.TrimSpace(text), 64)
            return f, err == nil
        }
        if n, ok := lamDbRowInt(value); ok {
            return float64(n), true
        }
        return 0, false
    }

    func lamDbRowStr(value interface{}) (string, bool) {
        switch typed := value.(type) {
        case nil:
            return "", false
        case string:
            return typed, true
        case []byte:
            return string(typed), true
        case bool:
            return strconv.FormatBool(typed), true
        case float64:
            return strconv.FormatFloat(typed, 'f', -1, 64), true
        case float32:
            return strconv.FormatFloat(float64(typed), 'f', -1, 32), true
        case time.Time:
            return typed.UTC().Format(time.RFC3339Nano), true
        case *big.Int:
            return typed.String(), true
        case *big.Float:
            return typed.Text('f', -1), true
        case *big.Rat:
            if typed.IsInt() {
                return typed.Num().String(), true
            }
            return typed.RatString(), true
        }
        return fmt.Sprintf("%v", value), true
    }

    func lamDbRowBool(value interface{}) (bool, bool) {
        switch typed := value.(type) {
        case nil:
            return false, false
        case bool:
            return typed, true
        case float64:
            return typed != 0, true
        case float32:
            return typed != 0, true
        }
        if text, ok := lamDbRowText(value); ok {
            switch strings.ToLower(strings.TrimSpace(text)) {
            case "t", "true", "1", "y", "yes", "on":
                return true, true
            case "f", "false", "0", "n", "no", "off":
                return false, true
            }
            return false, false
        }
        if n, ok := lamDbRowInt(value); ok {
            return n != 0, true
        }
        return false, false
    }

    // Timestamp texts: RFC 3339, PostgreSQL (``2026-11-03 19:05:00.5+01``)
    // and SQLite (``2026-11-03 19:05:00``); texts without an offset are UTC.
    var lamDbRowTimeLayouts = []string{
        time.RFC3339Nano,
        "2006-01-02 15:04:05.999999999Z07:00",
        "2006-01-02 15:04:05.999999999-07",
        "2006-01-02 15:04:05.999999999",
        "2006-01-02T15:04:05.999999999",
        "2006-01-02 15:04",
        "2006-01-02",
    }

    func lamDbRowTime(value interface{}) (time.Time, bool) {
        switch typed := value.(type) {
        case nil:
            return time.Time{}, false
        case time.Time:
            return typed, true
        case int64:
            return time.Unix(typed, 0), true
        case int:
            return time.Unix(int64(typed), 0), true
        case float64:
            if math.IsNaN(typed) || math.IsInf(typed, 0) {
                return time.Time{}, false
            }
            whole, frac := math.Modf(typed)
            return time.Unix(int64(whole), int64(frac*1e9)), true
        }
        if text, ok := lamDbRowText(value); ok {
            text = strings.TrimSpace(text)
            for _, layout := range lamDbRowTimeLayouts {
                if parsed, err := time.Parse(layout, text); err == nil {
                    return parsed, true
                }
            }
        }
        return time.Time{}, false
    }

    // PostgreSQL array literal (``{a,"b c",NULL}``, nested arrays
    // flattened, an optional ``[1:2]=`` bounds prefix). ``nulls[i]`` marks
    // an unquoted NULL element.
    func lamDbParseTextArray(raw string) ([]string, []bool, error) {
        text := strings.TrimSpace(raw)
        if strings.HasPrefix(text, "[") {
            if eq := strings.Index(text, "="); eq >= 0 {
                text = strings.TrimSpace(text[eq+1:])
            }
        }
        if len(text) < 2 || text[0] != '{' || text[len(text)-1] != '}' {
            return nil, nil, fmt.Errorf("not a PostgreSQL array literal: %q", raw)
        }
        values := []string{}
        nulls := []bool{}
        var current strings.Builder
        quoted, wasQuoted, escaped, pending := false, false, false, false
        depth := 0
        flush := func() {
            item := current.String()
            if !wasQuoted {
                item = strings.TrimSpace(item)
            }
            values = append(values, item)
            nulls = append(nulls, !wasQuoted && strings.EqualFold(item, "NULL"))
            current.Reset()
            wasQuoted, pending = false, false
        }
        for _, r := range text {
            switch {
            case escaped:
                current.WriteRune(r)
                escaped = false
            case quoted && r == '\\':
                escaped = true
            case r == '"':
                quoted = !quoted
                wasQuoted, pending = true, true
            case quoted:
                current.WriteRune(r)
            case r == '{':
                depth++
            case r == '}':
                if pending || current.Len() > 0 {
                    flush()
                }
                depth--
            case r == ',':
                if pending || current.Len() > 0 {
                    flush()
                }
            default:
                current.WriteRune(r)
                pending = true
            }
        }
        if quoted || depth != 0 {
            return nil, nil, fmt.Errorf("unterminated PostgreSQL array literal: %q", raw)
        }
        return values, nulls, nil
    }

    // The elements of an array value (literal text, or a slice from a
    // driver that decodes arrays); NULL elements are dropped.
    func lamDbRowStrList(value interface{}) []string {
        out := []string{}
        switch typed := value.(type) {
        case nil:
            return out
        case []string:
            return append(out, typed...)
        case []interface{}:
            for _, item := range typed {
                if text, ok := lamDbRowStr(item); ok {
                    out = append(out, text)
                }
            }
            return out
        }
        text, ok := lamDbRowText(value)
        if !ok {
            return out
        }
        values, nulls, err := lamDbParseTextArray(text)
        if err != nil {
            return out
        }
        for i, item := range values {
            if !nulls[i] {
                out = append(out, item)
            }
        }
        return out
    }
}

func main() {
    pass
}
