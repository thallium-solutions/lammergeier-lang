# Lammergeier standard library: random utilities
# Import with: from lamrandom import Random
#
# Uses math/rand for ordinary operations and crypto/rand for secure values. Use lamuuid for UUIDs.

from lamerrors import Result, Error

go! {
    import (
        "math/rand"
        crand "crypto/rand"
        "encoding/base64"
        "encoding/hex"
        "fmt"
        "math/big"
    )
}

class Random {
    static func randInt(minVal: int, maxVal: int) -> Result[int] {
        #- Random integer in [minVal, maxVal). -#
        go! {
            if maxVal <= minVal {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "randInt: maxVal must be greater than minVal", nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(rand.Intn(maxVal - minVal) + minVal)
        }
    }

    static func randFloat() -> float {
        #- Random float in [0.0, 1.0). -#
        go! {
            return rand.Float64()
        }
    }

    static func randFloatRange(minVal: float, maxVal: float) -> float {
        #- Random float in [minVal, maxVal). -#
        go! {
            return minVal + rand.Float64()*(maxVal-minVal)
        }
    }

    static func randBool() -> bool {
        go! {
            return rand.Intn(2) == 1
        }
    }

    static func seed(s: int) {
        go! {
            rand.Seed(int64(s))
        }
    }

    static func shuffle(arr: list[any]) -> list[any] {
        #- Return a shuffled copy of the list. The input is not mutated. -#
        go! {
            result := make([]interface{}, len(arr))
            copy(result, arr)
            rand.Shuffle(len(result), func(i, j int) {
                result[i], result[j] = result[j], result[i]
            })
            return result
        }
    }

    static func choice(arr: list[any]) -> Result[any] {
        #- Pick a single random element. -#
        go! {
            if len(arr) == 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "choice: list must not be empty", nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(arr[rand.Intn(len(arr))])
        }
    }

    static func sample(arr: list[any], k: int) -> Result[list[any]] {
        #- Pick k unique random elements (without replacement). -#
        go! {
            if k > len(arr) || k < 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", fmt.Sprintf("sample: k must be between 0 and %d", len(arr)), nil,
                ))
            }
            pool := make([]interface{}, len(arr))
            copy(pool, arr)
            rand.Shuffle(len(pool), func(i, j int) {
                pool[i], pool[j] = pool[j], pool[i]
            })
            return LAMMERGEIER.Result.Ok(pool[:k])
        }
    }

    static func randomString(length: int) -> Result[str] {
        #- Random alphanumeric string of the given length. -#
        go! {
            if length < 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "randomString: length must not be negative", nil,
                ))
            }
            const chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            b := make([]byte, length)
            for i := range b {
                b[i] = chars[rand.Intn(len(chars))]
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func randomHex(length: int) -> Result[str] {
        #- Random hex string of the given length (each char is 4 bits). -#
        go! {
            if length < 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "randomHex: length must not be negative", nil,
                ))
            }
            const chars = "0123456789abcdef"
            b := make([]byte, length)
            for i := range b {
                b[i] = chars[rand.Intn(len(chars))]
            }
            return LAMMERGEIER.Result.Ok(string(b))
        }
    }

    static func secureBytes(n: int) -> Result[str] {
        go! {
            if n < 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "secureBytes: size must not be negative", nil,
                ))
            }
            b := make([]byte, n)
            if _, err := crand.Read(b); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", fmt.Sprintf("secureBytes: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(hex.EncodeToString(b))
        }
    }

    static func secureToken(n: int) -> Result[str] {
        go! {
            if n < 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "secureToken: size must not be negative", nil,
                ))
            }
            b := make([]byte, n)
            if _, err := crand.Read(b); err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", fmt.Sprintf("secureToken: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(base64.RawURLEncoding.EncodeToString(b))
        }
    }

    static func secureInt(maxVal: int) -> Result[int] {
        go! {
            if maxVal <= 0 {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", "secureInt: maxVal must be positive", nil,
                ))
            }
            n, err := crand.Int(crand.Reader, big.NewInt(int64(maxVal)))
            if err != nil {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "RandomError", fmt.Sprintf("secureInt: %v", err), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(int(n.Int64()))
        }
    }

}

func main() {
    pass
}
