from lamotel import OtelConfig, OtelTracer, OtelSpanBatch
from lamenv import Env
from lamhttp import Http, HttpServer

class Capture {
    static path: str = ""
    static body: str = ""
}

func handler(method: str, path: str, body: str) -> str {
    _ = method
    Capture.path = path
    Capture.body = body
    return "{}"
}

func clearOtelEnv() {
    Env.unset("OTEL_SERVICE_NAME")
    Env.unset("OTEL_EXPORTER_OTLP_ENDPOINT")
    Env.unset("OTEL_EXPORTER_OTLP_HEADERS")
    Env.unset("OTEL_SERVICE_VERSION")
    Env.unset("OTEL_DEPLOYMENT_ENVIRONMENT")
    Env.unset("OTEL_RESOURCE_ATTRIBUTES")
}

func main() {
    clearOtelEnv()
    Env.set("OTEL_SERVICE_NAME", "checkout-api")
    Env.set("OTEL_SERVICE_VERSION", "1.2.3")
    Env.set("OTEL_DEPLOYMENT_ENVIRONMENT", "prod")
    Env.set("OTEL_RESOURCE_ATTRIBUTES", "team=payments,region=eu")

    cfg: OtelConfig = OtelConfig.fromEnv()
    resource: dict[str, str] = cfg.resource()
    print(resource["service.name"])
    print(resource["service.version"])
    print(resource["deployment.environment"])
    print(resource["team"])

    tracer: OtelTracer = OtelTracer(cfg)
    parent = tracer.startSpan("checkout")
    child = tracer.childSpan(parent, "stripe.create_payment_intent")
    child.recordException("card declined")
    child.end()
    parent.end()

    print(child.traceId == parent.traceId)
    print(child.parentSpanId == parent.spanId)
    print(child.statusCode == "error")

    data: dict[str, any] = child.toDict("checkout-api")
    print(str(data["status"]).contains("card declined"))
    print(str(data["events"]).contains("exception"))

    batch: OtelSpanBatch = tracer.batch()
    batch.add(parent)
    batch.add(child)
    print(batch.size())

    srv: HttpServer = Http.serve(39284, handler)
    cfg.endpoint = "http://127.0.0.1:39284"
    res = batch.export(tracer)
    print(res.ok())
    print(Capture.path == "/v1/traces")
    print(Capture.body.contains("deployment.environment"))
    srv.close()
    clearOtelEnv()
}
