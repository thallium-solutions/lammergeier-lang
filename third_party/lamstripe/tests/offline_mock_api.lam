# expect: true
# expect: POST
# expect: /customers
# expect: true
# expect: true

from lamstripe import StripeClient, StripeConfig
from lamhttp import Http, HttpServer

class Capture {
    static method: str = ""
    static path: str = ""
    static body: str = ""
}

func handler(method: str, path: str, body: str) -> str {
    Capture.method = method
    Capture.path = path
    Capture.body = body
    return "{\"id\":\"cus_test\",\"object\":\"customer\"}"
}

func main() {
    srv: HttpServer = Http.serve(39281, handler)
    cfg: StripeConfig = StripeConfig("sk_test_local", "http://127.0.0.1:39281", "", 5000)
    client: StripeClient = StripeClient(cfg)

    res = client.createCustomer("ada@example.com", "Ada Lovelace")
    print(res.ok())
    print(Capture.method)
    print(Capture.path)
    print(Capture.body.contains("email=ada%40example.com"))
    print(Capture.body.contains("name=Ada+Lovelace"))

    srv.close()
}
