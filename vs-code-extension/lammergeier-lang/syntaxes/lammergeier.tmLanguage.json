{
  "name": "Lammergeier",
  "scopeName": "source.lammergeier",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#go-block" },
    { "include": "#imports" },
    { "include": "#decorators" },
    { "include": "#function-definition" },
    { "include": "#class-definition" },
    { "include": "#interface-definition" },
    { "include": "#lammergeier-namespace" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#storage-modifiers" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#stdlib-modules" },
    { "include": "#stdlib-classes" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lammergeier",
          "begin": "#-",
          "end": "-#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.lammergeier" }
          }
        },
        {
          "name": "comment.line.number-sign.lammergeier",
          "match": "#(?!-).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.interpolated.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:f)(\"\"\")",
          "end": "(?<!\\\\)(?:\\\\\\\\)*\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.single.interpolated.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:f)(''')",
          "end": "(?<!\\\\)(?:\\\\\\\\)*'''",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:f)(\")(?!\"\")",
          "end": "(?<!\\\\)(?:\\\\\\\\)*\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.interpolated.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:f)(')(?!'')",
          "end": "(?<!\\\\)(?:\\\\\\\\)*'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.double.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:(?:[ubf]?r?|r[ubf]))(\"\"\")",
          "end": "(?<!\\\\)(?:\\\\\\\\)*\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.triple.single.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:(?:[ubf]?r?|r[ubf]))(''')",
          "end": "(?<!\\\\)(?:\\\\\\\\)*'''",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.double.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:(?:[ubf]?r?|r[ubf]))(\")(?!\"\")",
          "end": "(?<!\\\\)(?:\\\\\\\\)*\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#string-escape" }
          ]
        },
        {
          "name": "string.quoted.single.lammergeier",
          "begin": "(?<![A-Za-z0-9_])(?i:(?:[ubf]?r?|r[ubf]))(')(?!'')",
          "end": "(?<!\\\\)(?:\\\\\\\\)*'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lammergeier" }
          },
          "patterns": [
            { "include": "#string-escape" }
          ]
        }
      ]
    },
    "fstring-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.lammergeier",
          "begin": "(?<!\\{)\\{(?!\\{)",
          "end": "(?<!\\})\\}(?!\\})",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.lammergeier" }
          },
          "patterns": [
            { "include": "source.lammergeier" }
          ]
        },
        {
          "name": "constant.character.escape.brace.lammergeier",
          "match": "\\{\\{|\\}\\}"
        },
        { "include": "#string-escape" }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.lammergeier",
          "match": "\\\\(?:[\\\\\"'abfnrtv]|[0-7]{1,3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}\\n]+\\}|\\r?\\n)"
        }
      ]
    },
    "go-block": {
      "patterns": [
        {
          "name": "meta.embedded.block.go.inline.lammergeier",
          "begin": "(\\bgo!)[\\t ]*(\\{)(?=[^\\n]*\\}[\\t ]*(?:#.*)?$)",
          "end": "\\}(?=[\\t ]*(?:#.*)?$)",
          "beginCaptures": {
            "1": { "name": "keyword.control.go-block.lammergeier" },
            "2": { "name": "punctuation.section.block.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.lammergeier" }
          },
          "contentName": "meta.embedded.block.go",
          "patterns": [
            { "include": "#lammergeier-namespace" },
            { "include": "source.go" }
          ]
        },
        {
          "name": "meta.embedded.block.go.lammergeier",
          "begin": "^([\\t ]*)(go!)[\\t ]*(\\{)[\\t ]*(?:#.*)?$",
          "end": "^\\1\\}[\\t ]*(?:#.*)?$",
          "beginCaptures": {
            "2": { "name": "keyword.control.go-block.lammergeier" },
            "3": { "name": "punctuation.section.block.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.lammergeier" }
          },
          "contentName": "meta.embedded.block.go",
          "patterns": [
            { "include": "#lammergeier-namespace" },
            { "include": "source.go" }
          ]
        },
        {
          "name": "meta.embedded.block.go.indented.lammergeier",
          "begin": "^([\\t ]*)(go!)[\\t ]*(:)[\\t ]*(?:#.*)?$",
          "end": "^(?!\\1[\\t ]+)(?=[\\t ]*\\S)",
          "beginCaptures": {
            "2": { "name": "keyword.control.go-block.lammergeier" },
            "3": { "name": "punctuation.section.block.begin.lammergeier" }
          },
          "contentName": "meta.embedded.block.go",
          "patterns": [
            { "include": "#lammergeier-namespace" },
            { "include": "source.go" }
          ]
        },
        {
          "name": "meta.embedded.expression.go.lammergeier",
          "begin": "(\\bgo!)[\\t ]*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "keyword.control.go-inline.lammergeier" },
            "2": { "name": "punctuation.section.group.begin.lammergeier" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.lammergeier" }
          },
          "contentName": "meta.embedded.expression.go",
          "patterns": [
            { "include": "#lammergeier-namespace" },
            { "include": "source.go" }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.from.lammergeier",
          "match": "^([\\t ]*)(from)\\b[\\t ]+((?:\\.*[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|\\.+|@[A-Za-z0-9_][A-Za-z0-9_-]*(?:/[A-Za-z_][A-Za-z0-9_-]*)+))[\\t ]+(import)\\b",
          "captures": {
            "2": { "name": "keyword.control.import.from.lammergeier" },
            "3": { "name": "entity.name.namespace.import.lammergeier" },
            "4": { "name": "keyword.control.import.lammergeier" }
          }
        },
        {
          "name": "meta.import.lammergeier",
          "match": "^([\\t ]*)(import)\\b[\\t ]+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "2": { "name": "keyword.control.import.lammergeier" },
            "3": { "name": "entity.name.namespace.import.lammergeier" }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.lammergeier",
          "match": "^([\\t ]*)(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?=[\\t ]*(?:\\(|(?:func|class)\\b|(?:#.*)?$))",
          "captures": {
            "2": { "name": "punctuation.definition.decorator.lammergeier" },
            "3": { "name": "entity.name.function.decorator.lammergeier" }
          }
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b((?:(?:private|static|async)[\\t ]+)*)(func)[\\t ]+([A-Za-z_][A-Za-z0-9_]*)([\\t ]*\\[[^\\]\\n]+\\])?[\\t ]*(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.lammergeier" },
            "2": { "name": "keyword.other.func.lammergeier" },
            "3": { "name": "entity.name.function.lammergeier" },
            "4": { "name": "meta.type.parameters.lammergeier" }
          }
        }
      ]
    },
    "class-definition": {
      "patterns": [
        {
          "match": "\\b(class)[\\t ]+([A-Za-z_][A-Za-z0-9_]*)([\\t ]*\\[[^\\]\\n]+\\])?",
          "captures": {
            "1": { "name": "keyword.other.class.lammergeier" },
            "2": { "name": "entity.name.type.class.lammergeier" },
            "3": { "name": "meta.type.parameters.lammergeier" }
          }
        }
      ]
    },
    "interface-definition": {
      "patterns": [
        {
          "match": "\\b(interface)[\\t ]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.interface.lammergeier" },
            "2": { "name": "entity.name.type.interface.lammergeier" }
          }
        }
      ]
    },
    "contextual-keywords": {
      "patterns": [
        {
          "match": "^[\\t ]*(match)\\b(?=[\\t ]+(?![=:]|[+\\-*/%&|^<>]=)[^#\\n;]*\\{)",
          "captures": {
            "1": { "name": "keyword.control.match.lammergeier" }
          }
        },
        {
          "match": "^[\\t ]*(case)\\b(?=[\\t ]+(?![=:]|[+\\-*/%&|^<>]=)[^#\\n;]*\\{)",
          "captures": {
            "1": { "name": "keyword.control.case.lammergeier" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lammergeier",
          "match": "\\b(if|elif|else|for|while|break|continue|return|pass|try|catch|finally|raise|throw|do|defer|with|as|yield|del|assert|import|from|await)\\b"
        },
        {
          "name": "keyword.operator.logical.lammergeier",
          "match": "\\b(and|or|not|in|is)\\b"
        },
        {
          "name": "keyword.other.lammergeier",
          "match": "\\b(func|class|interface|global|nonlocal|lambda)\\b"
        }
      ]
    },
    "storage-modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.lammergeier",
          "match": "\\b(private|static|async|const)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lammergeier",
          "match": "\\b(True|False|None|true|false|nil|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.lammergeier",
          "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|string|str|bool|byte|rune|bytes|any|error|list|dict|set|tuple|json|func|object|optional|Option|Result|None)\\b"
        },
        {
          "name": "support.type.exception.lammergeier",
          "match": "\\b(ValueError|TypeError|KeyError|IndexError|RuntimeError|AttributeError|IOError|OSError|FileNotFoundError|ZeroDivisionError|OverflowError|NotImplementedError|StopIteration|Exception|ArithmeticError|LookupError|NameError)\\b"
        }
      ]
    },
    "stdlib-modules": {
      "patterns": [
        {
          "name": "support.class.stdlib.module.lammergeier",
          "match": "\\b(lamactor|lamarray|lambase64|lambytes|lamcache|lamcli|lamcompress|lamconcurrency|lamcontext|lamconv|lamcron|lamcrypto|lamcsv|lamdata|lamdatastructures|lamdatetime|lamdb|lamdeque|lamenv|lamerrors|lamexec|lamfmt|lamhash|lamheap|lamhttp|lamiter|lamjson|lamlog|lammath|lammigrate|lamnet|lamos|lampath|lamqueue|lamrandom|lamratelimit|lamre|lamretry|lamschema|lamset|lamsmtp|lamsort|lamstack|lamstats|lamstrings|lamtemplate|lamtest|lamtime|lamunicode|lamurl|lamuuid|lamxml|lamyaml)\\b"
        }
      ]
    },
    "stdlib-classes": {
      "patterns": [
        {
          "name": "support.class.stdlib.type.lammergeier",
          "match": "\\b(Result|Error|Crypto|CryptoKeyPair|CryptoCertificate|Context|Array|Matrix|Iter|LruCache|TtlCache|Uuid|Server|Request|Response|Http|HttpClient|HttpResponse|Heap|WaitGroup|Channel|Mutex|Atomic|Time|Duration|Path|File|Json|Csv|Xml|XmlNode|Yaml|Template|HtmlTemplate|Retry|TokenBucket|CircuitBreaker|HttpError|TusServer|Db|QueryBuilder)\\b"
        }
      ]
    },
    "lammergeier-namespace": {
      "patterns": [
        {
          "name": "meta.namespace.lammergeier",
          "match": "\\b(LAMMERGEIER)((?:\\.[A-Za-z_][A-Za-z0-9_]*)+)\\b",
          "captures": {
            "1": { "name": "support.namespace.lammergeier" },
            "2": { "name": "support.type.lammergeier-namespace.lammergeier" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lammergeier",
          "match": "\\b(print|input|open|exit|len|range|enumerate|sorted|reversed|append|format|type|isinstance|repr|abs|max|min|panic|recover|make|new|cap|copy|delete|close)\\b(?=[\\t ]*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.lammergeier",
          "match": "->"
        },
        {
          "name": "keyword.operator.null-coalescing.lammergeier",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.lammergeier",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.propagation.lammergeier",
          "match": "(?<=[A-Za-z0-9_\\)\\]\\}])\\?(?![?.])"
        },
        {
          "name": "keyword.operator.comparison.lammergeier",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.lammergeier",
          "match": "<<=|>>=|\\*\\*=|//=|\\+=|-=|\\*=|@=|/=|%=|&=|\\|=|\\^=|:=|="
        },
        {
          "name": "keyword.operator.increment-decrement.lammergeier",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.lammergeier",
          "match": "\\*\\*|//|\\+|-|\\*|@|/|%"
        },
        {
          "name": "keyword.operator.bitwise.lammergeier",
          "match": "<<|>>|&|\\||\\^|~"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.imaginary.lammergeier",
          "match": "(?<![A-Za-z0-9_])(?:(?:(?:[0-9](?:_?[0-9])*)\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?)[jJ](?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.float.lammergeier",
          "match": "(?<![A-Za-z0-9_])(?:(?:(?:[0-9](?:_?[0-9])*)\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.hex.lammergeier",
          "match": "(?<![A-Za-z0-9_])0[xX](?:_?[0-9A-Fa-f])+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.octal.lammergeier",
          "match": "(?<![A-Za-z0-9_])0[oO](?:_?[0-7])+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.binary.lammergeier",
          "match": "(?<![A-Za-z0-9_])0[bB](?:_?[01])+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.lammergeier",
          "match": "(?<![A-Za-z0-9_])[0-9](?:_?[0-9])*(?![A-Za-z0-9_])"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=[\\t ]*(?:\\[[^\\]\\n]+\\][\\t ]*)?\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.lammergeier" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.lammergeier",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
