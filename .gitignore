# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Lammergeier compiled binaries land next to the .lam source (default
# output path when ``-o`` is omitted) or in the working directory.
# Keep them out of git. We ignore every extension-less binary whose
# name matches an adjacent ``.lam`` source file, plus the legacy
# project-root patterns.
/test_*
/build/
**/lamc/
/vs-code-extension/*.vsix

# Every ``.lam`` source will, after a bare ``lamc src.lam`` invocation,
# produce a binary at the same path minus the extension. The list
# below is the manual enumeration — ``**/<stem>`` negative-matching
# isn't well-supported by the gitignore format, so we use loose
# patterns that cover the common cases without being too noisy.
**/tests/tests/cases/**/test_*
!**/tests/tests/cases/**/test_*.lam
**/tests/benchmarks/cases/**/bench_*
!**/tests/benchmarks/cases/**/bench_*.lam

# Stray root-level launcher artefacts from ad-hoc ``./lamc <name>.lam``
# invocations — keep the working copy tidy.
/lamsmtp_*
/lam_*

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Python virtual environments and tool caches
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# bunny.net API key for website/publish.sh (never commit)
website/.bunny-token
