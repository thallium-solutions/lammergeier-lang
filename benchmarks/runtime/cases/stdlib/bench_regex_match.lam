# lamre — match a moderately complex pattern against many lines.
# Today every call re-compiles via regexp.MustCompile on the fly;
# an obvious future optimisation is caching by pattern. When that
# lands this benchmark's running time should roughly halve.
#
# ops: 50000

from lamtime import Time
from lamre import Re
from lamerrors import Result

func resultBool(result: Result) -> bool {
    go! { return result.Value.(bool) }
}

func work() {
    lines: list[str] = []
    for i in range(1000) {
        lines = append(lines, f"2026-04-{i % 30:02d} INFO req_id=abc{i} path=/api/v1/items/{i}")
    }
    hits: int = 0
    for __i in range(50) {
        for line in lines {
            if resultBool(Re.match("req_id=\\w+", line)) {
                hits = hits + 1
            }
        }
    }
    if hits == 0 {
        print("unreachable")
    }
}

# Times only the workload: no process start, runtime or import costs.
func main() {
    start: int = Time.nowUnixNano()
    work()
    elapsed: int = Time.nowUnixNano() - start
    print(f"BENCH regex_match 50000 {elapsed}")
}
