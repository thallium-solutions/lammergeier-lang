# String concatenation — worst case because Lam currently lowers
# ``a + b`` on strings to naive Go concatenation. Once a stdlib
# ``strings.Builder`` shortcut lands this benchmark should drop
# sharply; until then it anchors the baseline.
#
# ops: 10000

from lamtime import Time

func work() {
    s: str = ""
    for i in range(10000) {
        s = s + "x"
    }
    # 10 000 x's — sanity-check the final length.
    if len(s) != 10000 {
        print("unreachable")
    }
}

# Times only the workload: no process start, runtime or import costs.
func main() {
    start: int = Time.nowUnixNano()
    work()
    elapsed: int = Time.nowUnixNano() - start
    print(f"BENCH string_concat 10000 {elapsed}")
}
