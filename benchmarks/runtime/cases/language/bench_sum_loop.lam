# Tight integer loop — baseline for the ``for i in range(N)`` lowering.
# Intentionally avoids any function calls so the measurement isolates
# loop overhead + int ops. A well-lowered loop should stay in the
# low-millisecond range for N=10_000_000.
#
# ops: 10000000

from lamtime import Time

func work() {
    total: int = 0
    for i in range(10000000) {
        total = total + i
    }
    if total == 0 {
        print("unreachable")
    }
}

# Times only the workload: no process start, runtime or import costs.
func main() {
    start: int = Time.nowUnixNano()
    work()
    elapsed: int = Time.nowUnixNano() - start
    print(f"BENCH sum_loop 10000000 {elapsed}")
}
