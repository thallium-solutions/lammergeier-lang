# Character access on a non-ASCII string (French accents, 126
# characters in 144 bytes): ``len(s)``, ``s[i]`` with runtime indexes (from
# both ends), short slices, a negative-bound slice and a reversal per round:
# the rune-aware path of ``str`` (characters, not bytes). The Go baseline
# converts the string to ``[]rune`` once per round.
#
# ops: 2360000

from lamtime import Time

func work() {
    text: str = "Le cœur déçu mais l'âme plutôt naïve, Louÿs rêva de crapaüter en canoë au delà des îles, près du mälström où brûlent les novæ."
    total: int = 0
    for r in range(20000) {
        n: int = len(text)
        for i in range(118) {
            if text[i] == text[n - 1 - i] {
                total += 1
            }
            if text[i:i + 2] == "o " {
                total += 2
            }
        }
        total += len(text[3:20]) + len(text[-5:]) + len(text[::-1])
    }
    if total == 0 {
        print("unreachable")
    }
}

# Times only the workload: no process start, runtime or import costs.
func main() {
    start: int = Time.nowUnixNano()
    work()
    elapsed: int = Time.nowUnixNano() - start
    print(f"BENCH string_chars_unicode 2360000 {elapsed}")
}
