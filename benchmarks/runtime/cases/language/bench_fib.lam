# Recursive fibonacci — measures function-call overhead and the
# int-arithmetic fast path. N tuned to stay under ~50ms on a modern
# laptop so a regression of ±10ms is comfortably visible in the
# best-of-3 timing.
#
# ops: 5

from lamtime import Time

func fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func work() {
    total: int = 0
    for __i in range(5) {
        total = total + fib(28)
    }
    # Consume the result so the optimiser can't eliminate the
    # recursion entirely.
    if total < 0 {
        print("unreachable")
    }
}

# Times only the workload: no process start, runtime or import costs.
func main() {
    start: int = Time.nowUnixNano()
    work()
    elapsed: int = Time.nowUnixNano() - start
    print(f"BENCH fib 5 {elapsed}")
}
