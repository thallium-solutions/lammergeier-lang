# expect-pass
# Where an optional fits, `obj?.method()` / `obj?.field` fit: `??` with a
# payload default (a plain `str`), `None` comparisons, equality with a
# payload value, an `optional[str]` parameter / variable / return, `print`,
# f-strings and `str()`.

class Shop {
    func init(self, name: str) {
        self.name: str = name
    }

    func title(self) -> str {
        return self.name
    }

    func count(self) -> int {
        return len(self.name)
    }
}

func takes(x: str) -> str {
    return x
}

func maybe(x: optional[str]) -> str {
    return x ?? "none"
}

func back(s: optional[Shop]) -> optional[str] {
    return s?.title()
}

func show(s: optional[Shop]) {
    print(takes(s?.title() ?? "d"))
    print(takes(s?.name ?? "d"))
    n: int = (s?.count() ?? 0) + 1
    c = s?.title()
    if c == None {
        print("none")
    }
    print(c != None, s?.title() == None, s?.title() == "abc", c == "abc")
    print(maybe(s?.title()), maybe(c), maybe(s?.name))
    o: optional[str] = s?.title()
    print(o ?? "", back(s) ?? "")
    print(s?.title(), c, n)
    print(f"{s?.title()} {c} {s?.count()}")
    print(str(c), str(s?.count()))
    d: str = c ?? "x"
    print(d.toUpper(), (c ?? "y").toUpper())
}

func main() {
    show(Shop("abc"))
    show(None)
}
