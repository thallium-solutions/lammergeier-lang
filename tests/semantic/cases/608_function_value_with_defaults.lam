func suffix(text: str, mark: str = "!") -> str {
    return text + mark
}

func apply(f: func(str) -> str, x: str) -> str {
    return f(x)
}

func register(handler: func(str) | (func(str) -> str)) {
    print("registered")
}

func main() {
    s: str = "a"
    print(apply(suffix, s))
    register(lambda a: suffix(a))
    register(suffix)
    print(apply(lambda a: suffix(a, "?"), s))
}
