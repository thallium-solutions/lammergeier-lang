# expect-pass
# expect-no-warning: whose type is `any`
# Items of a literal mixing a subclass and its base have the common base
# class; items of unrelated classes are usable after narrowing, through
# an annotated interface or base type, or without member access.

interface Shown {
    func show(self) -> str
}

class A {
    func init(self, n: int) { self.n: int = n }
    func show(self) -> str { return f"A{self.n}" }
}

class B(A) {
    func show(self) -> str { return f"B{self.n}" }
}

class C {
    func init(self, n: int) { self.n: int = n }
    func show(self) -> str { return f"C{self.n}" }
}

func total(xs: list[A]) -> int {
    n: int = 0
    for x in xs {
        n += x.n
    }
    return n
}

func main() {
    for x in [B(1), A(2)] {
        print(x.show(), x.n)
    }
    xs = [B(1), A(2)]
    print(total(xs), xs[0].show())
    d = {"b": B(1), "a": A(2)}
    print(d["b"].show())
    for u in [A(1), C(2)] {
        if isinstance(u, A) {
            print(u.show())
        }
        match u {
            case C() as c {
                print(c.show())
            }
            case _ {
                print(u)
            }
        }
    }
    shown: list[Shown] = [A(3), C(4)]
    for s in shown {
        print(s.show())
    }
    mixed = [A(5), C(6)]
    print(len(mixed))
    mixed = []
    print(len(mixed))
}
