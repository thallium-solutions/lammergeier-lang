# after 4.11 removed the optional type: a reference payload (a class, an
# interface, `html`, `xml`, `json`, `any`) already holds `None`, so
# `optional[X]` / `Option[X]` anywhere (parameters, results, fields,
# `Result[...]`, lists, dicts, generic arguments, casts) is a migration
# error pointing to `X`.

from lamerrors import Result

class Shop {
    name: str = ""
}

interface Named {
    func name(self) -> str
}

class Box[T] {
    value: T
}

func find(a: optional[Shop], b: Option[Shop]) -> Shop { return None }
func named() -> optional[Named] { return None }
func page() -> Result[optional[html]] { return Result.Ok(None) }

func feed(x: optional[xml]) -> xml { return x }
func doc(j: optional[json]) -> json { return j }
