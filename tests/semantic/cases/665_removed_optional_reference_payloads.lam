func boxes() -> dict[str, optional[Box[int]]] { return {} }
class Cart {
    owner: optional[Shop] = None
}
func cast(v: any) -> Shop { return v as optional[Shop] }
func pages() -> Result[list[optional[html]]] { return Result.Ok([]) }

