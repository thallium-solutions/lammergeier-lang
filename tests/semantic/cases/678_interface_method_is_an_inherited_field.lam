# expect-error: class `Catalog` does not satisfy interface `Listing`: missing method `entries`
# expect-error: `Catalog.entries` is a field (inherited from `Base`), not a method

interface Listing {
    func entries(self) -> list[str]
}

class Base {
    func init(self) {
        self.entries: list[str] = ["a"]
    }
}

class Catalog(Base) {
    func size(self) -> int {
        return 1
    }
}

func show(l: Listing) {
    print(len(l.entries()))
}

func main() {
    show(Catalog())
}
