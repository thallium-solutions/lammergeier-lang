# expect-pass
# 4.3.0: `"x" if c else None` is an `optional[str]`; it was rejected
# ("ternary branches must have compatible types: got `str` and `None`")
# even where an optional is expected: an annotated optional or `any`
# variable, an `optional` argument or return, a list item, a JSON value, a
# markup attribute (`None` omits it) and an f-string slot.

func show(v: optional[str]) -> str {
    return v ?? "-"
}

func pick(on: bool) -> optional[str] {
    return "x" if on else None
}

func main() {
    on: bool = len("ab") > 1
    a: optional[str] = "x" if on else None
    t: any = None if on else "y"
    n: optional[int] = 1 if on else None
    xs: list[optional[str]] = []
    xs.append("w" if on else None)
    doc: json = {"a": "x" if on else None}
    tag: html = <><input form="${'f' if on else None}" maxlength="${3 if on else None}"/></>
    print(show("y" if on else None), show(None if on else "z"), pick(on) ?? "", a ?? "", t, n ?? 0)
    print(len(xs), doc, tag, f"{'q' if on else None}")
}
