# expect-warning: unused catch variable `err` (prefix with `_` to silence)
# Mentioning the name inside a string literal is not a use.

from lamerrors import Result, Error

func fails() -> Result[int] {
    return Result.Err(Error("E", "boom"))
}

func main() {
    do {
        _ = fails()?
    } catch err {
        print("err: still an error")
    }
}
