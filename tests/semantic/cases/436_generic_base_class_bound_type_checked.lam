# expect-error: cannot assign `int` to `str` variable `s`

class Box[T] {
    func init(self, value: T) {
        self.value: T = value
    }
    func get(self) -> T {
        return self.value
    }
}

class IntBox(Box[int]) {
    func init(self, value: int) {
        base.init(value)
    }
}

func main() {
    b: IntBox = IntBox(2)
    s: str = b.get()
    print(s)
}
