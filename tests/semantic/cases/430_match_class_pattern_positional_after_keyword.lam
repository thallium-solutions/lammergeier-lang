# expect-error: positional sub-patterns must come before keyword sub-patterns

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

func main() {
    p: Point = Point(1, 2)
    match p {
        case Point(x=1, b) { print(b) }
        case _ { print("other") }
    }
}
