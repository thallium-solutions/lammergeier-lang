# Calling a function-typed value checks its arguments against the declared
# `func(...)` type, as for a named function (they failed in go build).
func apply(cb: func(int, str) -> int) -> int {
    return cb(1, 2)
}

func main() {
    f: func(int) -> int = lambda (x: int) -> int: x + 1
    print(f("a"))
    print(f())
    print(f(1, 2))
    print(f(x=1))
    print(f(3), apply(lambda (a: int, b: str) -> int: a + len(b)))
}
