# expect-pass
# Inferred constructor type arguments (4.1.3): from literals, typed locals,
# comprehensions (where the target names the type), nested generics, and in
# returns and arguments.
class Box[T] {
    func init(self, items: list[T]) {
        self.items: list[T] = items
    }

    func first(self) -> T {
        return self.items[0]
    }
}

class Pair[K, V] {
    func init(self, key: K, value: V) {
        self.key: K = key
        self.value: V = value
    }
}

func names() -> Box[str] {
    return Box(["a", "b"])
}

func total(b: Box[int]) -> int {
    return len(b.items)
}

func main() {
    a: Box[int] = Box([1, 2])
    xs: list[float] = [1.0, 2.0]
    b: Box[float] = Box(xs)
    c: Box[float] = Box([x / 2.0 for x in xs])
    d: Box[list[str]] = Box([["x"], ["y"]])
    p: Pair[str, int] = Pair("k", 3)
    inferred = Box([10, 20])
    print(a.first() + inferred.first(), b.items, c.items, d.first(), p.value, names().first(), total(Box([7])))
}
