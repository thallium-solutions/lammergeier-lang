class Box[T] {
    func init(self, items: list[T] = []) {
        self.items: list[T] = items
    }
}

class Pair[K, V] {
    func init(self, key: optional[K] = None, value: optional[V] = None) {
        self.key: optional[K] = key
        self.value: optional[V] = value
    }
}

func firstOf[T](xs: list[T] = []) -> int { return len(xs) }
func ident[T](x: optional[T]) -> optional[T] { return x }
func merge[T](xs: list[T], extra: list[T] = []) -> list[T] { return xs + extra }

func main() {
    print(firstOf())
    b = Box()
    print(ident(None))
    ints: list[int] = merge([])
    p = Pair()
    c: Box[int] = Box([])
    print(len(b.items), len(ints), p.key, len(c.items))
}
