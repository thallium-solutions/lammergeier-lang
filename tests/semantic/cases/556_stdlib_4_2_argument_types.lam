# expect-error: argument `key` to `Json.getInt` has type `int`, expected `str`
# expect-error: argument `fallback` to `Json.getStr` has type `int`, expected `str`
# expect-error: argument `layouts` to `DateTime.parseAny` has type `str`, expected `list[str]`
# expect-error: argument `s` to `Conv.parseFinite` has type `float`, expected `str`
# expect-error: argument `delimiter` to `Csv.formatAll` has type `int`, expected `str`
# expect-error: argument `s` to `Url.encodeComponent` has type `int`, expected `str`
# The 4.2 stdlib additions are typed like the rest of the stdlib.
from lamjson import Json
from lamdatetime import DateTime
from lamconv import Conv
from lamcsv import Csv
from lamurl import Url

func main() {
    doc: json = {"a": 1}
    _ = Json.getInt(doc, 1)
    _ = Json.getStr(doc, "a", 0)
    _ = DateTime.parseAny("2026-11-03", "2006-01-02")
    _ = Conv.parseFinite(1.5)
    _ = Csv.formatAll([["a"]], 59)
    _ = Url.encodeComponent(42)
}
