# The developer-experience lint checks (warnings; errors under `lamc --strict`):
# self-assignment, a repeated `elif` condition, SQL and `Exec.run` commands
# built from values, a self-comparison, a loop variable overwriting a
# parameter, unused private functions and methods, an async task never
# awaited. Quiet: constants and numbers in SQL, `?` parameters, the NaN test
# `x != x` of a float, used private members, a kept task.
from lamdb import Db
from lamexec import Exec

const Columns: str = "id, name"

class Box {
    func init(self) {
        self.v: int = 1
    }

    private func unusedMethod(self) -> int {
        return 1
    }

    private func usedMethod(self) -> int {
        return 2
    }

    func get(self) -> int {
        return self.usedMethod()
    }
}

private func unusedFn() -> int {
    return 1
}

private func usedFn() -> int {
    return 2
}

func run(db: Db, name: str, n: int, ratio: float) {
    x: int = n
    x = x
    if n > 1 {
        print("a")
    } elif n > 1 {
        print("b")
    }
    rows = db.query(f"SELECT {Columns} FROM users WHERE name = '{name}'")
    ok = db.query(f"SELECT {Columns} FROM users WHERE id = ?", [n])
    count = db.query("SELECT * FROM t WHERE a = " + name)
    lim = db.query(f"SELECT * FROM t LIMIT {n}")
    print(rows, ok, count, lim, Exec.run(f"ls {name}"), Exec.run("ls -l"))
    if n == n {
        print("same")
    }
    print(ratio != ratio)
    for n in [1, 2] {
        print(n)
    }
    print(usedFn(), Box().get())
}

func main() {
    print(1)
}

async func side() {
    print("s")
}

func tasks() {
    side()
    t = side()
    await t
}
