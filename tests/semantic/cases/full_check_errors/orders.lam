from .fields import FieldError

func invoice(total: int) -> str {
    return f"total {total}"
}

func label(n: int) -> str {
    return n
}

func ids() -> generator[int] {
    yield "a"
}

func summary(errors: list[FieldError]) -> int {
    return len(errors)
}

func render() -> str {
    keys: list[str] = ["a"]
    count: int = "many"
    return invoice("12") + str(summary(keys)) + str(count)
}
