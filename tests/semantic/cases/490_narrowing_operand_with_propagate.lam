# expect-error: unknown member `s.side` on class `Shape`
# expect-error: `s` is not narrowed to `Square` in an operand using `?`
# An `and` operand holding `?` is not narrowed (its propagation runs before
# the test); the error says so.

from lamerrors import Result, Error

class Shape {
    func init(self, name: str) {
        self.name: str = name
    }
}

class Square(Shape) {
    func init(self, side: int) {
        base.init("square")
        self.side: int = side
    }
}

func checked(n: int) -> Result[int] {
    return Result.Ok(n)
}

func f(s: Shape) -> Result[int] {
    if isinstance(s, Square) and checked(s.side)? > 1 {
        return Result.Ok(1)
    }
    return Result.Ok(0)
}

func main() {
    print(f(Square(2)).unwrap())
}
