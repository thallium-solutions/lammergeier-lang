from lamerrors import Result

func one() -> Result[int] {
    return Result.Ok(1)
}

func results() -> generator[Result[int]] {
    yield Result.Ok(2)
}

func main() {
    r: Result[int] = one()
    print(r.ok(), r.unwrap(), r.unwrapOr(0), r.value, r.error)
    print(r.isOk())
    print(r.unwrapOrElse(0))
    for g in results() {
        print(g.isErr())
    }
    for x in [one()] {
        print(x.payload)
    }
    print(one().isOk())
}
