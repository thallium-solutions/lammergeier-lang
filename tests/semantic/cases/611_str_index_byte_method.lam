# expect-error: `byte` has no method `toUpper`; indexing a `str` gives a `byte`: use `string(w[0]).toUpper()` for a one-character `str`
# expect-error: `byte` has no method `toLower`; indexing a `str` gives a `byte`: use `string(w[-1]).toLower()` for a one-character `str`
# expect-error: `byte` has no method `toUpper`; indexing a `str` gives a `byte`: use `string(x[0]).toUpper()` for a one-character `str`
# expect-error: `byte` has no method `isDigit`; indexing a `str` gives a `byte`: use `string(self.code[1]).isDigit()` for a one-character `str`
# expect-error: `byte` has no method `repeat`; indexing a `str` gives a `byte`: use `string(w[i]).repeat(...)` for a one-character `str`
# expect-error: `byte` has no method `toUpper`; indexing a `str` gives a `byte`: use `string(name[0]).toUpper()` for a one-character `str`
# expect-error: `byte` has no method `toUpper`; convert it with `string(data[0])` or `int(data[0])`
# expect-error: `byte` has no method `toUpper`; convert it with `string(b)` or `int(b)`
# expect-error: `int` has no method `toUpper`
# expect-error: `float` has no method `round`
# expect-error: `bool` has no method `toString`
# Indexing a `str` with one integer gives a `byte` (docs/SYNTAX.md,
# "Slicing"), which has no methods: `w[0].toUpper()` passed the checker and
# failed only in `go build` (`cannot use w[0] (value of type byte) as string
# value in argument to Strings_toUpper`), in comprehensions, on fields and
# with negative or computed indexes too. Methods on `int`, `float` and
# `bool` values failed the same way (`n.ToUpper undefined`).

class Card {
    func init(self, code: str) {
        self.code: str = code
    }

    func valid(self) -> bool {
        return self.code[1].isDigit()
    }
}

func initial(name: str) -> str {
    return name[0].toUpper()
}

func main() {
    w: str = "hello"
    i: int = 1
    print(w[0].toUpper())
    print(w[-1].toLower())
    print([x[0].toUpper() for x in ["ab", "cd"]])
    print(w[i].repeat(2))
    data: bytes = bytes("hi")
    print(data[0].toUpper())
    b: byte = data[1]
    print(b.toUpper())
    n: int = 3
    print(n.toUpper())
    f: float = 1.5
    print(f.round())
    ok: bool = true
    print(ok.toString())
    print(Card("a1").valid(), initial("bob"))
}
