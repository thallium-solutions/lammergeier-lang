class User {
    name: str = ""
    friend: User = None

    func greet(self) -> str {
        return "hi"
    }
}

func find() -> User {
    return None
}

func main() {
    u: User = find()
    v: any = None
    print(u?.name)
    print(u?.greet())
    print(u?.friend?.name)
    print(v?.anything)
    print(f"{u?.greet()}")
    f = lambda (x: User) -> str: x?.name
    print(find()?.name)
    print(f(u))
}
