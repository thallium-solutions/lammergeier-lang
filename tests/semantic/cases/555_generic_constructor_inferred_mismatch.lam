# expect-error: cannot assign `Box[int]` to `Box[str]` variable `labels`
# A generic class's type arguments are inferred from its constructor's
# arguments (4.1.3): `Box([1, 2])` is a `Box[int]`, not a `Box[str]`.
class Box[T] {
    func init(self, items: list[T]) {
        self.items: list[T] = items
    }
}

func main() {
    labels: Box[str] = Box([1, 2])
    print(labels.items)
}
