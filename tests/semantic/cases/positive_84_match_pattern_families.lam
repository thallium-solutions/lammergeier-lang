# expect-pass
# expect-no-warning: warning[match]
# Every pattern family type-checks: bindings get their element / field
# types, captures are exhaustive, value patterns resolve dotted names.

class Color {
    static RED: int = 0
    static BLUE: int = 2
}

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

func classify(v: any) -> str {
    match v {
        case [int(a), int(b)] {
            total: int = a + b
            return f"pair {total}"
        }
        case {"name": str(name), **rest} {
            upper: str = name
            return f"named {upper} {len(rest)}"
        }
        case Point(x, y=0) as p {
            moved: int = p.x + x
            return f"x-axis {moved}"
        }
        case 1 | 2 | 3 as small { return f"small {small}" }
        case other { return "other" }
    }
}

func colour(c: int) -> str {
    match c {
        case Color.RED | Color.BLUE { return "primary" }
        case _ { return "other" }
    }
}

func heads(xs: list[str]) -> str {
    match xs {
        case [first, *rest] {
            more: list[str] = rest
            label: str = first
            return f"{label} +{len(more)}"
        }
        case [] { return "empty" }
    }
    return "unreachable"
}

func pairs(t: tuple[str, int]) -> int {
    match t {
        case (name, count) {
            label: str = name
            return count + len(label)
        }
    }
    return 0
}

func payload(j: json) -> int {
    match j {
        case {"items": [first, *_]} {
            value: json = first
            return 1
        }
        case _ { return 0 }
    }
}

func main() {
    print(classify([1, 2]))
    print(colour(0))
    print(heads(["a"]))
    print(pairs(("x", 1)))
    print(payload({"items": [1]}))
}
