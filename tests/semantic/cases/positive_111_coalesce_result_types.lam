# expect-pass
# `??` results are typed: a `Result` payload through `?` has the payload's
# type (an int widens into a float fallback), chains compose, and a class
# reference with a fallback of its class is the class. (after 4.11: the removed
# `optional[int]` results became `Result[int]` payloads.)
from lamerrors import Result

class User {
    func init(self, name: str) {
        self.name: str = name
        self.age: int = 0
    }
}

func find(n: int) -> Result[int] {
    if n > 0 {
        return Result.Ok(n)
    }
    nothing: any = None
    return Result.Ok(nothing)
}

func lookup() -> User {
    return None
}

func ratio() -> Result[float] {
    w = find(1)? ?? 0
    return Result.Ok(1.5 * (100 - w))
}

func values() -> Result[float] {
    w = find(4)? ?? 0
    x: float = find(1)? ?? 2
    y = find(0)? ?? 3
    return Result.Ok(1.5 * (100 - w) + x + float(y + 1))
}

func main() {
    u = lookup() ?? User("x")
    a: int = u.age
    s: str = (lookup() ?? u).name
    print(a, s, ratio().unwrap(), values().unwrap())
}
