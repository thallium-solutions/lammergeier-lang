# expect-error: class `Both` inherits ambiguous member `label` from `Left` and `Right`; override it in `Both` or use named base aliases

class Left {
    func label(self) -> str {
        return "left"
    }
}

class Right {
    func label(self) -> str {
        return "right"
    }
}

class Both(Left, Right) {
    func value(self) -> str {
        return "both"
    }
}

func main() {
    b: Both = Both()
    print(b.value())
}
