# expect-error: case pattern `"zero"` can never match a value of type `int`

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

func main() {
    p: Point = Point(0, 0)
    match p {
        case Point(x="zero") { print("zero") }
        case _ { print("other") }
    }
}
