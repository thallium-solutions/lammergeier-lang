# expect-no-warning: ternary branches must have compatible types
# After 4.11: `"x" if c else None` is an `any` (a `str` cannot be `None`): a new
# variable without annotation takes it (it was an error, then an
# `optional[str]`), but a `str` variable or parameter does not.
func greet(name: str) -> str {
    return "hi " + name
}

func main(on: bool) {
    v = "x" if on else None
    s: str = "x" if on else None
    print(v, s, greet("y" if on else None))
}
