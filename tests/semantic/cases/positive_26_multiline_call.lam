# expect-pass

func add(a: int, b: int) -> int {
    return a + b
}

func takesNamed(left: int, right: int) -> int {
    return left + right
}

func main() {
    value: int = add(
        1,
        2,
    )
    named: int = takesNamed(
        left=3,
        right=4,
    )
    print(value + named)
}
