from lamerrors import Result

func count() -> int {
    return None
}
func load() -> Result[int] {
    return Result.Ok(None)
}
func tag(label: str = None) -> str { return label }
func greet(name: str) -> str { return name }

func main(on: bool) {
    print(count(), load(), tag())
    s: str = None
    n: int = None
    xs: list[int] = None
    t: str = "a" if on else None
    print(greet("b" if on else None))
    r: Result[str] = Result.Ok(None)
    print(s, n, xs, t, r)
    deep: str = "a" if on else ("b" if not on else None)
    print(deep)
}
