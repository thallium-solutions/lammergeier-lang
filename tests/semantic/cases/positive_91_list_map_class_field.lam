# expect-pass
# `.map(lambda p: p.name)` over `list[Person]` yields `list[str]`.

class Person {
    func init(self, name: str, age: int) {
        self.name: str = name
        self.age: int = age
    }
}

func main() {
    people: list[Person] = [Person("ann", 30)]
    names: list[str] = people.map(lambda p: p.name)
    ages: list[int] = people.map(lambda p: p.age + 1)
    print(names, ages)
}
