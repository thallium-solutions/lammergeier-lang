# expect-pass
# Chains, generic receivers, class payloads, `any` and `json` results.

class Box[T] {
    func init(self, v: T) {
        self.v: T = v
    }

    func get(self) -> T {
        return self.v
    }
}

class Profile {
    func init(self, email: str) {
        self.email: str = email
    }

    func mail(self) -> str {
        return self.email
    }

    func alias(self) -> optional[str] {
        return None
    }

    func raw(self) -> any {
        return 1
    }

    func doc(self) -> json {
        return {"a": 1}
    }
}

class User {
    func init(self) {
        self.profile: optional[Profile] = Profile("a@b")
    }

    func prof(self) -> optional[Profile] {
        return self.profile
    }
}

func takeProfile(p: Profile) -> str {
    return "p"
}

func takeAny(x: any) -> str {
    return "any"
}

func show(u: optional[User], b: optional[Box[int]]) {
    m: str = u?.prof()?.mail() ?? "none"
    e: str = u?.profile?.email ?? "none"
    a: optional[str] = u?.prof()?.alias()
    k: int = b?.get() ?? 0
    w: int = (b?.get() ?? 0) * 2
    p: optional[Profile] = u?.prof()
    print(m, e, a ?? "", k, w, p == None)
    print(takeProfile(u?.prof()))
    print(takeAny(u?.prof()?.raw()), takeAny(u?.prof()))
    j: json = {"x": 1}
    print(j?.x)
}

func main() {
    show(User(), Box[int](2))
}
