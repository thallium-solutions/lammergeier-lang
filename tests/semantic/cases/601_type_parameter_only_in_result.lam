# expect-error: line 18: error[type]: cannot infer type parameter `V` of `pick`
# expect-error: line 19: error[type]: cannot infer type parameter `R` of `make`
# A type parameter no parameter of a function mentions (only its result,
# or nothing) cannot be inferred by Go ("cannot infer V" in `go build`);
# it is a Lam error asking for the type arguments, which work. An
# annotated variable the call initializes binds it (`xs: list[int] =
# make()` emits `Make[int]()`); an unannotated one does not.

func pick[K, V](keys: list[K]) -> int {
    return len(keys)
}

func make[R]() -> list[R] {
    return []
}

func main() {
    print(pick(["a"]))
    zs = make()
    print(pick[str, int](["a"]))
    ys: list[str] = make[str]()
    xs: list[int] = make()
    print(len(xs) + len(ys) + len(zs))
}
