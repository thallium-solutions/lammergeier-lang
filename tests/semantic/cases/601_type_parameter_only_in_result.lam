# expect-error: line 16: error[type]: cannot infer type parameter `V` of `pick`
# expect-error: line 17: error[type]: cannot infer type parameter `R` of `make`
# A type parameter no parameter of a function mentions (only its result,
# or nothing) cannot be inferred by Go ("cannot infer V" in `go build`);
# it is a Lam error asking for the type arguments, which work.

func pick[K, V](keys: list[K]) -> int {
    return len(keys)
}

func make[R]() -> list[R] {
    return []
}

func main() {
    print(pick(["a"]))
    xs: list[int] = make()
    print(pick[str, int](["a"]))
    ys: list[str] = make[str]()
    print(len(xs) + len(ys))
}
