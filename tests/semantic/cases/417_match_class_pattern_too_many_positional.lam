# expect-error: class pattern `Point()` accepts at most 2 positional sub-patterns

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

func main() {
    p: Point = Point(1, 2)
    match p {
        case Point(a, b, c) { print(a) }
        case _ { print("other") }
    }
}
