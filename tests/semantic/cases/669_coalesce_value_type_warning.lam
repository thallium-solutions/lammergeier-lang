from lamerrors import Result

class User {
    age: int = 0
}

func label() -> str { return "l" }
func load() -> Result[str] { return Result.Ok("x") }

func run() -> Result[str] {
    name: str = "ada"
    u: User = None
    xs: list[int] = [1]
    v: any = None
    print(name ?? "anon")
    print(u.age ?? 0)
    print(xs ?? [])
    print(label() ?? "x")
    w = u ?? User()
    d: dict[str, int] = {}
    print(w.age, v ?? 1, load()? ?? "none", d["k"] ?? 0)
    return Result.Ok(name)
}

func main() {
    _ = run()
}
