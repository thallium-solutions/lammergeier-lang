# expect-pass
# `f()?.m()` on a `Result` is propagation followed by a call, not safe
# navigation: the payload's method result keeps its own type.

from lamerrors import Result

class Box {
    func init(self, v: int) {
        self.v: int = v
    }

    func label(self) -> str {
        return f"box {self.v}"
    }
}

func load(k: int) -> Result[Box] {
    return Result.Ok(Box(k))
}

func takes(x: str) -> str {
    return x
}

func run() -> Result[str] {
    t: str = takes(load(1)?.label())
    n: int = load(2)?.v + 1
    r: Result[Box] = load(3)
    m: int = r?.v
    return Result.Ok(f"{t} {n} {m}")
}

func main() {
    print(run().unwrap())
}
