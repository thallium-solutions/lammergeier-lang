# expect-error: unknown keyword argument `colour` in call to `Puppy`

class Animal {
    func init(self, name: str, age: int = 1) {
        self.name: str = name
        self.age: int = age
    }
}

class Dog(Animal) {
}

class Puppy(Dog) {
}

func main() {
    p: Puppy = Puppy("bolt", colour="brown")
    print(p.name)
}
