# expect-error: cannot assign `byte` to `str` variable `first`; indexing a `str` gives a `byte`: use `string(w[0])` for a one-character `str`
# expect-error: cannot compare `byte` and `str`; indexing a `str` gives a `byte`: use `string(w[0])` for a one-character `str`
# expect-error: cannot compare `str` and `byte`; indexing a `str` gives a `byte`: use `string(w[-1])` for a one-character `str`
# expect-error: cannot add `str` and `byte`; indexing a `str` gives a `byte`: use `string(w[-1])` for a one-character `str`
# expect-error: argument `s` to `shout` has type `byte`, expected `str`; indexing a `str` gives a `byte`: use `string(w[1])` for a one-character `str`
# expect-error: function `head` returns `byte`, expected `str`; indexing a `str` gives a `byte`: use `string(s[0])` for a one-character `str`
# The existing `byte` / `str` mismatches of a `str` index name the
# conversion to a one-character `str`.

func shout(s: str) -> str {
    return s.toUpper()
}

func head(s: str) -> str {
    return s[0]
}

func main() {
    w: str = "hello"
    first: str = w[0]
    print(w[0] == "h")
    print("o" != w[-1])
    print("x" + w[-1])
    print(shout(w[1]))
    print(first, head(w))
}
