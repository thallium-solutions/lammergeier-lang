# expect-pass

from lamerrors import Result

class Counter {
    func value(self) -> int {
        return 1
    }
}

func methodValue() -> int {
    counter = Counter()
    return counter.value()
}

func selected(ok: bool) -> int {
    return 1 if ok else 2
}

func values() -> list[int] {
    return [i for i in range(2)]
}

func wrapped() -> Result[int] {
    return Result.Ok(methodValue())
}
