# Transpilation: `expr as T` lowers to the conversion an annotated
# assignment to `T` uses. From `any`: a checked assertion for scalars and
# classes (`None` stays nil), the int-widening converter for `float`, an
# element-by-element conversion for typed lists. From a concrete type: the
# value itself (same type), `float64(n)` (int as float), the base view of
# a subclass instance (upcast), and a checked `_lamIs_<C>` downcast of a
# base-typed value (nil stays nil). Casts are Go primary expressions, so
# `row["count"] as int + 1` needs no parentheses.
# expect-go: var a int = interface{}(row["count"]).(int) + 1
# expect-go: var b float64 = func(v interface{}) float64 { if n, ok := v.(int); ok { return float64(n) }; return v.(float64) }(row["ratio"]) * 2.0
# expect-go: func(v interface{}) *User { if v == nil { return nil }; return v.(*User) }(Lookup("user")).Name
# expect-go: src := v.([]interface{}); out := make([]string, len(src))
# expect-go: var d float64 = float64(n) / 2.0
# expect-go: var e int = (n + 1) * 2
# expect-go: Describe(sq._lamUp_Shape())
# expect-go: func(v interface{}) *Square { if v == nil { return nil }; return v.(interface{ _lamIs_Square() *Square })._lamIs_Square() }(s._lamDyn()).Side
# expect-go: var g interface{} = n

class User {
    func init(self, name: str) { self.name: str = name }
}

class Shape {
    func area(self) -> int { return 0 }
}

class Square(Shape) {
    func init(self, side: int) { self.side: int = side }
    func area(self) -> int { return self.side * self.side }
}

func lookup(key: str) -> any {
    return User(key)
}

func describe(s: Shape) -> int {
    return s.area()
}

func main() {
    row: dict[str, any] = {"count": 41, "ratio": 1, "items": ["x", "y"]}
    n: int = 3
    a: int = row["count"] as int + 1
    b: float = row["ratio"] as float * 2.0
    print((lookup("user") as User).name)
    for item in row["items"] as list[str] {
        print(item.toUpper())
    }
    d: float = n as float / 2.0
    e: int = (n + 1) as int * 2
    sq: Square = Square(2)
    s: Shape = sq
    print(describe(sq as Shape), (s as Square).side)
    g: any = n as any
    print(a, b, d, e, g)
}
