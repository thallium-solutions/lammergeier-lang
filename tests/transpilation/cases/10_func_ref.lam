# Transpilation: bare user-function references resolve to their Go
# public name so they can be passed as first-class values.
# expect-go: Apply(Double, 5)
# expect-go: func Double(x int) int

func double(x: int) -> int {
    return x * 2
}

func apply(fn: any, x: int) -> int {
    go! {
        if f, ok := fn.(func(int) int); ok {
            return f(x)
        }
        return 0
    }
}

func main() {
    print(apply(double, 5))
}
