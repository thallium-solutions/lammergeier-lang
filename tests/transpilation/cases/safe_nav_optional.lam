# ``obj?.method(args)`` on a receiver of known type lowers to a typed
# optional: the receiver is evaluated once into ``__lamR``, the method is
# called like a plain call (class-aware names, typed arguments) and a value
# result is boxed (``*string``); a class result stays its pointer, a void
# method is a guarded statement, and an ``optional[str]`` receiver calls the
# method on the value it holds (``*__lamR``). An optional value compares by
# value with a payload or another optional, and ``str()`` shows the value.
# expect-go: x := func() *string { if __lamR := s; __lamR != nil { __lamV := __lamR.Title(); return &__lamV }; return nil }()
# expect-go: p := func() *Shop { if __lamR := s; __lamR != nil { return __lamR.Self_() }; return nil }()
# expect-go: func() { if __lamR := s; __lamR != nil { __lamR.Bump(2) } }()
# expect-go: u := func() *string { if __lamR := x; __lamR != nil { __lamV := Strings_toUpper((*__lamR)); return &__lamV }; return nil }()
# expect-go: func(__lamA *string, __lamB string) bool { return __lamA != nil && *__lamA == __lamB }(x, "abc")
# expect-go: func(__lamA, __lamB *string) bool { if __lamA == nil || __lamB == nil { return __lamA == __lamB }; return *__lamA == *__lamB }(x, u)
# expect-go: fmt.Sprintf("%v", func() interface{} { if __lamP := x; __lamP != nil { return *__lamP }; return nil }())

class Shop {
    func init(self, name: str) {
        self.name: str = name
        self.n: int = 0
    }

    func title(self) -> str {
        return self.name
    }

    func self_(self) -> Shop {
        return self
    }

    func bump(self, by: int) {
        self.n += by
    }
}

func main() {
    s: optional[Shop] = Shop("abc")
    x = s?.title()
    p = s?.self_()
    s?.bump(2)
    u = x?.toUpper()
    print(x == "abc", x == u, str(x), p == None)
}
