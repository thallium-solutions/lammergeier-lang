# Transpilation: async class methods return one-slot handles of result thunks.
# expect-go: func (s *AsyncBox[T]) Get() chan func() T {
# expect-go: __lam_async_ch := make(chan func() T, 1)
# expect-go: __lamTask := lamAsyncTaskFailed(r)
# expect-go: select { case __lam_async_ch <- func() T { lamAsyncTaskRetrieved(__lamTask); panic(r) }: default: }
# expect-go: var __lamAsyncV T = s.Value
# expect-go: __lam_async_ch <- func() T { return __lamAsyncV }
# expect-go: func AsyncBox_echo[T any](value T) chan func() T {
# expect-go: func (s *Secrets) hidden(value int) chan func() *Result {
# expect-go: __lam_async_ch := make(chan func() *Result, 1)
# expect-go: func secrets_hiddenStatic(value int) chan func() string {
# expect-go: var __lamAsyncV *Result = (<-s.hidden(value))()
# expect-go: var __lamAsyncV string = (<-secrets_hiddenStatic(value))()

from lamerrors import Result

class AsyncBox[T] {
    func init(self, value: T) {
        self.value: T = value
    }

    async func get(self) -> T {
        return self.value
    }

    static async func echo(value: T) -> T {
        return value
    }
}

class Secrets {
    private async func hidden(self, value: int) -> Result[int] {
        return Result.Ok(value)
    }

    async func reveal(self, value: int) -> Result[int] {
        return await self.hidden(value)
    }

    private static async func hiddenStatic(value: int) -> str {
        return f"secret-{value}"
    }

    static async func revealStatic(value: int) -> str {
        return await Secrets.hiddenStatic(value)
    }
}

func main() {
    box: AsyncBox[int] = AsyncBox[int](42)
    value: int = await box.get()
    echoed: int = await AsyncBox.echo(42)
    result: Result[int] = await Secrets().reveal(value)
    print(echoed)
    print(result.ok())
    print(await Secrets.revealStatic(value))
}
