from lamerrors import Result

func choose(seed: int, label: str = "value") -> int { return seed + 1 }
func choose(seed: int, label: str = "value") -> str { return f"{label}-{seed}" }

func payload(seed: int) -> Result[int] { return Result.Ok(seed) }
func payload(seed: int) -> Result[str] { return Result.Ok(str(seed)) }

class GenericSource[T] {
    func init(self, value: T) { self.value: T = value }
    func select(self, seed: int) -> int { return seed }
    func select(self, seed: int) -> str { return str(seed) }
}

func main() {
    defaulted: str = choose(seed=2)
    keyword: str = choose(label="bird", seed=3)
    values: list[str] = [choose(4), choose(5)]
    intResult: Result[int] = payload(6)
    strResult: Result[str] = payload(6)
    source: GenericSource[str] = GenericSource[str]("source")
    selected: str = source.select(7)
    print(defaulted, keyword, values, intResult, strResult, selected)
}
