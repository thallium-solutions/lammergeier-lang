class Source {
    static func pick(seed: int) -> int { return seed }
    static func pick(seed: int) -> str { return str(seed) }
    func value(self, seed: int) -> float { return float(seed) }
    func value(self, seed: int) -> bool { return seed > 0 }
}

func main() {
    source: Source = Source()
    integer: int = Source.pick(1)
    text: str = Source.pick(1)
    decimal: float = source.value(2)
    flag: bool = source.value(2)
    print(integer, text, decimal, flag)
}
