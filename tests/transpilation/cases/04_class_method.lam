# Transpilation: class -> struct + NewClass + method on (s *Class).
# expect-go: type Point struct {
# expect-go: func NewPoint(x int, y int) *Point
# expect-go: func (s *Point) Distance(other *Point) float64

class Point {
    func __init__(self, x: int, y: int) {
        self.x = x
        self.y = y
    }

    func distance(self, other: Point) -> float {
        dx: int = self.x - other.x
        dy: int = self.y - other.y
        return float((dx * dx) + (dy * dy))
    }
}

func main() {
    p: Point = Point(0, 0)
    q: Point = Point(3, 4)
    print(p.distance(q))
}
