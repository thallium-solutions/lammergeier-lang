# Generic code holds `optional[T]` as a Go `*T`, so with `T = User` a
# `**User`, while the program's `optional[User]` is the class pointer: the
# call result is dereferenced (nil-checked), arguments, field stores and
# list appends are boxed, `len` reads the stored list, and an override
# returning `optional[User]` satisfies the generic base's dispatch through
# an adapter.
# expect-go: var u *User = func(__lamB0 **User) *User { if __lamB0 == nil { return nil }; return *__lamB0 }(s._lamVirt_At(0))
# expect-go: s.Put(func(__lamB0 *User) **User { if __lamB0 == nil { return nil }; return &__lamB0 }(u))
# expect-go: s.Last = func(__lamB0 *User) **User { if __lamB0 == nil { return nil }; return &__lamB0 }(NewUser("b"))
# expect-go: s.Slots = append(s.Slots, func(__lamB0 *User) **User { if __lamB0 == nil { return nil }; return &__lamB0 }(nil))
# expect-go: len(s.Slots)
# expect-go: func (s *Users) _lamOv_Shelf_At(_i int) **User { return func(__lamB0 *User) **User { if __lamB0 == nil { return nil }; return &__lamB0 }(s.At(_i)) }

class User {
    func init(self, name: str) {
        self.name: str = name
    }
}

class Shelf[T] {
    func init(self, items: list[T]) {
        self.items: list[T] = items
        self.last: optional[T] = None
        self.slots: list[optional[T]] = []
    }

    func at(self, i: int) -> optional[T] {
        if i < 0 or i >= len(self.items) {
            return None
        }
        return self.items[i]
    }

    func put(self, x: optional[T]) {
        self.last = x
    }
}

class Users(Shelf[User]) {
    func init(self, items: list[User]) {
        base.init(items)
    }

    func at(self, _i: int) -> optional[User] {
        return None
    }
}

func main() {
    s: Shelf[User] = Shelf[User]([User("a")])
    u: optional[User] = s.at(0)
    s.put(u)
    s.last = User("b")
    s.slots.append(None)
    print(u?.name ?? "-", s.last?.name ?? "-", len(s.slots), Users([]).at(0) == None)
}
