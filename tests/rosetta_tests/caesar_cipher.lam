# Rosetta Code: Caesar cipher
# https://rosettacode.org/wiki/Caesar_cipher
# expect: Khoor Zruog
# expect: Hello World

func caesar_encrypt(text: str, shift: int) -> str {
    result: str = ""
    for i in range(len(text)) {
        c: int = int(text[i])
        if c >= 65 and c <= 90 {
            c = (c - 65 + shift) % 26 + 65
        } elif c >= 97 and c <= 122 {
            c = (c - 97 + shift) % 26 + 97
        }
        result = result + string(rune(c))
    }
    return result
}

func caesar_decrypt(text: str, shift: int) -> str {
    return caesar_encrypt(text, 26 - shift)
}

func main() {
    encrypted: str = caesar_encrypt("Hello World", 3)
    print(encrypted)
    decrypted: str = caesar_decrypt(encrypted, 3)
    print(decrypted)
}
