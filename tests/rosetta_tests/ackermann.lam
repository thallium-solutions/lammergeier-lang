# Rosetta Code: Ackermann function
# https://rosettacode.org/wiki/Ackermann_function
# expect: 2
# expect: 3
# expect: 4
# expect: 5
# expect: 3
# expect: 4
# expect: 5
# expect: 6
# expect: 5
# expect: 7

func ackermann(m: int, n: int) -> int {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ackermann(m - 1, 1)
    }
    return ackermann(m - 1, ackermann(m, n - 1))
}

func main() {
    for m in range(3) {
        for n in range(1, 5) {
            if m == 2 and n > 2 {
                continue
            }
            print(ackermann(m, n))
        }
    }
}
