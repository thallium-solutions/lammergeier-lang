# Rosetta Code: Dot product
# https://rosettacode.org/wiki/Dot_product
# expect: 3

func dot_product(a: list[int], b: list[int]) -> int {
    result: int = 0
    for i in range(len(a)) {
        result += a[i] * b[i]
    }
    return result
}

func main() {
    a: list[int] = [1, 3, -5]
    b: list[int] = [4, -2, -1]
    print(dot_product(a, b))
}
