# Integration test: fan-out / fan-in style "crawler".
#
# Spawns N goroutines that pretend to fetch a remote document
# (here: just compute the square of their worker id), pushes the
# result to a channel, and the main loop fans the values back in
# through a WaitGroup-coordinated drain.
#
# Stresses lamconcurrency's WaitGroup + Channel through Lam async orchestration
# without reaching through Channel's runtime boundary.
#
# expect: total=285
# expect: count=10
# expect: max_seen=81
# expect: crawler_ok

from lamconcurrency import Channel, WaitGroup

async func runWorker(id: int, results: Channel, wg: WaitGroup) -> bool {
    # The "fetch": compute id*id. Real crawler would call lamhttp here.
    sq: int = id * id
    results.send(sq).unwrap()
    wg.done()
    return true
}

func main() {
    n: int = 10
    results: Channel = Channel(n)
    wg: WaitGroup = WaitGroup()

    # Fan out: async calls start immediately and return buffered handles.
    i: int = 0
    while i < n {
        wg.add(1)
        _ = runWorker(i, results, wg)
        i = i + 1
    }

    # Wait for all workers to finish, then close before draining the
    # buffered results through the Result-based receive API.
    wg.wait()
    results.close().unwrap()

    # Fan in: drain exactly the values produced before the close.
    total: int = 0
    count: int = 0
    maxSeen: int = 0
    while count < n {
        value: int = results.receive().unwrap()
        total += value
        count += 1
        if value > maxSeen {
            maxSeen = value
        }
    }

    print(f"total={total}")        # 0+1+4+9+16+25+36+49+64+81 = 285
    print(f"count={count}")
    print(f"max_seen={maxSeen}")   # 9*9 = 81

    print("crawler_ok")
}
