# Cross-feature fixture: `?.` results as optionals in a small catalog,
# composed with generics, an interface, inheritance, lambdas,
# comprehensions, `Result` propagation (`load()?.m()` stays a plain call),
# `do/catch`, loops and narrowing of locals assigned from `obj?.m()`; the
# shelf's `at(i) -> optional[T]` (with `T = Product`) is generic code's
# optional crossing to the program's (it built `**Product`).
# expect: Lamp: 12 EUR (owner ann@x)
# expect: Desk: 40 EUR (owner none)
# expect: missing: no product
# expect: names: LAMP,DESK,-
# expect: prices: 12,40,0 total=52
# expect: owners: 1 of 3
# expect: cheapest=Lamp
# expect: loaded Chair 7
# expect: error: no product 9
# expect: priced true
# expect: shelf size=3 first=Lamp at1=Desk at9=none
# expect: shelf size=0 first=none at1=none at9=none
# expect: labels: [Lamp Desk ?]

from lamerrors import Result

interface Priced {
    func price(self) -> int
}

class Owner {
    func init(self, email: str) {
        self.email: str = email
    }

    func contact(self) -> str {
        return self.email
    }
}

class Item {
    func init(self, name: str) {
        self.name: str = name
        self.owner: optional[Owner] = None
    }

    func label(self) -> str {
        return self.name
    }
}

class Product(Item) {
    func init(self, name: str, cents: int) {
        base.init(name)
        self.cents: int = cents
    }

    func price(self) -> int {
        return self.cents
    }

    func ownerOf(self) -> optional[Owner] {
        return self.owner
    }
}

class Shelf[T] {
    func init(self, items: list[T]) {
        self.items: list[T] = items
    }

    func first(self) -> T {
        return self.items[0]
    }

    func size(self) -> int {
        return len(self.items)
    }

    func at(self, i: int) -> optional[T] {
        if i < 0 or i >= len(self.items) {
            return None
        }
        return self.items[i]
    }
}

func find(shelf: Shelf[Product], i: int) -> optional[Product] {
    return shelf.at(i)
}

func pickShelf(shelf: Shelf[Product], ok: bool) -> optional[Shelf[Product]] {
    if ok {
        return shelf
    }
    return None
}

func load(shelf: Shelf[Product], i: int) -> Result[Product] {
    p: optional[Product] = find(shelf, i)
    if p == None {
        return Result.Err(f"no product {i}")
    }
    return Result.Ok(p)
}

func describe(p: optional[Product]) -> str {
    name = p?.label()
    if name == None {
        return "missing: no product"
    }
    owner: str = p?.ownerOf()?.contact() ?? "none"
    return f"{name}: {p?.price() ?? 0} EUR (owner {owner})"
}

func loadedName(shelf: Shelf[Product], i: int) -> Result[str] {
    n: str = load(shelf, i)?.label()
    return Result.Ok(f"loaded {n} {load(shelf, i)?.price()}")
}

func main() {
    lamp: Product = Product("Lamp", 12)
    lamp.owner = Owner("ann@x")
    shelf: Shelf[Product] = Shelf[Product]([lamp, Product("Desk", 40), Product("Chair", 7)])
    for i in [0, 1, 5] {
        print(describe(find(shelf, i)))
    }
    picks: list[int] = [0, 1, 7]
    names: list[str] = [(find(shelf, i)?.label() ?? "-").toUpper() for i in picks]
    print("names: " + ",".join(names))
    prices: list[int] = [find(shelf, i)?.price() ?? 0 for i in picks]
    total: int = 0
    for c in prices {
        total += c
    }
    print(f"prices: {",".join([str(c) for c in prices])} total={total}")
    owned: int = len([i for i in picks if find(shelf, i)?.ownerOf() != None])
    print(f"owners: {owned} of {len(picks)}")
    cheaper = lambda (a: optional[Product], b: optional[Product]) -> optional[Product]: a if (a?.price() ?? 999) <= (b?.price() ?? 999) else b
    best: optional[Product] = cheaper(find(shelf, 0), find(shelf, 1))
    print(f"cheapest={best?.label() ?? "none"}")
    print(loadedName(shelf, 2).unwrap())
    do {
        missing: str = loadedName(shelf, 9)?
        print(missing)
    } catch err {
        print(f"error: {err}")
    }
    p: Priced = lamp
    print(f"priced {p.price() > 0 and lamp?.label() != None}")
    for ok in [true, false] {
        opt: optional[Shelf[Product]] = pickShelf(shelf, ok)
        print(f"shelf size={opt?.size() ?? 0} first={opt?.first()?.label() ?? "none"} at1={opt?.at(1)?.label() ?? "none"} at9={opt?.at(9)?.label() ?? "none"}")
    }
    labels: list[str] = []
    for i in picks {
        l = find(shelf, i)?.label()
        labels.append(l if l != None else "?")
    }
    print(f"labels: {labels}")
}
