# Integration test: Conway's Game of Life over a small grid.
#
# Sets up the classic blinker oscillator (a 1×3 line of live cells)
# and steps the world four times. The blinker has period 2: after one
# step it should rotate 90° to a 3×1 column, after two it returns to
# the original 1×3 row, and so on. Verifies that the rules are wired
# correctly and that the grid type round-trips through nested-list
# helpers.
#
# Stresses: classes with mutable 2-D state, neighbour iteration,
# nested loops, and equals-comparing nested lists.
#
# expect: step1=column
# expect: step2=row
# expect: step3=column
# expect: step4=row
# expect: stable_block_unchanged=true
# expect: gol_ok

class Grid {
    func __init__(self, rows: int, cols: int) {
        self.rows: int = rows
        self.cols: int = cols
        self.cells: list[list[int]] = []
        i: int = 0
        while i < rows {
            row: list[int] = []
            j: int = 0
            while j < cols {
                row.append(0)
                j = j + 1
            }
            self.cells.append(row)
            i = i + 1
        }
    }

    func set(self, r: int, c: int, v: int) {
        self.cells[r][c] = v
    }

    func get(self, r: int, c: int) -> int {
        if r < 0 or r >= self.rows {
            return 0
        }
        if c < 0 or c >= self.cols {
            return 0
        }
        return self.cells[r][c]
    }

    func liveNeighbours(self, r: int, c: int) -> int {
        # Sum the 8 neighbours, treating off-grid as 0 (dead).
        n: int = 0
        dr: int = -1
        while dr <= 1 {
            dc: int = -1
            while dc <= 1 {
                if not (dr == 0 and dc == 0) {
                    n = n + self.get(r + dr, c + dc)
                }
                dc = dc + 1
            }
            dr = dr + 1
        }
        return n
    }

    func step(self) -> Grid {
        # Standard Conway rules: live cell survives with 2 or 3
        # live neighbours; dead cell becomes alive with exactly 3.
        next_: Grid = Grid(self.rows, self.cols)
        r: int = 0
        while r < self.rows {
            c: int = 0
            while c < self.cols {
                live: int = self.get(r, c)
                neigh: int = self.liveNeighbours(r, c)
                alive: int = 0
                if live == 1 {
                    if neigh == 2 or neigh == 3 {
                        alive = 1
                    }
                } else {
                    if neigh == 3 {
                        alive = 1
                    }
                }
                next_.set(r, c, alive)
                c = c + 1
            }
            r = r + 1
        }
        return next_
    }

    func equals(self, other: Grid) -> bool {
        if self.rows != other.rows or self.cols != other.cols {
            return false
        }
        r: int = 0
        while r < self.rows {
            c: int = 0
            while c < self.cols {
                if self.get(r, c) != other.get(r, c) {
                    return false
                }
                c = c + 1
            }
            r = r + 1
        }
        return true
    }
}

func describeBlinker(g: Grid) -> str {
    # Centre cell is alive in both phases; check the orientation.
    horizontal: bool = g.get(2, 1) == 1 and g.get(2, 2) == 1 and g.get(2, 3) == 1
    vertical: bool = g.get(1, 2) == 1 and g.get(2, 2) == 1 and g.get(3, 2) == 1
    if horizontal {
        return "row"
    }
    if vertical {
        return "column"
    }
    return "other"
}

func main() {
    # 5x5 world with a horizontal blinker (1x3 row of live cells).
    g: Grid = Grid(5, 5)
    g.set(2, 1, 1)
    g.set(2, 2, 1)
    g.set(2, 3, 1)

    g1: Grid = g.step()
    print(f"step1={describeBlinker(g1)}")    # should rotate to "column"
    g2: Grid = g1.step()
    print(f"step2={describeBlinker(g2)}")    # back to "row"
    g3: Grid = g2.step()
    print(f"step3={describeBlinker(g3)}")
    g4: Grid = g3.step()
    print(f"step4={describeBlinker(g4)}")

    # Stable life: a 2x2 "block" must remain unchanged forever.
    block: Grid = Grid(4, 4)
    block.set(1, 1, 1)
    block.set(1, 2, 1)
    block.set(2, 1, 1)
    block.set(2, 2, 1)
    blockNext: Grid = block.step()
    print(f"stable_block_unchanged={block.equals(blockNext)}")

    print("gol_ok")
}
