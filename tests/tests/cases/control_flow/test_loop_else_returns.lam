# Test: a function whose loop has an `else` block that returns needs no
# trailing `return` when the loop body never breaks (every way out of
# the loop runs the `else`); a typed block lambda stored in a global.
#
# expect: first even: 4 -1
# expect: countdown: 0
# expect: classify: negative zero positive

func findFirstEven(nums: list[int]) -> int {
    for n in nums {
        if n % 2 != 0 {
            continue
        }
        return n
    } else {
        return -1
    }
}

func countdown(n: int) -> int {
    k = n
    while k > 0 {
        k -= 1
    } else {
        return k
    }
}

classify = lambda (n: int) -> str {
    if n < 0 {
        return "negative"
    }
    if n == 0 {
        return "zero"
    }
    return "positive"
}

func main() {
    print(f"first even: {findFirstEven([1, 4, 5])} {findFirstEven([1, 3])}")
    print(f"countdown: {countdown(3)}")
    print(f"classify: {classify(-3)} {classify(0)} {classify(2)}")
}
