# Test: capture patterns (`case other`), `as` bindings, guards combined
# with every pattern kind, binding scopes and exhaustive capture cases.
#
# expect: capture got 42
# expect: as-literal b
# expect: as-or 2
# expect: as-or 3
# expect: as-or none
# expect: base pattern matched Square named blob
# expect: guard literal 7 lucky
# expect: guard or 1 odd
# expect: guard or 2 even
# expect: guard value red-ish
# expect: guard sequence sum 9
# expect: guard mapping big 500
# expect: guard class wide 10x2
# expect: guard capture negative -3
# expect: guard as 15 fizz-buzz
# expect: exhaustive capture 5
# expect: outer x 1
# expect: shadow inner 9
# expect: outer x 1
# expect: case local seen
# expect: nested match inner 2 outer 1
# expect: or-bind 4
# expect: or-bind 6
# expect: loop break at 3
# expect: loop continue skipped 1

class Color {
    static RED: int = 0
}

class Shape {
    name: str = "blob"
}

class Square(Shape) {
    func init(self, side: int) {
        self.side: int = side
    }
}

class Rect {
    func init(self, w: int, h: int) {
        self.w: int = w
        self.h: int = h
    }
}

func exhaustive(n: int) -> str {
    match n {
        case 0 { return "zero" }
        case other { return f"exhaustive capture {other}" }
    }
}

func asOr(v: int) -> str {
    match v {
        case (2 | 3) as small { return f"as-or {small}" }
        case _ { return "as-or none" }
    }
}

func fizz(n: int) -> str {
    match n {
        case k as m if m % 15 == 0 { return f"guard as {k} fizz-buzz" }
        case _ { return "plain" }
    }
}

func main() {
    match 42 {
        case got { print(f"capture got {got}") }
    }

    letter: str = "b"
    match letter {
        case "a" as l { print(f"as-literal a {l}") }
        case "b" as l { print(f"as-literal {l}") }
    }

    print(asOr(2))
    print(asOr(3))
    print(asOr(4))

    thing: any = Square(2)
    match thing {
        case Shape(name=n) as s { print(f"base pattern matched Square named {n}") }
        case _ { print("no shape") }
    }

    lucky: int = 7
    match lucky {
        case 7 if lucky > 5 { print("guard literal 7 lucky") }
        case _ { print("guard literal miss") }
    }

    for n in [1, 2] {
        match n {
            case 1 | 3 if n < 3 { print(f"guard or {n} odd") }
            case 2 | 4 if n % 2 == 0 { print(f"guard or {n} even") }
            case _ { print("guard or miss") }
        }
    }

    shade: int = 0
    match shade {
        case Color.RED if shade == 0 { print("guard value red-ish") }
        case _ { print("guard value miss") }
    }

    match [4, 5] {
        case [a, b] if a + b == 9 { print(f"guard sequence sum {a + b}") }
        case _ { print("guard sequence miss") }
    }

    order: dict[str, int] = {"total": 500}
    match order {
        case {"total": t} if t < 100 { print("guard mapping small") }
        case {"total": t} if t >= 100 { print(f"guard mapping big {t}") }
        case _ { print("guard mapping miss") }
    }

    r: Rect = Rect(10, 2)
    match r {
        case Rect(w=w, h=h) if w > h { print(f"guard class wide {w}x{h}") }
        case Rect() { print("guard class tall") }
    }

    match -3 {
        case v if v < 0 { print(f"guard capture negative {v}") }
        case _ { print("guard capture positive") }
    }

    print(fizz(15))
    print(exhaustive(5))

    x: int = 1
    match 2 {
        case 1 { print("no") }
        case _ { print(f"outer x {x}") }
    }
    match 9 {
        case x { print(f"shadow inner {x}") }
    }
    print(f"outer x {x}")

    match "seen" {
        case word {
            note: str = f"case local {word}"
            print(note)
        }
    }

    match [1, [2]] {
        case [outer, inner] {
            match inner {
                case [value] { print(f"nested match inner {value} outer {outer}") }
                case _ { print("nested other") }
            }
        }
    }

    for pair in [[4, 0], [0, 6]] {
        match pair {
            case [k, 0] | [0, k] { print(f"or-bind {k}") }
            case _ { print("or-bind none") }
        }
    }

    i: int = 0
    while true {
        i += 1
        match i {
            case 3 {
                print(f"loop break at {i}")
                break
            }
            case _ { }
        }
    }

    for j in range(2) {
        match j {
            case 0 { continue }
            case other { print(f"loop continue skipped {other}") }
        }
    }
}
