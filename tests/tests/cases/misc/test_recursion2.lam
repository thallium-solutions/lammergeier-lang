# Test: Recursive algorithms - fibonacci, factorial, power, sum
# expect: 1
# expect: 1
# expect: 2
# expect: 3
# expect: 5
# expect: 8
# expect: 13
# expect: 21
# expect: 120
# expect: 720
# expect: 5040
# expect: 8
# expect: 27
# expect: 256
# expect: 55
# expect: 0
# expect: 1
# expect: 3
# expect: 6
# expect: 10
# expect: true
# expect: false
# expect: true
# expect: rec2_ok

func fib(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

func fact(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

func power_rec(base: int, exp: int) -> int {
    if exp == 0 {
        return 1
    }
    return base * power_rec(base, exp - 1)
}

func sum_rec(n: int) -> int {
    if n <= 0 {
        return 0
    }
    return n + sum_rec(n - 1)
}

func is_even_rec(n: int) -> bool {
    if n == 0 {
        return True
    }
    if n == 1 {
        return False
    }
    return is_even_rec(n - 2)
}

func main() {
    # Fibonacci sequence
    i: int = 0
    for i in range(8) {
        print(fib(i))
    }

    # Factorials
    print(fact(5))
    print(fact(6))
    print(fact(7))

    # Powers
    print(power_rec(2, 3))
    print(power_rec(3, 3))
    print(power_rec(4, 4))

    # Recursive sum
    print(sum_rec(10))

    # Sum of 0
    print(sum_rec(0))

    # Small sums
    print(sum_rec(1))
    print(sum_rec(2))
    print(sum_rec(3))
    print(sum_rec(4))

    # Even check
    print(is_even_rec(10))
    print(is_even_rec(7))
    print(is_even_rec(0))

    print("rec2_ok")
}
