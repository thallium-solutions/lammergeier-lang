# Test: Go channels and goroutine patterns
# expect: sum_chan=55
# expect: producer_done
# expect: ping
# expect: pong
# expect: goroutine_ok

func main() {
    # Sum via channel
    go! {
        ch := make(chan int)
        go func() {
            total := 0
            for i := 1; i <= 10; i++ {
                total += i
            }
            ch <- total
        }()
        result := <-ch
        fmt.Println(fmt.Sprintf("sum_chan=%d", result))
    }
    # Producer-consumer pattern
    go! {
        items := make(chan int, 5)
        go func() {
            for i := 0; i < 5; i++ {
                items <- i * i
            }
            close(items)
        }()
        for range items {
        }
        fmt.Println("producer_done")
    }
    # Ping-pong channels
    go! {
        ping := make(chan string, 1)
        pong := make(chan string, 1)
        ping <- "ping"
        msg := <-ping
        fmt.Println(msg)
        pong <- "pong"
        msg2 := <-pong
        fmt.Println(msg2)
    }
    print("goroutine_ok")
}
