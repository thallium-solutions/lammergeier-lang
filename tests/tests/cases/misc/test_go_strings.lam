# Test: String manipulation patterns using tpy string methods
# expect: length: 13
# expect: upper: HELLO, WORLD!
# expect: contains: true
# expect: replaced: hello, go!
# expect: split: 3
# expect: trim: hello
# expect: repeat: abcabcabc
# expect: startswith: true
# expect: endswith: true
# expect: count: 5
# expect: go_strings_ok

from lamstrings import Strings

func main() {
    s: str = "Hello, World!"
    print(f"length: {len(s)}")
    print(f"upper: {s.upper()}")
    if s.contains("World") {
        print("contains: true")
    }
    replaced: str = Strings.replace(s, "World", "Go")
    print(f"replaced: {replaced.lower()}")
    parts: list[str] = "a,b,c".split(",")
    print(f"split: {len(parts)}")
    trimmed: str = Strings.trim("  hello  ")
    print(f"trim: {trimmed}")
    repeated: str = Strings.repeat("abc", 3)
    print(f"repeat: {repeated}")
    if s.startswith("Hello") {
        print("startswith: true")
    }
    if s.endswith("!") {
        print("endswith: true")
    }
    cnt: int = Strings.count("abracadabra", "a")
    print(f"count: {cnt}")
    print("go_strings_ok")
}
