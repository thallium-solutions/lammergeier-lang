# Test: With statement (resource management via defer)
# expect: opened
# expect: working
# expect: done

class Resource {
    func init(self, name: str) {
        self.name: str = name
        print("opened")
    }

    func close(self) {
        pass
    }

    func work(self) {
        print("working")
    }
}

func main() {
    with Resource("test") as r {
        r.work()
    }
    print("done")
}
