# Test: Naming with underscores preserved
# expect: 15
# expect: hello_world

func add_numbers(a: int, b: int) -> int {
    return a + b
}

func get_greeting() -> str {
    return "hello_world"
}

func main() {
    result: int = add_numbers(7, 8)
    print(result)
    msg: str = get_greeting()
    print(msg)
}
