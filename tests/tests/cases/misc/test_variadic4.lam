# Test: variadic min/max
# expect: 1
# expect: 9

func find_min(*nums: int) -> int {
    result: int = nums[0]
    for n in nums {
        if n < result {
            result = n
        }
    }
    return result
}

func find_max(*nums: int) -> int {
    result: int = nums[0]
    for n in nums {
        if n > result {
            result = n
        }
    }
    return result
}

func main() {
    print(find_min(3, 1, 4, 1, 5))
    print(find_max(3, 1, 9, 2, 6))
}
