# Test: Recursive patterns - mutual recursion, deep recursion, tree-like
# expect: true
# expect: false
# expect: true
# expect: false
# expect: 89
# expect: 6765
# expect: 3
# expect: 1024
# expect: 15
# expect: recurse_ok

func is_even(n: int) -> bool {
    if n == 0 {
        return True
    }
    return is_odd(n - 1)
}

func is_odd(n: int) -> bool {
    if n == 0 {
        return False
    }
    return is_even(n - 1)
}

func fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func depth(n: int) -> int {
    if n <= 0 {
        return 0
    }
    return 1 + depth(n - 1)
}

func pow2(n: int) -> int {
    if n == 0 {
        return 1
    }
    return 2 * pow2(n - 1)
}

func sum_to(n: int) -> int {
    if n <= 0 {
        return 0
    }
    return n + sum_to(n - 1)
}

func main() {
    # Mutual recursion
    print(is_even(10))
    print(is_even(7))
    print(is_odd(7))
    print(is_odd(10))

    # Fibonacci
    print(fib(11))
    print(fib(20))

    # Depth counter
    print(depth(3))

    # Power of 2
    print(pow2(10))

    # Sum
    print(sum_to(5))

    print("recurse_ok")
}
