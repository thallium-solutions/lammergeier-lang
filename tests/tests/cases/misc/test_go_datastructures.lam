# Test: Go data structures via go! blocks - maps, slices, structs
# expect: map_ok
# expect: slice_ok
# expect: struct_ok
# expect: interface_ok
# expect: go_ds_done

func main() {
    # Go maps
    go! {
        m := map[string]int{"a": 1, "b": 2, "c": 3}
        total := 0
        for _, v := range m {
            total += v
        }
        if total == 6 {
            fmt.Println("map_ok")
        }
    }
    # Go slices
    go! {
        s := make([]int, 0)
        for i := 0; i < 5; i++ {
            s = append(s, i*i)
        }
        if len(s) == 5 && s[4] == 16 {
            fmt.Println("slice_ok")
        }
    }
    # Go structs
    go! {
        type Pair struct {
            First  string
            Second int
        }
        p := Pair{First: "hello", Second: 42}
        if p.First == "hello" && p.Second == 42 {
            fmt.Println("struct_ok")
        }
    }
    # Go interfaces
    go! {
        type Stringer interface {
            Str() string
        }
        type MyStr struct {
            Val string
        }
        // implement
        _ = MyStr{Val: "test"}
        fmt.Println("interface_ok")
    }
    print("go_ds_done")
}
