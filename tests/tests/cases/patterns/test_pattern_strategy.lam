# Strategy pattern: Select shipping cost calculator based on order weight
# The "strategy" is chosen at runtime based on conditions
# expect: Light (1kg): standard=2, express=5
# expect: Medium (3kg): standard=6, express=15
# expect: Heavy (15kg): standard=30, express=75
# expect: Auto for 1kg: 2
# expect: Auto for 3kg: 15
# expect: Auto for 15kg: 75

class StandardShipping {
    func __init__(self) {
        self.rate: int = 2
    }

    func calculate(self, weight: int) -> int {
        return weight * self.rate
    }
}

class ExpressShipping {
    func __init__(self) {
        self.rate: int = 5
    }

    func calculate(self, weight: int) -> int {
        return weight * self.rate
    }
}

# Strategy selector: picks shipping method based on weight threshold
func compute_cost(weight: int, strategy: str) -> int {
    if strategy == "standard" {
        s: StandardShipping = StandardShipping()
        return s.calculate(weight)
    } else {
        e: ExpressShipping = ExpressShipping()
        return e.calculate(weight)
    }
}

func select_strategy(weight: int) -> str {
    # Business rule: light packages go standard, heavy go express
    if weight <= 1 {
        return "standard"
    } else {
        return "express"
    }
}

func main() {
    weights: list[int] = [1, 3, 15]
    labels: list[str] = ["Light", "Medium", "Heavy"]

    std: StandardShipping = StandardShipping()
    exp: ExpressShipping = ExpressShipping()

    for i in range(3) {
        w: int = weights[i]
        label: str = labels[i]
        sc: int = std.calculate(w)
        ec: int = exp.calculate(w)
        print(f"{label} ({w}kg): standard={sc}, express={ec}")
    }

    # Auto-select strategy based on weight
    for i in range(3) {
        w: int = weights[i]
        strategy: str = select_strategy(w)
        cost: int = compute_cost(w, strategy)
        print(f"Auto for {w}kg: {cost}")
    }
}
