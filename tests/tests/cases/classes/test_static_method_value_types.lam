# A static method used as a function value has its declared parameter and
# result types in full (`list[Item]`, not `list`), so it fits a callback
# typed with element types: lists, dicts, sets, optionals, `Result`,
# tuples and nested callbacks; also generic callbacks, local and imported
# classes, typed locals and lists of callbacks. Bound instance methods
# keep their full types too.
# expect: count 1
# expect: values 1
# expect: ids 2
# expect: pairs 3
# expect: nested 6
# expect: bound 11
# expect: locals 0 10
# expect: generic 2 1
# expect: imported 6
# expect: callbacks 1 2

from lamerrors import Result
from private_method_values_provider import Pipeline

class Item {
    func init(self, n: int) {
        self.n: int = n
    }
}

func apply(fn: func(str, list[Item]) -> int) -> int {
    return fn("x", [Item(2)])
}

func applyDict(fn: func(dict[str, Item]) -> list[Item]) -> int {
    return len(fn({"a": Item(1)}))
}

func applySet(fn: func(set[int], optional[Item]) -> Result[list[int]]) -> int {
    ids: list[int] = fn({1, 2}, None).unwrap()
    return len(ids)
}

func applyPairs(fn: func(list[tuple[str, int]]) -> optional[dict[str, int]]) -> int {
    found: dict[str, int] = fn([("a", 1), ("b", 2)]) ?? {}
    return found["a"] + found["b"]
}

func applyNested(fn: func(func(int) -> list[int], int) -> int) -> int {
    return fn(lambda (n: int) -> list[int]: [n, n * 2], 2)
}

func applyAll[T](fn: func(str, list[T]) -> int, items: list[T]) -> int {
    return fn("x", items)
}

func pick[K, V](fn: func(dict[K, V]) -> list[V], m: dict[K, V]) -> int {
    return len(fn(m))
}

func applyTotal(fn: func(list[int], dict[str, float]) -> float) -> float {
    return fn([1, 2], {"w": 2.0})
}

class Handlers {
    func init(self, base: int) {
        self.base: int = base
    }

    static func count(_where: str, items: list[Item]) -> int {
        return len(items)
    }

    static func values(m: dict[str, Item]) -> list[Item] {
        return [v for _k, v in m]
    }

    static func ids(s: set[int], _it: optional[Item]) -> Result[list[int]] {
        return Result.Ok([x for x in s])
    }

    static func pairs(xs: list[tuple[str, int]]) -> optional[dict[str, int]] {
        out: dict[str, int] = {}
        for key, value in xs {
            out[key] = value
        }
        return out
    }

    static func nested(make: func(int) -> list[int], n: int) -> int {
        total: int = 0
        for x in make(n) {
            total += x
        }
        return total
    }

    func boundCount(self, _where: str, items: list[Item]) -> int {
        return self.base + len(items)
    }
}

func main() {
    print("count", apply(Handlers.count))
    print("values", applyDict(Handlers.values))
    print("ids", applySet(Handlers.ids))
    print("pairs", applyPairs(Handlers.pairs))
    print("nested", applyNested(Handlers.nested))
    h: Handlers = Handlers(10)
    print("bound", apply(h.boundCount))
    f: func(str, list[Item]) -> int = Handlers.count
    g: func(str, list[Item]) -> int = h.boundCount
    print("locals", f("y", []), g("z", []))
    print("generic", applyAll(Handlers.count, [Item(1), Item(2)]), pick(Handlers.values, {"a": Item(1)}))
    print("imported", applyTotal(Pipeline.total))
    callbacks: list[func(str, list[Item]) -> int] = [Handlers.count, Handlers.count]
    print("callbacks", callbacks[0]("a", [Item(1)]), callbacks[1]("b", [Item(1), Item(2)]))
}
