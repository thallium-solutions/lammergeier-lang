# Test: a class without its own `init` inherits the nearest ancestor's
# `init` (parameters, defaults and named arguments), like Python. The
# subclass's class-body field defaults still apply, overrides dispatch and
# the instance is usable as its base type.
#
# expect: animal rex 3 sound=...
# expect: dog rex 3 sound=woof
# expect: dog default age 1
# expect: named fido 5
# expect: puppy bolt 1 sound=yip tricks=0
# expect: puppy named lola 2
# expect: base view: dog rex says woof
# expect: field default: dog legs=4 cat legs=4 tail=true
# expect: generic box 7
# expect: imported-free chain: point 1 2 label=origin-ish
# expect: no-arg parent: 0 counter=10
# expect: multiple: alpha 0

class Animal {
    legs: int = 4

    func init(self, name: str, age: int = 1) {
        self.name: str = name
        self.age: int = age
    }

    func sound(self) -> str {
        return "..."
    }

    func describe(self) -> str {
        return f"{self.name} {self.age} sound={self.sound()}"
    }
}

class Dog(Animal) {
    func sound(self) -> str {
        return "woof"
    }
}

class Puppy(Dog) {
    tricks: int = 0

    func sound(self) -> str {
        return "yip"
    }
}

class Cat(Animal) {
    tail: bool = true
}

class Box[T] {
    func init(self, value: T) {
        self.value: T = value
    }
}

class IntBox(Box[int]) {
    func doubled(self) -> int {
        return self.value * 2
    }
}

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

class LabeledPoint(Point) {
    label: str = "origin-ish"
}

class Counter {
    count: int = 10
}

class SubCounter(Counter) {
    step: int = 0
}

class Named {
    func init(self, title: str) {
        self.title: str = title
    }
}

class Sized {
    func init(self, n: int) {
        self.n: int = n
    }
}

class Both(Named, Sized) {
    func both(self) -> str {
        return f"{self.title} {self.n}"
    }
}

func speak(a: Animal) -> str {
    return f"{a.name} says {a.sound()}"
}

func main() {
    a: Animal = Animal("rex", 3)
    print(f"animal {a.describe()}")
    d: Dog = Dog("rex", 3)
    print(f"dog {d.describe()}")
    dm: Dog = Dog("max")
    print(f"dog default age {dm.age}")
    named: Dog = Dog(age=5, name="fido")
    print(f"named {named.name} {named.age}")
    p: Puppy = Puppy("bolt")
    print(f"puppy {p.describe()} tricks={p.tricks}")
    p2: Puppy = Puppy(name="lola", age=2)
    print(f"puppy named {p2.name} {p2.age}")
    print(f"base view: dog {speak(d)}")
    c: Cat = Cat("tom")
    print(f"field default: dog legs={d.legs} cat legs={c.legs} tail={c.tail}")
    b: IntBox = IntBox(7)
    print(f"generic box {b.value}")
    lp: LabeledPoint = LabeledPoint(1, 2)
    print(f"imported-free chain: point {lp.x} {lp.y} label={lp.label}")
    sc: SubCounter = SubCounter()
    print(f"no-arg parent: {sc.step} counter={sc.count}")
    both: Both = Both("alpha")
    print(f"multiple: {both.both()}")
}
