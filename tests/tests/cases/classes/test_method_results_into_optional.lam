# A static or instance method call (on `self` or another receiver) whose
# declared result is a value type is boxed where an `optional` of that
# type is expected — returned, assigned, passed — like a module function
# call: `html`, `xml`, `str`, `int`, `float`, `bool`, `json`, a class,
# `list` and `dict`. `optional[json]` also takes JSON literals and `None`.
# expect: static html <p>x</p> free <p>f</p>
# expect: static str nm 4 2.5 true
# expect: static json {"a":1}
# expect: static class 3 list 2 dict 1
# expect: inst html <b>i</b> inst str inm 9
# expect: other html <b>i</b> other str inm
# expect: assigned <p>x</p> nm 9 {"a":1}
# expect: passed <p>x</p> inm 9
# expect: xml <n/>
# expect: json literal {"c":[1,2]} none true fallback {"b":2}
# expect: json reassigned {"a":3}
# expect: missing - -1 true <p>x</p>

class Item {
    func init(self, n: int) {
        self.n: int = n
    }
}

func freePage() -> html {
    return <><p>f</p></>
}

func showPage(p: optional[html]) -> str {
    return str(p ?? <></>)
}

func showName(s: optional[str]) -> str {
    return s ?? "-"
}

func showNum(n: optional[int]) -> int {
    return n ?? -1
}

class Hooks {
    func init(self) {
        self.k: int = 1
    }

    static func page() -> html {
        return <><p>x</p></>
    }

    static func feed() -> xml {
        return <><n/></>
    }

    static func name() -> str {
        return "nm"
    }

    static func num() -> int {
        return 4
    }

    static func ratio() -> float {
        return 2.5
    }

    static func flag() -> bool {
        return true
    }

    static func doc() -> json {
        return {"a": 1}
    }

    static func item() -> Item {
        return Item(3)
    }

    static func items() -> list[int] {
        return [1, 2]
    }

    static func table() -> dict[str, int] {
        return {"a": 1}
    }

    func ipage(self) -> html {
        return <><b>i</b></>
    }

    func iname(self) -> str {
        return "inm"
    }

    func inum(self) -> int {
        return 9
    }

    func idoc(self) -> json {
        return {"a": 3}
    }

    static func maybePage() -> optional[html] {
        return Hooks.page()
    }

    static func maybeFree() -> optional[html] {
        return freePage()
    }

    static func maybeFeed() -> optional[xml] {
        return Hooks.feed()
    }

    static func maybeName() -> optional[str] {
        return Hooks.name()
    }

    static func maybeNum() -> optional[int] {
        return Hooks.num()
    }

    static func maybeRatio() -> optional[float] {
        return Hooks.ratio()
    }

    static func maybeFlag() -> optional[bool] {
        return Hooks.flag()
    }

    static func maybeDoc() -> optional[json] {
        return Hooks.doc()
    }

    static func maybeItem() -> optional[Item] {
        return Hooks.item()
    }

    static func maybeItems() -> optional[list[int]] {
        return Hooks.items()
    }

    static func maybeTable() -> optional[dict[str, int]] {
        return Hooks.table()
    }

    static func missing(flag: bool) -> optional[html] {
        if flag {
            return Hooks.page()
        }
        return None
    }

    func imaybePage(self) -> optional[html] {
        return self.ipage()
    }

    func imaybeName(self) -> optional[str] {
        return self.iname()
    }

    func imaybeNum(self) -> optional[int] {
        return self.inum()
    }
}

func otherPage(h: Hooks) -> optional[html] {
    return h.ipage()
}

func otherName(h: Hooks) -> optional[str] {
    return h.iname()
}

func findDoc(key: str) -> optional[json] {
    if key == "c" {
        return {"c": [1, 2]}
    }
    return None
}

func main() {
    print("static html", str(Hooks.maybePage() ?? <></>), "free", str(Hooks.maybeFree() ?? <></>))
    print("static str", Hooks.maybeName() ?? "-", Hooks.maybeNum() ?? 0, Hooks.maybeRatio() ?? 0.0, Hooks.maybeFlag() ?? false)
    print("static json", Hooks.maybeDoc() ?? {})
    it: optional[Item] = Hooks.maybeItem()
    items: list[int] = Hooks.maybeItems() ?? []
    table: dict[str, int] = Hooks.maybeTable() ?? {}
    print("static class", (it ?? Item(0)).n, "list", len(items), "dict", table["a"])
    h: Hooks = Hooks()
    print("inst html", str(h.imaybePage() ?? <></>), "inst str", h.imaybeName() ?? "-", h.imaybeNum() ?? 0)
    print("other html", str(otherPage(h) ?? <></>), "other str", otherName(h) ?? "-")
    p: optional[html] = Hooks.page()
    n: optional[str] = Hooks.name()
    q: optional[int] = h.inum()
    d: optional[json] = Hooks.doc()
    print("assigned", str(p ?? <></>), n ?? "-", q ?? 0, d ?? {})
    print("passed", showPage(Hooks.page()), showName(h.iname()), showNum(h.inum()))
    empty: xml = <><none/></>
    print("xml", str(Hooks.maybeFeed() ?? empty))
    lit: optional[json] = findDoc("c")
    none: optional[json] = findDoc("x")
    print("json literal", lit ?? {}, "none", none == None, "fallback", none ?? {"b": 2})
    none = h.idoc()
    print("json reassigned", none ?? {})
    print("missing", showName(None), showNum(None), Hooks.missing(false) == None, str(Hooks.missing(true) ?? <></>))
}
