# Provider for test_private_method_values.lam: public statics of this
# module pass its private statics as function values (privacy is per
# module, so the importer only sees the public entry points).

class Pipeline {
    static func apply(fn: func(int) -> int, n: int) -> int {
        return fn(n)
    }

    static func viaPrivate(n: int) -> int {
        return Pipeline.apply(Pipeline.triple, n)
    }

    static func steps() -> list[func(int) -> int] {
        return [Pipeline.triple, Pipeline.inc]
    }

    static func total(items: list[int], weights: dict[str, float]) -> float {
        sum: float = 0.0
        for n in items {
            sum += float(n) * (weights["w"] ?? 1.0)
        }
        return sum
    }

    private static func triple(n: int) -> int {
        return n * 3
    }

    private static func inc(n: int) -> int {
        return n + 1
    }
}

# Built standalone by the test runner; dropped when imported.
func main() {
}
