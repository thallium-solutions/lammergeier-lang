# Test: init alias with default values
# expect: Point(0, 0)
# expect: Point(3, 4)

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func show(self) -> str {
        return f"Point({self.x}, {self.y})"
    }
}

func main() {
    p1: Point = Point(0, 0)
    p2: Point = Point(3, 4)
    print(p1.show())
    print(p2.show())
}
