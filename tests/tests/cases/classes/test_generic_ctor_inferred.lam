# Regression (4.1.3): a generic class's type arguments are inferred from its
# constructor's arguments in one module too: `b: Box[float] = Box([x / 2.0
# for x in xs])` was rejected ("cannot assign `Box` to `Box[float]`"), and a
# comprehension argument was emitted as `[]T` ("undefined: T").
class Box[T] {
    func init(self, items: list[T]) {
        self.items: list[T] = items
    }

    func first(self) -> T {
        return self.items[0]
    }
}

class Shelf {
    func init(self, words: list[str]) {
        self.words: list[str] = words
    }

    func upper(self) -> Box[str] {
        return Box([w.toUpper() for w in self.words])
    }
}

func evens(n: int) -> Box[int] {
    return Box([i for i in range(n) if i % 2 == 0])
}

func main() {
    a: Box[int] = Box([1, 2])
    c: Box[float] = Box([x / 2.0 for x in [1.0, 3.0]])
    print(a.items, c.items, evens(7).items)
    print(Shelf(["ab", "c"]).upper().first(), Box([[1], [2, 3]]).first())
    inferred = Box([w + "!" for w in ["hi"]])
    print(inferred.first())
}

# expect: [1 2] [0.5 1.5] [0 2 4 6]
# expect: AB [1]
# expect: hi!
