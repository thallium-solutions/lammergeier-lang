# Test: Operator overloading - comparison operators
# expect: true
# expect: false
# expect: true
# expect: false
# expect: true
# expect: false

class Score {
    func __init__(self, value: int) {
        self.value: int = value
    }

    func __lt__(self, other: Score) -> bool {
        return self.value < other.value
    }

    func __le__(self, other: Score) -> bool {
        return self.value <= other.value
    }

    func __gt__(self, other: Score) -> bool {
        return self.value > other.value
    }

    func __ge__(self, other: Score) -> bool {
        return self.value >= other.value
    }

    func __eq__(self, other: Score) -> bool {
        return self.value == other.value
    }

    func __ne__(self, other: Score) -> bool {
        return self.value != other.value
    }
}

func main() {
    a: Score = Score(10)
    b: Score = Score(20)
    c: Score = Score(10)

    print(a < b)
    print(a > b)
    print(a <= c)
    print(a != c)
    print(b >= a)
    print(b == a)
}
