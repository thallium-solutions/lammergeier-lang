# A list / dict / set literal mixing a subclass with its base (or sibling
# subclasses) takes the least common base class as its item type: calls
# dispatch to the overrides, fields read the base part, and the values flow
# into `list[Base]` parameters. Classes without a common base keep `any`
# and are used through `isinstance` narrowing.
# expect: loop B1 1
# expect: loop A2 2
# expect: local 3 B1 A3
# expect: total 6
# expect: deep Cat Dog
# expect: siblings Cat:4 Dog:4
# expect: chain Kitten Cat
# expect: dict x=B1 y=A2
# expect: dict-index B1
# expect: set 2
# expect: comp B5,A6
# expect: direct B7
# expect: ternary-list A8 B9
# expect: unrelated A1 C2
# expect: iface A3|C4
# expect: same A1 A2

interface Shown {
    func show(self) -> str
}

class A {
    func init(self, n: int) {
        self.n: int = n
    }

    func show(self) -> str {
        return f"A{self.n}"
    }
}

class B(A) {
    func show(self) -> str {
        return f"B{self.n}"
    }
}

class C {
    func init(self, n: int) {
        self.n: int = n
    }

    func show(self) -> str {
        return f"C{self.n}"
    }
}

class Animal {
    func init(self, name: str) {
        self.name: str = name
    }

    func legs(self) -> int {
        return 0
    }
}

class Cat(Animal) {
    func legs(self) -> int {
        return 4
    }
}

class Dog(Animal) {
    func legs(self) -> int {
        return 4
    }
}

class Kitten(Cat) {
}

func total(xs: list[A]) -> int {
    n: int = 0
    for x in xs {
        n += x.n
    }
    return n
}

func main() {
    for x in [B(1), A(2)] {
        print("loop", x.show(), x.n)
    }

    xs = [B(1), A(2)]
    xs.append(A(3))
    print(f"local {len(xs)} {xs[0].show()} {xs[2].show()}")
    print(f"total {total(xs)}")

    pets = [Cat("Cat"), Animal("Dog")]
    print("deep", pets[0].name, pets[1].name)
    out: list[str] = []
    for p in [Cat("Cat"), Dog("Dog")] {
        out.append(f"{p.name}:{p.legs()}")
    }
    print("siblings", " ".join(out))
    chain = [Kitten("Kitten"), Cat("Cat")]
    print("chain", chain[0].name, chain[1].name)

    d = {"x": B(1), "y": A(2)}
    parts: list[str] = []
    for k, v in d {
        parts.append(f"{k}={v.show()}")
    }
    parts.sort(inplace=true)
    print("dict", " ".join(parts))
    print("dict-index", d["x"].show())

    a: A = A(1)
    s = {a, B(2), a}
    print("set", len(s))

    print("comp", ",".join([e.show() for e in [B(5), A(6)]]))
    print("direct", [B(7), A(8)][0].show())
    flag: bool = true
    picked = [A(8) if flag else B(0), B(9)]
    print("ternary-list", picked[0].show(), picked[1].show())

    names: list[str] = []
    for u in [A(1), C(2)] {
        if isinstance(u, A) {
            names.append(u.show())
        } elif isinstance(u, C) {
            names.append(u.show())
        }
    }
    print("unrelated", " ".join(names))

    shown: list[Shown] = [A(3), C(4)]
    print("iface", "|".join([v.show() for v in shown]))

    same = [A(1), A(2)]
    print("same", same[0].show(), same[1].show())
}
