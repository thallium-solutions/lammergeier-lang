# Test: Operator overloading with dunder methods
# expect: Vec(4, 6)
# expect: Vec(-2, -2)
# expect: Vec(3, 6)
# expect: true

class Vec {
    func __init__(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func __add__(self, other: Vec) -> Vec {
        return Vec(self.x + other.x, self.y + other.y)
    }

    func __sub__(self, other: Vec) -> Vec {
        return Vec(self.x - other.x, self.y - other.y)
    }

    func __mul__(self, scalar: int) -> Vec {
        return Vec(self.x * scalar, self.y * scalar)
    }

    func __eq__(self, other: Vec) -> bool {
        return self.x == other.x and self.y == other.y
    }

    func __str__(self) -> str {
        return f"Vec({self.x}, {self.y})"
    }
}

func main() {
    a: Vec = Vec(1, 2)
    b: Vec = Vec(3, 4)

    c: Vec = a.add(b)
    print(c)

    d: Vec = a.sub(b)
    print(d)

    e: Vec = a.mul(3)
    print(e)

    f: Vec = Vec(1, 2)
    print(a.eq(f))
}
