# Test: Class with operator overloading - arithmetic
# expect: (4, 6)
# expect: (3, 6)
# expect: true
# expect: false

class Point {
    func __init__(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func __add__(self, other: Point) -> Point {
        return Point(self.x + other.x, self.y + other.y)
    }

    func __mul__(self, scalar: int) -> Point {
        return Point(self.x * scalar, self.y * scalar)
    }

    func __eq__(self, other: Point) -> bool {
        return self.x == other.x and self.y == other.y
    }

    func __str__(self) -> str {
        return f"({self.x}, {self.y})"
    }
}

func main() {
    a: Point = Point(1, 2)
    b: Point = Point(3, 4)

    # Operator overloading via method calls
    c: Point = a.add(b)
    print(c)

    d: Point = a.mul(3)
    print(d)

    e: Point = Point(1, 2)
    print(a.eq(e))
    print(a.eq(b))
}
