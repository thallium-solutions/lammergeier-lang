# Regression (4.1.3): a list comprehension passed to an imported generic
# class's constructor whose type argument is inferred (`Box([Row(...) for
# ...])`) was emitted as `[]T` ("undefined: T"); the explicit form
# `Box[Row]([...])` already worked (4.1.2).
from generic_infer_rows import load, names, Table
from generic_box_provider import Box

func main() {
    print(load(2).unwrap().first().name, load(3).unwrap().total)
    print(names(3).items)
    t: Table = Table("t")
    print(t.fetch(2).unwrap().first().name, t.squares(4))
    print(t.nested().first())
    local: Box[float] = Box([x / 2.0 for x in [1.0, 3.0]], 2)
    print(local.items)
}

# expect: r0 3
# expect: [0 1 2]
# expect: t0 [1 4 9]/3 [10 11]/2
# expect: [a A]
# expect: [0.5 1.5]
