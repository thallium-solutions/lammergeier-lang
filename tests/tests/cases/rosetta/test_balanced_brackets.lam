# Rosetta Code: Balanced brackets
# https://rosettacode.org/wiki/Balanced_brackets
# expect: true
# expect: true
# expect: false
# expect: false
# expect: true
# expect: false

func is_balanced(s: str) -> bool {
    count: int = 0
    for i in range(len(s)) {
        if string(s[i]) == "[" {
            count += 1
        } elif string(s[i]) == "]" {
            count -= 1
        }
        if count < 0 {
            return false
        }
    }
    return count == 0
}

func main() {
    print(is_balanced("[]"))
    print(is_balanced("[][]"))
    print(is_balanced("]["))
    print(is_balanced("[]]["))
    print(is_balanced("[[[]]]"))
    print(is_balanced("[[]"))
}
