# Rosetta Code: Pascal's triangle
# https://rosettacode.org/wiki/Pascal%27s_triangle
# expect: 1
# expect: 1 1
# expect: 1 2 1
# expect: 1 3 3 1
# expect: 1 4 6 4 1
# expect: 1 5 10 10 5 1

func main() {
    rows: int = 6
    row: list[int] = [1]
    for i in range(rows) {
        line: str = ""
        for j, v in enumerate(row) {
            if j > 0 {
                line = line + " "
            }
            line = line + f"{v}"
        }
        print(line)
        new_row: list[int] = [1]
        for k in range(len(row) - 1) {
            new_row = append(new_row, row[k] + row[k + 1])
        }
        new_row = append(new_row, 1)
        row = new_row
    }
}
