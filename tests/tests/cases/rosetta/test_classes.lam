# Rosetta Code: Classes
# https://rosettacode.org/wiki/Classes
# expect: Point(3, 4)
# expect: Point(1, 2)

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func to_string(self) -> str {
        return f"Point({self.x}, {self.y})"
    }
}

func main() {
    p1: Point = Point(3, 4)
    p2: Point = Point(1, 2)
    print(p1.to_string())
    print(p2.to_string())
}
