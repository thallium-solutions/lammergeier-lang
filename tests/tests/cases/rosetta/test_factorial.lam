# Rosetta Code: Factorial
# https://rosettacode.org/wiki/Factorial
# expect: 1
# expect: 1
# expect: 2
# expect: 6
# expect: 24
# expect: 120
# expect: 720
# expect: 5040
# expect: 40320
# expect: 362880
# expect: 3628800

func factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func main() {
    for i in range(11) {
        print(factorial(i))
    }
}
