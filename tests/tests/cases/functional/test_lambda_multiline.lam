# Test: multi-line lambda body + new typed multi-param syntax.
#
# expect: classify(-3): negative
# expect: classify(0): zero
# expect: classify(7): positive
# expect: addPair(2, 5): 7
# expect: kept: [1 3 5]
# expect: descr: positive (large)

func main() {
    # Multi-line lambda assigned to a local. Omitting the type
    # annotation lets the transpiler keep the concrete func type so
    # we can call it directly without a type assertion.
    classify = lambda (n: int) -> str {
        if n < 0 {
            return "negative"
        }
        if n == 0 {
            return "zero"
        }
        return "positive"
    }
    print(f"classify(-3): {classify(-3)}")
    print(f"classify(0): {classify(0)}")
    print(f"classify(7): {classify(7)}")

    # Single paren group, multi typed params, single-line body.
    addPair = lambda (a: int, b: int): a + b
    print(f"addPair(2, 5): {addPair(2, 5)}")

    # Multi-line lambda used as a `.filter` predicate (returns bool;
    # `.filter` keeps the input element type so this is type-clean).
    nums: list[int] = [1, 2, 3, 4, 5]
    kept: list[int] = nums.filter(lambda (x: int) -> bool {
        if x % 2 == 0 {
            return false
        }
        return true
    })
    print(f"kept: {kept}")

    # Multi-line lambda branching on multiple thresholds, called
    # eagerly.
    describe = lambda (n: int) -> str {
        if n < 0 {
            return "negative"
        }
        if n < 10 {
            return "positive (small)"
        }
        return "positive (large)"
    }
    print(f"descr: {describe(42)}")
}
