# 4.3.0 (reported on 4.2.1): the elements of a `generator[Result[int]]` are
# typed for the checker (`r.unwrap()` is an `int`) but the generated Go
# lost the payload, so `r.unwrap() * 2` failed in `go build` ("mismatched
# types interface{} and int"). The payload of `Result` elements follows
# generators, iterators and lists: function and method results, nested
# generators, annotated locals, parameters and fields, comprehensions,
# `?`, `unwrapOr`, and `Result` payloads of a class.
#
# expect: loop 8 errors 1
# expect: unwrap-or 2 1 4
# expect: list 6 params 9
# expect: method 30 iterator 12
# expect: comprehension [2 6] [11 31]
# expect: propagate ok 4
# expect: propagate err not a number: x
# expect: class Point(1, 2) Point(3, 4)
# expect: field 21

from lamerrors import Result

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func __str__(self) -> str {
        return f"Point({self.x}, {self.y})"
    }
}

func results() -> generator[Result[int]] {
    yield Result.Ok(1)
    yield Result.Err("bad")
    yield Result.Ok(3)
}

func counted() -> iterator[Result[int]] {
    for i in range(1, 4) {
        yield Result.Ok(i * 2)
    }
}

func points() -> generator[Result[Point]] {
    yield Result.Ok(Point(1, 2))
    yield Result.Ok(Point(3, 4))
}

func all(rows: list[Result[int]]) -> int {
    total: int = 0
    for r in rows {
        total += r.unwrap() * 3
    }
    return total
}

class Source {
    func init(self) {
        self.cached: list[Result[int]] = [Result.Ok(7)]
    }

    func each(self) -> generator[Result[int]] {
        yield Result.Ok(10)
        yield Result.Ok(5)
    }

    func cachedTotal(self) -> int {
        total: int = 0
        for r in self.cached {
            total += r.unwrap() * 3
        }
        return total
    }
}

func parsedSum(words: list[str]) -> Result[int] {
    func numbers() -> generator[Result[int]] {
        for w in words {
            if w == "x" {
                yield Result.Err(f"not a number: {w}")
            } else {
                yield Result.Ok(int(w))
            }
        }
    }
    total: int = 0
    for r in numbers() {
        n: int = r?
        total += n * 2
    }
    return Result.Ok(total)
}

func main() {
    total: int = 0
    errors: int = 0
    for r in results() {
        if r.ok() {
            total += r.unwrap() * 2
        } else {
            errors += 1
        }
    }
    print(f"loop {total} errors {errors}")
    print("unwrap-or " + " ".join([str(r.unwrapOr(0) + 1) for r in results()]))
    rows: list[Result[int]] = [Result.Ok(1), Result.Ok(2)]
    listTotal: int = 0
    for r in rows {
        listTotal += r.unwrap() * 2
    }
    print(f"list {listTotal} params {all(rows)}")
    src: Source = Source()
    methodTotal: int = 0
    for r in src.each() {
        methodTotal += r.unwrap() * 2
    }
    iterTotal: int = 0
    for r in counted() {
        iterTotal += r.unwrap()
    }
    print(f"method {methodTotal} iterator {iterTotal}")
    doubled: list[int] = [r.unwrap() * 2 for r in results() if r.ok()]
    plus: list[int] = [r.unwrap() * 10 + 1 for r in rows if r.unwrap() > 0]
    print(f"comprehension {doubled} [{plus[0]} {plus[1] + 10}]")
    ok: Result[int] = parsedSum(["1", "1"])
    print(f"propagate ok {ok.unwrap()}")
    bad: Result[int] = parsedSum(["1", "x"])
    print(f"propagate err {bad.error}")
    shown: list[str] = []
    for p in points() {
        pt: Point = p.unwrap()
        shown.append(str(pt))
    }
    print("class " + " ".join(shown))
    print(f"field {src.cachedTotal()}")
}
