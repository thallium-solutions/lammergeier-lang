# Generators do not leak goroutines: a loop leaving an endless generator
# early (`break`, `return`, an exception), a comprehension stopped by an
# exception, a generator method, a generic and a nested generator, a
# generator consuming another one, a generator never iterated and one
# kept in a variable, iterated partially and dropped (stopped when it is
# collected) all leave the goroutine count where it started.
#
# expect: break ok
# expect: return ok
# expect: exception ok
# expect: comprehension ok
# expect: method ok
# expect: generic ok
# expect: nested ok
# expect: chained ok
# expect: never iterated ok
# expect: dropped partial ok
# expect: total 15000

go! {
    import (
        "runtime"
        "time"
    )
}

func naturals() -> generator[int] {
    i: int = 0
    while True {
        yield i
        i += 1
    }
}

func cycle[T](items: list[T]) -> generator[T] {
    while True {
        for it in items {
            yield it
        }
    }
}

func scaled(src: generator[int], k: int) -> generator[int] {
    for n in src {
        yield n * k
    }
}

class Counter {
    func init(self, start: int) {
        self.start: int = start
    }

    func up(self) -> generator[int] {
        i: int = self.start
        while True {
            yield i
            i += 1
        }
    }
}

func firstAbove(n: int) -> int {
    for x in naturals() {
        if x > n {
            return x
        }
    }
    return -1
}

func failAt(x: int, at: int) -> int {
    if x == at {
        raise ValueError("stop")
    }
    return x
}

# The goroutine count once collected generators are stopped (cleanups run
# after a collection, in the background).
func goroutines(target: int) -> int {
    n: int = 0
    go! {
        for i := 0; i < 400; i++ {
            runtime.GC()
            if runtime.NumGoroutine() <= target {
                break
            }
            time.Sleep(5 * time.Millisecond)
        }
        n = runtime.NumGoroutine()
    }
    return n
}

func check(label: str, base: int) {
    now: int = goroutines(base)
    if now <= base {
        print(f"{label} ok")
    } else {
        print(f"{label} leaked {now - base} goroutines")
    }
}

func main() {
    base: int = goroutines(1)
    total: int = 0

    for k in range(1000) {
        for n in naturals() {
            if n == 2 {
                break
            }
            total += 1
        }
    }
    check("break", base)

    for k in range(1000) {
        total += firstAbove(1)
    }
    check("return", base)

    for k in range(1000) {
        try {
            for n in naturals() {
                total += failAt(n, 1)
            }
        } catch ValueError {
            total += 1
        }
    }
    check("exception", base)

    func upTo(limit: int) -> generator[int] {
        for n in naturals() {
            if n >= limit {
                return
            }
            yield n
        }
    }
    for k in range(1000) {
        try {
            vals: list[int] = [failAt(n, 2) for n in naturals()]
            total += len(vals)
        } catch ValueError {
            total += 1
        }
    }
    check("comprehension", base)

    counter: Counter = Counter(5)
    for k in range(1000) {
        for n in counter.up() {
            if n > 6 {
                break
            }
            total += 1
        }
    }
    check("method", base)

    for k in range(1000) {
        for s in cycle(["a", "b"]) {
            if s == "b" {
                break
            }
            total += 1
        }
    }
    check("generic", base)

    for k in range(1000) {
        for n in upTo(3) {
            total += 1
        }
    }
    check("nested", base)

    for k in range(1000) {
        for n in scaled(naturals(), 3) {
            if n > 3 {
                break
            }
            total += 1
        }
    }
    check("chained", base)

    for k in range(1000) {
        g: generator[int] = naturals()
        _ = g
    }
    check("never iterated", base)

    for k in range(1000) {
        g: generator[int] = naturals()
        for n in g {
            if n == 1 {
                break
            }
            total += 1
        }
    }
    check("dropped partial", base)
    print("total", total)
}
