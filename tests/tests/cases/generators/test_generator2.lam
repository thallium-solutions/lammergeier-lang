# Test: Generator yielding fibonacci numbers
# expect: 0
# expect: 1
# expect: 1
# expect: 2
# expect: 3
# expect: 5
# expect: 8

func fib_gen(n: int) -> int {
    a: int = 0
    b: int = 1
    i: int = 0
    while i < n {
        yield a
        temp: int = a + b
        a = b
        b = temp
        i += 1
    }
}

func main() {
    for val: int in fib_gen(7) {
        print(val)
    }
}
