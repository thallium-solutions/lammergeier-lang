# expect: true
# expect: true
# expect: true
# expect: true
# expect: true
# expect: true
# expect: 26
# expect: 3
# expect: 3
# expect: membership_ok

func main() {
    nums: list[int] = [1, 2, 3]
    print(2 in nums)
    print(9 not in nums)

    rows: list[list[int]] = [[1, 2], [3, 4]]
    print([3, 4] in rows)

    counts: dict[str, int] = {"a": 1, "b": 2}
    print("a" in counts)

    ids: set[int] = {5, 8, 13}
    print(8 in ids)

    print("ell" in "hello")
    print(2 < 3 < 4)
    print(2 < 3 > 1)

    total: int = 0
    for id in ids {
        total += id
    }
    print(total)

    copied: set[int] = {id for id in ids}
    print(len(copied))

    keyTotal: int = 0
    for key in counts {
        keyTotal += counts[key]
    }
    print(keyTotal)

    print("membership_ok")
}
