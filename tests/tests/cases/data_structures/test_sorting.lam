# Test: Sorting algorithms implemented in typed Python
# expect: 1
# expect: 2
# expect: 3
# expect: 4
# expect: 5
# expect: 6
# expect: 7
# expect: 8
# expect: 1
# expect: 2
# expect: 3
# expect: 4
# expect: 5
# expect: sorted_ok

func bubble_sort(arr: list[int], n: int) -> list[int] {
    i: int = 0
    j: int = 0
    temp: int = 0
    for i in range(n) {
        for j in range(0, n - i - 1) {
            if arr[j] > arr[j + 1] {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
    return arr
}

func selection_sort(arr: list[int], n: int) -> list[int] {
    i: int = 0
    j: int = 0
    min_idx: int = 0
    temp: int = 0
    for i in range(n) {
        min_idx = i
        for j in range(i + 1, n) {
            if arr[j] < arr[min_idx] {
                min_idx = j
            }
        }
        temp = arr[min_idx]
        arr[min_idx] = arr[i]
        arr[i] = temp
    }
    return arr
}

func main() {
    # Bubble sort
    data: list[int] = [5, 3, 8, 1, 7, 2, 6, 4]
    data = bubble_sort(data, 8)
    i: int = 0
    for i in range(8) {
        print(data[i])
    }

    # Selection sort
    data2: list[int] = [4, 2, 5, 1, 3]
    data2 = selection_sort(data2, 5)
    for i in range(5) {
        print(data2[i])
    }

    print("sorted_ok")
}
