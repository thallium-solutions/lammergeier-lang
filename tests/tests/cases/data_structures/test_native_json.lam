# expect: 2
# expect: 101
# expect: object:3
# expect: Ada
# expect: {"height":8,"width":16}
# expect: [1,true,null]
# expect: runtime-reject
# expect: numeric|dash|empty|space

from lamjson import Json
from lamerrors import Result

func resultJson(result: Result) -> json {
    go! { return result.Value.(LamJSON) }
}

func resultString(result: Result) -> str {
    go! { return result.Value.(string) }
}

func resultDict(result: Result) -> dict[str, any] {
    go! { return result.Value.(map[string]interface{}) }
}

class Image {
    func init(self, width: int, height: int) {
        self.width: int = width
        self.height: int = height
    }

    func __json__(self) -> json {
        return {"width": self.width, "height": self.height}
    }
}

func main() {
    payload: json = [{
        "hello": 100,
        "nested": {
            "y": [1, 2, 3]
        }
    }]
    second: int = payload[0].nested.y[1]
    print(second)
    payload[0].hello = 101
    hello: int = payload[0]["hello"]
    print(hello)

    obj: json = resultJson(Json.decode('{"name":"Ada","flags":[true,false],"meta":null}'))
    name: str = obj.name
    print(f"{Json.kind(obj)}:{len(obj)}")
    print(name)

    image: json = {"image": json(Image(16, 8))}
    imageData: dict[str, any] = resultDict(Json.toDict(image.image))
    imageJson: json = resultJson(Json.fromDict(imageData))
    print(resultString(Json.encode(imageJson)))
    valuesJson: json = resultJson(Json.fromList([1, true, None]))
    print(resultString(Json.encode(valuesJson)))

    dynamic: any = {1: "bad"}
    invalid: Result[json] = Json.fromValue(dynamic)
    if not invalid.ok() {
        print("runtime-reject")
    }

    unusual: json = {"123": "numeric", "first-name": "dash", "": "empty", " ": "space"}
    numeric: str = unusual["123"]
    dash: str = unusual["first-name"]
    empty: str = unusual[""]
    spaced: str = unusual[" "]
    print(f"{numeric}|{dash}|{empty}|{spaced}")
}
