# Test: list length() and sort() methods
# expect: 3
# expect: 1
# expect: 3
# expect: 3
# expect: 3
# expect: 2
# expect: list_sort_ok

func desc(a: int, b: int) -> bool {
    return a > b
}

func main() {
    nums: list[int] = [3, 1, 2]
    print(nums.length())

    sorted_nums: list[int] = nums.sort()
    print(sorted_nums[0])
    print(nums[0])

    desc_nums: list[int] = nums.sort(desc)
    print(desc_nums[0])

    words: list[str] = ["bee", "ant", "cat"]
    sorted_words: list[str] = words.sort(compare=lambda a, b: a > b)
    print(sorted_words[0].length())

    nums.sort(inplace=true)
    print(nums[1])

    print("list_sort_ok")
}
