# expect: {"name":"Ada"}
# expect: string
# expect: "{\"x\":1}"
# expect: [1,true,null]
# expect: true
# expect: {"value":"kept"}

from lamjson import Json

class Profile {
    func init(self, name: str) {
        self.name: str = name
    }

    func __json__(self) -> json {
        return {"name": self.name}
    }
}

class CollidingName {
    func init(self) {
        self.lamJSON: str = "kept"
    }

    func __json__(self) -> json {
        return {"value": self.lamJSON}
    }
}

func main() {
    profile: json = json(Profile("Ada"))
    print(Json.encode(profile).unwrap())

    text: json = json('{"x":1}')
    print(Json.kind(text))
    print(Json.encode(text).unwrap())

    values: json = json([1, true, None])
    print(Json.encode(values).unwrap())

    same: json = json(profile)
    print(same == profile)
    print(Json.encode(json(CollidingName())).unwrap())
}
