# expect: <h1>Title</h1><p>one</p> &amp; text<hr>
# expect: &lt;b&gt;<i>x</i>
# expect: <items></items><item>1</item><item>2</item>
# expect: <li>0</li><li>1</li><li>2</li>

# + and += join markup like strings; a str operand is text (escaped).
func main() {
    page: html = <><h1>Title</h1></>
    page += <><p>one</p></>
    page += " & text"
    page = page + <><hr></>
    print(page)
    label: html = "<b>" + <><i>x</i></>
    print(label)
    feed: xml = <><items></items></>
    feed += <><item>1</item></>
    feed = feed + <><item>2</item></>
    print(feed)
    rows: html = <></>
    for i in range(3) {
        rows += <><li>${i}</li></>
    }
    print(rows)
}
