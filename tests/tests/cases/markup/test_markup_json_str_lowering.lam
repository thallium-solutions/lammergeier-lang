# expect: <?xml version="1.0"?><rss><channel><item><title>one</title></item><item><title>&lt;two&gt;</title></item><item><title>three &amp; four</title></item></channel></rss>
# expect: {"big":12345678901234567,"cards":[{"title":"a\u003cb"},{"title":"é \u0026 漢"},{"title":"100%"}],"html":"\u003cscript\u003e","n":1.5e-7,"none":null,"u":"\u2028"}
