# expect: NAME=alice
# expect: GREETING=hello, alice
# expect: PATH_EXT=/usr/local/bin
# expect: PORT=8080
# expect: EMPTY=
# expect: loaded=5
# expect: NAME env=alice
# expect: missing env=fallback
# expect: present env=alice
# expect: typed int=41
# expect: typed float=2.5
# expect: typed bool=true
# expect: typed fallbacks=7,1.25,true
# expect: typed defaults ok
# expect: typed try=41,2.5,true
# expect: typed try errors=ParseError,ParseError,ParseError
# expect: typed try missing=ParseError
# expect: title=Example
# expect: db.host=localhost
# expect: db.port=5432
# expect: debug=true
# expect: retries=3
# expect: merged.title=Example
# expect: merged.NAME=alice

from lamenv import Env, Dotenv, Config
from lamerrors import Result, Error

go! {
    import "os"
}

func main() {
    # Write fresh config files into a temp dir so the test is
    # deterministic even when /tmp has stale state from earlier runs.
    go! {
        td, _ := os.MkdirTemp("", "lamenv-test-*")
        os.WriteFile(td+"/.env", []byte(
            "# comment\n"+
            "NAME=alice\n"+
            "GREETING=\"hello, $NAME\"\n"+
            "export PATH_EXT='/usr/local/bin'\n"+
            "PORT=8080   # inline\n"+
            "EMPTY=\n"), 0644)
        os.WriteFile(td+"/config.toml", []byte(
            "title = \"Example\"\n\n"+
            "[database]\n"+
            "host = \"localhost\"\n"+
            "port = 5432\n"), 0644)
        os.WriteFile(td+"/config.json", []byte(
            "{\"debug\": true, \"retries\": 3}\n"), 0644)
        os.Setenv("_LAMENV_TEST_DIR", td)
    }

    dir: str = Env.get("_LAMENV_TEST_DIR")

    entries: dict[str, any] = Dotenv.parseFile(dir + "/.env")
    names: list[str] = ["NAME", "GREETING", "PATH_EXT", "PORT", "EMPTY"]
    for k in names {
        v = entries[k] ?? "(missing)"
        print(f"{k}={v}")
    }

    loaded: int = Dotenv.load(dir + "/.env")
    print(f"loaded={loaded}")
    print(f"NAME env={Env.get('NAME')}")
    print(f"missing env={Env.getOr('_LAMENV_MISSING', 'fallback')}")
    print(f"present env={Env.getOr('NAME', 'fallback')}")

    Env.set("_LAMENV_TYPED_INT", "41")
    Env.set("_LAMENV_TYPED_FLOAT", "2.5")
    Env.set("_LAMENV_TYPED_BOOL", "true")
    Env.set("_LAMENV_TYPED_INVALID", "not-a-value")
    Env.set("_LAMENV_TYPED_EMPTY", "")
    Env.unset("_LAMENV_TYPED_MISSING")

    print(f"typed int={Env.getInt('_LAMENV_TYPED_INT', -1)}")
    print(f"typed float={Env.getFloat('_LAMENV_TYPED_FLOAT', -1.0)}")
    print(f"typed bool={Env.getBool('_LAMENV_TYPED_BOOL', false)}")
    missingInt: int = Env.getInt("_LAMENV_TYPED_MISSING", 7)
    emptyFloat: float = Env.getFloat("_LAMENV_TYPED_EMPTY", 1.25)
    invalidBool: bool = Env.getBool("_LAMENV_TYPED_INVALID", true)
    print(f"typed fallbacks={missingInt},{emptyFloat},{invalidBool}")
    defaultIntOk: bool = Env.getInt("_LAMENV_TYPED_MISSING") == 0
    defaultFloatOk: bool = Env.getFloat("_LAMENV_TYPED_EMPTY") == 0.0
    defaultBoolOk: bool = not Env.getBool("_LAMENV_TYPED_INVALID")
    if defaultIntOk and defaultFloatOk and defaultBoolOk {
        print("typed defaults ok")
    }

    intResult: Result[int] = Env.tryGetInt("_LAMENV_TYPED_INT")
    floatResult: Result[float] = Env.tryGetFloat("_LAMENV_TYPED_FLOAT")
    boolResult: Result[bool] = Env.tryGetBool("_LAMENV_TYPED_BOOL")
    print(f"typed try={intResult.value},{floatResult.value},{boolResult.value}")

    badInt: Result[int] = Env.tryGetInt("_LAMENV_TYPED_INVALID")
    badFloat: Result[float] = Env.tryGetFloat("_LAMENV_TYPED_INVALID")
    badBool: Result[bool] = Env.tryGetBool("_LAMENV_TYPED_INVALID")
    intError: Error = badInt.error
    floatError: Error = badFloat.error
    boolError: Error = badBool.error
    print(f"typed try errors={intError.kind},{floatError.kind},{boolError.kind}")
    missingResult: Result[int] = Env.tryGetInt("_LAMENV_TYPED_MISSING")
    missingError: Error = missingResult.error
    print(f"typed try missing={missingError.kind}")

    toml: dict[str, any] = Config.load(dir + "/config.toml")
    print(f"title={toml['title']}")
    db: dict[str, any] = {}
    go! {
        if m, ok := toml["database"].(map[string]interface{}); ok {
            db = m
        }
    }
    print(f"db.host={db['host']}")
    print(f"db.port={db['port']}")

    j: dict[str, any] = Config.load(dir + "/config.json")
    print(f"debug={j['debug']}")
    print(f"retries={j['retries']}")

    merged: dict[str, any] = Config.merge([toml, Dotenv.parseFile(dir + "/.env")])
    print(f"merged.title={merged['title']}")
    print(f"merged.NAME={merged['NAME']}")
}
