# expect: NAME=alice
# expect: GREETING=hello, alice
# expect: PATH_EXT=/usr/local/bin
# expect: PORT=8080
# expect: EMPTY=
# expect: loaded=5
# expect: NAME env=alice
# expect: missing env=fallback
# expect: present env=alice
# expect: has env=true,false
# expect: empty env ok=true:0
# expect: typed values=41,2.5,true
# expect: typed errors=ParseError,ParseError,ParseError
# expect: typed missing=7
# expect: missing config err=true
# expect: title=Example
# expect: db.host=localhost
# expect: db.port=5432
# expect: debug=true
# expect: retries=3
# expect: merged.title=Example
# expect: merged.NAME=alice

from lamenv import Env, Dotenv, Config
from lamerrors import Result, Error

go! {
    import "os"
}

func resultString(result: Result) -> str {
    value: str = result.unwrap()
    return value
}

func resultInt(result: Result) -> int {
    value: int = result.unwrap()
    return value
}

func resultDict(result: Result) -> dict[str, any] {
    value: dict[str, any] = result.unwrap()
    return value
}

func main() {
    # Write fresh config files into a temp dir so the test is
    # deterministic even when /tmp has stale state from earlier runs.
    go! {
        td, _ := os.MkdirTemp("", "lamenv-test-*")
        os.WriteFile(td+"/.env", []byte(
            "# comment\n"+
            "NAME=alice\n"+
            "GREETING=\"hello, $NAME\"\n"+
            "export PATH_EXT='/usr/local/bin'\n"+
            "PORT=8080   # inline\n"+
            "EMPTY=\n"), 0644)
        os.WriteFile(td+"/config.toml", []byte(
            "title = \"Example\"\n\n"+
            "[database]\n"+
            "host = \"localhost\"\n"+
            "port = 5432\n"), 0644)
        os.WriteFile(td+"/config.json", []byte(
            "{\"debug\": true, \"retries\": 3}\n"), 0644)
        os.Setenv("_LAMENV_TEST_DIR", td)
    }

    dir: str = resultString(Env.get("_LAMENV_TEST_DIR"))

    entries: dict[str, any] = resultDict(Dotenv.parseFile(dir + "/.env"))
    names: list[str] = ["NAME", "GREETING", "PATH_EXT", "PORT", "EMPTY"]
    for k in names {
        v = entries[k] ?? "(missing)"
        print(f"{k}={v}")
    }

    loaded: int = resultInt(Dotenv.load(dir + "/.env"))
    print(f"loaded={loaded}")
    print(f"NAME env={resultString(Env.get('NAME'))}")
    print(f"missing env={Env.getOr('_LAMENV_MISSING', 'fallback')}")
    print(f"present env={Env.getOr('NAME', 'fallback')}")
    print(f"has env={Env.has('NAME')},{Env.has('_LAMENV_MISSING')}")

    _ = Env.set("_LAMENV_TYPED_INT", "41")
    _ = Env.set("_LAMENV_TYPED_FLOAT", "2.5")
    _ = Env.set("_LAMENV_TYPED_BOOL", "true")
    _ = Env.set("_LAMENV_TYPED_INVALID", "not-a-value")
    _ = Env.set("_LAMENV_TYPED_EMPTY", "")
    _ = Env.unset("_LAMENV_TYPED_MISSING")

    emptyEnv: Result[str] = Env.get("_LAMENV_TYPED_EMPTY")
    emptyValue: str = resultString(emptyEnv)
    print(f"empty env ok={emptyEnv.ok()}:{len(emptyValue)}")

    intResult: Result[int] = Env.get("_LAMENV_TYPED_INT", 0)
    floatResult: Result[float] = Env.get("_LAMENV_TYPED_FLOAT", 0.0)
    boolResult: Result[bool] = Env.get("_LAMENV_TYPED_BOOL", false)
    print(f"typed values={intResult.value},{floatResult.value},{boolResult.value}")

    badInt: Result[int] = Env.get("_LAMENV_TYPED_INVALID", 0)
    badFloat: Result[float] = Env.get("_LAMENV_TYPED_INVALID", 0.0)
    badBool: Result[bool] = Env.get("_LAMENV_TYPED_INVALID", false)
    intError: Error = badInt.error
    floatError: Error = badFloat.error
    boolError: Error = badBool.error
    print(f"typed errors={intError.kind},{floatError.kind},{boolError.kind}")
    missingResult: Result[int] = Env.get("_LAMENV_TYPED_MISSING", 7)
    missingValue: int = missingResult.unwrap()
    print(f"typed missing={missingValue}")
    print(f"missing config err={not Config.load(dir + '/missing.json').ok()}")

    toml: dict[str, any] = resultDict(Config.load(dir + "/config.toml"))
    print(f"title={toml['title']}")
    db: dict[str, any] = {}
    go! {
        if m, ok := toml["database"].(map[string]interface{}); ok {
            db = m
        }
    }
    print(f"db.host={db['host']}")
    print(f"db.port={db['port']}")

    j: dict[str, any] = resultDict(Config.load(dir + "/config.json"))
    print(f"debug={j['debug']}")
    print(f"retries={j['retries']}")

    envEntries: dict[str, any] = resultDict(Dotenv.parseFile(dir + "/.env"))
    merged: dict[str, any] = Config.merge([toml, envEntries])
    print(f"merged.title={merged['title']}")
    print(f"merged.NAME={merged['NAME']}")
}
