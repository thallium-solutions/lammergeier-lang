# Found by tests/fuzz/lamfuzz.py: programs the checker accepted whose
# generated Go did not build, and one checker false positive.
# - a for loop over a slice of a comprehension or over a list concatenation
#   left its variable untyped (a dict literal or a lambda using it failed);
# - `n -= x ** 4` on an int did not convert the power (a float) back;
# - a comprehension over range() inside a json literal was "unknown".
# expect: true false
# expect: false true
# expect: 3
# expect: 8
# expect: 2
# expect: 4
# expect: 4
# expect: 19 11
# expect: {"n":2,"xs":[0,1,2]}

from lamjson import Json

func powers(p2: int) -> str {
    v4: int = 100
    v4 -= ((p2 % 50) ** 4)
    v5: int = 2
    v5 += 3 ** 2
    return f"{v4} {v5}"
}

func main() {
    p0: bool = true
    acc: int = 0
    for it3 in [x5 for x5 in [79345, 1, 2] if p0][1:3] {
        acc += it3
        print({"go": 9, "Lam": it3}["Lam"] <= 1, [it3].any(lambda x: x > 1))
    }
    print(acc)
    p1: int = 1
    p2: int = 2
    for it7 in ([4, p1] + [p2, p2]) {
        v11: int = [77905, 1, 2, 3, 4][(p2 if false else it7)]
        print(v11 + it7)
    }
    print(powers(3))
    j: json = {"n": p2, "xs": [i for i in range(3)]}
    print(Json.encode(j).unwrap())
}
