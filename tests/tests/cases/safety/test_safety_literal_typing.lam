# Collection literals and string expressions used without an annotation
# (found by tests/fuzz/lamfuzz.py): the checker accepted these programs and
# the generated Go did not build.
# expect: 0 2
# expect: [1] 20 [2 4]
# expect: 64
# expect: 13
# expect: 1 map[2:true 4:true] true
# expect: map[k4:4]
# expect: [1]
# expect: [5 5] [0 0 0]
# expect: [a a ] XXX 4 xx
# expect: || bc bz
# expect: 1 0
# expect: 3
# expect: true

func main() {
    print({"b": 1, "xy": 2}["go"], max({"a": 1}["a"], 2))
    print([1, 2][0:1], [1, 20][1], [1, 2].map(lambda m: m * 2).sort()[-3:3])
    for x in {(-8)} {
        print(x * x)
    }
    n: int = 2
    squares: int = 0
    for y in {n, 3} {
        squares += y * y
    }
    print(squares)
    acc: int = 0
    for it in {1 for w in [4]} {
        acc += it * it
    }
    print(acc, {v * 2 for v in [1, 2]}, 3 in {z for z in [3]})
    print({f"k{k}": k for k in [8, 4][-1:2]})
    print([1] + [3, 4][3:0])
    print([5 for q in [1, 2]], [0 for c in "abc"])
    s: str = "ab"
    print((s * 2).split("b"), ("x" * 3).toUpper(), len("ab" * 2), ",".join(["x"]) * 2)
    print("|" + ""[:4] + "k"[2:0] + "|", "abc"[1:10], ("1"[:-1] + ("ab" + "zz"))[-3:3])
    one: int = 1 ** 100
    zero: int = 0 ** 70
    print(one, zero)
    print(len([[1], [2, 3]][1]) + {"a": [1]}["a"][0])
    print(n ** 2 <= [1, 20][1])
}
