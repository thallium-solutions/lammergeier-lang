# expect: called a
# expect: called b
# expect: [a b]
# expect: called bad
# expect: stopped at bad
# expect: called c
# expect: [{"label":"!","name":"c"}]
# Regression: `xs.append(f()?)` evaluated `f()` twice (side effects ran twice).
from lamerrors import Result, Error

func f(name: str) -> Result[str] {
    if name == "c" {
        print("called c")
        return Result.Ok("")
    }
    print(f"called {name}")
    if name == "bad" {
        return Result.Err(Error("Bad", "bad"))
    }
    return Result.Ok(name)
}

func collect(names: list[str]) -> Result[list[str]] {
    out: list[str] = []
    for name in names {
        out.append(f(name)?)
    }
    return Result.Ok(out)
}

func main() {
    print(collect(["a", "b"]).unwrap())
    failed: Result[list[str]] = collect(["bad"])
    if not failed.ok() {
        print("stopped at bad")
    }
    later()
}

func wrapped(names: list[str]) -> Result[list[json]] {
    rows: list[json] = []
    for name in names {
        rows.append({"name": name, "label": f(name)? + "!"})
    }
    return Result.Ok(rows)
}

func later() {
    print(wrapped(["c"]).unwrap())
}
