# Regression (4.1.2): a payload that may be `None` (a `Result[int]` built
# from an `any`; After 4.11: it was a `Result[optional[int]]`) is typed under
# `??` (`x: int = maybe(4)? ?? 0` is an `int`), and an `any` payload used
# with an operator takes the type of its inline cast
# (`x: int = anyVal()? as int * 2`; the operator alone is a Lam error).
#
# expect: optional: 4 7 6 n3 anon! true 5
# expect: any: 42 abc!
# expect: forwarded: 30

from lamerrors import Result

func maybe(n: int) -> Result[int] {
    if n < 0 {
        nothing: any = None
        return Result.Ok(nothing)
    }
    return Result.Ok(n)
}

func maybeName(n: int) -> Result[str] {
    if n < 0 {
        nothing: any = None
        return Result.Ok(nothing)
    }
    return Result.Ok(f"n{n}")
}

func maybeAny(n: int) -> Result[any] {
    if n < 0 {
        return Result.Ok(None)
    }
    return Result.Ok(n)
}

func anyVal() -> Result[any] {
    return Result.Ok(21)
}

func anyText() -> Result[any] {
    return Result.Ok("abc")
}

func optionals() -> Result[str] {
    x: int = maybe(4)? ?? 0
    y: int = maybe(-4)? ?? 7
    z = maybe(2)? ?? 1
    s: str = maybeName(3)? ?? "none"
    w = (maybeName(-1)? ?? "anon") + "!"
    v = maybeAny(-1)?
    return Result.Ok(f"{x} {y} {z * 3} {s} {w} {v == None} {maybe(5)?}")
}

func anys() -> Result[str] {
    x: int = anyVal()? as int * 2
    t: str = anyText()? as str + "!"
    return Result.Ok(f"{x} {t}")
}

func forward() -> Result[any] {
    return Result.Ok((maybe(3)? ?? 0) * 10)
}

func main() {
    print(f"optional: {optionals().unwrap()}")
    print(f"any: {anys().unwrap()}")
    print(f"forwarded: {forward().unwrap()}")
}
