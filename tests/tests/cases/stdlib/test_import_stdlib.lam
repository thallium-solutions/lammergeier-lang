# Test: import from standard library (lammergeieronv)
# expect: 42
# expect: 123

from lamconv import Conv
from lamerrors import Result

func resultInt(result: Result[int]) -> int {
    go! { return result.Value.(int) }
}

func main() {
    s: str = str(42)
    print(s)
    parsed: Result[int] = Conv.parse("123")
    n: int = resultInt(parsed)
    print(n)
}
