# Test: the Result-returning methods across the stdlib
# (lamconv / lamjson / lamre / lamos). Each module's success
# and failure paths get exercised, plus one ``?``-propagation
# example to confirm the new APIs cooperate with the operator from
# Sprint 2B.
#
# expect: conv_int_ok=42
# expect: conv_int_err: ParseError
# expect: conv_float_ok=3.14
# expect: conv_bool_ok=true
# expect: conv_zero_ok=0
# expect: json_encode_ok={"a":1}
# expect: json_decode_err: JsonDecodeError
# expect: re_match_ok=true
# expect: re_no_match_ok=
# expect: re_match_err: RegexError
# expect: os_read_ok=hello stdlib
# expect: os_read_err: IOError
# expect: propagated: ParseError
# expect: result_apis_ok

from lamconv import Conv
from lamjson import Json
from lamre import Re
from lamos import Os
from lamerrors import Result, Error

func resultStr(r: Result[str]) -> str {
    go! { return r.Value.(string) }
}

func parseChain(a: str, b: str) -> Result[int] {
    # Threads two overloaded ``Conv.parse`` calls through ``?`` so the test
    # exercises a stdlib Result with the propagation operator.
    xResult: Result[int] = Conv.parse(a)
    x: int = xResult?
    yResult: Result[int] = Conv.parse(b)
    y: int = yResult?
    return Result.Ok(x + y)
}

func main() {
    # ─── lamconv ────────────────────────────────────────────
    n: Result[int] = Conv.parse("42")
    print(f"conv_int_ok={n.value}")

    bad: Result[int] = Conv.parse("not-a-number")
    e: Error = bad.error
    print(f"conv_int_err: {e.kind}")

    f: Result[float] = Conv.parse("3.14")
    print(f"conv_float_ok={f.value}")

    b: Result[bool] = Conv.parse("true")
    print(f"conv_bool_ok={b.value}")

    zero: Result[int] = Conv.parse("0")
    print(f"conv_zero_ok={zero.value}")

    # ─── lamjson ────────────────────────────────────────────
    enc: Result[str] = Json.encode({"a": 1})
    print(f"json_encode_ok={enc.value}")

    invalidJson: str = "not json at all"
    dec: Result[json] = Json.decode(invalidJson)
    je: Error = dec.error
    print(f"json_decode_err: {je.kind}")

    # ─── lamre ──────────────────────────────────────────────
    rm: Result[bool] = Re.match("h.*o", "hello")
    print(f"re_match_ok={rm.value}")

    noMatch: Result[str] = Re.find("[0-9]+", "letters")
    print(f"re_no_match_ok={noMatch.value}")

    badRe: Result[bool] = Re.match("[unterminated", "anything")
    re: Error = badRe.error
    print(f"re_match_err: {re.kind}")

    # ─── lamos ──────────────────────────────────────────────
    # Round-trip through a tmp file using the unsuffixed Result APIs.
    tmp: str = resultStr(Os.tempFile("lamtest-result-", ".txt"))
    Os.writeFile(tmp, "hello stdlib").unwrap()
    rd: Result[str] = Os.readFile(tmp)
    print(f"os_read_ok={rd.value}")
    Os.remove(tmp).unwrap()

    missing: Result[str] = Os.readFile("/no/such/file/here")
    me: Error = missing.error
    print(f"os_read_err: {me.kind}")

    # ─── ? propagation across modules ───────────────────────
    chain: Result[int] = parseChain("1", "x")  # second call fails
    ce: Error = chain.error
    print(f"propagated: {ce.kind}")

    print("result_apis_ok")
}
