# expect: scalar-string-valid: true
# expect: scalar-string-value: hello
# expect: scalar-string-invalid: false

from lamerrors import Result
from lamjson import Json
from lamschema import Schema

func resultJson(result: Result) -> json {
    go! { return result.Value.(LamJSON) }
}

func main() {
    schema: json = {"type": "string", "minLength": 2}
    valid: json = "hello"
    invalid: json = ""

    accepted: Result[json] = Schema.validate(schema, valid)
    acceptedJson: json = resultJson(Json.fromValue(accepted.value))
    acceptedValue: str = acceptedJson
    rejected: Result[json] = Schema.validate(schema, invalid)

    print(f"scalar-string-valid: {accepted.ok()}")
    print(f"scalar-string-value: {acceptedValue}")
    print(f"scalar-string-invalid: {rejected.ok()}")
}
