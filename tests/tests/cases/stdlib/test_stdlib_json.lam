# expect: json_encode_ok
# expect: valid_true: true
# expect: valid_false: false
# expect: decode_ok: true
# expect: decode_err: true
# expect: null_ok: true

from lamjson import Json
from lamerrors import Result

func resultString(result: Result) -> str {
    go! { return result.Value.(string) }
}

func main() {
    encoded: str = resultString(Json.encode("hello"))
    if len(encoded) > 0 {
        print("json_encode_ok")
    }

    good: bool = Json.isValid('{"a": 1}')
    bad: bool = Json.isValid("{not json}")
    print(f"valid_true: {good}")
    print(f"valid_false: {bad}")

    parsed: Result = Json.decode('{"a": 1}')
    invalidJson: str = "not json at all"
    failed: Result = Json.decode(invalidJson)
    nullValue: Result = Json.decode("null")
    isErr: bool = not failed.ok()
    print(f"decode_ok: {parsed.ok()}")
    print(f"decode_err: {isErr}")
    print(f"null_ok: {nullValue.ok()}")
}
