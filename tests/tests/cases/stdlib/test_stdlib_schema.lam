# Test: lamschema Result-based JSON Schema validation.
# expect: text/text: true
# expect: text/json: true
# expect: json/text: true
# expect: json/json: true
# expect: invalid: false
# expect: invalid-kind: SchemaValidationError
# expect: bad-schema-kind: SchemaParseError
# expect: bad-document-kind: SchemaParseError
# expect: is-json: true

from lamerrors import Result, Error
from lamjson import Json
from lamschema import Schema

func main() {
    schemaText: str = '{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1}}}'
    schemaValue: json = {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}},
    }
    documentText: str = '{"name":"Ada"}'
    documentValue: json = {"name": "Ada"}

    textText: Result[str] = Schema.validate(schemaText, documentText)
    textValue: Result[json] = Schema.validate(schemaText, documentValue)
    valueText: Result[str] = Schema.validate(schemaValue, documentText)
    valueValue: Result[json] = Schema.validate(schemaValue, documentValue)
    print(f"text/text: {textText.ok()}")
    print(f"text/json: {textValue.ok()}")
    print(f"json/text: {valueText.ok()}")
    print(f"json/json: {valueValue.ok()}")

    invalid: Result[json] = Schema.validate(schemaValue, {"name": ""})
    print(f"invalid: {invalid.ok()}")
    invalidError: Error = invalid.error
    print(f"invalid-kind: {invalidError.kind}")

    badSchemaText: str = "{not-" + "json}"
    badSchema: Result[str] = Schema.validate(badSchemaText, documentText)
    badSchemaError: Error = badSchema.error
    print(f"bad-schema-kind: {badSchemaError.kind}")

    badDocument: Result[str] = Schema.validate(schemaText, "{not-json}")
    badDocumentError: Error = badDocument.error
    print(f"bad-document-kind: {badDocumentError.kind}")

    print(f"is-json: {Json.isValid(documentText)}")
}
