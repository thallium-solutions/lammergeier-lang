# Test: lamhttp.HttpClient — reusable client with base URL,
# default headers, and the full HTTP-verb surface.
#
# Spins up a tiny test server that echoes the method + path +
# the request's Authorization header back as JSON, then exercises
# every verb plus the base-URL composition rules.
#
# expect: get-status: 200
# expect: get-method-path: GET /users/42
# expect: head-status: 200
# expect: post-status: 200
# expect: post-method-path: POST /things {"name":"x"}
# expect: native-post-method-path: POST /native {"name":"native"}
# expect: post-content-type: application/json
# expect: plain-post-method-path: POST /plain ping
# expect: plain-post-content-type: text/plain
# expect: put-status: 200
# expect: put-method-path: PUT /things/1 {"name":"y"}
# expect: put-content-type: application/json
# expect: patch-status: 200
# expect: patch-method-path: PATCH /things/1 {"name":"z"}
# expect: patch-content-type: application/json
# expect: delete-status: 200
# expect: delete-method-path: DELETE /things/1
# expect: auth-echoed: Bearer abc123
# expect: response-header: first
# expect: response-header-values: first|second
# expect: response-header-fallback: fallback
# expect: response-json: true
# expect: response-json-error: true
# expect: non-2xx-result-ok: true
# expect: non-2xx-response-ok: false
# expect: response-cookies: 2
# expect: cookie-attrs: /api|example.test|Wed, 21 Oct 2015 07:28:00 GMT|3600|true|true|Lax|true
# expect: cookie-raw: true
# expect: cookie-unparsed: Priority=High
# expect: cookie-lookup: dark
# expect: cookie-missing: true
# expect: ok-helper-true: true
# expect: ok-helper-false: false
# expect: absolute-url-bypasses-base: true
# expect: relative-url-normalization: true
# expect: remove-header: true
# expect: options-status: 200
# expect: options-query: page=2&q=lam+bird
# expect: options-header: per-request
# expect: builder-status: 200
# expect: builder-query: mode=fluent
# expect: builder-header: builder
# expect: builder-body: PATCH /builder payload
# expect: builder-content-type: text/plain
# expect: builder-json: POST /builder-json {"kind":"bird"}
# expect: static-request: 200
# expect: request-error: true
# expect: timeout-error: true

from lamerrors import Result
from lamhttp import Http, HttpClient, HttpCookie, HttpRequestOptions, HttpResponse
from lamtime import Time

go! {
    import (
        "fmt"
        "net"
        "net/http"
        "strings"
    )
}

class NativePayload {
    func init(self, name: str) {
        self.name: str = name
    }

    func __json__(self) -> json {
        return {"name": self.name}
    }
}

func resultHttpResponse(result: Result) -> HttpResponse {
    go! { return result.Value.(*HttpResponse) }
}

func resultJson(result: Result) -> json {
    go! { return result.Value.(LamJSON) }
}

func main() {
    # ── Spin up a self-contained echo server. ``port`` is captured
    #    from the listener so the test doesn't need a hardcoded port.
    port: int = 0
    go! {
        ln, err := net.Listen("tcp", "127.0.0.1:0")
        if err != nil {
            panic(err)
        }
        port = ln.Addr().(*net.TCPAddr).Port

        mux := http.NewServeMux()
        mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
            if r.URL.Path == "/not-found" {
                w.WriteHeader(404)
                fmt.Fprint(w, "missing")
                return
            }
            if r.URL.Path == "/json-response" {
                w.Header().Set("Content-Type", "application/json")
                fmt.Fprint(w, `{"ok":true}`)
                return
            }
            authHdr := r.Header.Get("Authorization")
            body := ""
            if r.Body != nil {
                buf := make([]byte, 4096)
                n, _ := r.Body.Read(buf)
                body = string(buf[:n])
            }
            w.Header().Add("X-Trace", "first")
            w.Header().Add("X-Trace", "second")
            w.Header().Set("X-Request-Content-Type", r.Header.Get("Content-Type"))
            w.Header().Set("X-Request-Query", r.URL.RawQuery)
            w.Header().Set("X-Request-Option", r.Header.Get("X-Option"))
            w.Header().Add("Set-Cookie", "session=abc123; Path=/api; Domain=example.test; Expires=Wed, 21 Oct 2015 07:28:00 GMT; Max-Age=3600; Secure; HttpOnly; SameSite=Lax; Partitioned; Priority=High")
            w.Header().Add("Set-Cookie", "theme=dark; Path=/prefs")
            fmt.Fprintf(w, "%s %s %s|auth=%s", r.Method, r.URL.Path, body, authHdr)
        })
        srv := &http.Server{Handler: mux}
        go func() { _ = srv.Serve(ln) }()
        // Give the listener a tick to be ready.
        // The httptest package has Sleep semantics built in; we
        // use a tiny pause here for the same reason.
    }
    Time.sleepMs(50)

    base: str = ""
    go! {
        base = fmt.Sprintf("http://127.0.0.1:%d", port)
    }

    api: HttpClient = HttpClient(base, 5000)
    api.setHeader("Authorization", "Bearer abc123")

    # ── GET. The echo body looks like ``METHOD PATH BODY|auth=...``;
    #    we slice everything before the ``|auth=`` marker so the
    #    expects don't depend on the auth header layout.
    r1: HttpResponse = resultHttpResponse(api.get("/users/42"))
    print(f"get-status: {r1.status}")
    body1: str = r1.body
    mp1: str = ""
    go! {
        if i := strings.Index(body1, "|auth="); i >= 0 {
            mp1 = body1[:i]
        }
    }
    print(f"get-method-path: {mp1.trim()}")

    # ── HEAD (server doesn't return a body for HEAD, but status echoes).
    r2: HttpResponse = resultHttpResponse(api.head("/anything"))
    print(f"head-status: {r2.status}")

    # ── Native JSON overloads encode the value and supply the content type.
    r3: HttpResponse = resultHttpResponse(api.post("/things", {"name": "x"}))
    print(f"post-status: {r3.status}")
    body3: str = r3.body
    mp3: str = ""
    go! {
        if i := strings.Index(body3, "|auth="); i >= 0 {
            mp3 = body3[:i]
        }
    }
    print(f"post-method-path: {mp3}")

    nativeResponse: HttpResponse = resultHttpResponse(api.post("/native", json(NativePayload("native"))))
    nativeBody: str = nativeResponse.body
    nativeMethodPath: str = ""
    go! {
        if i := strings.Index(nativeBody, "|auth="); i >= 0 {
            nativeMethodPath = nativeBody[:i]
        }
    }
    print(f"native-post-method-path: {nativeMethodPath}")
    print(f"post-content-type: {r3.header('x-request-content-type')}")

    # The explicit content type + string body overload remains available.
    plainResponse: HttpResponse = resultHttpResponse(api.post("/plain", "text/plain", "ping"))
    plainBody: str = plainResponse.body
    plainMethodPath: str = ""
    go! {
        if i := strings.Index(plainBody, "|auth="); i >= 0 {
            plainMethodPath = plainBody[:i]
        }
    }
    print(f"plain-post-method-path: {plainMethodPath}")
    print(f"plain-post-content-type: {plainResponse.header('X-Request-Content-Type')}")

    # ── PUT JSON
    r4: HttpResponse = resultHttpResponse(api.put("/things/1", {"name": "y"}))
    print(f"put-status: {r4.status}")
    body4: str = r4.body
    mp4: str = ""
    go! {
        if i := strings.Index(body4, "|auth="); i >= 0 {
            mp4 = body4[:i]
        }
    }
    print(f"put-method-path: {mp4}")
    print(f"put-content-type: {r4.header('X-REQUEST-CONTENT-TYPE')}")

    # ── PATCH JSON
    r5: HttpResponse = resultHttpResponse(api.patch("/things/1", {"name": "z"}))
    print(f"patch-status: {r5.status}")
    body5: str = r5.body
    mp5: str = ""
    go! {
        if i := strings.Index(body5, "|auth="); i >= 0 {
            mp5 = body5[:i]
        }
    }
    print(f"patch-method-path: {mp5}")
    print(f"patch-content-type: {r5.header('x-request-content-type')}")

    # ── DELETE
    r6: HttpResponse = resultHttpResponse(api.delete("/things/1"))
    print(f"delete-status: {r6.status}")
    body6: str = r6.body
    mp6: str = ""
    go! {
        if i := strings.Index(body6, "|auth="); i >= 0 {
            mp6 = body6[:i]
        }
    }
    print(f"delete-method-path: {mp6.trim()}")

    # ── Authorization header echoed by the server.
    auth: str = ""
    go! {
        idx := strings.Index(body1, "auth=")
        if idx >= 0 {
            auth = body1[idx+5:]
        }
    }
    print(f"auth-echoed: {auth}")

    # ── Response metadata preserves repeated headers and parses cookies.
    print(f"response-header: {r1.header('x-trace')}")
    traceValues: list[str] = r1.headerValues("X-TRACE")
    print(f"response-header-values: {traceValues[0]}|{traceValues[1]}")
    print(f"response-header-fallback: {r1.header('missing', 'fallback')}")
    jsonResponse: HttpResponse = resultHttpResponse(api.get("/json-response"))
    jsonBody: json = resultJson(jsonResponse.json())
    jsonOk: bool = jsonBody.ok
    print(f"response-json: {jsonOk}")
    print(f"response-json-error: {not r1.json().ok()}")
    non2xxResult: Result[HttpResponse] = api.get("/not-found")
    non2xxResponse: HttpResponse = resultHttpResponse(non2xxResult)
    print(f"non-2xx-result-ok: {non2xxResult.ok()}")
    print(f"non-2xx-response-ok: {non2xxResponse.ok()}")
    print(f"response-cookies: {len(r1.cookies())}")
    sessionCookie: HttpCookie = r1.cookie("session")
    print(f"cookie-attrs: {sessionCookie.path}|{sessionCookie.domain}|{sessionCookie.expires}|{sessionCookie.maxAge}|{sessionCookie.secure}|{sessionCookie.httpOnly}|{sessionCookie.sameSite}|{sessionCookie.partitioned}")
    print(f"cookie-raw: {sessionCookie.raw.startsWith('session=abc123')}")
    print(f"cookie-unparsed: {sessionCookie.unparsed[0]}")
    themeCookie: HttpCookie = r1.cookie("theme")
    print(f"cookie-lookup: {themeCookie.value}")
    print(f"cookie-missing: {r1.cookie('missing') == None}")

    # ── ok() helper.
    print(f"ok-helper-true: {r1.ok()}")
    bad: HttpResponse = HttpResponse(404, "nope")
    print(f"ok-helper-false: {bad.ok()}")

    # ── Absolute URL bypasses baseUrl composition. Even when the
    #    HttpClient has a different baseUrl, an absolute path must
    #    win.
    api2: HttpClient = HttpClient("http://wrong.invalid", 2000)
    api2.setHeader("Authorization", "Bearer abc123")
    absUrl: str = f"{base}/explicit"
    rAbs: HttpResponse = resultHttpResponse(api2.get(absUrl))
    bodyAbs: str = rAbs.body
    bypass: bool = rAbs.status == 200
    go! {
        if !strings.Contains(bodyAbs, "/explicit") {
            bypass = false
        }
    }
    print(f"absolute-url-bypasses-base: {bypass}")

    slashClient: HttpClient = HttpClient("http://example.test/", 2000)
    normalized: bool = slashClient._resolveUrl("/x") == "http://example.test/x"
    normalized = normalized and slashClient._resolveUrl("x") == "http://example.test/x"
    normalized = normalized and HttpClient("http://example.test", 2000)._resolveUrl("x") == "http://example.test/x"
    print(f"relative-url-normalization: {normalized}")

    api.removeHeader("Authorization")
    noAuthResponse: HttpResponse = resultHttpResponse(api.get("/no-auth"))
    noAuth: bool = false
    go! {
        noAuth = strings.HasSuffix(noAuthResponse.Body, "auth=")
    }
    print(f"remove-header: {noAuth}")

    options: HttpRequestOptions = HttpRequestOptions()
    options.header("X-Option", "per-request").query("q", "lam bird").query("page", "2")
    optionsResult: Result[HttpResponse] = api.request("GET", "/options", options)
    optionsResponse: HttpResponse = resultHttpResponse(optionsResult)
    print(f"options-status: {optionsResponse.status}")
    print(f"options-query: {optionsResponse.header('X-Request-Query')}")
    print(f"options-header: {optionsResponse.header('X-Request-Option')}")

    builderResult: Result[HttpResponse] = api.build("PATCH", "/builder").header("X-Option", "builder").query("mode", "fluent").timeout(5000).text("payload", "text/plain").send()
    builderResponse: HttpResponse = resultHttpResponse(builderResult)
    print(f"builder-status: {builderResponse.status}")
    print(f"builder-query: {builderResponse.header('X-Request-Query')}")
    print(f"builder-header: {builderResponse.header('X-Request-Option')}")
    builderMethodPath: str = builderResponse.body.split("|")[0].trim()
    print(f"builder-body: {builderMethodPath}")
    print(f"builder-content-type: {builderResponse.header('X-Request-Content-Type')}")

    builderJsonResult: Result[HttpResponse] = api.build("POST", "/builder-json").json({"kind": "bird"}).send()
    builderJsonResponse: HttpResponse = resultHttpResponse(builderJsonResult)
    builderJsonMethodPath: str = builderJsonResponse.body.split("|")[0].trim()
    print(f"builder-json: {builderJsonMethodPath}")

    staticResult: Result[HttpResponse] = Http.request("GET", f"{base}/static")
    staticResponse: HttpResponse = resultHttpResponse(staticResult)
    print(f"static-request: {staticResponse.status}")
    failedRequest: Result[HttpResponse] = Http.request("GET", "http://127.0.0.1:1/")
    print(f"request-error: {not failedRequest.ok()}")

    # ── Tiny timeout against a non-routable address surfaces an
    #    error string. Use 10.255.255.1 (RFC 5737 is HTTP-only;
    #    this is reserved-ish private space that won't resolve).
    timeoutClient: HttpClient = HttpClient("http://10.255.255.1", 50)
    timeoutResult: Result[HttpResponse] = timeoutClient.get("/x")
    print(f"timeout-error: {not timeoutResult.ok()}")
}
