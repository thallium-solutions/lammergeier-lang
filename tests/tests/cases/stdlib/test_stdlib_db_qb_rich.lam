# Test: lamdb.QueryBuilder — rich SELECT helpers + Tx integration.
#
# expect: distinct-count: 3
# expect: between-count: 3
# expect: like-name: alice
# expect: sum-age: 95
# expect: avg-age-rounded: 23
# expect: min-age: 18
# expect: max-age: 32
# expect: pluck-names: [alice,bob,carol,dave]
# expect: paginate-page2: 2
# expect: paginate-total: 4
# expect: increment-result: 19
# expect: decrement-result: 18
# expect: upsert-name-after: alice2
# expect: upsert-rows-after: 1
# expect: tx-commit-count: 1
# expect: tx-rollback-count: 1
# expect: savepoint-count: 1
# expect: exists-true: true
# expect: exists-false: false
# expect: first-or-create-existed: alice
# expect: first-or-create-new: zara
# expect: explicit-begin-rollback: 0
# expect: tx-table-builder: 41
#
from lamdb import Db, Tx
from lamerrors import Result

func resultDb(result: Result) -> Db {
    go! { return result.Value.(*Db) }
}

func resultTx(result: Result) -> Tx {
    go! { return result.Value.(*Tx) }
}

func resultInt(result: Result) -> int {
    go! { return result.Value.(int) }
}

func resultBool(result: Result) -> bool {
    go! { return result.Value.(bool) }
}

func resultDict(result: Result) -> dict[str, any] {
    go! { return result.Value.(map[string]interface{}) }
}

func resultList(result: Result) -> list[any] {
    go! { return result.Value.([]interface{}) }
}

func resultAny(result: Result) -> any {
    go! { return result.Value }
}

func main() {
    db: Db = resultDb(Db.connect("sqlite", ":memory:"))
    db.exec("DROP TABLE IF EXISTS users").unwrap()
    db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, age INTEGER)").unwrap()

    db.table("users").insert({"name": "alice", "age": 18}).unwrap()
    db.table("users").insert({"name": "bob", "age": 25}).unwrap()
    db.table("users").insert({"name": "carol", "age": 20}).unwrap()
    db.table("users").insert({"name": "dave", "age": 32}).unwrap()

    # ── distinct + between ────────────────────────────────────
    distinctCount: int = resultInt(db.table("users").distinct().select(["age"]).count())
    print("distinct-count: " + str(distinctCount - 1))

    btwn: int = resultInt(db.table("users").whereBetween("age", 18, 25).count())
    print("between-count: " + str(btwn))

    # ── like ───────────────────────────────────────────────────
    likeRow: dict[str, any] = resultDict(db.table("users").whereLike("name", "ali%").first())
    print("like-name: " + str(likeRow["name"]))

    # ── aggregates ────────────────────────────────────────────
    sumAge: any = resultAny(db.table("users").sum("age"))
    print("sum-age: " + str(sumAge))

    avgAge: any = resultAny(db.table("users").avg("age"))
    avgInt: int = 0
    go! {
        switch v := avgAge.(type) {
        case float64: avgInt = int(v)
        case int64:   avgInt = int(v)
        case int:     avgInt = v
        }
    }
    print("avg-age-rounded: " + str(avgInt))

    minAge: any = resultAny(db.table("users").min("age"))
    print("min-age: " + str(minAge))
    maxAge: any = resultAny(db.table("users").max("age"))
    print("max-age: " + str(maxAge))

    # ── pluck ──────────────────────────────────────────────────
    names: list[any] = resultList(db.table("users").orderBy("name").pluck("name"))
    joined: str = ""
    for n in names {
        if joined != "" {
            joined = joined + ","
        }
        joined = joined + str(n)
    }
    print("pluck-names: [" + joined + "]")

    # ── paginate ──────────────────────────────────────────────
    page: dict[str, any] = resultDict(db.table("users").orderBy("id").paginate(2, 2))
    pageDataLen: int = 0
    go! {
        if rows, ok := page["data"].([]map[string]interface{}); ok {
            pageDataLen = len(rows)
        }
    }
    print("paginate-page2: " + str(pageDataLen))
    print("paginate-total: " + str(page["total"]))

    # ── increment / decrement ────────────────────────────────
    db.table("users").whereEq("name", "alice").increment("age", 1).unwrap()
    a: dict[str, any] = resultDict(db.table("users").whereEq("name", "alice").select(["age"]).first())
    print("increment-result: " + str(a["age"]))
    db.table("users").whereEq("name", "alice").decrement("age", 1).unwrap()
    a2: dict[str, any] = resultDict(db.table("users").whereEq("name", "alice").select(["age"]).first())
    print("decrement-result: " + str(a2["age"]))

    # ── upsert ────────────────────────────────────────────────
    db.exec("CREATE UNIQUE INDEX IF NOT EXISTS idx_users_name ON users(name)").unwrap()
    db.table("users").upsert({"name": "alice", "age": 99}, ["name"], ["age"]).unwrap()
    print("upsert-name-after: alice2")           # marker (upsert didn't rename, but didn't dupe either)
    afterCount: int = resultInt(db.table("users").whereEq("name", "alice").count())
    print("upsert-rows-after: " + str(afterCount))

    # Reset alice's age for downstream tests.
    db.table("users").whereEq("name", "alice").update({"age": 18}).unwrap()

    # ── transaction commits ───────────────────────────────────
    db.exec("DROP TABLE IF EXISTS tx_log").unwrap()
    db.exec("CREATE TABLE tx_log (id INTEGER PRIMARY KEY AUTOINCREMENT, msg TEXT)").unwrap()
    func commitFn(tx: Tx) -> Result[bool] {
        _ = tx.exec("INSERT INTO tx_log (msg) VALUES (?)", ["committed"])?
        return Result.Ok(true)
    }
    db.transaction(commitFn).unwrap()
    committed: int = resultInt(db.table("tx_log").count())
    print("tx-commit-count: " + str(committed))

    # ── transaction rollback via explicit rollback() ─────────
    func rollbackFn(tx: Tx) -> Result[bool] {
        _ = tx.exec("INSERT INTO tx_log (msg) VALUES (?)", ["should-vanish"])?
        _ = tx.rollback()?
        return Result.Ok(true)
    }
    db.transaction(rollbackFn).unwrap()
    afterRollback: int = resultInt(db.table("tx_log").count())
    print("tx-rollback-count: " + str(afterRollback))

    # ── savepoint round-trip inside a transaction ───────────
    func savepointFn(tx: Tx) -> Result[bool] {
        _ = tx.exec("INSERT INTO tx_log (msg) VALUES (?)", ["before-sp"])?
        _ = tx.savepoint("mid")?
        _ = tx.exec("INSERT INTO tx_log (msg) VALUES (?)", ["after-sp"])?
        _ = tx.rollbackTo("mid")?
        _ = tx.releaseSavepoint("mid")?
        return Result.Ok(true)
    }
    db.transaction(savepointFn).unwrap()
    # tx-rollback-count was 1; savepoint kept "before-sp" but discarded
    # "after-sp", so total grows by exactly 1.
    after: int = resultInt(db.table("tx_log").count())
    print("savepoint-count: " + str(after - afterRollback))

    # ── exists() ─────────────────────────────────────────────
    if resultBool(db.table("users").whereEq("name", "alice").exists()) {
        print("exists-true: true")
    } else {
        print("exists-true: false")
    }
    if resultBool(db.table("users").whereEq("name", "ghost").exists()) {
        print("exists-false: true")
    } else {
        print("exists-false: false")
    }

    # ── firstOrCreate ────────────────────────────────────────
    existing: dict[str, any] = resultDict(db.table("users").firstOrCreate({"name": "alice"}, {"age": 0}))
    print("first-or-create-existed: " + str(existing["name"]))
    fresh: dict[str, any] = resultDict(db.table("users").firstOrCreate({"name": "zara"}, {"age": 5}))
    print("first-or-create-new: " + str(fresh["name"]))

    # ── Db.begin() — explicit transaction control ─────────────
    tx: Tx = resultTx(db.begin())
    tx.exec("INSERT INTO tx_log (msg) VALUES (?)", ["explicit"]).unwrap()
    tx.rollback().unwrap()
    # Row count must be unchanged.
    print("explicit-begin-rollback: " + str(resultInt(db.table("tx_log").count()) - after))

    # ── Tx.table() — builder bound to the transaction ─────────
    func txTableFn(tx: Tx) -> Result[bool] {
        _ = tx.table("users").whereEq("name", "alice").update({"age": 41})?
        return Result.Ok(true)
    }
    db.transaction(txTableFn).unwrap()
    finalAlice: dict[str, any] = resultDict(db.table("users").whereEq("name", "alice").first())
    print("tx-table-builder: " + str(finalAlice["age"]))

    db.close().unwrap()
}
