# Test: lamdeque Deque
# expect: PASS 1 empty
# expect: PASS 2 pushBack size
# expect: PASS 3 peekFront
# expect: PASS 4 peekBack
# expect: PASS 5 pushFront
# expect: PASS 6 front order
# expect: PASS 7 popFront
# expect: PASS 8 popBack
# expect: PASS 9 toList round-trip
# expect: PASS 10 clear empties
# expect: PASS 11 popFront error
# expect: PASS 12 popBack error
# expect: PASS 13 peekFront error
# expect: PASS 14 peekBack error
# expect: PASS 15 heterogeneous values
# expect: 15 passed, 0 failed, 15 total

from lamdatastructures import Deque
from lamtest import Test

func main() {
    d: Deque = Deque()
    Test.assertTrue(d.isEmpty(), "1 empty")

    d.pushBack(10)
    d.pushBack(20)
    d.pushBack(30)
    Test.assertEqual(d.size(), 3, "2 pushBack size")
    Test.assertEqual(d.peekFront().unwrap(), 10, "3 peekFront")
    Test.assertEqual(d.peekBack().unwrap(), 30, "4 peekBack")

    d.pushFront(0)
    Test.assertEqual(d.size(), 4, "5 pushFront")
    Test.assertEqual(d.peekFront().unwrap(), 0, "6 front order")

    first: any = d.popFront().unwrap()
    Test.assertEqual(first, 0, "7 popFront")

    last: any = d.popBack().unwrap()
    Test.assertEqual(last, 30, "8 popBack")

    snapshot: list[any] = d.toList()
    expected: list[any] = [10, 20]
    Test.assertEqual(snapshot, expected, "9 toList round-trip")

    d.clear()
    Test.assertTrue(d.isEmpty(), "10 clear empties")

    Test.assertFalse(d.popFront().ok(), "11 popFront error")
    Test.assertFalse(d.popBack().ok(), "12 popBack error")
    Test.assertFalse(d.peekFront().ok(), "13 peekFront error")
    Test.assertFalse(d.peekBack().ok(), "14 peekBack error")

    d.pushBack("word")
    d.pushBack(7)
    d.pushFront(true)
    mixed: list[any] = d.toList()
    mixedOk: bool = (len(mixed) == 3) and (mixed[0] == true) and (mixed[1] == "word") and (mixed[2] == 7)
    Test.assertTrue(mixedOk, "15 heterogeneous values")

    Test.summary()
}
