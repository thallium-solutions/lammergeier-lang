# Test: lamstack.Stack data structure
# expect: empty: true
# expect: size: 3
# expect: peek: 30
# expect: pop: 30
# expect: pop: 20
# expect: size: 1
# expect: empty: false
# expect: tolist_size: 1
# expect: cleared: true
# expect: mixed: 3

from lamdatastructures import Stack

func main() {
    s: Stack = Stack()
    print(f"empty: {s.isEmpty()}")

    s.push(10)
    s.push(20)
    s.push(30)
    print(f"size: {s.size()}")
    print(f"peek: {s.peek().unwrap()}")
    print(f"pop: {s.pop().unwrap()}")
    print(f"pop: {s.pop().unwrap()}")
    print(f"size: {s.size()}")
    print(f"empty: {s.isEmpty()}")

    items: list[any] = s.toList()
    print(f"tolist_size: {len(items)}")

    s.clear()
    print(f"cleared: {s.isEmpty()}")

    s.push("word")
    s.push(7)
    s.push(true)
    mixed: list[any] = s.toList()
    print(f"mixed: {len(mixed)}")
}
