# expect: {"age":30,"name":"Alice"}
# expect: Alice
# expect: 30
# expect: Bob
# expect: 25

from lamjson import Json
from lamerrors import Result

func resultString(result: Result) -> str {
    go! { return result.Value.(string) }
}

class Person {
    func init(self, name: str, age: int) {
        self.name: str = name
        self.age: int = age
    }

    func __json__(self) -> json {
        return {"name": self.name, "age": self.age}
    }
}

func main() {
    p: Person = Person("Alice", 30)
    jsonStr: str = resultString(Json.encode(json(p)))
    print(jsonStr)

    # Decode back into a new Person
    p2: Person = Person("", 0)
    _ = Json.decodeInto(jsonStr, p2)
    print(p2.name)
    print(p2.age)

    # Encode/decode another
    p3: Person = Person("Bob", 25)
    json3: str = resultString(Json.encode(json(p3)))
    p4: Person = Person("", 0)
    _ = Json.decodeInto(json3, p4)
    print(p4.name)
    print(p4.age)
}
