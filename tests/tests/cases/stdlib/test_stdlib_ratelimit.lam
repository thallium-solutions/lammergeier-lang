# Test: lamratelimit — token bucket.
#
# Scenarios:
#   * A fresh bucket of capacity=5 allows 5 immediate takeAvailables.
#   * The 6th takeAvailable fails (bucket empty).
#   * After sleeping long enough for a refill, takeAvailable succeeds again.
#   * take() blocks until the missing tokens have refilled.
#
# expect: initial-available: 5
# expect: burst-5: true
# expect: sixth-fails: false
# expect: after-refill: true
# expect: take-waited-for-refill: true
# expect: emptied-by-take: true

from lamratelimit import TokenBucket
from lamtime import Time

func main() {
    bucket: TokenBucket = TokenBucket(5, 50)   # 5 tokens, refills at 50/s
    print(f"initial-available: {bucket.available()}")

    # Drain the bucket — 5 takes should all succeed immediately.
    burstOk: bool = true
    for i in range(5) {
        if not bucket.takeAvailable(1) { burstOk = false }
    }
    print(f"burst-5: {burstOk}")

    # The 6th take fails — bucket is empty.
    sixth: bool = bucket.takeAvailable(1)
    print(f"sixth-fails: {sixth}")

    # Wait 100ms — at 50 tokens/sec that's ~5 tokens back.
    Time.sleepMs(100)
    afterRefill: bool = bucket.takeAvailable(1)
    print(f"after-refill: {afterRefill}")

    # Drain completely, then check that a blocking take() waits for the
    # tokens it is missing. The deficit is measured when take() starts:
    # under heavy load the process can be descheduled between draining and
    # starting the clock, and the bucket legitimately refills meanwhile.
    while bucket.takeAvailable(1) {
        pass
    }
    start: int = Time.nowUnixMilli()
    deficit: int = 4 - bucket.available()
    bucket.take(4)   # needs 4 tokens, must wait for the missing ones
    elapsed: int = Time.elapsedSince(start)
    required: int = deficit * 20 - 5   # 50 tokens/s -> 20ms per token, 5ms clock slack
    waited: bool = deficit <= 0 or elapsed >= required
    print(f"take-waited-for-refill: {waited}")
    print(f"emptied-by-take: {bucket.available() <= 1}")
}
