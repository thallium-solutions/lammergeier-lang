# expect: connected
# expect: table created
# expect: inserted 3 rows
# expect: Bob 25
# expect: Alice 30
# expect: Charlie 35
# expect: row count: 3
# expect: cleaned up

from lamdb import Db
from lamerrors import Result

func resultDb(result: Result) -> Db {
    go! { return result.Value.(*Db) }
}

func resultRows(result: Result) -> list[dict[str, any]] {
    go! { return result.Value.([]map[string]interface{}) }
}

func resultAny(result: Result) -> any {
    go! { return result.Value }
}

func main() {
    # In-memory SQLite — disposable, no setup needed.
    db: Db = resultDb(Db.connect("sqlite", ":memory:"))
    print("connected")

    db.exec("DROP TABLE IF EXISTS lam_test_users").unwrap()
    db.exec("CREATE TABLE lam_test_users (name TEXT, age INTEGER)").unwrap()
    print("table created")

    db.exec("INSERT INTO lam_test_users (name, age) VALUES ('Alice', 30)").unwrap()
    db.exec("INSERT INTO lam_test_users (name, age) VALUES ('Bob', 25)").unwrap()
    db.exec("INSERT INTO lam_test_users (name, age) VALUES ('Charlie', 35)").unwrap()
    print("inserted 3 rows")

    rows: list[dict[str, any]] = resultRows(db.query(
        "SELECT name, age FROM lam_test_users ORDER BY age"
    ))
    for row in rows {
        name: any = row["name"]
        age: any = row["age"]
        print(f"{name} {age}")
    }

    n: any = resultAny(db.scalar("SELECT COUNT(*) FROM lam_test_users"))
    print(f"row count: {n}")

    db.exec("DROP TABLE lam_test_users").unwrap()
    db.close().unwrap()
    print("cleaned up")
}
