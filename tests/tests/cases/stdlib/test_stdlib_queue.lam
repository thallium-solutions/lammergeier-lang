# Test: lamqueue.Queue data structure
# expect: empty: true
# expect: size: 3
# expect: peek: a
# expect: dequeue: a
# expect: dequeue: b
# expect: size: 1
# expect: empty: false
# expect: tolist_size: 1
# expect: cleared: true
# expect: mixed: 3

from lamdatastructures import Queue

func main() {
    q: Queue = Queue()
    print(f"empty: {q.isEmpty()}")

    q.enqueue("a")
    q.enqueue("b")
    q.enqueue("c")
    print(f"size: {q.size()}")
    print(f"peek: {q.peek().unwrap()}")
    print(f"dequeue: {q.dequeue().unwrap()}")
    print(f"dequeue: {q.dequeue().unwrap()}")
    print(f"size: {q.size()}")
    print(f"empty: {q.isEmpty()}")

    items: list[any] = q.toList()
    print(f"tolist_size: {len(items)}")

    q.clear()
    print(f"cleared: {q.isEmpty()}")

    q.enqueue("word")
    q.enqueue(7)
    q.enqueue(true)
    mixed: list[any] = q.toList()
    print(f"mixed: {len(mixed)}")
}
