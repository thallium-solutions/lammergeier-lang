# Integration test: lamcron scheduled-job helper.
#
# Drives the "happy path" of the Cron class against a tight
# schedule (``*/1 * * * * *`` — every second, with a seconds field)
# so the test fires 2-3 times within ~2.5s and completes reliably
# even on slow CI.
#
# expect: count-zero: 0
# expect: started-nonzero: true
# expect: entries-one: true
# expect: remove-empty: true
# expect: restart-ok: true
# expect: invalid-expr: error
# expect: invalid-callback: error
# expect: void-lambda: true
# expect: concurrent-cron: true

from lamconcurrency import Atomic
from lamcron import Cron
from lamtime import Time
from lamerrors import Result

go! {
    import (
        "sync"
        "sync/atomic"
    )
}

func resultInt(r: Result) -> int {
    value: int = r.unwrap()
    return value
}

class Counter {
    #- Tiny mutable cell so the scheduled lambda has somewhere to
       stash its tick-count. A plain ``int`` in ``main`` wouldn't
       survive the lambda capture boundary. -#
    func init(self) {
        self.n: Atomic = Atomic(0)
    }
    func tick(self) -> int {
        return self.n.increment()
    }
    func value(self) -> int {
        return self.n.get()
    }
}

func exerciseConcurrentCron() -> bool {
    scheduler: Cron = Cron.newWithSeconds()
    succeeded: bool = false
    go! {
        var wg sync.WaitGroup
        var failed atomic.Bool
        for worker := 0; worker < 6; worker++ {
            wg.Add(1)
            go func() {
                defer wg.Done()
                for j := 0; j < 20; j++ {
                    result := scheduler.Schedule("@every 1h", func() interface{} { return nil })
                    if result == nil || !result.Ok() {
                        failed.Store(true)
                        continue
                    }
                    entryId, ok := result.Value.(int)
                    if !ok {
                        failed.Store(true)
                        continue
                    }
                    scheduler.Start()
                    _ = scheduler.EntryIds()
                    scheduler.Remove(entryId)
                    scheduler.Stop()
                }
            }()
        }
        wg.Wait()
        scheduler.Stop()
        succeeded = !failed.Load() && scheduler.Count() == 0
    }
    return succeeded
}

func main() {
    c: Cron = Cron.newWithSeconds()

    # Before ``start`` the scheduler is quiescent.
    print("count-zero: " + str(c.count()))

    ctr: Counter = Counter()
    id: int = resultInt(c.schedule("* * * * * *", lambda: ctr.tick()))

    c.start()
    # Two full seconds is enough to observe at least one tick;
    # waiting 2.3s keeps us comfortably inside the window even if
    # the scheduler's 0.x-second phase lands unfavourably.
    Time.sleepMs(2300)
    c.stop()

    if ctr.value() > 0 {
        print("started-nonzero: true")
    } else {
        print("started-nonzero: false (got " + str(ctr.value()) + ")")
    }

    if c.count() == 1 and len(c.entryIds()) == 1 {
        print("entries-one: true")
    } else {
        print("entries-one: false")
    }

    c.remove(id)
    if c.count() == 0 and len(c.entryIds()) == 0 {
        print("remove-empty: true")
    } else {
        print("remove-empty: false")
    }

    # Restart path: schedule a fresh job, start again, observe
    # that the counter keeps climbing.
    before: int = ctr.value()
    c.schedule("* * * * * *", lambda: ctr.tick()).unwrap()
    c.start()
    Time.sleepMs(1300)
    c.stop()
    if ctr.value() > before {
        print("restart-ok: true")
    } else {
        print("restart-ok: false (" + str(before) + " → " + str(ctr.value()) + ")")
    }

    # Malformed expressions are ordinary Result errors.
    invalid: Result[int] = c.schedule("this is not a cron expression", lambda: 0)
    if not invalid.ok() {
        print("invalid-expr: error")
    } else {
        print("invalid-expr: missed")
    }
    invalidCallback: Result[int] = c.schedule("* * * * * *", 42)
    if not invalidCallback.ok() {
        print("invalid-callback: error")
    }
    # A void lambda (the documented ``lambda: print("tick")`` shape) is a
    # supported ``func()`` callback; it emitted invalid Go before.
    printer: Cron = Cron.new()
    tick: Result[int] = printer.schedule("0 0 1 1 *", lambda: print("tick"))
    print(f"void-lambda: {tick.ok()}")

    print(f"concurrent-cron: {exerciseConcurrentCron()}")
}
