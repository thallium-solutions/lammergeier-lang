# expect: dataframe-json:array:2:2

from lamdata import DataFrame
from lamjson import Json

func main() {
    rows: json = [
        {"name": "Ada", "score": 10},
        {"name": "Lin", "score": 12}
    ]
    frame: DataFrame = DataFrame.readJSON(rows)
    restored: json = frame.jsonValue()
    legacy: DataFrame = DataFrame.readJsonValue(rows)
    print(f"dataframe-json:{Json.kind(restored)}:{len(restored)}:{legacy.nrow()}")
}
