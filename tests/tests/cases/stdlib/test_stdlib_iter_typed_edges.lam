# Test: typed `Iter[T]` edge cases — an `Iter[any]` passing values
# through, `repeat(None, ...)`, inferred locals, `Iter[int]` parameters and
# returns, block-bodied and capturing lambdas, an `Iter` inside a lambda,
# list results, `for` over `toList()`, comprehensions and `first()`
# unwrapped inline, and a long chain (typed in linear time: each link
# used to re-type and re-lower its receiver several times).
#
# expect: [1 a]
# expect: 2
# expect: [0 3 6]
# expect: 20
# expect: [one many]
# expect: [10 20 30]
# expect: [1 2 3]
# expect: a
# expect: [[1 2] [2 4]]
# expect: [false true]
# expect: 100
# expect: 101
# expect: [a]
# expect: [1 2]
# expect: A
# expect: empty=[] 0
# expect: long=[441 1089 2025 3249 4761 6561]

from lamiter import Iter

class User {
    func init(self, name: str, age: int) {
        self.name: str = name
        self.age: int = age
    }
}

func evens(n: int) -> Iter[int] {
    return Iter.range_(0, n).filter(lambda x: x % 2 == 0)
}

func total(it: Iter[int]) -> int {
    return it.reduce(0, lambda a, b: a + b)
}

func main() {
    loose: list[any] = [1, "a"]
    same: list[any] = Iter.fromList(loose).map(lambda x: x).toList()
    print(same)
    print(Iter.repeat(None, 2).count_())
    x = Iter.range_(0, 3)
    print(x.map(lambda v: v * 3).toList())
    print(total(evens(10)))
    labels: list[str] = Iter.range_(1, 3).map(lambda (n: int) -> str {
        if n == 1 {
            return "one"
        }
        return "many"
    }).toList()
    print(labels)
    factor: int = 10
    print(Iter.range_(1, 4).map(lambda v: v * factor).toList())
    print(Iter.range_(1, 4).map(lambda v: Iter.range_(0, v).count_()).toList())
    users: list[User] = [User("a", 3)]
    olds: list[User] = Iter.fromList(users).filter(lambda u: u.age > 1).toList()
    print(olds[0].name)
    nested: list[list[int]] = Iter.range_(1, 3).map(lambda n: [n, n * 2]).toList()
    print(nested)
    flags: list[bool] = Iter.fromList(["a", ""]).map(lambda s: s == "").toList()
    print(flags)
    for v in Iter.range_(0, 2).toList() {
        print(v + 100)
    }
    print([u.name for u in Iter.fromList(users).toList()])
    print(Iter.fromList([1.5, 2.5]).map(lambda f: int(f)).toList())
    print(Iter.fromList(users).map(lambda u: u.name.toUpper()).first().unwrap())
    none: list[str] = []
    print(f"empty={Iter.fromList(none).map(lambda s: len(s)).toList()} {Iter.fromList(none).count_()}")
    long: list[int] = Iter.range_(0, 100).filter(lambda x: x % 2 == 0).map(lambda x: x + 1).filter(lambda x: x > 3).map(lambda x: x * 2).take(20).drop(2).map(lambda x: x - 1).filter(lambda x: x % 3 == 0).map(lambda x: x * x).takeWhile(lambda x: x < 100000).toList()
    print(f"long={long}")
}
