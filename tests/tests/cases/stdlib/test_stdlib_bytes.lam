# expect: encode_ok
# expect: decode_ok
# expect: contains_ok
# expect: count_ok

from lambytes import Bytes
from lamerrors import Result

func resultStr(r: Result) -> str {
    go! { return r.Value.(string) }
}

func main() {
    # Hex encode
    h: str = Bytes.hexEncode("hello")
    if len(h) > 0 {
        print("encode_ok")
    }

    # Hex decode
    d: str = resultStr(Bytes.hexDecode(h))
    if d == "hello" {
        print("decode_ok")
    }

    if Bytes.contains("hello bytes", "bytes") and not Bytes.contains("hello", "z") {
        print("contains_ok")
    }
    if Bytes.count("aaaa", "aa") == 2 {
        print("count_ok")
    }
}
