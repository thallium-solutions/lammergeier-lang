# expect: Ada:2
# expect: true
# expect: object
# expect: json-error: true

from lamdb import Db
from lamjson import Json
from lamerrors import Result

func resultDb(result: Result) -> Db {
    go! { return result.Value.(*Db) }
}

func resultRows(result: Result) -> list[dict[str, any]] {
    go! { return result.Value.([]map[string]interface{}) }
}

func resultJson(result: Result) -> json {
    go! { return result.Value.(LamJSON) }
}

func main() {
    db: Db = resultDb(Db.connect("sqlite", ":memory:"))
    db.exec("CREATE TABLE records (id INTEGER PRIMARY KEY, payload TEXT)").unwrap()
    payload: json = {"name": "Ada", "roles": ["admin", "writer"], "active": true}
    db.exec("INSERT INTO records (id, payload) VALUES (?, ?)", [1, payload]).unwrap()

    rows: list[dict[str, any]] = resultRows(db.queryJson("SELECT payload FROM records WHERE id = ?", ["payload"], [1]))
    restored: json = resultJson(Json.fromValue(rows[0]["payload"]))
    name: str = restored.name
    roleCount: int = len(restored.roles)
    active: bool = restored.active
    print(f"{name}:{roleCount}")
    print(active)

    scalar: json = resultJson(db.scalarJson("SELECT payload FROM records WHERE id = ?", [1]))
    print(Json.kind(scalar))

    db.exec("INSERT INTO records (id, payload) VALUES (?, ?)", [2, "not-json"]).unwrap()
    badJson: Result[list[dict[str, any]]] = db.queryJson("SELECT payload FROM records WHERE id = ?", ["payload"], [2])
    print(f"json-error: {not badJson.ok()}")
    db.close().unwrap()
}
