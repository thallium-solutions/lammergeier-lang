# Test: `int(3.7)` truncates (also negative and through a variable),
# `x **= n` on an int stays an int (floats stay floats), and negative /
# stepped slices of typed lists and strings keep their type so they can
# be assigned to annotated targets.
#
# expect: int: 3 -3 2
# expect: power: 9 81 6.25
# expect: tail: [3 4] 7
# expect: reversed: [4 3 2 1]
# expect: every other: [1 3]
# expect: middle: [2 3]
# expect: string: llo olleh
# expect: dynamic: [3 4]

func main() {
    f: float = 2.9
    print(f"int: {int(3.7)} {int(-3.7)} {int(f)}")
    x: int = 3
    x **= 2
    y = 3
    y **= 4
    z: float = 2.5
    z **= 2
    print(f"power: {x} {y} {z}")
    a: list[int] = [1, 2, 3, 4]
    b: list[int] = a[-2:]
    print(f"tail: {b} {b[0] + b[1]}")
    r: list[int] = a[::-1]
    print(f"reversed: {r}")
    print(f"every other: {a[::2]}")
    m: list[int] = a[1:-1]
    print(f"middle: {m}")
    s: str = "hello"
    t: str = s[-3:]
    print(f"string: {t} {s[::-1]}")
    k = -2
    d: list[int] = a[k:]
    print(f"dynamic: {d}")
}
