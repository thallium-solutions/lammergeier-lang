# Test: Python division semantics. `/` is always a float division
# (`7 / 2 == 3.5`, `4 / 2 == 2.0`), `//` floors (`-7 // 2 == -4`) and `%`
# takes the sign of the divisor (`-7 % 2 == 1`), for ints and floats, in
# literals, typed locals, fields, f-strings, chains, compound assignments,
# lambdas and generics. Every zero divisor raises ZeroDivisionError.
#
# expect: 3.5 true 0.3333333333333333
# expect: 3.5 3.5 2.5
# expect: -4 -4 -4 3 -3
# expect: 1 1 -1 -1 2
# expect: pow2 -1 1 -2 1 0 7
# expect: 0.5 -4 -0.5 9 -1.5
# expect: 3.5 3 2 true
# expect: dollars -3 rest 50 ratio 0.5
# expect: 3.5 3 1 -4 1
# expect: k -4 2 g 3.5 1 1.5
# expect: 5 3 1.5 2 3
# expect: [-2 -1 -1 0 0 1 1] [0 1 2 0 1 2 0]
# expect: mid 30 last 50 wrap 10
# expect: lambda 2.5 generic 3.5 2.25
# expect: zero zde zde zde zde zde zde zde zde
# expect: messages division by zero | integer division or modulo by zero | float modulo
# expect: arith caught ZeroDivisionError

class Account {
    func init(self, cents: int) {
        self.cents: int = cents
    }

    func dollars(self) -> int {
        return self.cents // 100
    }

    func rest(self) -> int {
        return self.cents % 100
    }

    func ratio(self, other: Account) -> float {
        return self.cents / other.cents
    }
}

func half(n: int) -> float {
    return n / 2
}

func mean(xs: list[int]) -> float {
    total: int = 0
    for x in xs {
        total += x
    }
    return total / len(xs)
}

func avg[T: number](a: T, b: T) -> float {
    return (a + b) / 2
}

func tryInt(a: int, b: int, op: str) -> str {
    try {
        if op == "/" {
            return str(a / b)
        }
        if op == "//" {
            return str(a // b)
        }
        return str(a % b)
    } catch ZeroDivisionError as _e {
        return "zde"
    }
}

func tryFloat(a: float, b: float, op: str) -> str {
    try {
        if op == "/" {
            return str(a / b)
        }
        if op == "//" {
            return str(a // b)
        }
        return str(a % b)
    } catch ZeroDivisionError as _e {
        return "zde"
    }
}

func message(a: float, b: int, op: str) -> str {
    try {
        if op == "/" {
            return str(a / b)
        }
        if op == "//" {
            return str(int(a) // b)
        }
        return str(a % b)
    } catch e {
        text: str = f"{e}"
        return text.replace("ZeroDivisionError: ", "")
    }
}

func main() {
    n: int = 7
    m: int = -7
    print(7 / 2, 4 / 2 == 2.0, 1 / 3)

    y: float = n / 2
    print(y, half(n), mean([1, 2, 3, 4]))

    print(-7 // 2, m // 2, 7 // -2, m // -2, m // 3)
    print(-7 % 2, m % 2, 7 % -2, m % -3, m % 3)
    print("pow2", m // 8, m % 8, m // 4, m % 4, n // 8, n % 8)

    f: float = -7.5
    print(f % 2.0, f // 2.0, 7.5 % -2.0, 1.0 // 0.1, f / 5)

    print(n / 2.0, n // 2.0, n % 2.5, n / 7 == 1.0)

    debt: Account = Account(-250)
    print(f"dollars {debt.dollars()} rest {debt.rest()} ratio {Account(1).ratio(Account(2))}")

    print(f"{n / 2} {n // 2} {n % 2} {m // 2} {m % 2}")

    k: int = -7
    k //= 2
    first: int = k
    k %= 3
    g: float = 7.0
    g /= 2
    g2: float = g
    g //= 2
    g3: float = g
    g = 7.5
    g %= 3
    print(f"k {first} {k} g {g2} {g3} {g}")

    print(10 / 4 * 2, 2 * 7 // 4, 7 // 2 / 2, -7 // 2 % 3, -m // 2)

    floors: list[int] = []
    mods: list[int] = []
    for i in range(-3, 4) {
        floors.append(i // 2)
        mods.append(i % 3)
    }
    print(floors, mods)

    xs: list[int] = [10, 20, 30, 40, 50]
    back: int = -1
    print(f"mid {xs[len(xs) // 2]} last {xs[back % len(xs)]} wrap {xs[len(xs) % len(xs)]}")

    halve = lambda (x: int): x / 2
    print(f"lambda {halve(5)} generic {avg(3, 4)} {avg(1.5, 3.0)}")

    zero: int = 0
    fzero: float = 0.0
    print("zero", tryInt(1, zero, "/"), tryInt(1, zero, "//"), tryInt(1, zero, "%"),
        tryFloat(1.0, fzero, "/"), tryFloat(1.0, fzero, "//"), tryFloat(1.0, fzero, "%"),
        tryFloat(float(n), float(zero), "/"), tryInt(-5, zero, "%"))

    trueDiv: str = message(1.0, zero, "/")
    floorDiv: str = message(1.0, zero, "//")
    modulo: str = message(1.0, zero, "%")
    print(f"messages {trueDiv} | {floorDiv} | {modulo}")

    try {
        print(n / zero)
    } catch ArithmeticError as _e {
        print("arith caught ZeroDivisionError")
    }
}
