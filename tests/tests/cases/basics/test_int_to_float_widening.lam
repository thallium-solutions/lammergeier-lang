# An `int` value (variable or expression) where a `float` is expected widens
# implicitly, like in Python: arguments, returns, collection elements,
# declarations, assignments, fields, augmented assignments, function values,
# interface methods, lambdas and generators.
# expect: 1.5 3 4 3
# expect: [1 3 2.5] map[a:3 b:1]
# expect: 4
# expect: 6
# expect: [3]
# expect: 1.5
# expect: 3
# expect: 7 6
# expect: -1.5
# expect: map[k:3] [3]
# expect: 12
# expect: 6 4
# expect: 0
# expect: 1

func half(v: float) -> float {
    return v / 2
}

func asFloat(n: int) -> float {
    return n
}

func addOne(n: int) -> float {
    return n + 1
}

class P {
    func init(self, x: float) {
        self.x: float = x
    }
}

class Acc {
    func init(self) {
        self.total: float = 0.0
    }

    func add(self, v: float) {
        self.total += v
    }

    static func scale(v: float, k: float) -> float {
        return v * k
    }
}

interface Shape {
    func area(scale: float) -> float;
}

class Sq {
    func init(self, s: int) {
        self.s: int = s
    }

    func area(self, scale: float) -> float {
        return self.s * self.s * scale
    }
}

func gen(n: int) -> generator[float] {
    for i in range(n) {
        yield i
    }
}

func main() {
    n: int = 3
    print(half(n), half(n * 2), asFloat(4), addOne(2))
    xs: list[float] = [1, n, 2.5]
    d: dict[str, float] = {"a": n, "b": 1}
    print(xs, d)
    p: P = P(n)
    p.x = n + 1
    print(p.x)
    f: float = n
    f = n * 2
    print(f)
    ys: list[float] = []
    ys.append(n)
    print(ys)
    g: func(float) -> float = half
    print(g(n))
    t: float = n if n > 1 else 0.5
    print(t)

    a: Acc = Acc()
    a.add(n)
    a.add(n + 1)
    print(a.total, Acc.scale(n, 2))
    h: float = 1.5
    h += n
    h -= n * 2
    print(h)
    dd: dict[str, float] = {}
    dd["k"] = n
    zs: list[float] = [0.0]
    zs[0] = n
    print(dd, zs)
    sh: Shape = Sq(2)
    print(sh.area(n))
    lam: func(int) -> float = lambda (x: int) -> float: x * 2
    blk: func(int) -> float = lambda (x: int) -> float {
        return x + 1
    }
    print(lam(n), blk(n))
    for v in gen(2) {
        print(v)
    }
}
