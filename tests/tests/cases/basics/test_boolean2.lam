# Test: Boolean algebra and truth table patterns
# expect: true
# expect: false
# expect: false
# expect: false
# expect: false
# expect: true
# expect: true
# expect: true
# expect: false
# expect: true
# expect: true
# expect: false
# expect: true
# expect: false
# expect: true
# expect: true
# expect: true
# expect: false
# expect: true
# expect: bool2_ok

func nand(a: bool, b: bool) -> bool {
    return not (a and b)
}

func nor(a: bool, b: bool) -> bool {
    return not (a or b)
}

func xor_bool(a: bool, b: bool) -> bool {
    return (a or b) and not (a and b)
}

func implies(a: bool, b: bool) -> bool {
    return not a or b
}

func main() {
    # AND truth table
    print(True and True)
    print(True and False)
    print(False and True)
    print(False and False)

    # OR truth table
    print(False or False)
    print(False or True)
    print(True or False)
    print(True or True)

    # NOT
    print(not True)
    print(not False)

    # NAND
    print(nand(True, False))
    print(nand(True, True))

    # NOR
    print(nor(False, False))
    print(nor(True, False))

    # XOR
    print(xor_bool(True, False))
    print(xor_bool(True, True))

    # Implies
    print(implies(False, True))
    print(implies(True, False))
    print(implies(True, True))

    print("bool2_ok")
}
