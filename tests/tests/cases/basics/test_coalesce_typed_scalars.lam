# Regression (4.1.2): the result of `opt ?? fallback` has the payload type,
# so it composes with arithmetic (int/float widening), string operations,
# boolean logic, comparisons and f-strings, for unannotated and annotated
# targets. `w = find(4) ?? 0` followed by `1.5 * (100 - w)` used to fail
# `go build` ("1.5 (untyped float constant) truncated to int").

func find(n: int) -> optional[int] {
    if n > 3 {
        return n * 2
    }
    return None
}

func ratio(n: int) -> optional[float] {
    if n > 0 {
        return 0.5
    }
    return None
}

func name(n: int) -> optional[str] {
    if n > 0 {
        return "ada"
    }
    return None
}

func flag(n: int) -> optional[bool] {
    if n > 0 {
        return true
    }
    return None
}

func main() {
    # int
    w = find(4) ?? 0
    print(1.5 * (100 - w))
    v = find(1) ?? 3
    print(v * 0.5, v // 2, -v, v % 2)
    annotated: int = find(9) ?? 0
    print(annotated + w)
    widened: float = find(1) ?? 2
    print(widened / 4)
    print((find(5) ?? 0) * 2.5, (find(0) ?? 1) + 0.5)

    # float (an int fallback widens)
    r = ratio(0) ?? 1
    print(r * 3, r + w)
    r2: float = ratio(1) ?? 0
    print(r2 * 4)
    mixed = find(4) ?? 0.5
    print(mixed * 2, (find(1) ?? 0.5) * 2)

    # str
    s = name(1) ?? "x"
    print(s.toUpper(), s + "!", len(s), s * 2)
    t: str = name(0) ?? "anon"
    print(t.toUpper(), (name(0) ?? "guest").capitalize())
    print("hello " + (name(0) ?? "world"), name(1) ?? "a" + "b")

    # bool
    b = flag(0) ?? false
    c = flag(1) ?? false
    print(not b, b or c, c and not b)
    if not b and (flag(1) ?? false) {
        print("flags ok")
    }

    # comparisons and f-strings
    print(w > 7, (find(0) ?? 10) >= 10, (name(0) ?? "a") == "a", v != 3)
    print(f"w={w} half={w / 2} r={ratio(1) ?? 0.0} s={name(0) ?? 'none'} {(find(4) ?? 0) * 1.5}")
}

# expect: 138
# expect: 1.5 1 -3 1
# expect: 26
# expect: 0.5
# expect: 25 1.5
# expect: 3 9
# expect: 2
# expect: 16 1
# expect: ADA ada! 3 adaada
# expect: ANON Guest
# expect: hello world ada
# expect: true true true
# expect: flags ok
# expect: true true true false
# expect: w=8 half=4 r=0.5 s=none 12
