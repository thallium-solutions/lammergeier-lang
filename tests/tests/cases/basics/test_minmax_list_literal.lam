# Regression (4.13.2): `min` / `max` of a list literal (`min([4, 1, 9])`)
# emitted the literal as a `[]interface{}` and failed in `go build`
# (`interface{} does not satisfy cmp.Ordered`); a typed list variable
# worked. The literal now has its element type.
#
# expect: ints: 1 9 1 9
# expect: floats: 1 2.5
# expect: strs: a c
# expect: mixed-any: 2.5 b

func main() {
    nums: list[int] = [4, 1, 9]
    print(f"ints: {min(nums)} {max(nums)} {min([4, 1, 9])} {max([4, 1, 9])}")
    print(f"floats: {min([2.5, 1.0])} {max([2.5, 1.0])}")
    print(f"strs: {min(['b', 'a', 'c'])} {max(['b', 'a', 'c'])}")
    mixed: list[any] = [10, "b", 2.5]
    print(f"mixed-any: {min(mixed)} {max(mixed)}")
}
