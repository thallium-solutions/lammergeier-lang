# Regression (4.1.2): `??` over optionals of another module (functions, a
# generic function, a method, optional fields of an imported class and a
# `Result[optional[int]]` consumed with `?`) keeps the payload type.
from lamerrors import Result
from coalesce_typed_provider import Account, findAge, findRate, nickname, findAccount, loadAge, firstOf

func discount(name: str) -> Result[float] {
    age = loadAge(name)? ?? 0
    return Result.Ok(1.5 * (100 - age))
}

func main() {
    age = findAge("bob") ?? 20
    print(age * 0.5, 100 - (findAge("ada") ?? 0))
    rate = findRate("bob") ?? 1
    print(rate * age, (findRate("ada") ?? 0.0) * 4)
    print((nickname("bob") ?? "anon").toUpper(), nickname("ada") ?? "x" + "y")
    acct = findAccount("") ?? Account("guest")
    print(acct.owner, (acct.balance() ?? 0) / 4, (findAccount("ab") ?? acct).balance() ?? -1)
    limit = acct.limit ?? 50
    print(limit * 1.1 > 55, len(acct.tags ?? ["t"]))
    acct.tags = ["vip", "new"]
    print((acct.tags ?? [])[0].toUpper())
    print(discount("ada").unwrap(), discount("bob").unwrap(), discount("boom").ok())
    print((firstOf([3, 4]) ?? 0) * 1.5, (firstOf(["q"]) ?? "").toUpper())
    print(f"{findAge('ada') ?? 0}/{nickname('zed') ?? 'none'}")
}

# expect: 10 64
# expect: 20 1
# expect: ANON countess
# expect: guest 125 200
# expect: true 1
# expect: VIP
# expect: 96 150 false
# expect: 4.5 Q
# expect: 36/none
