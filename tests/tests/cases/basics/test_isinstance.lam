# Test: `isinstance` is backed by real Go type switches / reflect checks
# (no longer a placeholder `true`).
# expect: PASS 1 int against int
# expect: PASS 2 str against str
# expect: PASS 3 float against float
# expect: PASS 4 bool against bool
# expect: PASS 5 None check
# expect: PASS 6 list kind
# expect: PASS 7 dict kind
# expect: PASS 8 tuple-of-types OR
# expect: PASS 9 user class positive
# expect: PASS 10 user class negative
# expect: 10 passed, 0 failed, 10 total

from lamtest import Test

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }
}

class Other {
    func init(self, tag: int) {
        self.tag: int = tag
    }
}

func main() {
    # Primitive positive cases
    i: any = 42
    Test.assertTrue(isinstance(i, int), "1 int against int")

    s: any = "hello"
    Test.assertTrue(isinstance(s, str), "2 str against str")

    f: any = 3.14
    Test.assertTrue(isinstance(f, float), "3 float against float")

    b: any = true
    Test.assertTrue(isinstance(b, bool), "4 bool against bool")

    # Nil / None
    n: any = nil
    Test.assertTrue(isinstance(n, None), "5 None check")

    # Container kinds via reflect
    xs: any = [1, 2, 3]
    Test.assertTrue(isinstance(xs, list), "6 list kind")

    d: any = {"a": 1}
    Test.assertTrue(isinstance(d, dict), "7 dict kind")

    # Tuple-of-types — OR combines
    v: any = "hello"
    Test.assertTrue(isinstance(v, (int, str)), "8 tuple-of-types OR")

    # User class positive
    p: any = Point(1, 2)
    Test.assertTrue(isinstance(p, Point), "9 user class positive")

    # User class negative
    o: any = Other(7)
    Test.assertFalse(isinstance(o, Point), "10 user class negative")

    Test.summary()
}
