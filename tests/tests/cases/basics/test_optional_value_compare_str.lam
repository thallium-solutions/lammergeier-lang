# Regression: an `optional[str]` / `optional[int]` compares by value with a
# payload value or another optional (`None == None` is true), `str()` of it
# is the value or `<nil>` (it was the pointer's address), and `x?.m()` on an
# `optional[str]` calls the str method on the value (it failed to build).
# expect: true false false true
# expect: true true false
# expect: abc 3 ABC
# expect: false true false true
# expect: <nil> <nil> <nil>
# expect: none

func get(k: str) -> optional[str] {
    if k == "" {
        return None
    }
    return k
}

func size(k: str) -> optional[int] {
    if k == "" {
        return None
    }
    return len(k)
}

func main() {
    x: optional[str] = get("abc")
    y: optional[str] = get("abc")
    n: optional[int] = size("abc")
    none: optional[str] = get("")
    print(x == "abc", x != "abc", x == "zz", "abc" == x)
    print(x == y, n == 3, n == 4)
    print(str(x), str(n), x?.toUpper() ?? "")
    print(none == "abc", none == get(""), none == x, none != x)
    print(str(none), str(size("")), none?.toUpper())
    print(none?.toUpper() ?? "none")
}
