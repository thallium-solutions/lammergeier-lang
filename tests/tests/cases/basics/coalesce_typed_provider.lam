# Provider for test_coalesce_typed_imported.lam: functions, a generic
# function, a class with optional fields and methods returning optionals.
from lamerrors import Result

class Account {
    func init(self, owner: str) {
        self.owner: str = owner
        self.limit: optional[float] = None
        self.tags: optional[list[str]] = None
    }

    func balance(self) -> optional[int] {
        if self.owner == "" {
            return None
        }
        return len(self.owner) * 100
    }
}

func findAge(name: str) -> optional[int] {
    if name == "ada" {
        return 36
    }
    return None
}

func findRate(name: str) -> optional[float] {
    if name == "ada" {
        return 0.25
    }
    return None
}

func nickname(name: str) -> optional[str] {
    if name == "ada" {
        return "countess"
    }
    return None
}

func findAccount(name: str) -> optional[Account] {
    if name == "" {
        return None
    }
    return Account(name)
}

func loadAge(name: str) -> Result[optional[int]] {
    if name == "boom" {
        return Result.Err("boom")
    }
    return Result.Ok(findAge(name))
}

func firstOf[T](xs: list[T]) -> optional[T] {
    if len(xs) == 0 {
        return None
    }
    return xs[0]
}

func main() { pass }
