# Regression (4.1.2): `x == None` / `x != None` / `x is None` / `x is not
# None` (also `None == x`) narrow an optional local or parameter like
# `isinstance(x, None)`: after `if h == None { return ... }` an
# `optional[html]` is an `html` (it was refused), in functions, methods,
# static methods and lambdas alike, and a narrowed value returned or passed
# where an optional is expected is boxed again.

class User {
    func init(self, name: str) {
        self.name: str = name
    }
}

func page(h: optional[html]) -> html {
    if h == None {
        return <><i>empty</i></>
    }
    return h
}

func double(n: optional[int]) -> int {
    if n is None {
        return 0
    }
    return n * 2
}

func bump(n: optional[int]) -> optional[int] {
    if n == None {
        return None
    }
    return n + 1
}

func same(n: optional[int]) -> optional[int] {
    if n != None {
        return n
    }
    return None
}

func label(u: optional[User]) -> str {
    if None == u {
        return "-"
    }
    return u.name
}

func words(xs: optional[list[str]]) -> int {
    if xs is not None and len(xs) > 0 {
        return len(xs)
    }
    return 0
}

func pick(a: optional[str], b: str) -> str {
    if a != None {
        return a
    }
    return b
}

func sumAll(values: list[optional[int]]) -> int {
    total = 0
    for v in values {
        if v == None {
            continue
        }
        total += v
    }
    return total
}

func settled(n: optional[int]) -> str {
    if n == None {
        return "none"
    }
    whole: int = n ?? -1
    half: float = n ?? 0.5
    return f"{whole} {half * 2}"
}

class View {
    func init(self, title: str) {
        self.title: str = title
    }

    func page(self, h: optional[html]) -> html {
        if h == None {
            return <><b>${self.title}</b></>
        }
        return h
    }

    func size(self, n: optional[int]) -> int {
        if n is not None {
            return n + len(self.title)
        }
        return 0
    }

    func keep(self, n: optional[int]) -> optional[int] {
        if n == None {
            return None
        }
        return n
    }

    static func parse(s: optional[str]) -> int {
        if s == None {
            return -1
        }
        return len(s)
    }
}

func main() {
    print(page(<><p>a</p></>), page(None))
    print(double(4), double(None), bump(1), bump(None), same(7), same(None))
    print(label(User("ann")), label(None), words(["a", "b"]), words(None), words([]))
    print(pick("x", "y"), pick(None, "y"), sumAll([1, None, 3]), settled(4), settled(None))
    v: View = View("t")
    print(v.page(None), v.page(<><s>q</s></>), v.size(3), v.size(None), v.keep(5), v.keep(None))
    print(View.parse("abc"), View.parse(None))
    f = lambda(n: optional[int]) -> int: n * 3 if n != None else -3
    two: optional[int] = 2
    nothing: optional[int] = None
    print(f(two), f(nothing))
    msg: optional[str] = "hi"
    if msg != None {
        print(f"{msg.toUpper()}!")
    }
}

# expect: <p>a</p> <i>empty</i>
# expect: 8 0 2 <nil> 7 <nil>
# expect: ann - 2 0 0
# expect: x y 4 4 8 none
# expect: <b>t</b> <s>q</s> 4 0 5 <nil>
# expect: 3 -1
# expect: 6 -3
# expect: HI!
