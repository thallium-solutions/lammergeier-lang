# Regression (4.1.2): `??` results are typed inside larger constructs:
# chains (`a ?? b ?? c`), function / builtin arguments (an int result
# widens into a `float` parameter), `return`, `Result.Ok(...)`, ternaries,
# `?` on a `Result[optional[T]]` (`load(n)? ?? 0`), generic functions
# returning `optional[T]`, lambdas, comprehensions and `do` blocks.
from lamerrors import Result

func a(n: int) -> optional[int] {
    if n > 5 {
        return n
    }
    return None
}

func label(n: int) -> optional[str] {
    if n > 5 {
        return f"#{n}"
    }
    return None
}

func half(x: float) -> float {
    return x / 2
}

func pick(n: int) -> int {
    return a(n) ?? 7
}

func pickF(n: int) -> float {
    return a(n) ?? 0.5
}

func load(n: int) -> Result[optional[int]] {
    if n < 0 {
        return Result.Err("negative")
    }
    return Result.Ok(a(n))
}

func run(n: int) -> Result[float] {
    w = load(n)? ?? 0
    return Result.Ok(1.5 * w)
}

func run2(n: int) -> Result[int] {
    return Result.Ok(load(n)? ?? 5)
}

func run3(n: int) -> Result[str] {
    do {
        s = label(load(n)? ?? 0) ?? "none"
        return Result.Ok(s.toUpper() + "!")
    } catch e {
        return Result.Err(e)
    }
}

func first[T](xs: list[T]) -> optional[T] {
    if len(xs) == 0 {
        return None
    }
    return xs[0]
}

func orDefault[T](x: optional[T], d: T) -> T {
    return x ?? d
}

func main() {
    # chains
    v = a(1) ?? a(2) ?? 3
    print(v * 1.5, a(1) ?? a(8) ?? 0, label(1) ?? label(2) ?? "z")
    c: int = a(0) ?? a(1) ?? a(9) ?? 1
    print(c - 1)

    # arguments, return, Result.Ok
    print(half(a(1) ?? 4), max(a(1) ?? 2, 3), str(a(6) ?? 0) + "?")
    print(pick(1), pick(8), pickF(1), pickF(6) * 2)
    print(run(2).unwrap(), run(7).unwrap(), run2(0).unwrap(), run2(9).unwrap())
    print(run3(8).unwrap(), run3(1).unwrap(), run(-1).ok())

    # ternaries
    y = (a(1) ?? 2) if v > 0 else 0
    print(y * 2.5, (a(1) ?? 1) if y > 1 else (a(9) ?? 0))
    z: float = a(1) ?? 2
    print(z)

    # generics
    f = first([1, 2]) ?? 0
    print(f * 0.5)
    g = first(["a"]) ?? "z"
    empty: list[str] = []
    print(g.toUpper(), (first(empty) ?? "e").toUpper())
    h: int = orDefault(a(1), 4)
    print(h + 1)

    # lambdas and comprehensions
    fn: func(int) -> int = lambda n: (a(n) ?? 1) * 10
    print(fn(1), fn(6))
    labels = [label(n) ?? "-" for n in [1, 6, 9]]
    print(labels, [(a(n) ?? 0) * 0.5 for n in [2, 8]])
    total = 0
    for n in [3, 6, 7] {
        total += a(n) ?? 1
    }
    print(total)
}

# expect: 4.5 8 z
# expect: 8
# expect: 2 3 6?
# expect: 7 8 0.5 12
# expect: 0 10.5 5 9
# expect: #8! NONE! false
# expect: 5 1
# expect: 2
# expect: 0.5
# expect: A E
# expect: 5
# expect: 10 60
# expect: [- #6 #9] [0 4]
# expect: 14
