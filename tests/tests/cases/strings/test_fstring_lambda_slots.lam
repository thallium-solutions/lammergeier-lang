# Regression (4.2.1): an f-string slot holding a lambda with a block body
# (`f"{xs.all(lambda (x: int) -> bool { return x > 0 })}"`) was parsed
# without the statement preprocessing (the `;` before the inner `}`), fell
# back to the textual lowering and reached Go verbatim ("syntax error:
# unexpected :"). Python format specs that are not a Go verb (`{x:>5}`,
# `{s:<6}`, `{x:}`) produced invalid Go the same way. Slots are checked
# with nested braces, colons and strings in lambdas, dict literals, slices,
# ternaries, nested f-strings, in methods and in another module.
#
# expect: inline=true true
# expect: block=true false
# expect: multi=[7 3 5]
# expect: dict=3 3 bb{}:a{}:ccc
# expect: slice=[1 2] [3 1] cc [2 1 3]
# expect: spec=[    3] [ccc   ] [00001] [   3.142] [+3] [  bb] [2.50  ] [3] [3.1]
# expect: tern=big|   3|
# expect: combo=[[10 20]] [  2]
# expect: braces=[bb} a} ccc}]
# expect: nestedf=TRUE
# expect: gate=false
# expect: provider=true [  3] [[2 3]]
# expect: scores=[12  ] true

from fstring_lambda_provider import describe, Scores

class Gate {
    func init(self, limit: int) {
        self.limit: int = limit
    }

    func check(self, xs: list[int]) -> str {
        return f"gate={xs.all(lambda (x: int) -> bool { return x <= self.limit })}"
    }
}

func main() {
    xs: list[int] = [3, 1, 2]
    words: list[str] = ["bb", "a", "ccc"]
    d: dict[str, int] = {"a": 1, "b": 2}
    print(f"inline={xs.all(lambda(x: int) -> bool: x > 0)} {xs.any(lambda (x: int) -> bool: x > 2)}")
    print(f"block={xs.all(lambda(x: int) -> bool { return x > 0 })} {xs.all(lambda (x: int) -> bool { return x > 1 })}")
    print(f"multi={xs.map(lambda (x: int) -> int { y: int = x * 2; return y + 1 })}")
    print(f"dict={ {"k": len(xs)}["k"] } {d["a"] + d["b"]} {"{}:".join(words)}")
    print(f"slice={xs[1:]} {xs[:2]} {words[2][1:]} {xs[::-1]}")
    print(f"spec=[{xs[0]:>5}] [{words[2]:<6}] [{xs[1]:05d}] [{3.14159:8.3f}] [{xs[0]:+d}] [{words[0]:>4}] [{2.5:<6.2f}] [{xs[0]:}] [{3.14159:.2}]")
    print(f"tern={"big" if len(xs) > 2 else "small"}|{xs[0] if xs[0] > 2 else -1:>4}|")
    print(f"combo=[{xs.map(lambda (x: int) -> int { return x * 10 })[1:]}] [{len(xs.filter(lambda(x: int) -> bool: x > 1)):>3}]")
    print(f"braces={words.map(lambda (w: str) -> str { return w + "}" })}")
    print(f"nestedf={f'{xs.any(lambda (x: int) -> bool { return x > 2 })}'.toUpper()}")
    print(Gate(2).check(xs))
    print(describe(xs))
    print(Scores([5, 7]).render())
}
