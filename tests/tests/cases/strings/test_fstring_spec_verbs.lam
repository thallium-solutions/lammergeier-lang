# Coverage (4.13.2): f-string format specs pinned — Go verbs and Python
# alignment forms on every scalar type: hex / octal / binary / exponent /
# general verbs, `#` alternate forms, `+` and space signs, zero padding,
# widths on strings (left by default, `<` right-padded), precision on
# floats and strings, `%v` of lists, dicts and classes, specs on
# expressions (calls, indexing, ternaries, static fields), and literal
# braces next to slots.
#
# expect: ints: [ff] [FF] [0xff] [377] [11111111] [+7] [ 7] [007] [   42] [42   ]
# expect: floats: [3.14] [  3.142] [3.14e+00] [3.1E+00] [2.5] [+1.5] [1.50  ]
# expect: strs: [   ab] [ab   ] [abc] [   xy] ["q"]
# expect: values: [1 2 3] map[a:1] Point(1,2) [true] {'a': 1}
# expect: exprs: [    3] [x    ] [0.50] [   EUR] {literal} {5}

class Point {
    func init(self, x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    func __str__(self) -> str {
        return f"Point({self.x},{self.y})"
    }
}

class Shop {
    static currency: str = "EUR"
}

func half(n: int) -> float {
    return n / 2.0
}

func main() {
    n: int = 255
    seven: int = 7
    print(f"ints: [{n:x}] [{n:X}] [{n:#x}] [{n:o}] [{n:b}] [{seven:+d}] [{seven: d}] [{seven:03d}] [{42:5d}] [{42:<5}]")
    pi: float = 3.14159
    print(f"floats: [{pi:.2f}] [{pi:7.3f}] [{pi:.2e}] [{pi:.1E}] [{2.5:g}] [{1.5:+.1f}] [{1.5:<6.2f}]")
    s: str = "ab"
    print(f"strs: [{s:5}] [{s:<5}] [{'abcdef':.3}] [{'xy':>5}] [{'q':q}]")
    counts: dict[str, int] = {"a": 1}
    print(f"values: {[1, 2, 3]} {counts} {Point(1, 2)} [{true}] {{'a': 1}}")
    words: list[str] = ["x", "y"]
    print(f"exprs: [{len(words) + 1:5d}] [{words[0]:<5}] [{half(1):.2f}] [{Shop.currency:>6}] {{literal}} {{{len('hello')}}}")
}
