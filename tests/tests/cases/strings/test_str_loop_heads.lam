# A loop reading a `str` local it never rebinds computes a view of the
# string once (docs/TRANSPILATION.md, "Loop-invariant `str` views"): `len(s)`, `s[i]`, `s[a:b]` and `s[a:]` inside it stay character
# operations on ASCII, mixed, non-ASCII, short and long (indexed) strings,
# negative indexes and bounds past either end; a fault is still an
# IndexError at its Lam line. A loop rebinding the string (an assignment, a
# `go!` block, a nested function with `nonlocal`), a lambda or a `defer`
# reading it after it is rebound, and module code keep the plain lowering.
# expect: scan=5,90,4,2,0
# expect: ends=ohhéllolééllolllloéllohoo|eaabc
# expect: slices=[ab|bc|c|] [aé|éb|b|] [xé|é|]
# expect: caught=IndexError: index out of range [3] with length 3 (at test_str_loop_heads.lam:56)
# expect: caught=IndexError: index out of range [-4] with length 3 (at test_str_loop_heads.lam:56)
# expect: caught=IndexError: index out of range [101] with length 101 (at test_str_loop_heads.lam:56)
# expect: caught=IndexError: index out of range [-102] with length 101 (at test_str_loop_heads.lam:56)
# expect: rebound=abé|é|abéééé
# expect: lambdas=é,é,é deferred=a
# expect: nested=14 lines=3,5,0
# expect: goblock=a,b,é
# expect: closure=a,é,é
# expect: gen=[h l o] leaf=5
# expect: module=x,é

func count(s: str, want: str) -> int {
    i: int = 0
    n: int = 0
    while i < len(s) {
        if s[i] == want or s[i] == "a" {
            n += 1
        }
        i += 1
    }
    return n
}

func ends(s: str) -> str {
    out: str = ""
    for i in range(len(s)) {
        out = out + s[-1 - i] + s[i:i + 1] + s[i:]
    }
    return out
}

func pairs(s: str) -> str {
    parts: list[str] = []
    k: int = 0
    while k < len(s) + 1 {
        parts.append(s[k:k + 2])
        k += 1
    }
    return "[" + "|".join(parts) + "]"
}

func probe(s: str) {
    for k in [len(s), -len(s) - 1] {
        try {
            print(f"{s[k]}")
        } catch IndexError as e {
            print(f"caught={e}")
        }
    }
}

func rebound() -> str {
    s: str = "ab"
    j: int = 0
    out: list[str] = []
    while j < len(s) {
        s = s + "é"
        j += 1
        if j == 1 {
            out.append(s)
        }
        if len(s) > 5 {
            break
        }
    }
    out.append(s[len(s) - 1])
    out.append(s)
    return "|".join(out)
}

func lambdas() -> str {
    s: str = "abc"
    fs: list[func() -> str] = []
    for i in range(3) {
        fs.append(lambda: s[0])
    }
    s = "é" * 3
    return ",".join([f() for f in fs])
}

func deferred() -> str {
    s: str = "abc"
    out: list[str] = []
    func push(c: str) {
        out.append(c)
    }
    func run() {
        for i in range(1) {
            defer push(s[i])
        }
        s = "é"
    }
    run()
    return out[0]
}

func nested(s: str) -> int {
    total: int = 0
    i: int = 0
    while i < len(s) {
        j: int = i
        while j < len(s) and s[j] != " " {
            j += 1
        }
        total += j - i
        i = j + 1
    }
    return total
}

func widths(lines: list[str]) -> str {
    out: list[str] = []
    for line in lines {
        w: int = 0
        while w < len(line) and line[w] != "!" {
            w += 1
        }
        out.append(f"{w}")
    }
    return ",".join(out)
}

func goblock() -> str {
    s: str = "ab"
    out: list[str] = []
    for i in range(3) {
        if i == 2 {
            go! {
                s = "ééé"
            }
        }
        out.append(s[i])
    }
    return ",".join(out)
}

func closure() -> str {
    cs: str = "ab"
    func change() {
        nonlocal cs
        cs = "éé"
    }
    out: list[str] = []
    for i in range(2) {
        out.append(cs[i])
        change()
    }
    out.append(cs[0])
    return ",".join(out)
}

func letters(s: str) -> generator[str] {
    i: int = 0
    while i < len(s) {
        yield s[i]
        i += 2
    }
}

func leaf(s: str) -> generator[int] {
    n: int = 0
    for i in range(len(s)) {
        if s[i] != " " {
            n += 1
        }
    }
    yield n
}

func main() {
    long: str = "éaébc" * 30
    print(f"scan={count("banana", "n")},{count(long, "é")},{count("x" * 70 + "aéaa", "é")},{count("éé", "é")},{count("", "a")}")
    print(f"ends={ends("héllo")}|{ends("abcde")[0:5]}")
    print(f"slices={pairs("abc")} {pairs("aéb")} {pairs("xé")}")
    probe("abc")
    probe("x" * 100 + "é")
    print(f"rebound={rebound()}")
    print(f"lambdas={lambdas()} deferred={deferred()}")
    print(f"nested={nested("ab cdé fghij  klmn")} lines={widths(["abc!d", "héllo", "!"])}")
    print(f"goblock={goblock()}")
    print(f"closure={closure()}")
    gen: list[str] = []
    for c in letters("hélloé") {
        gen.append(c)
    }
    total: int = 0
    for n in leaf("a b c d e") {
        total += n
    }
    print(f"gen={gen} leaf={total}")
    print(f"module={module()}")
}

s_global: str = "xy"

func module() -> str {
    out: list[str] = []
    for i in range(2) {
        out.append(s_global[0])
        s_global = "é"
    }
    return ",".join(out)
}
